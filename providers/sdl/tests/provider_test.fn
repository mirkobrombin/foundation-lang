package foundation.ui.sdl

import foundation.ui
import std.bytes

fn surfaceSizeFailed(window ui.Window, surface ui.Surface) bool {
    match window.SurfaceSize(surface) {
        Ok(value): { discard value false }
        Err(error): match error {
            Failed: true
            _: false
        }
    }
}

fn drawCompactGroup(&window ui.Window) void {
    if !window.BeginCompactGroup("compact") return
    window.Row(24.0, 1)
    window.Label("Compact", .Primary, false)
    window.EndGroup()
}

fn drawSurfaceGroup(&window ui.Window) void {
    if !window.BeginSurfaceGroup("surface") return
    window.Row(24.0, 1)
    window.Label("Surface", .Primary, false)
    window.EndGroup()
}

fn drawContextMenu(&window ui.Window) void {
    if !window.BeginContextMenu(180.0, 2) return
    discard window.ContextMenuItem("Action", true)
    discard window.ContextMenuItem("Unavailable", false)
    window.EndContextMenu()
}

fn drawPopover(&window ui.Window) void {
    if !window.BeginNamedPopover("provider-popover", 240.0, 120.0) return
    window.Row(28.0, 1)
    window.Label("Popover", .Primary, false)
    window.EndPopover()
}

fn drawTextFields(&window ui.Window) void {
    const edited = window.Edit("field", "value", 32) else {
        fail("provider did not draw a text field")
    }
    if edited.Value != "value" {
        fail("provider changed an idle text field")
    }
    const hinted = window.EditHint("hinted", "", "Search", 32) else {
        fail("provider did not draw a hinted text field")
    }
    if hinted.Value != "" {
        fail("provider changed an idle hinted text field")
    }
    const formText = window.FormTextField(
        "Account",
        "form-text",
        "",
        "Email or account name",
        64
    ) else {
        fail("provider did not draw a form text field")
    }
    if formText.Value != "" {
        fail("provider changed an idle form text field")
    }
    const formAction = window.FormActionField(
        "Folder",
        "form-action",
        "",
        "Choose a folder",
        "Choose...",
        .Secondary,
        128,
        true
    ) else {
        fail("provider did not draw a form action field")
    }
    if formAction.Edit.Value != "" || formAction.Activated {
        fail("provider changed an idle form action field")
    }
    const formSecret = window.FormSecretField(
        "Passphrase",
        "form-secret",
        "secret",
        64
    ) else {
        fail("provider did not draw a form secret field")
    }
    if formSecret.Value != "secret" {
        fail("provider changed an idle form secret field")
    }
    const fieldNames = [
        "one",
        "two",
        "three",
        "four",
        "five",
        "six",
        "seven",
        "eight",
        "nine"
    ]
    for name in fieldNames {
        const repeated = window.Edit(name, "", 8) else {
            fail("provider exhausted text field state")
        }
        discard repeated
    }
}

fn drawSlider(&window ui.Window) void {
    const value = window.Slider(50, 0, 100, 1) else {
        fail("provider did not draw a slider")
    }
    if value.Value != 50 || value.Changed {
        fail("provider changed an idle slider")
    }
    const invalid = window.Slider(10, 10, 10, 1)
    match invalid {
        Ok(result): {
            discard result
            fail("provider accepted equal slider bounds")
        }
        Err(error): match error {
            Invalid: {}
            _: { fail("provider reported the wrong slider error") }
        }
    }
}

fn configureContentGeometry(&window ui.Window) void {
    window.Wait(1) else {
        fail("provider did not accept a bounded event wait")
    }
    window.SetContentPadding(0, 0) else {
        fail("provider did not apply content padding")
    }
    window.SetContentSpacing(0, 0) else {
        fail("provider did not apply content spacing")
    }
    const rejected = match window.SetContentPadding(257, 0) {
        Ok: false
        Err(error): match error {
            Invalid: true
            _: false
        }
    }
    if !rejected {
        fail("provider accepted content padding outside the supported range")
    }
    window.SetTheme(.Light) else {
        fail("provider did not apply the light theme")
    }
}

fn drawContentGeometry(&window ui.Window, surface ui.Surface) void {
    const frame = window.BeginFrame() else {
        fail("provider did not begin the geometry frame")
    }
    discard frame
    if window.BeginRoot() {
        window.Row(100.0, 1)
        window.DrawSurfaceFill(surface) else {
            fail("provider did not draw the geometry surface")
        }
        const size = window.SurfaceSize(surface) else {
            fail("provider did not report the geometry surface")
        }
        if size.Width != 720 || size.Height != 100 {
            fail("theme reset the configured content geometry")
        }
        window.EndRoot()
    }
    window.EndFrame() else {
        fail("provider did not end the geometry frame")
    }
}

fn drawSelectionWidgets(&window ui.Window) void {
    discard window.ActionButton("Primary", .Primary, true)
    discard window.ActionButton("Disabled", .Secondary, false)
    discard window.ActionButton("Remove", .Destructive, true)
    window.Row(20.0, 1)
    window.Progress(1, 2) else {
        fail("provider did not draw progress")
    }
    window.Row(36.0, 1)
    discard window.NavigationItem("Navigation", true, true)
    window.Row(40.0, 1)
    discard window.SidebarItem(.Shield, "Sidebar", true, true)
    window.Row(48.0, 1)
    discard window.ListItem("List item", "Supporting text", true, true)
    window.Row(48.0, 1)
    discard window.ToggleItem("Toggle", "Supporting text", true, true)
    window.Row(48.0, 1)
    discard window.CheckItem("Check", "Supporting text", true, true)
    window.Row(48.0, 1)
    discard window.RadioItem("Radio", "Supporting text", true, true)
    window.Row(48.0, 1)
    discard window.ActionItem(
        "Action",
        "Supporting text",
        "Open",
        .Secondary,
        true
    )
    window.Row(48.0, 1)
    discard window.ChoiceItem(
        "Choice",
        "Supporting text",
        "Selected value",
        true
    )
    window.Row(96.0, 1)
    window.EmptyState(.Download, "Nothing here", "Supporting text")
    window.Row(54.0, 1)
    window.Notice("Notice", "Supporting text", .Accent)
    const segment = window.Segmented(["First", "Second"], 0, true)
    if segment != 0 {
        fail("provider changed an idle segmented selection")
    }
    window.Row(36.0, 1)
    if window.BeginNamedPicker("provider-picker", "Selected", 120.0) {
        discard window.PickerItem("Selected", true, true)
        discard window.PickerItem("Unavailable", false, false)
        window.EndPicker()
    }
}

test "provider opens a native window" {
    const opened = Open("Foundation UI", 720, 480) else {
        fail("provider did not open a window")
    }
    var window = opened
    window.SetTheme(.Dark) else {
        fail("provider did not apply the theme")
    }
    window.SetAccent(ui.Color {
        Red = 95
        Green = 221
        Blue = 122
        Alpha = 255
    }) else {
        fail("provider did not apply the accent")
    }
    const size = window.Size() else {
        fail("provider did not report the window size")
    }
    if size.Width != 720 || size.Height != 480 {
        fail("provider reported the wrong window size")
    }
    window.SetVisible(false) else {
        fail("provider did not hide the window")
    }
    if window.Visible() {
        fail("provider reported a hidden window as visible")
    }
    window.Raise() else {
        fail("provider did not raise the window")
    }
    if !window.Visible() {
        fail("provider did not show the raised window")
    }
    pass()
}

test "provider configures content geometry" {
    const opened = Open("Foundation UI", 720, 480) else {
        fail("provider did not open a window")
    }
    var window = opened
    configureContentGeometry(&window)
    const surface = window.CreateSurface() else {
        fail("provider did not create a geometry surface")
    }
    window.UpdateSurface(surface, 1, 1, bytes.FromText("RGBA")) else {
        fail("provider did not update the geometry surface")
    }
    drawContentGeometry(&window, surface)
    pass()
}

test "provider reports an idle file dialog" {
    const opened = Open("Foundation UI", 720, 480) else {
        fail("provider did not open a window")
    }
    var window = opened
    const dialog = window.PollOpenFileDialog() else {
        fail("provider did not report file dialog state")
    }
    match dialog {
        Idle: {}
        _: { fail("provider reported an active file dialog") }
    }
    pass()
}

test "provider reports an idle folder dialog" {
    const opened = Open("Foundation UI", 720, 480) else {
        fail("provider did not open a window")
    }
    var window = opened
    const dialog = window.PollOpenFolderDialog() else {
        fail("provider did not report folder dialog state")
    }
    match dialog {
        Idle: {}
        _: { fail("provider reported an active folder dialog") }
    }
    pass()
}

test "provider keeps surfaces independent" {
    const opened = Open("Foundation UI", 720, 480) else {
        fail("provider did not open a window")
    }
    var window = opened
    const first = window.CreateSurface() else {
        fail("provider did not create the first surface")
    }
    const second = window.CreateSurface() else {
        fail("provider did not create the second surface")
    }
    window.UpdateSurface(first, 1, 1, bytes.FromText("RGBA")) else {
        fail("provider did not update the first surface")
    }
    window.UpdateSurface(second, 1, 1, bytes.FromText("ARGB")) else {
        fail("provider did not update the second surface")
    }
    pass()
}

test "provider selects embedded surface input" {
    const opened = Open("Foundation UI", 720, 480) else {
        fail("provider did not open a window")
    }
    var window = opened
    const surface = window.CreateSurface() else {
        fail("provider did not create a surface")
    }
    window.SetSurfaceInputMode(surface, .Embedded) else {
        fail("provider did not select embedded surface input")
    }
    if window.SurfaceCaptured(surface) || window.SurfaceFocused(surface) {
        fail("provider focused an idle embedded surface")
    }
    pass()
}

test "provider rejects a surface from another window" {
    const firstOpened = Open("First", 320, 240) else {
        fail("provider did not open the first window")
    }
    const secondOpened = Open("Second", 320, 240) else {
        fail("provider did not open the second window")
    }
    var firstWindow = firstOpened
    var secondWindow = secondOpened
    const surface = firstWindow.CreateSurface() else {
        fail("provider did not create a surface")
    }
    const rejected = match secondWindow.DestroySurface(surface) {
        Ok: false
        Err(error): match error {
            Invalid: true
            _: false
        }
    }
    if !rejected {
        fail("provider accepted a surface from another window")
    }
    const firstFrame = firstWindow.BeginFrame() else {
        fail("provider did not begin the first window frame")
    }
    discard firstFrame
    firstWindow.EndFrame() else {
        fail("provider did not end the first window frame")
    }
    const secondFrame = secondWindow.BeginFrame() else {
        fail("provider did not begin the second window frame")
    }
    discard secondFrame
    secondWindow.EndFrame() else {
        fail("provider did not end the second window frame")
    }
    pass()
}

test "provider reports a surface layout size" {
    const opened = Open("Foundation UI", 720, 480) else {
        fail("provider did not open a window")
    }
    var window = opened
    const surface = window.CreateSurface() else {
        fail("provider did not create a surface")
    }
    window.UpdateSurface(surface, 1, 1, bytes.FromText("RGBA")) else {
        fail("provider did not update the surface")
    }
    if !surfaceSizeFailed(window, surface) {
        fail("provider reported an undrawn surface size")
    }
    const frame = window.BeginFrame() else {
        fail("provider did not begin a frame")
    }
    discard frame
    if window.BeginRoot() {
        window.Row(80.0, 1)
        window.DrawSurfaceFill(surface) else {
            fail("provider did not draw the surface")
        }
        const surfaceSize = window.SurfaceSize(surface) else {
            fail("provider did not report the surface cell size")
        }
        if surfaceSize.Width == 0 || surfaceSize.Height == 0 {
            fail("provider reported an empty surface cell")
        }
        window.EndRoot()
    }
    window.EndFrame() else {
        fail("provider did not end the frame")
    }
    pass()
}

test "provider draws and destroys a surface" {
    const opened = Open("Foundation UI", 720, 480) else {
        fail("provider did not open a window")
    }
    var window = opened
    const surface = window.CreateSurface() else {
        fail("provider did not create a surface")
    }
    window.UpdateSurface(surface, 1, 1, bytes.FromText("RGBA")) else {
        fail("provider did not update the surface")
    }
    const frame = window.BeginFrame() else {
        fail("provider did not begin a frame")
    }
    discard frame
    if window.BeginRoot() {
        window.Row(80.0, 1)
        window.DrawSurface(surface) else {
            fail("provider did not draw the surface")
        }
        window.EndRoot()
    }
    window.EndFrame() else {
        fail("provider did not end the frame")
    }
    window.DestroySurface(surface) else {
        fail("provider did not destroy the surface")
    }
    const rejected = match window.DestroySurface(surface) {
        Ok: false
        Err(error): match error {
            Invalid: true
            _: false
        }
    }
    if !rejected {
        fail("provider accepted a destroyed surface")
    }
    pass()
}

test "provider draws standard widgets" {
    const opened = Open("Foundation UI", 720, 480) else {
        fail("provider did not open a window")
    }
    var window = opened
    const surface = window.CreateSurface() else {
        fail("provider did not create an image surface")
    }
    window.UpdateSurface(surface, 1, 1, bytes.FromText("RGBA")) else {
        fail("provider did not load an image surface")
    }
    window.SetApplicationIcon(1, 1, bytes.FromText("RGBA")) else {
        fail("provider did not set the application icon")
    }
    const frame = window.BeginFrame() else {
        fail("provider did not begin a frame")
    }
    discard frame
    if window.BeginRoot() {
        drawCompactGroup(&window)
        drawSurfaceGroup(&window)
        window.Titlebar("Foundation UI", "widgets")
        window.Row(48.0, 16)
        window.ApplicationIcon()
        discard window.MonogramButton("UI", "Monogram", ui.Color {
            Red = 98
            Green = 100
            Blue = 167
            Alpha = 255
        }, false, true)
        discard window.ImageButton(surface, "Image", false, true)
        discard window.IconButton(.Theme, "Theme", false, true)
        discard window.CompactIconButton(.Back, "Compact back", false, true)
        discard window.IconButton(.Home, "Home", false, true)
        discard window.IconButton(.Add, "Add", false, true)
        discard window.IconButton(.Workspace, "Workspace", false, true)
        discard window.IconButton(.Key, "Key", false, true)
        discard window.IconButton(.Settings, "Settings", false, true)
        discard window.IconButton(.Back, "Back", false, true)
        discard window.IconButton(.Forward, "Forward", false, true)
        discard window.IconButton(.Reload, "Reload", false, true)
        discard window.IconButton(.External, "External", false, true)
        discard window.IconButton(.Split, "Split", false, true)
        discard window.IconButton(.Notification, "Notification", false, true)
        discard window.IconButton(.Download, "Download", false, true)
        discard window.IconButton(.Web, "Web", false, true)
        window.Row(36.0, 1)
        window.Heading("Heading")
        window.Label("Label", .Accent, false)
        discard window.Button("Button", false, true)
        drawSelectionWidgets(&window)
        window.Row(28.0, 1)
        discard window.Switch(true, true)
        window.BeginRow(30.0, 2)
        window.PushColumn(0.5)
        discard window.Segment("First", true, .First, true)
        window.PushColumn(0.5)
        discard window.Segment("Last", false, .Last, true)
        window.EndRow()
        drawSlider(&window)
        drawContextMenu(&window)
        discard window.FileEntry("src", "directory", true)
        drawPopover(&window)
        drawTextFields(&window)
        window.Row(80.0, 1)
        if window.BeginScrollable("outer") {
            window.Row(36.0, 1)
            if window.BeginGroup("inner") {
                window.Label("Nested", .Primary, false)
                window.EndGroup()
            }
            window.EndGroup()
        }
        window.EndRoot()
    }
    window.EndFrame() else {
        fail("provider did not end a frame")
    }
    pass()
}

test "provider draws a secret field" {
    const opened = Open("Foundation UI", 720, 480) else {
        fail("provider did not open a window")
    }
    var window = opened
    const frame = window.BeginFrame() else {
        fail("provider did not begin a frame")
    }
    discard frame
    if window.BeginRoot() {
        window.Row(36.0, 1)
        const secret = window.SecretEdit("secret", "value", 32) else {
            fail("provider did not draw a secret field")
        }
        if secret.Value != "value" {
            fail("provider changed an idle secret field")
        }
        window.EndRoot()
    }
    window.EndFrame() else {
        fail("provider did not end a frame")
    }
    pass()
}

test "provider renders terminal output" {
    const opened = Open("Foundation UI", 720, 480) else {
        fail("provider did not open a window")
    }
    var window = opened
    window.UpdateTerminal(bytes.FromText("ready\n")) else {
        fail("provider did not update terminal output")
    }
    const frame = window.BeginFrame() else {
        fail("provider did not begin a frame")
    }
    discard frame
    if window.BeginRoot() {
        const terminal = window.Terminal(240.0) else {
            fail("provider did not draw the terminal")
        }
        if terminal.Columns < 2 || terminal.Rows < 2 {
            fail("provider reported invalid terminal dimensions")
        }
        window.EndRoot()
    }
    window.EndFrame() else {
        fail("provider did not end a frame")
    }
    pass()
}
