package foundation.fsm

import foundation.events
import std.collections
import std.time

// Identifies one ordered lifecycle notification for a committed transition.
enum EventType {
    // Observes the source and destination snapshots before exit notification.
    BeforeTransition

    // Observes the committed transition as the source state exits.
    ExitState

    // Observes the committed transition as the destination state enters.
    EnterState

    // Observes the transition after every state notification.
    AfterTransition
}

// Stores one immutable transition snapshot in chronological history.
struct Record<S, G> {
    // The state snapshot captured before the transition.
    From S

    // The state snapshot captured after the transition.
    To S

    // The typed trigger supplied by the caller.
    Trigger G

    // The wall-clock time captured once for the committed transition.
    Timestamp time.Instant
}

// Carries immutable state snapshots to one lifecycle listener.
struct Event<S, G> {
    // The lifecycle phase being published.
    Type EventType

    // The state snapshot captured before the transition.
    From S

    // The state snapshot captured after the transition.
    To S

    // The typed trigger supplied by the caller.
    Trigger G

    // The wall-clock time shared by every phase of the transition.
    Timestamp time.Instant
}

// Associates one listener publication failure with its lifecycle phase.
struct ListenerFailure<E> {
    // The lifecycle phase whose publication failed.
    Type EventType

    // The ordered handler failures reported by the event bus.
    Error events.PublishError<E>
}

// Carries independent snapshots to one reusable transition guard.
struct GuardEvent<S, G> {
    // The state snapshot captured before the transition.
    From S

    // The candidate state produced by the transition.
    To S

    // The typed trigger supplied by the caller.
    Trigger G
}

// Chooses whether effect execution stops or collects every effect error.
enum EffectPolicy {
    // Stops later effects after the first failure.
    StopOnFirstError

    // Runs every exit and enter effect after a committed transition.
    BestEffort
}

// Associates one effect publication failure with the affected phase.
struct EffectFailure<E> {
    // The ExitState or EnterState phase whose effects failed.
    Type EventType

    // The ordered effect failures reported by the event bus.
    Error events.PublishError<E>
}

// Reports non-blocking callback failures for one committed transition.
struct ApplyReport<TE, LE> {
    // Ordered failures from exit and enter effects.
    EffectFailures own collections.List<EffectFailure<TE>>

    // Ordered failures from lifecycle listeners.
    ListenerFailures own collections.List<ListenerFailure<LE>>

    // Returns true when every non-blocking callback succeeded.
    fn IsClean(self) bool {
        self.EffectFailures.IsEmpty() && self.ListenerFailures.IsEmpty()
    }
}

// Distinguishes a pending timeout from one committed transition report.
enum TimeoutResult<TE, LE> {
    // The state has not reached the requested timeout.
    Pending

    // The timeout committed a transition and produced this report.
    Applied(report own ApplyReport<TE, LE>)
}

// Describes one registered timeout without exposing its executable callback.
struct TimeoutRule<S, G> {
    // The source state represented by the rule.
    Source S

    // The typed trigger recorded when the timeout commits.
    Trigger G

    // The positive duration required before the rule may commit.
    Duration time.Duration
}

// Distinguishes rule discovery from pending and committed timeout checks.
enum TimeoutSweepResult<TE, LE> {
    // No registered timeout applies to the current state.
    NoRule

    // One rule applies but its duration has not elapsed.
    Pending

    // One rule applied and committed a transition.
    Applied(report own ApplyReport<TE, LE>)
}

// Reports invalid or overlapping timeout registration.
enum TimeoutRegistrationError {
    // The supplied rule does not cover its declared source state.
    SourceNotCovered

    // Another registered rule covers the same source state.
    DuplicateSource

    // The supplied rule produced an unsupported duration.
    InvalidTimeout
}

struct timeoutBinding<S, G, TE> {
    order u64
    source S
    trigger G
    durationNanoseconds u64
    rule fn(S) Option<u64>
    transition fn(&S) Result<void, TE>
}

struct timeoutRuleSnapshot<S, G> {
    order u64
    rule TimeoutRule<S, G>
}

// Separates transition, guard, clock, and timeout failures that occur
// before commit.
enum ApplyError<TE> {
    // The executable state transition rejected the current state.
    Transition(error TE)

    // A reusable guard rejected the transition candidate.
    Guard(error events.PublishError<TE>)

    // The monotonic clock moved behind the state-entry reference.
    Clock(error time.Error)

    // A timeout duration was zero, too large, or changed after registration.
    InvalidTimeout

    // More than one custom timeout rule covers the current state.
    OverlappingTimeout
}

// Owns one typed state value, guards, effects, immutable history, and
// lifecycle listeners.
struct Machine<S, G, TE, LE> {
    state S
    cloneState fn(S) S
    cloneTrigger fn(G) G
    history own collections.List<Record<S, G>>
    guards own events.Bus<GuardEvent<S, G>, TE>
    exitEffects own events.Bus<Event<S, G>, TE>
    enterEffects own events.Bus<Event<S, G>, TE>
    listeners own events.Bus<Event<S, G>, LE>
    timeoutBindings own collections.List<own timeoutBinding<S, G, TE>>
    nextTimeoutOrder u64
    effectPolicy EffectPolicy
    enteredAt time.MonotonicInstant

    // Returns an independent snapshot of the current state.
    fn Snapshot(self) S {
        cloneValue(self.cloneState, self.state)
    }

    // Returns the number of committed transitions retained in history.
    fn HistoryLen(self) i32 {
        self.history.Len()
    }

    // Returns independent transition records in chronological order.
    fn History(&self) own collections.List<Record<S, G>> {
        var empty = collections.NewList<Record<S, G>>()
        var source = replace self.history with empty
        var restored = collections.NewList<Record<S, G>>()
        var snapshot = collections.NewList<Record<S, G>>()
        while !source.IsEmpty() {
            const record = requiredRecord(source.PopFront())
            snapshot.PushFront(cloneRecord(self, record))
            restored.PushFront($record)
        }
        while !restored.IsEmpty() {
            self.history.PushFront(requiredRecord(restored.PopFront()))
        }
        discard source
        discard restored
        snapshot
    }

    // Registers one typed listener with stable priority and
    // registration ordering.
    fn Subscribe(
        &self,
        $listener fn(Event<S, G>) Result<void, LE>,
        priority events.Priority
    ) Result<void, events.SubscribeError> {
        self.listeners.Subscribe($listener, priority)
    }

    // Registers one pre-commit guard with stable priority and ordering.
    fn Guard(
        &self,
        $guard fn(GuardEvent<S, G>) Result<void, TE>,
        priority events.Priority
    ) Result<void, events.SubscribeError> {
        self.guards.Subscribe($guard, priority)
    }

    // Registers one post-commit exit effect.
    fn OnExit(
        &self,
        $effect fn(Event<S, G>) Result<void, TE>,
        priority events.Priority
    ) Result<void, events.SubscribeError> {
        self.exitEffects.Subscribe($effect, priority)
    }

    // Registers one post-commit enter effect.
    fn OnEnter(
        &self,
        $effect fn(Event<S, G>) Result<void, TE>,
        priority events.Priority
    ) Result<void, events.SubscribeError> {
        self.enterEffects.Subscribe($effect, priority)
    }

    // Registers one declarative timeout rule and its executable transition.
    fn BindTimeout(
        &self,
        source S,
        trigger G,
        $rule fn(S) Option<u64>,
        $transition fn(&S) Result<void, TE>
    ) Result<void, TimeoutRegistrationError> {
        const duration = requiredTimeoutDuration(rule(source)) else error {
            discard rule
            discard transition
            return .Err(error)
        }

        var empty = collections.NewList<own timeoutBinding<S, G, TE>>()
        var pending = replace self.timeoutBindings with empty
        var visited = collections.NewList<own timeoutBinding<S, G, TE>>()
        var duplicate = false
        while !pending.IsEmpty() {
            const binding = requiredTimeoutBinding(pending.PopFront())
            if timeoutCovers(invokeTimeoutRule(binding.rule, source)) ||
                timeoutCovers(invokeTimeoutRule(rule, binding.source)) {
                duplicate = true
            }
            visited.PushFront($binding)
        }
        restoreTimeoutBindings(&self.timeoutBindings, $pending, $visited)
        if duplicate {
            discard rule
            discard transition
            return .Err(.DuplicateSource)
        }

        self.timeoutBindings.PushFront(own timeoutBinding<S, G, TE> {
            order = self.nextTimeoutOrder
            source = cloneValue(self.cloneState, source)
            trigger = cloneValue(self.cloneTrigger, trigger)
            durationNanoseconds = duration
            rule = rule
            transition = transition
        })
        self.nextTimeoutOrder = self.nextTimeoutOrder + 1
        .Ok
    }

    // Returns independent timeout rule snapshots in registration order.
    fn TimeoutRules(&self) own collections.List<TimeoutRule<S, G>> {
        var empty = collections.NewList<own timeoutBinding<S, G, TE>>()
        var pending = replace self.timeoutBindings with empty
        var restored = collections.NewList<own timeoutBinding<S, G, TE>>()
        var snapshots = collections.NewList<timeoutRuleSnapshot<S, G>>()
        while !pending.IsEmpty() {
            const binding = requiredTimeoutBinding(pending.PopFront())
            snapshots.PushFront(timeoutRuleSnapshot<S, G> {
                order = binding.order
                rule = TimeoutRule<S, G> {
                    Source = cloneValue(self.cloneState, binding.source)
                    Trigger = cloneValue(self.cloneTrigger, binding.trigger)
                    Duration = time.Nanoseconds(binding.durationNanoseconds)
                }
            })
            restored.PushFront($binding)
        }
        restoreTimeoutBindings(&self.timeoutBindings, $pending, $restored)
        const compare fn(
            timeoutRuleSnapshot<S, G>,
            timeoutRuleSnapshot<S, G>
        ) i32 = compareTimeoutRuleSnapshots
        var ordered = collections.Sort($snapshots, compare)
        var result = collections.NewList<TimeoutRule<S, G>>()
        while !ordered.IsEmpty() {
            const snapshot = requiredTimeoutRuleSnapshot(ordered.PopFront())
            const timeoutRuleSnapshot { order rule } = snapshot
            discard order
            result.PushFront($rule)
        }
        discard ordered
        result
    }

    // Applies one transition to an independent candidate and commits it
    // only after the transition and every guard succeed.
    fn Apply(
        &self,
        trigger G,
        $transition fn(&S) Result<void, TE>
    ) Result<own ApplyReport<TE, LE>, ApplyError<TE>> {
        var candidate = cloneValue(self.cloneState, self.state)
        const applied = transition(&candidate)
        match applied {
            Ok: self.guardAndCommit($candidate, trigger)
            Err(error): .Err(.Transition(error = error))
        }
    }

    // Returns the monotonic duration since the latest committed transition.
    fn Elapsed(self) Result<time.Duration, time.Error> {
        time.MonotonicNow().Since(self.enteredAt)
    }

    // Applies one transition when the current state has reached a
    // positive timeout.
    fn CheckTimeout(
        &self,
        duration time.Duration,
        trigger G,
        $transition fn(&S) Result<void, TE>
    ) Result<TimeoutResult<TE, LE>, ApplyError<TE>> {
        if duration.IsNegative() || duration.Nanoseconds() == 0 {
            discard transition
            return .Err(.InvalidTimeout)
        }
        const elapsed = self.Elapsed() else error {
            discard transition
            return .Err(.Clock(error = error))
        }
        if elapsed.Nanoseconds() < duration.Nanoseconds() {
            discard transition
            return .Ok(.Pending)
        }
        const report = self.Apply(trigger, $transition) else error {
            return .Err(error)
        }
        .Ok(.Applied(report = report))
    }

    // Checks the declarative timeout rule for the current state.
    fn CheckTimeouts(
        &self
    ) Result<TimeoutSweepResult<TE, LE>, ApplyError<TE>> {
        var empty = collections.NewList<own timeoutBinding<S, G, TE>>()
        var pending = replace self.timeoutBindings with empty
        var visited = collections.NewList<own timeoutBinding<S, G, TE>>()
        var selected Option<own timeoutBinding<S, G, TE>> = .None
        var selectedNanoseconds u64 = 0
        var matches i32 = 0
        while !pending.IsEmpty() {
            const binding = requiredTimeoutBinding(pending.PopFront())
            const duration = invokeTimeoutRule(binding.rule, self.state)
            match duration {
                None: visited.PushFront($binding)
                Some(nanoseconds): {
                    if !validTimeoutNanoseconds(nanoseconds) ||
                        nanoseconds != binding.durationNanoseconds {
                        visited.PushFront($binding)
                        const selectedValue = replace selected with .None
                        match selectedValue {
                            None: {}
                            Some(value): visited.PushFront($value)
                        }
                        restoreTimeoutBindings(
                            &self.timeoutBindings,
                            $pending,
                            $visited
                        )
                        return .Err(.InvalidTimeout)
                    }
                    matches = matches + 1
                    if matches == 1 {
                        selected = .Some(binding)
                        selectedNanoseconds = nanoseconds
                    } else {
                        visited.PushFront($binding)
                    }
                    discard nanoseconds
                }
            }
        }

        if matches == 0 {
            restoreTimeoutBindings(&self.timeoutBindings, $pending, $visited)
            return .Ok(.NoRule)
        }
        if matches > 1 {
            const selectedValue = replace selected with .None
            match selectedValue {
                None: {}
                Some(value): visited.PushFront($value)
            }
            restoreTimeoutBindings(&self.timeoutBindings, $pending, $visited)
            return .Err(.OverlappingTimeout)
        }

        const binding = requiredTimeoutBinding(
            replace selected with .None
        )
        const elapsed = self.Elapsed() else error {
            visited.PushFront($binding)
            restoreTimeoutBindings(&self.timeoutBindings, $pending, $visited)
            return .Err(.Clock(error = error))
        }
        const limit = time.Nanoseconds(selectedNanoseconds)
        if elapsed.Nanoseconds() < limit.Nanoseconds() {
            visited.PushFront($binding)
            restoreTimeoutBindings(&self.timeoutBindings, $pending, $visited)
            return .Ok(.Pending)
        }

        var candidate = cloneValue(self.cloneState, self.state)
        const applied = invokeTimeoutTransition(binding.transition, &candidate)
        const selectedTrigger = cloneValue(self.cloneTrigger, binding.trigger)
        visited.PushFront($binding)
        restoreTimeoutBindings(&self.timeoutBindings, $pending, $visited)
        match applied {
            Ok: {
                const report = self.guardAndCommit($candidate, selectedTrigger)
                else error {
                    return .Err(error)
                }
                .Ok(.Applied(report = report))
            }
            Err(error): .Err(.Transition(error = error))
        }
    }

    fn guardAndCommit(
        &self,
        $next S,
        trigger G
    ) Result<own ApplyReport<TE, LE>, ApplyError<TE>> {
        const checked = self.guards.Publish(GuardEvent<S, G> {
            From = cloneValue(self.cloneState, self.state)
            To = cloneValue(self.cloneState, next)
            Trigger = cloneValue(self.cloneTrigger, trigger)
        })
        match checked {
            Ok: .Ok(self.commit($next, trigger))
            Err(error): {
                discard next
                .Err(.Guard(error = error))
            }
        }
    }

    fn commit(
        &self,
        $next S,
        trigger G
    ) own ApplyReport<TE, LE> {
        const before = cloneValue(self.cloneState, self.state)
        const after = cloneValue(self.cloneState, next)
        const timestamp = time.Now()
        var listenerFailures = collections.NewList<ListenerFailure<LE>>()
        var effectFailures = collections.NewList<EffectFailure<TE>>()
        self.publish(
            .BeforeTransition,
            before,
            after,
            trigger,
            timestamp,
            &listenerFailures
        )

        const previous = replace self.state with next
        discard previous
        self.history.PushFront(Record<S, G> {
            From = cloneValue(self.cloneState, before)
            To = cloneValue(self.cloneState, after)
            Trigger = cloneValue(self.cloneTrigger, trigger)
            Timestamp = timestamp
        })
        self.enteredAt = time.MonotonicNow()

        const exitFailed = self.publishEffect(
            &self.exitEffects,
            .ExitState,
            before,
            after,
            trigger,
            timestamp,
            &effectFailures
        )
        self.publish(
            .ExitState,
            before,
            after,
            trigger,
            timestamp,
            &listenerFailures
        )
        if !exitFailed || runsEveryEffect(self.effectPolicy) {
            discard self.publishEffect(
                &self.enterEffects,
                .EnterState,
                before,
                after,
                trigger,
                timestamp,
                &effectFailures
            )
        }
        self.publish(
            .EnterState,
            before,
            after,
            trigger,
            timestamp,
            &listenerFailures
        )
        self.publish(
            .AfterTransition,
            before,
            after,
            trigger,
            timestamp,
            &listenerFailures
        )
        finishApply<TE, LE>($effectFailures, $listenerFailures)
    }

    fn publishEffect(
        &self,
        &bus events.Bus<Event<S, G>, TE>,
        kind EventType,
        before S,
        after S,
        trigger G,
        timestamp time.Instant,
        &failures collections.List<EffectFailure<TE>>
    ) bool {
        const published = bus.Publish(Event<S, G> {
            Type = kind
            From = cloneValue(self.cloneState, before)
            To = cloneValue(self.cloneState, after)
            Trigger = cloneValue(self.cloneTrigger, trigger)
            Timestamp = timestamp
        })
        match published {
            Ok: false
            Err(error): {
                failures.PushFront(EffectFailure<TE> {
                    Type = kind
                    Error = error
                })
                true
            }
        }
    }

    fn publish(
        &self,
        kind EventType,
        before S,
        after S,
        trigger G,
        timestamp time.Instant,
        &failures collections.List<ListenerFailure<LE>>
    ) void {
        const published = self.listeners.Publish(Event<S, G> {
            Type = kind
            From = cloneValue(self.cloneState, before)
            To = cloneValue(self.cloneState, after)
            Trigger = cloneValue(self.cloneTrigger, trigger)
            Timestamp = timestamp
        })
        match published {
            Ok: publishedSuccessfully()
            Err(error): failures.PushFront(ListenerFailure<LE> {
                Type = kind
                Error = error
            })
        }
    }
}

// Creates a machine around one explicit initial state and two clone functions.
fn New<S, G, TE, LE>(
    $initial S,
    $cloneState fn(S) S,
    $cloneTrigger fn(G) G
) own Machine<S, G, TE, LE> {
    NewWithEffectPolicy<S, G, TE, LE>(
        $initial,
        $cloneState,
        $cloneTrigger,
        .BestEffort
    )
}

// Creates a machine with one explicit post-commit effect policy.
fn NewWithEffectPolicy<S, G, TE, LE>(
    $initial S,
    $cloneState fn(S) S,
    $cloneTrigger fn(G) G,
    effectPolicy EffectPolicy
) own Machine<S, G, TE, LE> {
    const strategy = effectStrategy(effectPolicy)
    own Machine<S, G, TE, LE> {
        state = initial
        cloneState = cloneState
        cloneTrigger = cloneTrigger
        history = collections.NewList<Record<S, G>>()
        guards = events.NewBus<GuardEvent<S, G>, TE>(.StopOnFirstError)
        exitEffects = events.NewBus<Event<S, G>, TE>(strategy)
        enterEffects = events.NewBus<Event<S, G>, TE>(strategy)
        listeners = events.NewBus<Event<S, G>, LE>(.BestEffort)
        timeoutBindings = collections.NewList<own timeoutBinding<S, G, TE>>()
        nextTimeoutOrder = 0
        effectPolicy = effectPolicy
        enteredAt = time.MonotonicNow()
    }
}

fn cloneValue<T>(clone fn(T) T, value T) T {
    clone(value)
}

fn requiredTimeoutDuration(
    value Option<u64>
) Result<u64, TimeoutRegistrationError> {
    match value {
        None: .Err(.SourceNotCovered)
        Some(nanoseconds): {
            if !validTimeoutNanoseconds(nanoseconds) {
                return .Err(.InvalidTimeout)
            }
            .Ok(nanoseconds)
        }
    }
}

fn validTimeoutNanoseconds(value u64) bool {
    value > 0 && value <= 9223372036854775807
}

fn timeoutCovers(value Option<u64>) bool {
    match value {
        None: false
        Some(nanoseconds): validTimeoutNanoseconds(nanoseconds)
    }
}

fn invokeTimeoutRule<S>(
    rule fn(S) Option<u64>,
    state S
) Option<u64> {
    rule(state)
}

fn invokeTimeoutTransition<S, TE>(
    transition fn(&S) Result<void, TE>,
    &state S
) Result<void, TE> {
    transition(&state)
}

fn requiredTimeoutBinding<S, G, TE>(
    $value Option<own timeoutBinding<S, G, TE>>
) own timeoutBinding<S, G, TE> {
    match value {
        None: missingTimeoutBinding<S, G, TE>()
        Some(binding): binding
    }
}

fn missingTimeoutBinding<S, G, TE>() own timeoutBinding<S, G, TE> {
    panic("fsm timeout binding invariant failed")
}

fn compareTimeoutRuleSnapshots<S, G>(
    left timeoutRuleSnapshot<S, G>,
    right timeoutRuleSnapshot<S, G>
) i32 {
    if left.order > right.order return -1
    if left.order < right.order return 1
    0
}

fn requiredTimeoutRuleSnapshot<S, G>(
    $value Option<timeoutRuleSnapshot<S, G>>
) timeoutRuleSnapshot<S, G> {
    match value {
        None: missingTimeoutRuleSnapshot<S, G>()
        Some(snapshot): snapshot
    }
}

fn missingTimeoutRuleSnapshot<S, G>() timeoutRuleSnapshot<S, G> {
    panic("fsm timeout snapshot invariant failed")
}

fn restoreTimeoutBindings<S, G, TE>(
    &target collections.List<own timeoutBinding<S, G, TE>>,
    $pending own collections.List<own timeoutBinding<S, G, TE>>,
    $visited own collections.List<own timeoutBinding<S, G, TE>>
) void {
    var pendingValues = pending
    var visitedValues = visited
    while !pendingValues.IsEmpty() {
        visitedValues.PushFront(
            requiredTimeoutBinding(pendingValues.PopFront())
        )
    }
    while !visitedValues.IsEmpty() {
        target.PushFront(requiredTimeoutBinding(visitedValues.PopFront()))
    }
    discard pendingValues
    discard visitedValues
}

fn cloneRecord<S, G, TE, LE>(
    machine Machine<S, G, TE, LE>,
    record Record<S, G>
) Record<S, G> {
    Record<S, G> {
        From = cloneValue(machine.cloneState, record.From)
        To = cloneValue(machine.cloneState, record.To)
        Trigger = cloneValue(machine.cloneTrigger, record.Trigger)
        Timestamp = record.Timestamp
    }
}

fn requiredRecord<S, G>(
    $value Option<Record<S, G>>
) Record<S, G> {
    match value {
        None: missingRecord<S, G>()
        Some(record): record
    }
}

fn missingRecord<S, G>() Record<S, G> {
    panic("fsm history invariant failed")
}

fn publishedSuccessfully() void {
    return
}

fn finishApply<TE, LE>(
    $effectFailures own collections.List<EffectFailure<TE>>,
    $listenerFailures own collections.List<ListenerFailure<LE>>
) own ApplyReport<TE, LE> {
    own ApplyReport<TE, LE> {
        EffectFailures = orderEffectFailures($effectFailures)
        ListenerFailures = orderListenerFailures($listenerFailures)
    }
}

fn orderListenerFailures<E>(
    $failures own collections.List<ListenerFailure<E>>
) own collections.List<ListenerFailure<E>> {
    var pending = failures
    var ordered = collections.NewList<ListenerFailure<E>>()
    while !pending.IsEmpty() {
        ordered.PushFront(requiredFailure(pending.PopFront()))
    }
    discard pending
    ordered
}

fn orderEffectFailures<E>(
    $failures own collections.List<EffectFailure<E>>
) own collections.List<EffectFailure<E>> {
    var pending = failures
    var ordered = collections.NewList<EffectFailure<E>>()
    while !pending.IsEmpty() {
        ordered.PushFront(requiredEffectFailure(pending.PopFront()))
    }
    discard pending
    ordered
}

fn requiredFailure<E>(
    $value Option<ListenerFailure<E>>
) ListenerFailure<E> {
    match value {
        None: missingFailure<E>()
        Some(failure): failure
    }
}

fn missingFailure<E>() ListenerFailure<E> {
    panic("fsm listener invariant failed")
}

fn requiredEffectFailure<E>(
    $value Option<EffectFailure<E>>
) EffectFailure<E> {
    match value {
        None: missingEffectFailure<E>()
        Some(failure): failure
    }
}

fn missingEffectFailure<E>() EffectFailure<E> {
    panic("fsm effect invariant failed")
}

fn runsEveryEffect(policy EffectPolicy) bool {
    match policy {
        StopOnFirstError: false
        BestEffort: true
    }
}

fn effectStrategy(policy EffectPolicy) events.Strategy {
    match policy {
        StopOnFirstError: .StopOnFirstError
        BestEffort: .BestEffort
    }
}
