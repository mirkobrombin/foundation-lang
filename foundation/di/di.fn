package foundation.di

// Controls the lifetime selected by a Foundation application host.
enum Lifetime {
    Transient
    Scoped
    Singleton
}

// Declares the lifetime used when the host registers a service. Services are transient by default.
attribute Scope(value Lifetime) targets(service)

// Gives a service provider a non-empty stable name for disambiguation.
attribute Name(value String) targets(service)

// Selects a named service provider for a constructor parameter. The selector cannot be empty.
attribute From(value String) targets(parameter)
