package foundation.secrets

import std.bytes
import std.env
import std.fs
import std.path
import std.text

// Classifies failures without exposing secret material in diagnostics.
enum Error {
    // The requested key does not exist.
    NotFound
    // The selected backend does not permit mutation.
    ReadOnly
    // Required backend configuration is absent.
    NotConfigured
    // The key is empty, contains NUL, or violates a backend path rule.
    InvalidKey
    // An encryption key is not exactly 32 bytes.
    InvalidCipherKey
    // Authenticated ciphertext or its key binding is invalid.
    AuthenticationFailed
    // A remote Vault address uses plaintext HTTP.
    InsecureAddress
    // A value, file, or response exceeds its explicit limit.
    TooLarge
    // The selected store owner is already closed.
    Closed
    // The operation was cancelled before completion.
    Cancelled
    // The process lacks permission for the requested operation.
    Permission
    // A backend transport failed before returning a protocol response.
    Transport
    // A backend returned an invalid status, shape, or encoding.
    Protocol
    // A native storage or environment operation failed.
    Io
}

// Defines asynchronous storage with explicit cloning and owned byte values.
contract Store {
    // Creates an independent owner for the same backend.
    fn Clone(self) own Store

    // Copies one owned value into the backend.
    fn Set(
        self,
        $key String,
        $value own bytes.Bytes
    ) Task<Result<void, Error>>

    // Returns one independent owned value.
    fn Get(self, $key String) Task<Result<own bytes.Bytes, Error>>

    // Removes one value. Missing values are accepted.
    fn Delete(self, $key String) Task<Result<void, Error>>
}

// Stores copied values in task-safe native memory and clears them on release.
struct MemoryStore implements Store {
    memory own bytes.SecretMemory

    // Creates a transferable concrete owner for the same task-safe backend.
    fn Share(self) own MemoryStore {
        const retained = self.memory.Clone() else error {
            discard error
            panic("secret memory closed during share")
        }
        own MemoryStore { memory = retained }
    }

    // Creates an independent contract owner for the same task-safe backend.
    fn Clone(self) own Store {
        self.Share()
    }

    // Copies one owned value into synchronized native memory.
    fn Set(
        self,
        $key String,
        $value own bytes.Bytes
    ) Task<Result<void, Error>> {
        const retained = self.memory.Clone() else error {
            discard error
            return spawn closedSet($key, $value)
        }
        spawn memorySet($retained, $key, $value)
    }

    // Returns one independent owned copy from synchronized native memory.
    fn Get(self, $key String) Task<Result<own bytes.Bytes, Error>> {
        const retained = self.memory.Clone() else error {
            discard error
            return spawn closedGet($key)
        }
        spawn memoryGet($retained, $key)
    }

    // Removes and clears one synchronized value.
    fn Delete(self, $key String) Task<Result<void, Error>> {
        const retained = self.memory.Clone() else error {
            discard error
            return spawn closedDelete($key)
        }
        spawn memoryDelete($retained, $key)
    }
}

// Reads process environment variables without permitting writes or deletes.
struct EnvStore implements Store {
    // Creates another stateless environment reader.
    fn Clone(self) own Store {
        own EnvStore {}
    }

    // Rejects an environment mutation as read-only.
    fn Set(
        self,
        $key String,
        $value own bytes.Bytes
    ) Task<Result<void, Error>> {
        spawn readOnlySet($key, $value)
    }

    // Reads one environment variable into owned bytes.
    fn Get(self, $key String) Task<Result<own bytes.Bytes, Error>> {
        spawn environmentGet($key)
    }

    // Rejects an environment deletion as read-only.
    fn Delete(self, $key String) Task<Result<void, Error>> {
        spawn readOnlyDelete($key)
    }
}

// Persists authenticated ciphertext in an owner-private directory.
struct PrivateFileStore implements Store {
    directory String
    cipherKey own bytes.Bytes

    // Creates an independent owner with a copied cipher key.
    fn Clone(self) own Store {
        const cipherKey = requiredBytes(self.cipherKey.Copy())
        own PrivateFileStore {
            directory = text.Copy(self.directory)
            cipherKey = cipherKey
        }
    }

    // Encrypts one value into an owner-private atomic file.
    fn Set(
        self,
        $key String,
        $value own bytes.Bytes
    ) Task<Result<void, Error>> {
        const cipherKey = requiredBytes(self.cipherKey.Copy())
        spawn privateFileSet(
            text.Copy(self.directory),
            $cipherKey,
            $key,
            $value
        )
    }

    // Reads and authenticates one encrypted private file.
    fn Get(self, $key String) Task<Result<own bytes.Bytes, Error>> {
        const cipherKey = requiredBytes(self.cipherKey.Copy())
        spawn privateFileGet(text.Copy(self.directory), $cipherKey, $key)
    }

    // Removes one encrypted regular file without following links.
    fn Delete(self, $key String) Task<Result<void, Error>> {
        const cipherKey = requiredBytes(self.cipherKey.Copy())
        spawn privateFileDelete(text.Copy(self.directory), $cipherKey, $key)
    }
}

// Encrypts every value with AES-256-GCM before forwarding it to another store.
struct CipherStore implements Store {
    store own Store
    cipherKey own bytes.Bytes

    // Creates an independent wrapper owner with a copied cipher key.
    fn Clone(self) own Store {
        const cipherKey = requiredBytes(self.cipherKey.Copy())
        own CipherStore { store = self.store.Clone() cipherKey = cipherKey }
    }

    // Encrypts and forwards one value to the wrapped store.
    fn Set(
        self,
        $key String,
        $value own bytes.Bytes
    ) Task<Result<void, Error>> {
        const cipherKey = requiredBytes(self.cipherKey.Copy())
        spawn cipherSet(self.store.Clone(), $cipherKey, $key, $value)
    }

    // Loads and authenticates one value from the wrapped store.
    fn Get(self, $key String) Task<Result<own bytes.Bytes, Error>> {
        const cipherKey = requiredBytes(self.cipherKey.Copy())
        spawn cipherGet(self.store.Clone(), $cipherKey, $key)
    }

    // Forwards deletion to the wrapped store.
    fn Delete(self, $key String) Task<Result<void, Error>> {
        self.store.Delete($key)
    }
}

// Prepends a namespace to every key before forwarding an operation.
struct PrefixStore implements Store {
    store own Store
    prefix String

    // Creates an independent wrapper owner with a copied prefix.
    fn Clone(self) own Store {
        own PrefixStore {
            store = self.store.Clone()
            prefix = text.Copy(self.prefix)
        }
    }

    // Prepends the namespace and forwards one value.
    fn Set(
        self,
        $key String,
        $value own bytes.Bytes
    ) Task<Result<void, Error>> {
        self.store.Set(text.Copy(self.prefix) + key, $value)
    }

    // Prepends the namespace and loads one value.
    fn Get(self, $key String) Task<Result<own bytes.Bytes, Error>> {
        self.store.Get(text.Copy(self.prefix) + key)
    }

    // Prepends the namespace and removes one value.
    fn Delete(self, $key String) Task<Result<void, Error>> {
        self.store.Delete(text.Copy(self.prefix) + key)
    }
}

// Uses a secondary store only for the expected absence or read-only conditions.
struct FallbackStore implements Store {
    primary own Store
    secondary own Store

    // Creates independent owners for both backends.
    fn Clone(self) own Store {
        own FallbackStore {
            primary = self.primary.Clone()
            secondary = self.secondary.Clone()
        }
    }

    // Uses the secondary backend only when the primary is read-only.
    fn Set(
        self,
        $key String,
        $value own bytes.Bytes
    ) Task<Result<void, Error>> {
        spawn fallbackSet(
            self.primary.Clone(),
            self.secondary.Clone(),
            $key,
            $value
        )
    }

    // Uses the secondary backend only when the primary key is absent.
    fn Get(self, $key String) Task<Result<own bytes.Bytes, Error>> {
        spawn fallbackGet(
            self.primary.Clone(),
            self.secondary.Clone(),
            $key
        )
    }

    // Deletes from both backends while preserving unexpected failures.
    fn Delete(self, $key String) Task<Result<void, Error>> {
        spawn fallbackDelete(
            self.primary.Clone(),
            self.secondary.Clone(),
            $key
        )
    }
}

// Creates an empty in-process store.
fn NewMemoryStore() own MemoryStore {
    own MemoryStore { memory = bytes.NewSecretMemory() }
}

// Creates a read-only environment store.
fn NewEnvStore() own EnvStore {
    own EnvStore {}
}

// Creates encrypted private files with HMAC-SHA256 key names.
task NewPrivateFileStore(
    $directory String,
    $cipherKey own bytes.Bytes
) Result<own PrivateFileStore, Error> {
    if text.IsEmpty(directory) {
        discard directory
        discard cipherKey
        return .Err(.InvalidKey)
    }
    if !validCipherKey(cipherKey) {
        discard directory
        discard cipherKey
        return .Err(.InvalidCipherKey)
    }
    const retained = text.Copy(directory)
    const creating = spawn fs.CreatePrivateDirectory($directory)
    const created = $creating.wait()
    match created {
        Ok: .Ok(own PrivateFileStore {
            directory = retained
            cipherKey = cipherKey
        })
        Err(error): {
            discard retained
            discard cipherKey
            .Err(mapFileError(error))
        }
    }
}

// Creates an AES-256-GCM wrapper and consumes the supplied encryption key.
fn NewCipherStore(
    $store own Store,
    $cipherKey own bytes.Bytes
) Result<own CipherStore, Error> {
    if !validCipherKey(cipherKey) {
        discard store
        discard cipherKey
        return .Err(.InvalidCipherKey)
    }
    .Ok(own CipherStore { store = store cipherKey = cipherKey })
}

// Creates a namespace wrapper without changing the wrapped backend.
fn NewPrefixStore($store own Store, $prefix String) own PrefixStore {
    own PrefixStore { store = store prefix = prefix }
}

// Creates an explicit primary-secondary fallback chain.
fn NewFallbackStore(
    $primary own Store,
    $secondary own Store
) own FallbackStore {
    own FallbackStore { primary = primary secondary = secondary }
}

task memorySet(
    $memory own bytes.SecretMemory,
    $key String,
    $value own bytes.Bytes
) Result<void, Error> {
    const result = memory.Set(key, $value)
    discard memory
    discard key
    match result {
        Ok: .Ok
        Err(error): .Err(mapMemoryError(error))
    }
}

task memoryGet(
    $memory own bytes.SecretMemory,
    $key String
) Result<own bytes.Bytes, Error> {
    const result = memory.Get(key)
    discard memory
    discard key
    match result {
        Ok(value): .Ok(value)
        Err(error): .Err(mapMemoryError(error))
    }
}

task memoryDelete(
    $memory own bytes.SecretMemory,
    $key String
) Result<void, Error> {
    const result = memory.Delete(key)
    discard memory
    discard key
    match result {
        Ok: .Ok
        Err(error): .Err(mapMemoryError(error))
    }
}

task environmentGet($key String) Result<own bytes.Bytes, Error> {
    if !validKey(key) {
        discard key
        return .Err(.InvalidKey)
    }
    const selected = env.Get(key)
    discard key
    match selected {
        Ok(value): match value {
            None: .Err(.NotFound)
            Some(secret): .Ok(bytes.FromText(secret))
        }
        Err(error): {
            discard error
            .Err(.Io)
        }
    }
}

task readOnlySet(
    $key String,
    $value own bytes.Bytes
) Result<void, Error> {
    discard key
    discard value
    .Err(.ReadOnly)
}

task readOnlyDelete($key String) Result<void, Error> {
    discard key
    .Err(.ReadOnly)
}

task privateFileSet(
    $directory String,
    $cipherKey own bytes.Bytes,
    $key String,
    $value own bytes.Bytes
) Result<void, Error> {
    if !validKey(key) {
        discard directory
        discard cipherKey
        discard key
        discard value
        return .Err(.InvalidKey)
    }
    if byteLength(value) > maximumSecretSize() {
        discard directory
        discard cipherKey
        discard key
        discard value
        return .Err(.TooLarge)
    }
    const destination = secretPath(directory, key, cipherKey)
    discard directory
    const encrypted = bytes.EncryptAES256GCM(cipherKey, value, key) else error {
        discard cipherKey
        discard key
        discard value
        discard error
        discard destination
        return .Err(.Io)
    }
    discard value
    discard cipherKey
    discard key
    const encoded = bytes.EncodeBase64URL(encrypted) else error {
        discard encrypted
        discard error
        discard destination
        return .Err(.TooLarge)
    }
    discard encrypted
    const writing = spawn fs.WritePrivateTextAtomic(
        $destination,
        $encoded,
        maximumFileSize()
    )
    const written = $writing.wait()
    match written {
        Ok: .Ok
        Err(error): .Err(mapFileError(error))
    }
}

task privateFileGet(
    $directory String,
    $cipherKey own bytes.Bytes,
    $key String
) Result<own bytes.Bytes, Error> {
    if !validKey(key) {
        discard directory
        discard cipherKey
        discard key
        return .Err(.InvalidKey)
    }
    const destination = secretPath(directory, key, cipherKey)
    discard directory
    const reading = spawn fs.ReadPrivateTextLimited(
        $destination,
        maximumFileSize()
    )
    const read = $reading.wait()
    const encoded = match read {
        Ok(value): value
        Err(error): {
            return .Err(mapFileError(error))
        }
    }
    const encrypted = bytes.DecodeBase64URL(encoded) else error {
        discard encoded
        discard error
        return .Err(.AuthenticationFailed)
    }
    discard encoded
    const decrypted = bytes.DecryptAES256GCM(
        cipherKey,
        encrypted,
        key
    ) else error {
        discard encrypted
        discard error
        return .Err(.AuthenticationFailed)
    }
    discard cipherKey
    discard encrypted
    discard key
    .Ok(decrypted)
}

task privateFileDelete(
    $directory String,
    $cipherKey own bytes.Bytes,
    $key String
) Result<void, Error> {
    if !validKey(key) {
        discard directory
        discard cipherKey
        discard key
        return .Err(.InvalidKey)
    }
    const destination = secretPath(directory, key, cipherKey)
    discard directory
    discard cipherKey
    discard key
    const deleting = spawn fs.DeletePrivateFile($destination)
    const deleted = $deleting.wait()
    match deleted {
        Ok: .Ok
        Err(error): mapDeleteFileError(error)
    }
}

task cipherSet(
    $store own Store,
    $cipherKey own bytes.Bytes,
    $key String,
    $value own bytes.Bytes
) Result<void, Error> {
    if !validKey(key) {
        discard store
        discard cipherKey
        discard key
        discard value
        return .Err(.InvalidKey)
    }
    const encrypted = bytes.EncryptAES256GCM(cipherKey, value, key) else error {
        discard store
        discard cipherKey
        discard key
        discard value
        discard error
        return .Err(.Io)
    }
    discard value
    discard cipherKey
    const storing = store.Set(text.Copy(key), $encrypted)
    discard store
    discard key
    const stored = $storing.wait()
    stored
}

task cipherGet(
    $store own Store,
    $cipherKey own bytes.Bytes,
    $key String
) Result<own bytes.Bytes, Error> {
    if !validKey(key) {
        discard store
        discard cipherKey
        discard key
        return .Err(.InvalidKey)
    }
    const loading = store.Get(text.Copy(key))
    discard store
    const loaded = $loading.wait()
    const encrypted = match loaded {
        Ok(value): value
        Err(error): {
            return .Err(error)
        }
    }
    const decrypted = bytes.DecryptAES256GCM(
        cipherKey,
        encrypted,
        key
    ) else error {
        discard encrypted
        discard error
        return .Err(.AuthenticationFailed)
    }
    discard cipherKey
    discard encrypted
    discard key
    .Ok(decrypted)
}

task fallbackSet(
    $primary own Store,
    $secondary own Store,
    $key String,
    $value own bytes.Bytes
) Result<void, Error> {
    const secondaryValue = requiredBytes(value.Copy())
    const first = primary.Set(text.Copy(key), $value)
    discard primary
    const attempted = $first.wait()
    match attempted {
        Ok: {
            discard secondary
            discard secondaryValue
            discard key
            .Ok
        }
        Err(error): {
            if fallbackForSet(error) {
                const second = secondary.Set($key, $secondaryValue)
                discard secondary
                const stored = $second.wait()
                return stored
            }
            discard secondary
            discard secondaryValue
            discard key
            .Err(error)
        }
    }
}

task fallbackGet(
    $primary own Store,
    $secondary own Store,
    $key String
) Result<own bytes.Bytes, Error> {
    const first = primary.Get(text.Copy(key))
    discard primary
    const attempted = $first.wait()
    match attempted {
        Ok(value): {
            discard secondary
            discard key
            .Ok(value)
        }
        Err(error): {
            if isNotFound(error) {
                const second = secondary.Get($key)
                discard secondary
                const loaded = $second.wait()
                return loaded
            }
            discard secondary
            discard key
            .Err(error)
        }
    }
}

task fallbackDelete(
    $primary own Store,
    $secondary own Store,
    $key String
) Result<void, Error> {
    const first = primary.Delete(text.Copy(key))
    discard primary
    const attempted = $first.wait()
    match attempted {
        Ok: {}
        Err(error): {
            if !isNotFound(error) {
                discard secondary
                discard key
                return .Err(error)
            }
        }
    }
    const second = secondary.Delete($key)
    discard secondary
    const deleted = $second.wait()
    match deleted {
        Ok: .Ok
        Err(error): {
            if isNotFound(error) {
                return .Ok
            }
            .Err(error)
        }
    }
}

task closedSet(
    $key String,
    $value own bytes.Bytes
) Result<void, Error> {
    discard key
    discard value
    .Err(.Closed)
}

task closedGet($key String) Result<own bytes.Bytes, Error> {
    discard key
    .Err(.Closed)
}

task closedDelete($key String) Result<void, Error> {
    discard key
    .Err(.Closed)
}

fn validKey(value String) bool {
    const length = text.ByteLen(value)
    if length == 0 return false
    var offset u64 = 0
    while offset < length {
        const byte = text.ByteAt(value, offset) else error {
            discard error
            return false
        }
        if byte == 0 return false
        offset = offset + 1
    }
    true
}

fn validCipherKey(value bytes.Bytes) bool {
    byteLength(value) == 32
}

fn byteLength(value bytes.Bytes) u64 {
    const result = value.Len() else error {
        discard error
        return 0
    }
    result
}

fn secretPath(directory String, key String, cipherKey bytes.Bytes) String {
    const keyBytes = bytes.FromText(key)
    const digest = bytes.HmacSha256(cipherKey, keyBytes) else error {
        discard keyBytes
        discard error
        panic("secret key digest failed")
    }
    discard keyBytes
    const encoded = bytes.EncodeBase64URL(digest) else error {
        discard digest
        discard error
        panic("secret key encoding failed")
    }
    discard digest
    path.Join(directory, encoded + ".secret")
}

fn requiredBytes(
    $value Result<own bytes.Bytes, bytes.Error>
) own bytes.Bytes {
    match value {
        Ok(result): result
        Err(error): {
            discard error
            panic("secret bytes closed during copy")
        }
    }
}

fn mapMemoryError(error bytes.SecretMemoryError) Error {
    match error {
        Closed: .Closed
        NotFound: .NotFound
        InvalidKey: .InvalidKey
    }
}

fn mapFileError(error fs.Error) Error {
    match error {
        NotFound: .NotFound
        Permission: .Permission
        TooLarge: .TooLarge
        Closed: .Closed
        InvalidPath: .InvalidKey
        InvalidUtf8: .AuthenticationFailed
        LineTooLong: .TooLarge
        InvalidInterval: .Io
        ResourceLimit: .Io
        Cancelled: .Io
        Io: .Io
    }
}

fn mapDeleteFileError(error fs.Error) Result<void, Error> {
    match error {
        NotFound: .Ok
        Permission: .Err(.Permission)
        InvalidPath: .Err(.InvalidKey)
        InvalidUtf8: .Err(.AuthenticationFailed)
        LineTooLong: .Err(.TooLarge)
        TooLarge: .Err(.TooLarge)
        InvalidInterval: .Err(.Io)
        ResourceLimit: .Err(.Io)
        Cancelled: .Err(.Io)
        Closed: .Err(.Closed)
        Io: .Err(.Io)
    }
}

fn fallbackForSet(error Error) bool {
    match error {
        ReadOnly: true
        NotConfigured: true
        NotFound: false
        InvalidKey: false
        InvalidCipherKey: false
        AuthenticationFailed: false
        InsecureAddress: false
        TooLarge: false
        Closed: false
        Cancelled: false
        Permission: false
        Transport: false
        Protocol: false
        Io: false
    }
}

fn isNotFound(error Error) bool {
    match error {
        NotFound: true
        ReadOnly: false
        NotConfigured: false
        InvalidKey: false
        InvalidCipherKey: false
        AuthenticationFailed: false
        InsecureAddress: false
        TooLarge: false
        Closed: false
        Cancelled: false
        Permission: false
        Transport: false
        Protocol: false
        Io: false
    }
}

fn maximumSecretSize() u64 {
    524288
}

fn maximumFileSize() u64 {
    1048576
}
