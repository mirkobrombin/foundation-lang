package foundation.secrets

import std.bytes
import std.env
import std.json
import std.text

// Identifies one Vault KV v2 operation.
enum VaultMethod {
    // Writes one KV v2 value.
    Put
    // Reads one KV v2 value.
    Get
    // Deletes one KV v2 value.
    Delete
}

// Carries a bounded Vault request to an HTTP adapter.
struct VaultRequest {
    // Selects the exact HTTP operation.
    Method VaultMethod
    // Contains the normalized Vault origin without a trailing slash.
    Address String
    // Contains the escaped absolute KV v2 API path.
    Path String
    // Contains the authentication token outside the ordinary header map.
    Token String
    // Contains the JSON request body or an empty String.
    Body String
    // Limits bytes accepted from the response body.
    MaximumResponseSize u64
    // Requires the adapter to reject redirects when false.
    FollowRedirects bool
}

// Carries the bounded status and body returned by an HTTP adapter.
struct VaultResponse {
    // Contains the HTTP status code.
    Status i32
    // Contains the bounded response body.
    Body String
}

// Defines the HTTP boundary without selecting one client package.
contract VaultTransport {
    // Creates an independent owner for the same transport backend.
    fn Clone(self) own VaultTransport

    // Sends one request under its response and redirect policy.
    fn Send(
        self,
        $request VaultRequest
    ) Task<Result<VaultResponse, Error>>
}

// Stores secrets in one Vault KV v2 mount through an explicit transport.
struct VaultStore implements Store {
    transport own VaultTransport
    address String
    token String
    mount String

    // Creates independent owners for the transport and configuration.
    fn Clone(self) own Store {
        own VaultStore {
            transport = self.transport.Clone()
            address = text.Copy(self.address)
            token = text.Copy(self.token)
            mount = text.Copy(self.mount)
        }
    }

    // Encodes and writes one bounded KV v2 value.
    fn Set(
        self,
        $key String,
        $value own bytes.Bytes
    ) Task<Result<void, Error>> {
        spawn vaultSet(
            self.transport.Clone(),
            text.Copy(self.address),
            text.Copy(self.token),
            text.Copy(self.mount),
            $key,
            $value
        )
    }

    // Reads and decodes one bounded KV v2 value.
    fn Get(self, $key String) Task<Result<own bytes.Bytes, Error>> {
        spawn vaultGet(
            self.transport.Clone(),
            text.Copy(self.address),
            text.Copy(self.token),
            text.Copy(self.mount),
            $key
        )
    }

    // Deletes one KV v2 value and accepts an absent key.
    fn Delete(self, $key String) Task<Result<void, Error>> {
        spawn vaultDelete(
            self.transport.Clone(),
            text.Copy(self.address),
            text.Copy(self.token),
            text.Copy(self.mount),
            $key
        )
    }
}

// Creates a configured Vault KV v2 store and rejects remote plaintext HTTP.
fn NewVaultStore(
    $transport own VaultTransport,
    $address String,
    $token String,
    $mount String
) Result<own VaultStore, Error> {
    const normalizedAddress = trimTrailingSlashes(address)
    const normalizedMount = trimSlashes(mount)
    discard address
    discard mount
    if text.IsEmpty(normalizedAddress) ||
        text.IsEmpty(token) ||
        text.IsEmpty(normalizedMount) {
        discard transport
        discard normalizedAddress
        discard normalizedMount
        discard token
        return .Err(.NotConfigured)
    }
    if !secureVaultAddress(normalizedAddress) {
        discard transport
        discard normalizedAddress
        discard normalizedMount
        discard token
        return .Err(.InsecureAddress)
    }
    .Ok(own VaultStore {
        transport = transport
        address = normalizedAddress
        token = token
        mount = normalizedMount
    })
}

// Reads VAULT_ADDR and VAULT_TOKEN while keeping the transport explicit.
task NewVaultStoreFromEnvironment(
    $transport own VaultTransport
) Result<own VaultStore, Error> {
    const addressResult = env.Get("VAULT_ADDR")
    const address = match addressResult {
        Ok(value): match value {
            None: {
                return .Err(.NotConfigured)
            }
            Some(result): result
        }
        Err(error): {
            discard error
            return .Err(.NotConfigured)
        }
    }
    const tokenResult = env.Get("VAULT_TOKEN")
    const token = match tokenResult {
        Ok(value): match value {
            None: {
                return .Err(.NotConfigured)
            }
            Some(result): result
        }
        Err(error): {
            discard error
            return .Err(.NotConfigured)
        }
    }
    NewVaultStore($transport, $address, $token, "secret")
}

task vaultSet(
    $transport own VaultTransport,
    $address String,
    $token String,
    $mount String,
    $key String,
    $value own bytes.Bytes
) Result<void, Error> {
    if !validVaultKey(key) {
        discard transport
        discard address
        discard token
        discard mount
        discard key
        discard value
        return .Err(.InvalidKey)
    }
    if byteLength(value) > maximumSecretSize() {
        discard transport
        discard address
        discard token
        discard mount
        discard key
        discard value
        return .Err(.TooLarge)
    }
    const encoded = bytes.EncodeBase64(value) else error {
        discard transport
        discard address
        discard token
        discard mount
        discard key
        discard value
        discard error
        return .Err(.TooLarge)
    }
    discard value
    const request = vaultRequest(
        .Put,
        $address,
        $token,
        $mount,
        $key,
        "{\"data\":{\"value\":\"" + encoded + "\"}}"
    ) else error {
        discard transport
        discard encoded
        return .Err(error)
    }
    discard encoded
    const sending = transport.Send($request)
    discard transport
    const sent = $sending.wait()
    const response = sent else error {
        return .Err(error)
    }
    if response.Status == 200 || response.Status == 204 {
        discard response
        return .Ok
    }
    discard response
    .Err(.Protocol)
}

task vaultGet(
    $transport own VaultTransport,
    $address String,
    $token String,
    $mount String,
    $key String
) Result<own bytes.Bytes, Error> {
    if !validVaultKey(key) {
        discard transport
        discard address
        discard token
        discard mount
        discard key
        return .Err(.InvalidKey)
    }
    const request = vaultRequest(
        .Get,
        $address,
        $token,
        $mount,
        $key,
        ""
    ) else error {
        discard transport
        return .Err(error)
    }
    const sending = transport.Send($request)
    discard transport
    const sent = $sending.wait()
    const response = sent else error {
        return .Err(error)
    }
    if response.Status == 404 {
        discard response
        return .Err(.NotFound)
    }
    if response.Status != 200 ||
        text.ByteLen(response.Body) > maximumVaultResponseSize() {
        discard response
        return .Err(.Protocol)
    }
    const encoded = vaultValue(response.Body) else error {
        discard response
        return .Err(error)
    }
    discard response
    const value = bytes.DecodeBase64(encoded) else error {
        discard encoded
        discard error
        return .Err(.Protocol)
    }
    discard encoded
    if byteLength(value) > maximumSecretSize() {
        discard value
        return .Err(.TooLarge)
    }
    .Ok(value)
}

task vaultDelete(
    $transport own VaultTransport,
    $address String,
    $token String,
    $mount String,
    $key String
) Result<void, Error> {
    if !validVaultKey(key) {
        discard transport
        discard address
        discard token
        discard mount
        discard key
        return .Err(.InvalidKey)
    }
    const request = vaultRequest(
        .Delete,
        $address,
        $token,
        $mount,
        $key,
        ""
    ) else error {
        discard transport
        return .Err(error)
    }
    const sending = transport.Send($request)
    discard transport
    const sent = $sending.wait()
    const response = sent else error {
        return .Err(error)
    }
    if response.Status == 200 ||
        response.Status == 204 ||
        response.Status == 404 {
        discard response
        return .Ok
    }
    discard response
    .Err(.Protocol)
}

fn vaultRequest(
    method VaultMethod,
    $address String,
    $token String,
    $mount String,
    $key String,
    body String
) Result<VaultRequest, Error> {
    const escapedMount = escapeVaultSegment(mount) else error {
        discard address
        discard token
        discard mount
        discard key
        return .Err(error)
    }
    discard mount
    const escapedKey = escapeVaultKey(key) else error {
        discard address
        discard token
        discard key
        discard escapedMount
        return .Err(error)
    }
    discard key
    .Ok(VaultRequest {
        Method = method
        Address = address
        Path = "/v1/" + escapedMount + "/data/" + escapedKey
        Token = token
        Body = text.Copy(body)
        MaximumResponseSize = maximumVaultResponseSize()
        FollowRedirects = false
    })
}

fn vaultValue(source String) Result<String, Error> {
    const parsed = json.Parse(source) else error {
        discard error
        return .Err(.Protocol)
    }
    const root = match parsed {
        Object(value): value
        Null: {
            return .Err(.Protocol)
        }
        Bool(value): {
            discard value
            return .Err(.Protocol)
        }
        Number(value): {
            discard value
            return .Err(.Protocol)
        }
        Text(value): {
            discard value
            return .Err(.Protocol)
        }
        Array(value): {
            discard value
            return .Err(.Protocol)
        }
    }
    var rootFields = root
    const outer = takeVaultObject(&rootFields, "data") else error {
        discard rootFields
        return .Err(error)
    }
    discard rootFields
    var outerFields = outer
    const inner = takeVaultObject(&outerFields, "data") else error {
        discard outerFields
        return .Err(error)
    }
    discard outerFields
    var innerFields = inner
    const value = takeVaultText(&innerFields, "value") else error {
        discard innerFields
        return .Err(error)
    }
    discard innerFields
    .Ok(value)
}

fn takeVaultObject(
    &object json.Object,
    key String
) Result<own json.Object, Error> {
    const selected = object.Take(key)
    match selected {
        None: .Err(.Protocol)
        Some(value): match value {
            Object(result): .Ok(result)
            Null: .Err(.Protocol)
            Bool(item): {
                discard item
                .Err(.Protocol)
            }
            Number(item): {
                discard item
                .Err(.Protocol)
            }
            Text(item): {
                discard item
                .Err(.Protocol)
            }
            Array(item): {
                discard item
                .Err(.Protocol)
            }
        }
    }
}

fn takeVaultText(
    &object json.Object,
    key String
) Result<String, Error> {
    const selected = object.Take(key)
    match selected {
        None: .Err(.Protocol)
        Some(value): match value {
            Text(result): .Ok(result)
            Null: .Err(.Protocol)
            Bool(item): {
                discard item
                .Err(.Protocol)
            }
            Number(item): {
                discard item
                .Err(.Protocol)
            }
            Array(item): {
                discard item
                .Err(.Protocol)
            }
            Object(item): {
                discard item
                .Err(.Protocol)
            }
        }
    }
}

fn validVaultKey(value String) bool {
    const length = text.ByteLen(value)
    if length == 0 return false
    var offset u64 = 0
    var segmentStart u64 = 0
    while offset <= length {
        if offset == length || vaultByte(value, offset) == 47 {
            if offset == segmentStart return false
            const segment = text.Slice(value, segmentStart, offset) else error {
                discard error
                return false
            }
            if segment == "." || segment == ".." return false
            segmentStart = offset + 1
        }
        offset = offset + 1
    }
    true
}

fn escapeVaultKey(value String) Result<String, Error> {
    if !validVaultKey(value) return .Err(.InvalidKey)
    var builder = text.NewBuilder()
    const length = text.ByteLen(value)
    var offset u64 = 0
    var segmentStart u64 = 0
    while offset <= length {
        if offset == length || vaultByte(value, offset) == 47 {
            const segment = text.Slice(value, segmentStart, offset) else error {
                discard error
                discard builder
                return .Err(.InvalidKey)
            }
            writeVaultSegment(&builder, segment)
            if offset != length {
                writeVaultCodePoint(&builder, 47)
            }
            segmentStart = offset + 1
        }
        offset = offset + 1
    }
    const result = builder.Finish() else error {
        discard error
        discard builder
        return .Err(.TooLarge)
    }
    discard builder
    .Ok(result)
}

fn escapeVaultSegment(value String) Result<String, Error> {
    if text.IsEmpty(value) return .Err(.InvalidKey)
    var builder = text.NewBuilder()
    writeVaultSegment(&builder, value)
    const result = builder.Finish() else error {
        discard error
        discard builder
        return .Err(.TooLarge)
    }
    discard builder
    .Ok(result)
}

fn writeVaultSegment(&builder text.Builder, value String) void {
    const length = text.ByteLen(value)
    var offset u64 = 0
    while offset < length {
        const byte = vaultByte(value, offset)
        if vaultUnreserved(byte) {
            writeVaultCodePoint(&builder, byte)
        } else {
            writeVaultCodePoint(&builder, 37)
            writeVaultCodePoint(&builder, hexDigit(byte / 16))
            writeVaultCodePoint(&builder, hexDigit(byte % 16))
        }
        offset = offset + 1
    }
}

fn writeVaultCodePoint(&builder text.Builder, value u64) void {
    const written = builder.WriteCodePoint(value) else error {
        discard error
        panic("vault path builder failed")
    }
    discard written
}

fn vaultByte(value String, offset u64) u64 {
    const byte = text.ByteAt(value, offset) else error {
        discard error
        return 0
    }
    byte
}

fn vaultUnreserved(value u64) bool {
    (value >= 65 && value <= 90) ||
        (value >= 97 && value <= 122) ||
        (value >= 48 && value <= 57) ||
        value == 45 || value == 46 || value == 95 || value == 126
}

fn hexDigit(value u64) u64 {
    if value < 10 return 48 + value
    65 + value - 10
}

fn secureVaultAddress(value String) bool {
    if !vaultAddressBytesSafe(value) return false
    if text.StartsWith(value, "https://") {
        return validHttpsAuthority(value)
    }
    if !text.StartsWith(value, "http://") return false
    loopbackAuthority(value, "localhost") ||
        loopbackAuthority(value, "127.0.0.1") ||
        loopbackAuthority(value, "[::1]")
}

fn vaultAddressBytesSafe(value String) bool {
    const length = text.ByteLen(value)
    var offset u64 = 0
    while offset < length {
        const byte = vaultByte(value, offset)
        if byte <= 32 || byte == 127 || byte == 64 || byte == 92 ||
            byte == 63 || byte == 35 {
            return false
        }
        offset = offset + 1
    }
    true
}

fn validHttpsAuthority(value String) bool {
    const length = text.ByteLen(value)
    var offset u64 = 8
    if offset == length return false
    if vaultByte(value, offset) == 91 {
        offset = offset + 1
        const addressStart = offset
        while offset < length && vaultByte(value, offset) != 93 {
            const byte = vaultByte(value, offset)
            if !vaultHostByte(byte) || byte == 91 return false
            offset = offset + 1
        }
        if offset == addressStart || offset == length return false
        offset = offset + 1
        if offset == length || vaultByte(value, offset) == 47 return true
        if vaultByte(value, offset) != 58 return false
        return validVaultPort(value, offset + 1)
    }
    const hostStart = offset
    while offset < length {
        const byte = vaultByte(value, offset)
        if byte == 47 return offset > hostStart
        if byte == 58 {
            if offset == hostStart return false
            return validVaultPort(value, offset + 1)
        }
        if !vaultHostByte(byte) || byte == 91 || byte == 93 return false
        offset = offset + 1
    }
    offset > hostStart
}

fn vaultHostByte(value u64) bool {
    (value >= 65 && value <= 90) ||
        (value >= 97 && value <= 122) ||
        (value >= 48 && value <= 57) ||
        value == 45 || value == 46 || value == 95 || value == 37 || value == 58
}

fn loopbackAuthority(value String, host String) bool {
    const prefix = "http://" + host
    if !text.StartsWith(value, prefix) return false
    const length = text.ByteLen(value)
    var offset = text.ByteLen(prefix)
    if offset == length return true
    const next = vaultByte(value, offset)
    if next == 47 return true
    if next != 58 return false
    validVaultPort(value, offset + 1)
}

fn validVaultPort(value String, start u64) bool {
    const length = text.ByteLen(value)
    var offset = start
    if offset == length return false
    var port u64 = 0
    var digits u64 = 0
    while offset < length {
        const byte = vaultByte(value, offset)
        if byte == 47 {
            return digits > 0 && port > 0 && port <= 65535
        }
        if byte < 48 || byte > 57 return false
        port = port * 10 + byte - 48
        if port > 65535 return false
        digits = digits + 1
        offset = offset + 1
    }
    digits > 0 && port > 0
}

fn trimTrailingSlashes(value String) String {
    var end = text.ByteLen(value)
    while end > 0 && vaultByte(value, end - 1) == 47 {
        end = end - 1
    }
    const result = text.Slice(value, 0, end) else error {
        discard error
        return ""
    }
    result
}

fn trimSlashes(value String) String {
    const length = text.ByteLen(value)
    var start u64 = 0
    var end = length
    while start < end && vaultByte(value, start) == 47 {
        start = start + 1
    }
    while end > start && vaultByte(value, end - 1) == 47 {
        end = end - 1
    }
    const result = text.Slice(value, start, end) else error {
        discard error
        return ""
    }
    result
}

fn maximumVaultResponseSize() u64 {
    1048576
}
