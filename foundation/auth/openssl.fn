package foundation.auth

import std.bytes

extern c fn signNative(
    algorithm u64,
    privateKey u64,
    signingInput u64,
    &signature u64
) i32 as foundation_openssl_sign
extern c fn verifyNative(
    algorithm u64,
    publicKey u64,
    signingInput u64,
    signature u64
) i32 as foundation_openssl_verify
extern c fn generateEd25519Native(
    &privateKey u64,
    &publicKey u64,
    &rawPublicKey u64
) i32 as foundation_openssl_ed25519_generate

// Owns one generated Ed25519 keypair in provider and wire formats.
struct OpenSSLEd25519KeyPair {
    PrivateKeyPEM own bytes.Bytes
    PublicKeyPEM own bytes.Bytes
    RawPublicKey own bytes.Bytes
}

// Provides RS256, ES256, and Ed25519 signing through an explicitly linked OpenSSL adapter.
struct OpenSSLAsymmetricProvider implements AsymmetricProvider {
    fn Sign(
        &self,
        algorithm AsymmetricAlgorithm,
        privateKey bytes.Bytes,
        signingInput bytes.Bytes
    ) Result<own bytes.Bytes, AsymmetricProviderError> {
        var signature u64 = 0
        const status = signNative(
            openSSLAlgorithm(algorithm),
            bytes.RuntimeHandle(privateKey),
            bytes.RuntimeHandle(signingInput),
            &signature
        )
        if status != 0 return .Err(openSSLAsymmetricError(status))
        const claimed = bytes.ClaimRuntimeHandle(signature) else error {
            discard error
            return .Err(.Failed)
        }
        .Ok(claimed)
    }

    fn Verify(
        &self,
        algorithm AsymmetricAlgorithm,
        publicKey bytes.Bytes,
        signingInput bytes.Bytes,
        signature bytes.Bytes
    ) Result<void, AsymmetricProviderError> {
        const status = verifyNative(
            openSSLAlgorithm(algorithm),
            bytes.RuntimeHandle(publicKey),
            bytes.RuntimeHandle(signingInput),
            bytes.RuntimeHandle(signature)
        )
        if status != 0 return .Err(openSSLAsymmetricError(status))
        .Ok
    }
}

// Creates the provider only when the application explicitly links providers/openssl.
fn OpenSSLAsymmetric() own AsymmetricProvider {
    own OpenSSLAsymmetricProvider {}
}

// Generates an Ed25519 keypair for signing, verification, and protocol pinning.
fn GenerateOpenSSLEd25519() Result<OpenSSLEd25519KeyPair, AsymmetricProviderError> {
    var privateKey u64 = 0
    var publicKey u64 = 0
    var rawPublicKey u64 = 0
    if generateEd25519Native(&privateKey, &publicKey, &rawPublicKey) != 0 {
        return .Err(.Failed)
    }
    const claimedPrivate = bytes.ClaimRuntimeHandle(privateKey) else error {
        discard error
        return .Err(.Failed)
    }
    const claimedPublic = bytes.ClaimRuntimeHandle(publicKey) else error {
        discard error
        return .Err(.Failed)
    }
    const claimedRaw = bytes.ClaimRuntimeHandle(rawPublicKey) else error {
        discard error
        return .Err(.Failed)
    }
    .Ok(OpenSSLEd25519KeyPair {
        PrivateKeyPEM = claimedPrivate
        PublicKeyPEM = claimedPublic
        RawPublicKey = claimedRaw
    })
}

fn openSSLAlgorithm(algorithm AsymmetricAlgorithm) u64 {
    match algorithm {
        RS256: 0
        ES256: 1
        EdDSA: 2
    }
}

fn openSSLAsymmetricError(status i32) AsymmetricProviderError {
    if status == 2 return .InvalidPrivateKey
    if status == 3 return .InvalidPublicKey
    if status == 4 return .InvalidSignature
    if status == 1 return .Failed
    .Failed
}
