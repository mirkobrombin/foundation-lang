package foundation.serializer

import std.json
import std.format
import std.parse
import std.text

// Requests compiler-derived JSON serialization for one concrete struct.
attribute Serializable() targets(struct)

// Overrides the JSON key of one serializable field.
attribute Name(value String) targets(field)

// Excludes one field from encoding and decoding.
attribute Ignore() targets(field)

// Marks the typed value-to-JSON method of a custom serializable type.
attribute Encode() targets(method)

// Marks the typed JSON-to-value function of a custom serializable type.
attribute Decode() targets(method)

enum NamingStrategy {
    PascalCase
    CamelCase
    SnakeCase
}

enum ErrorKind {
    Syntax
    ExpectedObject
    ExpectedString
    ExpectedBoolean
    ExpectedNumber
    InvalidNumber
    InvalidUUID
    DuplicateField
    UnknownField
    Custom
}

struct Error {
    Kind ErrorKind
    Field String = ""
    Message String = ""
    Offset u64 = 0
    JSONKind Option<json.ErrorKind> = .None
}

struct Policy {
    Naming NamingStrategy = .PascalCase
    IgnoreNone bool = false
    IgnoreZero bool = false
    RejectUnknown bool = false
}

fn Default() Policy {
    Policy {}
}

fn FieldName(name String, naming NamingStrategy) String {
    match naming {
        PascalCase: text.Copy(name)
        CamelCase: camelCase(name)
        SnakeCase: snakeCase(name)
    }
}

fn Syntax(error json.Error) Error {
    Error {
        Kind = .Syntax
        Offset = error.Offset
        JSONKind = .Some(error.Kind)
    }
}

fn Write(error json.WriteError) Error {
    const kind = match error.Kind {
        InvalidNumber: "invalid JSON number"
        DepthLimit: "JSON depth limit exceeded"
        Builder: "JSON writer failed"
    }
    Error { Kind = .Custom Message = kind }
}

fn Expected(field String, kind ErrorKind) Error {
    Error { Kind = kind Field = text.Copy(field) }
}

fn Invalid(field String, kind ErrorKind) Error {
    Error { Kind = kind Field = text.Copy(field) }
}

fn Duplicate(field String) Error {
    Error { Kind = .DuplicateField Field = text.Copy(field) }
}

fn Unknown(field String) Error {
    Error { Kind = .UnknownField Field = text.Copy(field) }
}

fn Keep(
    $value json.Value,
    ignoreNone bool,
    ignoreZero bool
) Option<json.Value> {
    match value {
        Null: .None if ignoreNone || ignoreZero else .Some(.Null)
        Bool(state): .None if ignoreZero && !state else .Some(.Bool(state))
        Number(number): keepNumber($number, ignoreZero)
        Text(textValue): keepText($textValue, ignoreZero)
        Array(array): keepArray($array, ignoreZero)
        Object(object): keepObject($object, ignoreZero)
    }
}

fn NonNull($value json.Value) Option<json.Value> {
    match value {
        Null: .None
        Bool(state): .Some(.Bool(state))
        Number(number): .Some(.Number(number))
        Text(textValue): .Some(.Text(textValue))
        Array(array): .Some(.Array(array))
        Object(object): .Some(.Object(object))
    }
}

fn StringValue(value String) json.Value {
    .Text(text.Copy(value))
}

fn BooleanValue(value bool) json.Value {
    .Bool(value)
}

fn I8Value(value i8) json.Value {
    .Number(format.I8(value))
}

fn I16Value(value i16) json.Value {
    .Number(format.I16(value))
}

fn I32Value(value i32) json.Value {
    .Number(format.I32(value))
}

fn I64Value(value i64) json.Value {
    .Number(format.I64(value))
}

fn IsizeValue(value isize) json.Value {
    .Number(format.Isize(value))
}

fn U8Value(value u8) json.Value {
    .Number(format.U8(value))
}

fn U16Value(value u16) json.Value {
    .Number(format.U16(value))
}

fn U32Value(value u32) json.Value {
    .Number(format.U32(value))
}

fn U64Value(value u64) json.Value {
    .Number(format.U64(value))
}

fn UsizeValue(value usize) json.Value {
    .Number(format.Usize(value))
}

fn F32Value(value f32) json.Value {
    .Number(format.F32(value))
}

fn F64Value(value f64) json.Value {
    .Number(format.F64(value))
}

fn UUIDValue(value UUID) json.Value {
    .Text(value.String())
}

fn I8($value json.Value, field String) Result<i8, Error> {
    const number = Number($value, field) else error {
        return .Err(error)
    }
    const parsed = parse.I8(number) else error {
        discard error
        return .Err(Invalid(field, .InvalidNumber))
    }
    .Ok(parsed)
}

