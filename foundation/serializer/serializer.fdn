fn UUIDValueFromJSON($value json.Value, field String) Result<UUID, Error> {
    const encoded = Text($value, field) else error {
        return .Err(error)
    }
    const parsed = UUID.Parse(encoded) else error {
        discard error
        return .Err(Invalid(field, .InvalidUUID))
    }
    .Ok(parsed)
}

fn At(field String, $error Error) Error {
    const Error { Kind Field Message Offset JSONKind } = error
    Error {
        Kind = Kind
        Field = fieldPath(field, Field)
        Message = Message
        Offset = Offset
        JSONKind = JSONKind
    }
}

fn Text($value json.Value, field String) Result<String, Error> {
    match value {
        Text(found): .Ok(found)
        Null: .Err(Expected(field, .ExpectedString))
        Bool(state): impossibleBool(state, field, .ExpectedString)
        Number(number): impossibleString(number, field, .ExpectedString)
        Array(array): impossibleArray($array, field, .ExpectedString)
        Object(object): impossibleObject($object, field, .ExpectedString)
    }
}

fn Boolean($value json.Value, field String) Result<bool, Error> {
    match value {
        Bool(found): .Ok(found)
        Null: .Err(Expected(field, .ExpectedBoolean))
        Text(textValue): {
            discard textValue
            .Err(Expected(field, .ExpectedBoolean))
        }
        Number(number): {
            discard number
            .Err(Expected(field, .ExpectedBoolean))
        }
        Array(array): {
            discard array
            .Err(Expected(field, .ExpectedBoolean))
        }
        Object(object): {
            discard object
            .Err(Expected(field, .ExpectedBoolean))
        }
    }
}

fn Number($value json.Value, field String) Result<String, Error> {
    match value {
        Number(found): .Ok(found)
        Null: .Err(Expected(field, .ExpectedNumber))
        Bool(state): impossibleBool(state, field, .ExpectedNumber)
        Text(textValue): impossibleString(textValue, field, .ExpectedNumber)
        Array(array): impossibleArray($array, field, .ExpectedNumber)
        Object(object): impossibleObject($object, field, .ExpectedNumber)
    }
}

fn RequireObject($value json.Value, field String) Result<own json.Object, Error> {
    match value {
        Object(found): .Ok(found)
        Null: .Err(Expected(field, .ExpectedObject))
        Bool(state): impossibleObjectBool(state, field)
        Text(textValue): impossibleObjectString(textValue, field)
        Number(number): impossibleObjectString(number, field)
        Array(array): impossibleObjectArray($array, field)
    }
}

fn Set(
    &object json.Object,
    $key String,
    $value json.Value
) Result<void, Error> {
    const errorKey = text.Copy(key)
    object.Set($key, $value) else error {
        discard error
        return .Err(Duplicate(errorKey))
    }
    .Ok
}

fn fieldPath(prefix String, field String) String {
    if !field return text.Copy(prefix)
    var builder = text.NewBuilder()
    write(&builder, prefix)
    write(&builder, ".")
    write(&builder, field)
    const result = builder.Finish() else error {
        discard error
        panic("serializer field path builder is closed")
    }
    result
}

fn keepNumber($value String, ignoreZero bool) Option<json.Value> {
    if ignoreZero {
        const parsed = parse.F64(value)
        const zero = match parsed {
            Ok(number): number == 0.0
            Err(error): {
                discard error
                false
            }
        }
        if zero {
            discard value
            return .None
        }
    }
    .Some(.Number(value))
}

fn keepText($value String, ignoreZero bool) Option<json.Value> {
    if ignoreZero && !value {
        discard value
        return .None
    }
    .Some(.Text(value))
}

fn keepArray($value own json.Array, ignoreZero bool) Option<json.Value> {
    if ignoreZero && value.Len() == 0 {
        discard value
        return .None
    }
    .Some(.Array(value))
}

fn keepObject($value own json.Object, ignoreZero bool) Option<json.Value> {
    if ignoreZero && value.Len() == 0 {
        discard value
        return .None
    }
    .Some(.Object(value))
}

fn camelCase(value String) String {
    const length = text.ByteLen(value)
    if length == 0 return ""
    var builder = text.NewBuilder()
    const first = byteAt(value, 0)
    writeByte(&builder, asciiLower(first))
    if length > 1 {
        const suffix = text.Slice(value, 1, length) else error {
            discard error
            panic("serializer field name boundary failed")
        }
        write(&builder, suffix)
    }
    const result = builder.Finish() else error {
        discard error
        panic("serializer field name builder is closed")
    }
    result
}

fn snakeCase(value String) String {
    const length = text.ByteLen(value)
    var builder = text.NewBuilder()
    var offset u64 = 0
    while offset < length {
        const byte = byteAt(value, offset)
        if offset > 0 && byte >= 65 && byte <= 90 {
            writeByte(&builder, 95)
        }
        writeByte(&builder, asciiLower(byte))
        offset = offset + 1
    }
    const result = builder.Finish() else error {
        discard error
        panic("serializer field name builder is closed")
    }
    result
}

fn asciiLower(value u64) u64 {
    value + 32 if value >= 65 && value <= 90 else value
}

fn byteAt(value String, index u64) u64 {
    const byte = text.ByteAt(value, index) else error {
        discard error
        panic("serializer field name byte invariant failed")
    }
    byte
}

fn write(&builder text.Builder, value String) void {
    const written = builder.Write(value) else error {
        discard error
        panic("serializer builder is closed")
    }
    discard written
}

fn writeByte(&builder text.Builder, value u64) void {
    const written = builder.WriteCodePoint(value) else error {
        discard error
        panic("serializer code point invariant failed")
    }
    if !written {
        panic("serializer code point write failed")
    }
}

fn impossibleBool(
    state bool,
    field String,
    kind ErrorKind
) Result<String, Error> {
    discard state
    .Err(Expected(field, kind))
}

fn impossibleString(
    value String,
    field String,
    kind ErrorKind
) Result<String, Error> {
    discard value
    .Err(Expected(field, kind))
}

fn impossibleArray(
    $value own json.Array,
    field String,
    kind ErrorKind
) Result<String, Error> {
    discard value
    .Err(Expected(field, kind))
}

fn impossibleObject(
    $value own json.Object,
    field String,
    kind ErrorKind
) Result<String, Error> {
    discard value
    .Err(Expected(field, kind))
}

fn impossibleObjectBool(state bool, field String) Result<own json.Object, Error> {
    discard state
    .Err(Expected(field, .ExpectedObject))
}

fn impossibleObjectString(value String, field String) Result<own json.Object, Error> {
    discard value
    .Err(Expected(field, .ExpectedObject))
}

fn impossibleObjectArray(
    $value own json.Array,
    field String
) Result<own json.Object, Error> {
    discard value
    .Err(Expected(field, .ExpectedObject))
}
