package foundation.validation

import std.collections
import std.pattern
import std.text

// Requests compiler-generated validation for one concrete struct.
attribute Validatable() targets(struct)

// Rejects an empty String or collection field.
attribute Required() targets(field)

// Rejects a numeric field below the inclusive limit.
attribute Min(value f64) targets(field)

// Rejects a numeric field above the inclusive limit.
attribute Max(value f64) targets(field)

// Rejects a String that does not match the standard email shape.
attribute Email() targets(field)

// Rejects a String that does not match a portable safe pattern.
attribute Pattern(expression String) targets(field)

// Validates a field through its generated Validate method.
attribute Nested() targets(field)

// Marks a typed model method as a custom validation rule.
attribute Rule() targets(method)

enum ErrorKind {
    Required
    Min
    Max
    Email
    Pattern
    Custom
}

struct Error {
    Kind ErrorKind
    Field String
    Message String
}

struct Errors {
    values own collections.List<Error>

    fn Add(&self, kind ErrorKind, field String, message String) void {
        var reversed = collections.NewList<Error>()
        while !self.values.IsEmpty() {
            const current = self.values.PopFront()
            match current {
                None: panic("validation error order invariant failed")
                Some(error): reversed.PushFront($error)
            }
        }
        self.values.PushFront(Error {
            Kind = kind
            Field = text.Copy(field)
            Message = text.Copy(message)
        })
        while !reversed.IsEmpty() {
            const current = reversed.PopFront()
            match current {
                None: panic("validation error order invariant failed")
                Some(error): self.values.PushFront($error)
            }
        }
    }

    fn IsEmpty(self) bool {
        self.values.IsEmpty()
    }

    fn Len(self) i32 {
        self.values.Len()
    }

    fn TakeFirst(&self) Option<Error> {
        self.values.PopFront()
    }

    fn AddNested(&self, prefix String, $nested own Errors) void {
        var remaining = nested
        while !remaining.IsEmpty() {
            const current = remaining.TakeFirst()
            match current {
                None: panic("nested validation error invariant failed")
                Some(error): self.addNested(prefix, $error)
            }
        }
    }

    fn addNested(&self, prefix String, $error Error) void {
        const Error { Kind Field Message } = error
        self.Add(Kind, nestedField(prefix, Field), Message)
    }
}

fn NewErrors() own Errors {
    own Errors { values = collections.NewList<Error>() }
}

fn nestedField(prefix String, field String) String {
    var builder = text.NewBuilder()
    writeText(&builder, prefix)
    writeText(&builder, ".")
    writeText(&builder, field)
    const result = builder.Finish() else error {
        discard error
        panic("nested validation field builder is closed")
    }
    result
}

fn writeText(&builder text.Builder, value String) void {
    const written = builder.Write(value) else error {
        discard error
        panic("nested validation field builder is closed")
    }
    discard written
}

fn IsEmail(value String) bool {
    const length = text.ByteLen(value)
    if length < 5 return false
    var cursor u64 = 0
    var separator = length
    while cursor < length {
        const current = byteAt(value, cursor)
        if current == 64 {
            if separator != length || cursor == 0 return false
            separator = cursor
            cursor = cursor + 1
            continue
        }
        if separator == length && !emailLocalByte(current) return false
        cursor = cursor + 1
    }
    if separator == length || separator + 3 >= length return false
    cursor = separator + 1
    var lastDot = length
    while cursor < length {
        const current = byteAt(value, cursor)
        if current == 46 {
            lastDot = cursor
            cursor = cursor + 1
            continue
        }
        if !emailDomainByte(current) return false
        cursor = cursor + 1
    }
    if lastDot == length || lastDot == separator + 1 || lastDot + 2 >= length return false
    cursor = lastDot + 1
    while cursor < length {
        if !asciiLetter(byteAt(value, cursor)) return false
        cursor = cursor + 1
    }
    true
}

fn IsPattern(value String, expression String) bool {
    pattern.Matches(value, expression)
}

fn byteAt(value String, index u64) u64 {
    const found = text.ByteAt(value, index) else error {
        discard error
        panic("validation byte index invariant failed")
    }
    found
}

fn emailLocalByte(value u64) bool {
    asciiLetter(value) || asciiDigit(value) || value == 46 || value == 95 ||
        value == 37 || value == 43 || value == 45
}

fn emailDomainByte(value u64) bool {
    asciiLetter(value) || asciiDigit(value) || value == 46 || value == 45
}

fn asciiLetter(value u64) bool {
    value >= 65 && value <= 90 || value >= 97 && value <= 122
}

fn asciiDigit(value u64) bool {
    value >= 48 && value <= 57
}
