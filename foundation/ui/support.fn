package foundation.ui

fn validImage(width u64, height u64, length u64) bool {
    if width == 0 || height == 0 return false
    if width > 18446744073709551615 / height return false
    if width * height > 4611686018427387903 return false
    length == width * height * 4
}

fn labelToneValue(value LabelTone) u64 {
    match value {
        Primary: 0
        Muted: 1
        Accent: 2
        Danger: 3
    }
}

fn iconValue(value Icon) u64 {
    match value {
        Link: 0
        Share: 1
        Terminal: 2
        Folder: 3
        Display: 4
        Theme: 5
        Home: 6
        Add: 7
        Workspace: 8
        Key: 9
        Settings: 10
        Back: 11
        Forward: 12
        Reload: 13
        External: 14
        Split: 15
        Notification: 16
        Download: 17
        Web: 18
    }
}

fn surfaceInputKind(value u64) Result<SurfaceInputKind, Error> {
    if value == 0 return .Ok(.MouseMove)
    if value == 1 return .Ok(.MouseButton)
    if value == 2 return .Ok(.Key)
    if value == 3 return .Ok(.Wheel)
    if value == 4 return .Ok(.Text)
    if value == 5 return .Ok(.MouseLeave)
    .Err(.Invalid)
}

fn status(value i32) Result<void, Error> {
    if value == 0 return .Ok
    .Err(errorFor(value))
}

fn errorFor(value i32) Error {
    if value == -1 return .Unavailable
    if value == -2 return .Invalid
    .Failed
}
