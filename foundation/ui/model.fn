package foundation.ui

// Classifies failures reported by a native UI provider.
enum Error {
    // The selected provider or required platform service is unavailable.
    Unavailable
    // An argument or resource identifier is invalid.
    Invalid
    // The provider failed to complete the operation.
    Failed
}

// Selects the light or dark application palette.
enum Theme {
    // Uses a dark application surface.
    Dark
    // Uses a light application surface.
    Light
}

// Describes whether a window can produce another frame.
enum FrameState {
    // The window is visible and ready to draw.
    Active
    // The provider has no frame work until another event arrives.
    Idle
    // The user requested that the window close.
    Closing
}

// Describes the current result of a window-owned open-file dialog.
enum FileDialog {
    // No dialog is active and no result is waiting.
    Idle
    // The provider is waiting for a selection or cancellation.
    Pending
    // The user closed the dialog without selecting a file.
    Cancelled
    // Owns the selected native file path.
    Selected(path String)
}

// Describes the current result of a window-owned folder dialog.
enum FolderDialog {
    // No dialog is active and no result is waiting.
    Idle
    // The provider is waiting for a selection or cancellation.
    Pending
    // The user closed the dialog without selecting a folder.
    Cancelled
    // Owns the selected native folder path.
    Selected(path String)
}

// Selects the semantic color of a text label.
enum LabelTone {
    // Uses the ordinary foreground color.
    Primary
    // Uses the secondary foreground color.
    Muted
    // Uses the application accent color.
    Accent
    // Uses the destructive-action color.
    Danger
}

// Selects how one segment joins the neighboring items in its control.
enum SegmentPosition {
    // Draws a standalone segment.
    Single
    // Draws the leading segment.
    First
    // Draws a segment between two neighbors.
    Middle
    // Draws the trailing segment.
    Last
}

// Selects the visual role of an application action.
enum ActionStyle {
    // Draws an ordinary secondary action.
    Secondary
    // Draws the preferred action in its local group.
    Primary
    // Draws an action that removes or invalidates data.
    Destructive
}

// Selects one provider-independent interface symbol.
enum Icon {
    // Draws two connected links.
    Link
    // Draws an outward share action.
    Share
    // Draws a terminal prompt.
    Terminal
    // Draws a folder.
    Folder
    // Draws a display.
    Display
    // Draws a theme control.
    Theme
    // Draws a home action.
    Home
    // Draws an add action.
    Add
    // Draws a workspace selector.
    Workspace
    // Draws a credential key.
    Key
    // Draws an application settings action.
    Settings
    // Draws backward navigation.
    Back
    // Draws forward navigation.
    Forward
    // Draws a reload action.
    Reload
    // Draws an external navigation action.
    External
    // Draws a split layout.
    Split
    // Draws a notification action.
    Notification
    // Draws a download action.
    Download
    // Draws a web service.
    Web
    // Draws a security shield.
    Shield
    // Draws an extension piece.
    Extension
    // Draws an information symbol.
    Information
    // Draws a storage device.
    Storage
    // Draws an accessibility person.
    Accessibility
}

// Stores one RGBA color with eight-bit channels.
struct Color {
    // Stores the red channel.
    Red u8
    // Stores the green channel.
    Green u8
    // Stores the blue channel.
    Blue u8
    // Stores the alpha channel.
    Alpha u8
}

// Classifies input forwarded through a drawn surface.
enum SurfaceInputKind {
    // Reports pointer motion in normalized surface coordinates.
    MouseMove
    // Reports a pointer button transition.
    MouseButton
    // Reports a keyboard key transition.
    Key
    // Reports vertical wheel motion.
    Wheel
    // Reports committed UTF-8 text.
    Text
    // Reports that the pointer left an embedded surface.
    MouseLeave
}

// Selects how a drawn surface participates in window input.
enum SurfaceInputMode {
    // Owns pointer and keyboard input until explicitly released.
    Captured
    // Keeps keyboard focus while pointer events outside return to the window UI.
    Embedded
}

// Carries one input event for the current surface.
struct SurfaceInput {
    // Identifies the event payload.
    Type SurfaceInputKind
    // Stores the horizontal surface coordinate.
    X u64
    // Stores the vertical surface coordinate.
    Y u64
    // Stores the provider-independent pointer button.
    Button u64
    // Stores the platform key code.
    Key u64
    // Distinguishes press from release.
    Down bool
    // Stores signed wheel motion.
    Delta i64
    // Reports the Control modifier state.
    Control bool
    // Reports the Shift modifier state.
    Shift bool
    // Reports the Alt modifier state.
    Alt bool
    // Reports the platform command modifier state.
    Super bool
    // Owns committed UTF-8 text for a text event.
    Text String
}

// Describes the result of one text editing widget.
struct TextEdit {
    // Owns the current field value.
    Value String
    // Reports a value change during this frame.
    Changed bool
    // Reports that the user committed the field.
    Committed bool
}

// Describes a text field with one adjacent action.
struct TextActionEdit {
    // Stores the adjacent text field result.
    Edit TextEdit
    // Reports that the adjacent action was activated.
    Activated bool
}

// Describes the result of one bounded numeric slider.
struct SliderEdit {
    // Stores the current slider value.
    Value u64
    // Reports a value change during this frame.
    Changed bool
}

// Carries terminal input and the visible cell dimensions.
struct TerminalFrame {
    // Owns bytes entered during this frame.
    Input String
    // Stores the visible terminal width in cells.
    Columns u64
    // Stores the visible terminal height in cells.
    Rows u64
    // Reports a cell-size change.
    Resized bool
}

// Stores a two-dimensional size in logical pixels.
struct Size {
    // Stores the horizontal extent.
    Width u64
    // Stores the vertical extent.
    Height u64
}

// Identifies one drawable surface owned by a window.
struct Surface {
    window u64
    id u64
}

// Owns one native application window and its provider resources.
struct Window {
    handle u64
}
