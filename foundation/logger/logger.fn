package foundation.logger

import std.collections
import std.text
import std.time

// Orders log severities from diagnostic messages to fatal failures.
enum Level {
    // Enables detailed diagnostic output.
    Debug
    // Represents normal operational output.
    Info
    // Reports a potential problem.
    Warn
    // Reports a failed operation.
    Error
    // Marks a process-ending failure for policies outside this logger.
    Fatal
}

// Stores one owned structured key and value.
struct Field {
    // Identifies the structured value.
    Key String
    // Stores its deterministic text representation.
    Value String
}

// Carries explicit distributed trace identity without ambient context values.
struct Trace {
    // Identifies the distributed trace attached to an entry.
    TraceID String
    // Identifies the current span within that trace.
    SpanID String
}

// Applies severity, persistent fields, and trace identity before delivery.
struct Logger {
    fields own collections.List<Field>
    minimum Level
    traceID String
    spanID String

    // Changes the minimum severity emitted by later calls.
    fn SetLevel(&self, level Level) void {
        self.minimum = level
    }

    // Retains one owned field on the logger for later entries.
    fn Bind(&self, $field Field) void {
        const active = replace self.fields with collections.NewList<Field>()
        self.fields = withField($active, $field)
    }

    // Replaces the trace and span attached to later entries.
    fn BindTrace(&self, $trace Trace) void {
        const Trace { TraceID SpanID } = trace
        const previousTrace = replace self.traceID with TraceID
        const previousSpan = replace self.spanID with SpanID
        discard previousTrace
        discard previousSpan
    }

    // Removes trace identity from later entries.
    fn ClearTrace(&self) void {
        const previousTrace = replace self.traceID with ""
        const previousSpan = replace self.spanID with ""
        discard previousTrace
        discard previousSpan
    }

    // Builds one owned entry when its severity reaches the threshold.
    fn Prepare(
        &self,
        level Level,
        message String,
        $fields own collections.List<Field>
    ) Option<own Entry> {
        self.PrepareAt(level, time.Now(), message, $fields)
    }

    // Builds one entry with a caller-supplied timestamp.
    fn PrepareAt(
        &self,
        level Level,
        timestamp time.Instant,
        message String,
        $fields own collections.List<Field>
    ) Option<own Entry> {
        if levelRank(level) < levelRank(self.minimum) {
            discard fields
            return .None
        }
        .Some(newEntry(&self, level, timestamp, message, $fields))
    }

    // Emits one compact text entry when its severity reaches the threshold.
    fn Log(
        &self,
        level Level,
        message String,
        $fields own collections.List<Field>
    ) void {
        const prepared = self.Prepare(level, message, $fields)
        match prepared {
            None: {
                return
            }
            Some(entry): print(RenderText($entry))
        }
    }

    // Emits one debug entry when debug logging is enabled.
    fn Debug(&self, message String, $fields own collections.List<Field>) void {
        self.Log(.Debug, message, $fields)
    }

    // Emits one informational entry.
    fn Info(&self, message String, $fields own collections.List<Field>) void {
        self.Log(.Info, message, $fields)
    }

    // Emits one warning entry.
    fn Warn(&self, message String, $fields own collections.List<Field>) void {
        self.Log(.Warn, message, $fields)
    }

    // Emits one error entry.
    fn Error(&self, message String, $fields own collections.List<Field>) void {
        self.Log(.Error, message, $fields)
    }
}

// Creates a standard-output logger with an informational threshold.
fn New() own Logger {
    NewWith(.Info)
}

// Creates a standard-output logger with an explicit minimum severity.
fn NewWith(minimum Level) own Logger {
    own Logger {
        fields = collections.NewList<Field>()
        minimum = minimum
        traceID = ""
        spanID = ""
    }
}

// Creates an empty owned per-call field list.
fn Fields() own collections.List<Field> {
    collections.NewList<Field>()
}

// Replaces one field in an owned field list and returns its owner.
fn WithField(
    $fields own collections.List<Field>,
    $key String,
    $value String
) own collections.List<Field> {
    withField($fields, $Field { Key = key Value = value })
}

// Returns the canonical lowercase text for one severity.
fn LevelText(level Level) String {
    match level {
        Debug: "debug"
        Info: "info"
        Warn: "warn"
        Error: "error"
        Fatal: "fatal"
    }
}

fn levelRank(level Level) i32 {
    match level {
        Debug: 0
        Info: 1
        Warn: 2
        Error: 3
        Fatal: 4
    }
}

fn newEntry(
    &logger Logger,
    level Level,
    timestamp time.Instant,
    message String,
    $fields own collections.List<Field>
) own Entry {
    own Entry {
        Level = level
        Time = timestamp
        Message = text.Copy(message)
        Fields = mergeFields(&logger, $fields)
        TraceID = text.Copy(logger.traceID)
        SpanID = text.Copy(logger.spanID)
    }
}

fn mergeFields(
    &logger Logger,
    $fields own collections.List<Field>
) own collections.List<Field> {
    var bound = replace logger.fields with collections.NewList<Field>()
    var restored = collections.NewList<Field>()
    var merged = collections.NewList<Field>()
    while !bound.IsEmpty() {
        const field = fieldValue(bound.PopFront())
        const copied = Field {
            Key = text.Copy(field.Key)
            Value = text.Copy(field.Value)
        }
        restored.PushFront($field)
        merged.PushFront($copied)
    }
    logger.fields = reverseFields($restored)
    merged = reverseFields($merged)

    var active = reverseFields($fields)
    while !active.IsEmpty() {
        merged = withFieldLast($merged, $fieldValue(active.PopFront()))
    }
    merged
}

fn withField(
    $fields own collections.List<Field>,
    $field Field
) own collections.List<Field> {
    var pending = fields
    var kept = collections.NewList<Field>()
    while !pending.IsEmpty() {
        const current = fieldValue(pending.PopFront())
        if current.Key == field.Key {
            discard current
        } else {
            kept.PushFront($current)
        }
    }
    var result = reverseFields($kept)
    result.PushFront($field)
    result
}

fn withFieldLast(
    $fields own collections.List<Field>,
    $field Field
) own collections.List<Field> {
    var pending = fields
    var kept = collections.NewList<Field>()
    while !pending.IsEmpty() {
        const current = fieldValue(pending.PopFront())
        if current.Key == field.Key {
            discard current
        } else {
            kept.PushFront($current)
        }
    }
    kept.PushFront($field)
    reverseFields($kept)
}

fn fieldValue($value Option<Field>) Field {
    match value {
        None: panic("logger field invariant failed")
        Some(field): field
    }
}

fn reverseFields(
    $source own collections.List<Field>
) own collections.List<Field> {
    var active = source
    var result = collections.NewList<Field>()
    while !active.IsEmpty() {
        result.PushFront(fieldValue(active.PopFront()))
    }
    result
}
