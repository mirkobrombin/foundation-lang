package foundation.web

import foundation.worker
import std.bytes
import std.collections
import std.concurrent
import std.format
import std.net
import std.parse
import std.pattern as portablePattern
import std.text

// Declares one statically discoverable HTTP endpoint.
attribute Route(method Method, path String) targets(fn, method)

// Binds one route parameter to a handler parameter.
attribute Path(name String) targets(parameter)

// Binds one query value to a handler parameter.
attribute Query(name String) targets(parameter)

// Binds one request header to a handler parameter.
attribute Header(name String) targets(parameter)

// Binds the request body to a handler parameter.
attribute Body() targets(parameter)

// Binds one form value to a handler parameter.
attribute Form(name String) targets(parameter)

// Resolves one application service for a handler parameter.
attribute Inject() targets(parameter)

// Places one typed middleware around the complete generated application.
attribute GlobalMiddleware(order i32) targets(fn)

// Places one typed middleware around routes below a static path prefix.
attribute GroupMiddleware(prefix String, order i32) targets(fn) repeatable

// Places one typed middleware around a single generated route.
attribute RouteMiddleware(method Method, path String, order i32) targets(fn) repeatable

enum Method {
    GET
    POST
    PUT
    PATCH
    DELETE
    HEAD
    OPTIONS
}

struct HeaderValue {
    Name String
    Value String
}

struct Parameter {
    Name String
    Value String
}

struct Request {
    Method Method
    Target String
    Path String
    Version String
    // Carries the numeric transport peer address when a server accepted the request.
    RemoteAddress String = ""
    // Carries a validated client UUID or a generated UUIDv7.
    RequestID UUID = UUID.Nil()
    Body String = ""
    ContentLength u64 = 0
    hasContentLength bool = false
    Headers own collections.List<HeaderValue>
    Params own collections.List<Parameter>

    fn Param(&self, name String) Option<String> {
        var active = replace self.Params with collections.NewList<Parameter>()
        var reversed = collections.NewList<Parameter>()
        var result Option<String> = .None
        while !active.IsEmpty() {
            const parameter = parameterValue(active.PopFront())
            if parameter.Name == name {
                result = .Some(text.Copy(parameter.Value))
            }
            reversed.PushFront($parameter)
        }
        self.Params = reverseParameters($reversed)
        result
    }

    fn Query(self, name String) Option<String> {
        queryValue(self.Target, name)
    }

    fn Form(self, name String) Option<String> {
        queryValueAfter(self.Body, name, 0)
    }

    fn Header(&self, name String) Option<String> {
        var active = replace self.Headers with collections.NewList<HeaderValue>()
        var reversed = collections.NewList<HeaderValue>()
        var result Option<String> = .None
        var found = false
        while !active.IsEmpty() {
            const header = headerValue(active.PopFront())
            if !found && equalFoldAscii(header.Name, name) {
                result = .Some(text.Copy(header.Value))
                found = true
            }
            reversed.PushFront($header)
        }
        self.Headers = reverseHeaders($reversed)
        result
    }

    // Reports whether Content-Type selects JSON, including parameters.
    fn IsJSON(&self) bool {
        const contentType = self.Header("Content-Type")
        match contentType {
            None: false
            Some(value): jsonContentType($value)
        }
    }
}

struct Response {
    Status i32
    Headers own collections.List<HeaderValue>
    // Owns arbitrary response bytes. Text and JSON helpers convert UTF-8 text at the boundary.
    Body own bytes.Bytes

    // Copies the response body into UTF-8 text when the selected representation permits it.
    fn TextBody(self) Result<String, bytes.Error> {
        self.Body.Text()
    }

    // Returns the first response header using ASCII case-insensitive matching.
    fn Header(&self, name String) Option<String> {
        var active = replace self.Headers with collections.NewList<HeaderValue>()
        var reversed = collections.NewList<HeaderValue>()
        var result Option<String> = .None
        var found = false
        while !active.IsEmpty() {
            const header = headerValue(active.PopFront())
            if !found && equalFoldAscii(header.Name, name) {
                result = .Some(text.Copy(header.Value))
                found = true
            }
            reversed.PushFront($header)
        }
        self.Headers = reverseHeaders($reversed)
        result
    }

    // Replaces every matching response header with one canonical value.
    fn SetHeader(&self, name String, value String) void {
        var active = replace self.Headers with collections.NewList<HeaderValue>()
        var reversed = collections.NewList<HeaderValue>()
        var replaced = false
        while !active.IsEmpty() {
            const header = headerValue(active.PopFront())
            if equalFoldAscii(header.Name, name) {
                if !replaced {
                    reversed.PushFront(HeaderValue {
                        Name = text.Copy(name)
                        Value = text.Copy(value)
                    })
                    replaced = true
                }
                discard header
            } else {
                reversed.PushFront($header)
            }
        }
        if !replaced {
            reversed.PushFront(HeaderValue {
                Name = text.Copy(name)
                Value = text.Copy(value)
            })
        }
        self.Headers = reverseHeaders($reversed)
    }

    // Appends one response header without replacing existing values.
    fn AddHeader(&self, name String, value String) void {
        var active = replace self.Headers with collections.NewList<HeaderValue>()
        var reversed = collections.NewList<HeaderValue>()
        while !active.IsEmpty() {
            reversed.PushFront(headerValue(active.PopFront()))
        }
        reversed.PushFront(HeaderValue {
            Name = text.Copy(name)
            Value = text.Copy(value)
        })
        self.Headers = reverseHeaders($reversed)
    }
}

enum RegistrationError {
    EmptyPath
    InvalidPath
    MalformedSegment
    InvalidParameter
    DuplicateParameter
    UnknownConstraint
    UnsupportedConstraint
    CatchAllNotLast
    AmbiguousRoute
    DuplicateRoute
    DuplicateId
}

enum MiddlewareRegistrationError {
    InvalidGroup
    UnknownGroup
    UnknownRoute
    DuplicateOrder
}

enum ProtocolError {
    Closed
    RequestLineTooLong
    HeaderLineTooLong
    TooManyHeaders
    MalformedRequestLine
    UnsupportedMethod
    UnsupportedVersion
    MalformedHeader
    InvalidContentLength
    BodyTooLarge
    BodyTruncated
    BodyUnsupported
}

enum ReadError {
    Network(error net.Error)
    Protocol(error ProtocolError)
}

enum DispatchError<E> {
    NotFound
    MethodNotAllowed
    Handler(error E)
}

enum MatchError {
    NotFound
    MethodNotAllowed
}

enum ServeError<E> {
    Network(error net.Error)
    Protocol(error ProtocolError)
    Handler(error E)
}

contract Handler<E> {
    fn Handle(self, $request Request) Result<Response, E>
}

// Wraps one request with reusable mutable state owned by the router.
contract Middleware<E> {
    fn Handle(
        &self,
        $request Request,
        next fn($Request) Result<Response, DispatchError<E>>
    ) Result<Response, DispatchError<E>>
}

// Dispatches one request through a reusable application graph.
contract Application<E> {
    fn Dispatch(&self, $request Request) Result<Response, DispatchError<E>>

    // Converts a handler error into a response or preserves it for the caller.
    fn ErrorResponse(self, $error E) Result<Response, E> {
        .Err(error)
    }
}

struct RouteMatch {
    Id u64
    Params own collections.List<Parameter>
}

struct routePattern {
    id u64
    method Method
    path String
}

struct routeTableSearch {
    found bool
    pathSeen bool
    id u64
    params own collections.List<Parameter>
    rank String
}

// Stores validated route metadata without owning application handlers.
struct RouteTable {
    routes own collections.List<routePattern>

    fn Add(
        &self,
        id u64,
        method Method,
        $path String
    ) Result<void, RegistrationError> {
        if path == "" return .Err(.EmptyPath)
        if !text.StartsWith(path, "/") return .Err(.InvalidPath)
        const valid = validateRoutePath(path) else error {
            return .Err(error)
        }
        discard valid
        const available = tableRegistrationConflict(&self, id, method, path) else error {
            return .Err(error)
        }
        discard available
        self.routes.PushFront(routePattern { id = id method = method path = path })
        .Ok
    }

    fn Match(
        &self,
        method Method,
        path String
    ) Result<RouteMatch, MatchError> {
        const selected = findTableRoute(&self, method, path)
        const routeTableSearch { found pathSeen id params rank } = selected
        discard rank
        if !found {
            discard params
            if pathSeen return .Err(.MethodNotAllowed)
            return .Err(.NotFound)
        }
        .Ok(RouteMatch { Id = id Params = params })
    }
}

struct route<E> {
    method Method
    path String
    handler own Handler<E>
}

struct functionMiddleware<E> implements Middleware<E> {
    handler fn(
        $Request,
        fn($Request) Result<Response, DispatchError<E>>
    ) Result<Response, DispatchError<E>>

    fn Handle(
        &self,
        $request Request,
        next fn($Request) Result<Response, DispatchError<E>>
    ) Result<Response, DispatchError<E>> {
        invokeFunctionMiddleware(self.handler, $request, next)
    }
}

fn invokeFunctionMiddleware<E>(
    handler fn(
        $Request,
        fn($Request) Result<Response, DispatchError<E>>
    ) Result<Response, DispatchError<E>>,
    $request Request,
    next fn($Request) Result<Response, DispatchError<E>>
) Result<Response, DispatchError<E>> {
    handler($request, next)
}

enum middlewareScope {
    Global
    Group
    Route
}

struct routerMiddleware<E> {
    scope middlewareScope
    method Method
    path String
    order i32
    sequence u64
    handler own Middleware<E>
}

struct pathCursor {
    value String
    offset u64
    end u64

    fn HasNext(self) bool {
        self.offset < self.end
    }

    fn Next(&self) String {
        const start = self.offset
        while self.offset < self.end && byteAt(self.value, self.offset) != 47 {
            self.offset = self.offset + 1
        }
        const result = slice(self.value, start, self.offset)
        if self.offset < self.end {
            self.offset = self.offset + 1
        }
        result
    }

    fn Remaining(self) String {
        slice(self.value, self.offset, self.end)
    }
}

struct parameterSpec {
    name String
    constraints String
}

struct parameterNames {
    value String
}

struct pathMatch {
    params own collections.List<Parameter>
    rank String
}

enum componentError {
    Malformed
}

struct decodedComponent {
    valid bool
    value String
}

struct componentCursor {
    value String
    offset u64
    end u64

    fn Next(&self) Result<u64, componentError> {
        if self.offset >= self.end return .Err(.Malformed)
        const value = byteAt(self.value, self.offset)
        if value == 43 {
            self.offset = self.offset + 1
            return .Ok(32)
        }
        if value != 37 {
            self.offset = self.offset + 1
            return .Ok(value)
        }
        if self.offset + 2 >= self.end return .Err(.Malformed)
        const high = hexValue(byteAt(self.value, self.offset + 1))
        const low = hexValue(byteAt(self.value, self.offset + 2))
        if high >= 16 || low >= 16 return .Err(.Malformed)
        self.offset = self.offset + 3
        .Ok(high * 16 + low)
    }
}

struct routeSearch {
    found bool
    pathSeen bool
    pattern String
    params own collections.List<Parameter>
    rank String
}

struct Router<E> implements Application<E> {
    routes own collections.List<own route<E>>
    middleware own collections.List<own routerMiddleware<E>>
    nextMiddlewareSequence u64

    // Registers a unique method and path pair.
    fn Map(
        &self,
        method Method,
        $path String,
        $handler own Handler<E>
    ) Result<void, RegistrationError> {
        if path == "" return .Err(.EmptyPath)
        if !text.StartsWith(path, "/") return .Err(.InvalidPath)
        const valid = validateRoutePath(path) else error {
            return .Err(error)
        }
        discard valid
        const available = registrationConflict(&self, method, path) else error {
            return .Err(error)
        }
        discard available
        self.routes.PushFront(own route<E> {
            method = method
            path = path
            handler = handler
        })
        .Ok
    }

    // Wraps route lookup with one typed middleware function.
    fn Use(
        &self,
        order i32,
        $middleware fn(
            $Request,
            fn($Request) Result<Response, DispatchError<E>>
        ) Result<Response, DispatchError<E>>
    ) Result<void, MiddlewareRegistrationError> {
        registerRouterMiddleware(
            &self,
            .Global,
            .GET,
            "",
            order,
            own functionMiddleware<E> { handler = middleware }
        )
    }

    // Wraps route lookup with one stateful middleware owned by the router.
    fn UseStateful(
        &self,
        order i32,
        $middleware own Middleware<E>
    ) Result<void, MiddlewareRegistrationError> {
        registerRouterMiddleware(
            &self,
            .Global,
            .GET,
            "",
            order,
            $middleware
        )
    }

    // Wraps every mapped route below one static path prefix.
    fn UseGroup(
        &self,
        $prefix String,
        order i32,
        $middleware fn(
            $Request,
            fn($Request) Result<Response, DispatchError<E>>
        ) Result<Response, DispatchError<E>>
    ) Result<void, MiddlewareRegistrationError> {
        if !validMiddlewareGroup(prefix) return .Err(.InvalidGroup)
        if !routerScopeExists(&self, .Group, .GET, prefix) return .Err(.UnknownGroup)
        registerRouterMiddleware(
            &self,
            .Group,
            .GET,
            $prefix,
            order,
            own functionMiddleware<E> { handler = middleware }
        )
    }

    // Wraps every mapped route below one static path prefix with owned state.
    fn UseGroupStateful(
        &self,
        $prefix String,
        order i32,
        $middleware own Middleware<E>
    ) Result<void, MiddlewareRegistrationError> {
        if !validMiddlewareGroup(prefix) return .Err(.InvalidGroup)
        if !routerScopeExists(&self, .Group, .GET, prefix) return .Err(.UnknownGroup)
        registerRouterMiddleware(
            &self,
            .Group,
            .GET,
            $prefix,
            order,
            $middleware
        )
    }

    // Wraps one exact mapped method and route pattern.
    fn UseRoute(
        &self,
        method Method,
        $path String,
        order i32,
        $middleware fn(
            $Request,
            fn($Request) Result<Response, DispatchError<E>>
        ) Result<Response, DispatchError<E>>
    ) Result<void, MiddlewareRegistrationError> {
        if !routerScopeExists(&self, .Route, method, path) return .Err(.UnknownRoute)
        registerRouterMiddleware(
            &self,
            .Route,
            method,
            $path,
            order,
            own functionMiddleware<E> { handler = middleware }
        )
    }

    // Wraps one exact mapped method and route pattern with owned state.
    fn UseRouteStateful(
        &self,
        method Method,
        $path String,
        order i32,
        $middleware own Middleware<E>
    ) Result<void, MiddlewareRegistrationError> {
        if !routerScopeExists(&self, .Route, method, path) return .Err(.UnknownRoute)
        registerRouterMiddleware(
            &self,
            .Route,
            method,
            $path,
            order,
            $middleware
        )
    }

    // Dispatches one owned request and preserves every registered handler.
    fn Dispatch(
        &self,
        $request Request
    ) Result<Response, DispatchError<E>> {
        dispatchGlobalMiddleware(&self, $request)
    }
}

fn dispatchGlobalMiddleware<E>(
    &router Router<E>,
    $request Request
) Result<Response, DispatchError<E>> {
    if router.middleware.IsEmpty() return dispatchMatchedRoute(&router, $request)

    const current = middlewareValue(router.middleware.PopFront())
    const routerMiddleware { scope method path order sequence handler } = current
    if middlewareScopeScore(scope) != 0 {
        router.middleware.PushFront(own routerMiddleware<E> {
            scope = scope
            method = method
            path = path
            order = order
            sequence = sequence
            handler = handler
        })
        return dispatchMatchedRoute(&router, $request)
    }

    var activeHandler = handler
    const handled = activeHandler.Handle(
        $request,
        fn(
            $nextRequest Request
        ) Result<Response, DispatchError<E>> capture(&router) {
            dispatchGlobalMiddleware(&router, $nextRequest)
        }
    )
    router.middleware.PushFront(own routerMiddleware<E> {
        scope = scope
        method = method
        path = path
        order = order
        sequence = sequence
        handler = activeHandler
    })
    handled
}

fn dispatchMatchedRoute<E>(
    &router Router<E>,
    $request Request
) Result<Response, DispatchError<E>> {
    const selected = findRoute(&router, request.Method, request.Path)
    const routeSearch { found pathSeen pattern params rank } = selected
    discard rank
    if !found {
        discard params
        if pathSeen return .Err(.MethodNotAllowed)
        return .Err(.NotFound)
    }
    var activeRequest = request
    const previousParams = replace activeRequest.Params with params
    discard previousParams
    dispatchScopedMiddleware(
        &router,
        activeRequest.Method,
        pattern,
        $activeRequest
    )
}

fn dispatchScopedMiddleware<E>(
    &router Router<E>,
    expectedMethod Method,
    pattern String,
    $request Request
) Result<Response, DispatchError<E>> {
    if router.middleware.IsEmpty() {
        return dispatchRoute(&router, expectedMethod, pattern, $request)
    }

    const current = middlewareValue(router.middleware.PopFront())
    const routerMiddleware { scope method path order sequence handler } = current
    const applies = middlewareApplies(scope, method, path, expectedMethod, pattern)
    const nextPattern = text.Copy(pattern)
    var activeHandler = handler
    const handled = if applies {
        activeHandler.Handle(
            $request,
            fn(
                $nextRequest Request
            ) Result<Response, DispatchError<E>> capture(&router, expectedMethod, $nextPattern) {
                dispatchScopedMiddleware(
                    &router,
                    expectedMethod,
                    nextPattern,
                    $nextRequest
                )
            }
        )
    } else {
        discard nextPattern
        dispatchScopedMiddleware(&router, expectedMethod, pattern, $request)
    }
    router.middleware.PushFront(own routerMiddleware<E> {
        scope = scope
        method = method
        path = path
        order = order
        sequence = sequence
        handler = activeHandler
    })
    handled
}

fn dispatchRoute<E>(
    &router Router<E>,
    expectedMethod Method,
    pattern String,
    $request Request
) Result<Response, DispatchError<E>> {
    var active = replace router.routes with newRouteList<E>()
    var processed = newRouteList<E>()

    while !active.IsEmpty() {
        const current = routeValue(active.PopFront())
        const route { method path handler } = current
        if path == pattern && methodEqual(method, expectedMethod) {
            const handled = handler.Handle($request)
            processed.PushFront(own route<E> {
                method = method
                path = path
                handler = handler
            })
            moveRemainingRoutes(&processed, $active)
            router.routes = reverseRoutes($processed)
            return match handled {
                Ok(response): .Ok(response)
                Err(error): .Err(.Handler(error = error))
            }
        }
        processed.PushFront(own route<E> {
            method = method
            path = path
            handler = handler
        })
    }

    router.routes = reverseRoutes($processed)
    .Err(.NotFound)
}

struct corsPolicy {
    enabled bool
    allowAny bool
    origins String
}

// Owns the transport listener used by Server. TLS listeners implement this
// boundary without duplicating HTTP parsing or dispatch.
contract ServerListener {
    fn Port(self) u64
    fn Close(&self) bool
    fn Accept($self) Task<own ServerAcceptOutcome>
}

// Owns one accepted transport connection before HTTP parsing splits it.
contract ServerConnection {
    fn PeerAddress(self) Result<String, net.Error>
    fn Split($self) Result<own ServerStreamPair, net.Error>
}

// Owns a request stream without exposing a concrete TCP reader to Server.
contract ServerReader {
    fn ReadLine($self, limit u64) Task<own ServerReadLineOutcome>
    fn ReadExact($self, length u64) Task<own ServerReadOutcome>
}

// Owns a response stream without exposing a concrete TCP writer to Server.
contract ServerWriter {
    fn WriteText($self, $value String) Task<own ServerWriteOutcome>
    fn WriteBytes($self, $value own bytes.Bytes) Task<own ServerWriteOutcome>
}

// Keeps the reader and writer sides of one transport connection independent.
struct ServerStreamPair {
    Reader own ServerReader
    Writer own ServerWriter
}

// Restores a reader beside one bounded line result.
struct ServerReadLineOutcome {
    Reader own ServerReader
    Value Result<Option<String>, net.Error>
}

// Restores a reader beside one exact text body result.
struct ServerReadOutcome {
    Reader own ServerReader
    Value Result<String, net.Error>
}

// Restores a writer beside one complete write result.
struct ServerWriteOutcome {
    Writer own ServerWriter
    Value Result<void, net.Error>
}

// Implements the default Server transport using the standard TCP listener.
struct tcpServerListener implements ServerListener {
    listener own net.TcpListener

    fn Port(self) u64 {
        self.listener.Port
    }

    fn Close(&self) bool {
        self.listener.Close()
    }

    fn Accept($self) Task<own ServerAcceptOutcome> {
        spawn acceptTcpServerListener($self)
    }
}

// Implements the default Server connection using the standard TCP connection.
struct tcpServerConnection implements ServerConnection {
    connection own net.TcpConnection

    fn PeerAddress(self) Result<String, net.Error> {
        self.connection.PeerAddress()
    }

    fn Split($self) Result<own ServerStreamPair, net.Error> {
        const tcpServerConnection { connection } = self
        const pair = connection.Split() else error {
            return .Err(error)
        }
        const net.StreamPair { Reader Writer } = pair
        .Ok(own ServerStreamPair {
            Reader = own tcpServerReader { reader = Reader }
            Writer = own tcpServerWriter { writer = Writer }
        })
    }
}

// Adapts the standard TCP reader to the owned Server reader contract.
struct tcpServerReader implements ServerReader {
    reader own net.TcpReader

    fn ReadLine($self, limit u64) Task<own ServerReadLineOutcome> {
        spawn readTcpServerLine($self, limit)
    }

    fn ReadExact($self, length u64) Task<own ServerReadOutcome> {
        spawn readTcpServerExact($self, length)
    }
}

// Adapts the standard TCP writer to the owned Server writer contract.
struct tcpServerWriter implements ServerWriter {
    writer own net.TcpWriter

    fn WriteText($self, $value String) Task<own ServerWriteOutcome> {
        spawn writeTcpServerText($self, $value)
    }

    fn WriteBytes($self, $value own bytes.Bytes) Task<own ServerWriteOutcome> {
        spawn writeTcpServerBytes($self, $value)
    }
}

struct ServerAcceptOutcome {
    Listener own ServerListener
    Value Result<own ServerConnection, net.Error>
}

task acceptTcpServerListener($listener own tcpServerListener) own ServerAcceptOutcome {
    const tcpServerListener { listener as tcpListener } = listener
    const accepting = spawn net.Accept($tcpListener)
    const accepted = $accepting.wait()
    const net.AcceptOutcome { Listener Value } = accepted
    const connection = Value else error {
        return own ServerAcceptOutcome {
            Listener = own tcpServerListener { listener = Listener }
            Value = .Err(error)
        }
    }
    own ServerAcceptOutcome {
        Listener = own tcpServerListener { listener = Listener }
        Value = .Ok(own tcpServerConnection { connection = connection })
    }
}

task readTcpServerLine(
    $reader own tcpServerReader,
    limit u64
) own ServerReadLineOutcome {
    const tcpServerReader { reader as tcpReader } = reader
    const reading = spawn net.ReadLineLimited($tcpReader, limit)
    const outcome = $reading.wait()
    const net.ReadLineOutcome { Reader Value } = outcome
    own ServerReadLineOutcome {
        Reader = own tcpServerReader { reader = Reader }
        Value = Value
    }
}

task readTcpServerExact(
    $reader own tcpServerReader,
    length u64
) own ServerReadOutcome {
    const tcpServerReader { reader as tcpReader } = reader
    const reading = spawn net.ReadExact($tcpReader, length)
    const outcome = $reading.wait()
    const net.ReadOutcome { Reader Value } = outcome
    own ServerReadOutcome {
        Reader = own tcpServerReader { reader = Reader }
        Value = Value
    }
}

task writeTcpServerText(
    $writer own tcpServerWriter,
    $value String
) own ServerWriteOutcome {
    const tcpServerWriter { writer as tcpWriter } = writer
    const writing = spawn net.WriteAll($tcpWriter, $value)
    const outcome = $writing.wait()
    const net.WriteOutcome { Writer Value } = outcome
    own ServerWriteOutcome {
        Writer = own tcpServerWriter { writer = Writer }
        Value = Value
    }
}

task writeTcpServerBytes(
    $writer own tcpServerWriter,
    $value own bytes.Bytes
) own ServerWriteOutcome {
    const tcpServerWriter { writer as tcpWriter } = writer
    const writing = spawn net.WriteAllBytes($tcpWriter, $value)
    const outcome = $writing.wait()
    const net.WriteOutcome { Writer Value } = outcome
    own ServerWriteOutcome {
        Writer = own tcpServerWriter { writer = Writer }
        Value = Value
    }
}

struct Server<E> {
    listener own ServerListener
    router own Application<E>
    cors corsPolicy

    fn Port(self) u64 {
        self.listener.Port()
    }

    // Enables transport-level CORS for the configured origin set.
    fn ConfigureCORS(&self, allowOrigins [String]) void {
        self.cors = corsPolicyFrom(allowOrigins)
    }

    // Closes the listening socket. A pending ServeOne then returns a typed network failure.
    fn Close(&self) bool {
        self.listener.Close()
    }

    // Accepts and serves one HTTP/1.1 request, then returns the reusable server.
    fn ServeOne($self) Task<own ServeOutcome<E>> {
        spawn serveOne<E>($self)
    }

    // Accepts a bounded batch while serving established connections concurrently.
    fn ServeBatch($self, requests u64) Task<own ServeOutcome<E>> {
        const source = concurrent.NewCancellationSource()
        spawn serveConcurrent<E>($self, source.Token(), requests, true)
    }

    // Serves established connections concurrently until cancellation is observed before accept.
    fn ServeUntil(
        $self,
        $cancellation concurrent.Cancellation
    ) Task<Result<own Server<E>, ServeError<E>>> {
        spawn serveUntil<E>($self, $cancellation)
    }
}

struct ServeOutcome<E> {
    Server own Server<E>
    Value Result<void, ServeError<E>>
}

struct ReadOutcome {
    Reader own ServerReader
    Value Result<Request, ReadError>
}

struct ConnectionOutcome<E> {
    Router own Application<E>
    cors corsPolicy
    Value Result<void, ServeError<E>>
}

struct applicationDispatch<E> {
    request Request
    reply Sender<applicationDispatchResult<E>>
}

struct applicationDispatchResult<E> {
    Value Result<Response, DispatchError<E>>
}

struct sharedApplication<E> implements Application<E> {
    sender Sender<applicationDispatch<E>>

    fn Dispatch(
        &self,
        $request Request
    ) Result<Response, DispatchError<E>> {
        const pending = spawn dispatchShared<E>(self.sender.clone(), $request)
        $pending.wait()
    }
}

// Creates an empty router whose handlers share one explicit error type.
fn NewRouter<E>() own Router<E> {
    own Router<E> {
        routes = newRouteList<E>()
        middleware = newMiddlewareList<E>()
        nextMiddlewareSequence = 0
    }
}

// Creates an empty route table for compiler-generated application dispatch.
fn NewRouteTable() own RouteTable {
    own RouteTable { routes = newRoutePatternList() }
}

// Binds an HTTP server. Port zero asks the operating system to choose a port.
fn NewServer<E>(
    $address String,
    port u64,
    $application own Application<E>
) Result<own Server<E>, net.Error> {
    const listener = net.Listen($address, port) else error {
        return .Err(error)
    }
    .Ok(own Server<E> {
        listener = own tcpServerListener { listener = listener }
        router = application
        cors = disabledCORS()
    })
}

task serveUntil<E>(
    $server own Server<E>,
    $cancellation concurrent.Cancellation
) Result<own Server<E>, ServeError<E>> {
    const serving = spawn serveConcurrent<E>($server, $cancellation, 0, false)
    const outcome = $serving.wait()
    const ServeOutcome { Server Value } = outcome
    Value else error {
        discard Server
        return .Err(error)
    }
    .Ok(Server)
}

fn Empty(status i32) Response {
    Response {
        Status = status
        Headers = collections.NewList<HeaderValue>()
        Body = bytes.FromText("")
    }
}

fn Text(status i32, $body String) Response {
    var headers = collections.NewList<HeaderValue>()
    headers.PushFront(HeaderValue {
        Name = "Content-Type"
        Value = "text/plain; charset=utf-8"
    })
    Response { Status = status Headers = headers Body = bytes.FromText(body) }
}

fn Json(status i32, $body String) Response {
    var headers = collections.NewList<HeaderValue>()
    headers.PushFront(HeaderValue {
        Name = "Content-Type"
        Value = "application/json; charset=utf-8"
    })
    Response { Status = status Headers = headers Body = bytes.FromText(body) }
}

// Builds an HTTP response from arbitrary owned bytes without requiring UTF-8.
fn Binary(status i32, $body own bytes.Bytes, contentType String) Response {
    var headers = collections.NewList<HeaderValue>()
    headers.PushFront(HeaderValue {
        Name = "Content-Type"
        Value = text.Copy(contentType)
    })
    Response { Status = status Headers = headers Body = body }
}

task serveConcurrent<E>(
    $server own Server<E>,
    $cancellation concurrent.Cancellation,
    requests u64,
    bounded bool
) own ServeOutcome<E> {
    if bounded && requests == 0 {
        discard cancellation
        return own ServeOutcome<E> { Server = server Value = .Ok }
    }

    const Server { listener router cors } = server
    const capacity u64 = 256
    const Channel { sender receiver } = channel<applicationDispatch<E>>(capacity)
    const application = spawn serveApplication<E>($receiver, $router)
    var connections = worker.NewGroup<bool>(capacity)
    var activeListener = listener
    var accepted u64 = 0
    var failure Option<net.Error> = .None

    while !cancellation.IsRequested() && (!bounded || accepted < requests) {
        if connections.Count() >= 256 {
            const waiting = $connections.Next()
            const completed = $waiting.wait()
            const worker.GroupNext { Group Value } = completed
            connections = Group
            requireConnectionCompletion($Value)
        }
        const accepting = activeListener.Accept()
        const acceptedValue = $accepting.wait()
        const ServerAcceptOutcome { Listener Value } = acceptedValue
        activeListener = Listener
        const connection = Value else error {
            failure = .Some(error)
            break
        }
        const proxy own Application<E> = own sharedApplication<E> {
            sender = sender.clone()
        }
        const handling = spawn handleConcurrentConnection<E>(
            $proxy,
            cloneCORSPolicy(cors),
            $connection
        )
        requireConnectionAdmission(connections.Add($handling))
        accepted += 1
    }

    while connections.Count() > 0 {
        const waiting = $connections.Next()
        const completed = $waiting.wait()
        const worker.GroupNext { Group Value } = completed
        connections = Group
        requireConnectionCompletion($Value)
    }
    connections.Shutdown()
    discard sender
    const restored = $application.wait()
    const active = own Server<E> {
        listener = activeListener
        router = restored
        cors = cors
    }
    match failure {
        None: own ServeOutcome<E> { Server = active Value = .Ok }
        Some(error): own ServeOutcome<E> {
            Server = active
            Value = .Err(.Network(error = error))
        }
    }
}

task serveApplication<E>(
    $receiver Receiver<applicationDispatch<E>>,
    $application own Application<E>
) own Application<E> {
    var inbox = receiver
    var active = application
    while true {
        const received = inbox.receive()
        match received {
            Ok(dispatch): {
                const applicationDispatch { request reply } = dispatch
                const value = dispatchApplication<E>(&active, $request)
                const delivered = reply.send(applicationDispatchResult<E> {
                    Value = value
                })
                match delivered {
                    Ok: {}
                    Err(error): { discard error }
                }
            }
            Err(error): {
                discard error
                break
            }
        }
    }
    active
}

fn dispatchApplication<E>(
    &application Application<E>,
    $request Request
) Result<Response, DispatchError<E>> {
    const dispatched = application.Dispatch($request)
    const response = responseForDispatch(application, $dispatched)
    match response {
        Ok(value): .Ok(value)
        Err(error): .Err(.Handler(error = error))
    }
}

task dispatchShared<E>(
    $sender Sender<applicationDispatch<E>>,
    $request Request
) Result<Response, DispatchError<E>> {
    const Channel { sender as reply receiver } =
        channel<applicationDispatchResult<E>>(0)
    select {
        sender.send(applicationDispatch<E> {
            request = request
            reply = reply
        }): {
            const received = receiver.receive()
            return match received {
                Ok(value): {
                    const applicationDispatchResult { Value } = value
                    Value
                }
                Err(error): sharedDispatchFailed<E>(error)
            }
        }
        else error: return sharedDispatchFailed<E>(error)
    }
}

fn sharedDispatchFailed<E>(error ChannelError) never {
    discard error
    panic("web application dispatcher invariant failed")
}

task handleConcurrentConnection<E>(
    $application own Application<E>,
    $cors corsPolicy,
    $connection own ServerConnection
) bool {
    const handling = spawn handleConnection<E>($application, $cors, $connection)
    const outcome = $handling.wait()
    const ConnectionOutcome { Router cors as completedCORS Value } = outcome
    discard Router
    discard completedCORS
    discard Value
    true
}

fn cloneCORSPolicy(value corsPolicy) corsPolicy {
    corsPolicy {
        enabled = value.enabled
        allowAny = value.allowAny
        origins = text.Copy(value.origins)
    }
}

fn requireConnectionAdmission($value Result<void, worker.GroupError>) void {
    match value {
        Ok: {}
        Err(error): {
            discard error
            panic("web connection admission invariant failed")
        }
    }
}

fn requireConnectionCompletion($value Result<bool, worker.GroupError>) void {
    match value {
        Ok(completed): {
            if !completed {
                panic("web connection completion invariant failed")
            }
        }
        Err(error): {
            discard error
            panic("web connection completion invariant failed")
        }
    }
}

task serveOne<E>($server own Server<E>) own ServeOutcome<E> {
    const Server { listener router cors } = server
    const accepting = listener.Accept()
    const accepted = $accepting.wait()
    const ServerAcceptOutcome { Listener Value } = accepted
    const connection = Value else error {
        return own ServeOutcome<E> {
            Server = own Server<E> {
                listener = Listener
                router = router
                cors = cors
            }
            Value = .Err(.Network(error = error))
        }
    }
    const finishing = spawn finishAccepted<E>($Listener, $router, $cors, $connection)
    const result = $finishing.wait()
    result
}

task finishAccepted<E>(
    $listener own ServerListener,
    $router own Application<E>,
    $cors corsPolicy,
    $connection own ServerConnection
) own ServeOutcome<E> {
    const handling = spawn handleConnection<E>($router, $cors, $connection)
    const handled = $handling.wait()
    const ConnectionOutcome { Router cors as nextCORS Value } = handled
    own ServeOutcome<E> {
        Server = own Server<E> {
            listener = listener
            router = Router
            cors = nextCORS
        }
        Value = Value
    }
}

task handleConnection<E>(
    $router own Application<E>,
    $cors corsPolicy,
    $connection own ServerConnection
) own ConnectionOutcome<E> {
    const remoteAddress = connection.PeerAddress() else error {
        return own ConnectionOutcome<E> {
            Router = router
            cors = cors
            Value = .Err(.Network(error = error))
        }
    }
    const pair = connection.Split() else error {
        return own ConnectionOutcome<E> {
            Router = router
            cors = cors
            Value = .Err(.Network(error = error))
        }
    }
    const ServerStreamPair { Reader Writer } = pair
    const reading = spawn readRequest($Reader)
    const readOutcome = $reading.wait()
    const ReadOutcome { Reader as readerAfter Value as read } = readOutcome
    discard readerAfter
    const request = read else error {
        return finishReadError<E>($router, $cors, $Writer, $error)
    }
    var preparedRequest = request
    preparedRequest.RemoteAddress = remoteAddress
    const dispatching = spawn dispatchRequest<E>(
        $router,
        $cors,
        $Writer,
        $preparedRequest
    )
    const result = $dispatching.wait()
    result
}

fn finishReadError<E>(
    $router own Application<E>,
    $cors corsPolicy,
    $writer own ServerWriter,
    $error ReadError
) own ConnectionOutcome<E> {
    discard writer
    const mapped ServeError<E> = match error {
        Network(error): .Network(error = error)
        Protocol(error): .Protocol(error = error)
    }
    own ConnectionOutcome<E> {
        Router = router
        cors = cors
        Value = .Err(mapped)
    }
}

task dispatchRequest<E>(
    $router own Application<E>,
    $cors corsPolicy,
    $writer own ServerWriter,
    $request Request
) own ConnectionOutcome<E> {
    var activeRouter = router
    var preparedRequest = request
    const id = requestID(&preparedRequest)
    const origin = requestOrigin(&preparedRequest)
    preparedRequest.RequestID = id
    if cors.enabled && methodEqual(preparedRequest.Method, .OPTIONS) {
        var preflight = Empty(204)
        applyTransportHeaders(&preflight, cors, origin, id)
        const preflightWriting = spawn writeResponse<E>(
            $activeRouter,
            $cors,
            $writer,
            $preflight
        )
        const preflightResult = $preflightWriting.wait()
        return preflightResult
    }
    const dispatched = activeRouter.Dispatch($preparedRequest)
    const response = responseForDispatch(activeRouter, $dispatched) else error {
        return finishHandlerError<E>($activeRouter, $cors, $writer, $error)
    }
    var preparedResponse = response
    applyTransportHeaders(&preparedResponse, cors, origin, id)
    const writing = spawn writeResponse<E>($activeRouter, $cors, $writer, $preparedResponse)
    const result = $writing.wait()
    result
}

fn requestID(&request Request) UUID {
    const supplied = request.Header("X-Request-ID")
    match supplied {
        None: UUID.NewV7()
        Some(value): match UUID.Parse(value) {
            Ok(id): if id.IsNil() { UUID.NewV7() } else { id }
            Err(error): invalidRequestID(error)
        }
    }
}

fn invalidRequestID(error UUIDError) UUID {
    discard error
    UUID.NewV7()
}

fn requestOrigin(&request Request) String {
    match request.Header("Origin") {
        None: ""
        Some(origin): origin
    }
}

fn applyTransportHeaders(
    &response Response,
    policy corsPolicy,
    origin String,
    id UUID
) void {
    response.SetHeader("X-Request-ID", id.String())
    if !policy.enabled return
    if policy.allowAny {
        response.SetHeader("Access-Control-Allow-Origin", "*")
    } else {
        const exact = "\n" + origin + "\n"
        if origin != "" && text.Contains(policy.origins, exact) {
            response.SetHeader("Access-Control-Allow-Origin", origin)
            response.AddHeader("Vary", "Origin")
        }
    }
    response.SetHeader(
        "Access-Control-Allow-Methods",
        "GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS"
    )
    response.SetHeader(
        "Access-Control-Allow-Headers",
        "Content-Type, Authorization"
    )
}

fn corsPolicyFrom(allowOrigins [String]) corsPolicy {
    var allowAny = len(allowOrigins) == 0
    var origins = "\n"
    for origin in allowOrigins {
        if origin == "*" {
            allowAny = true
        } else {
            origins = origins + origin + "\n"
        }
    }
    corsPolicy {
        enabled = true
        allowAny = allowAny
        origins = origins
    }
}

fn disabledCORS() corsPolicy {
    corsPolicy { enabled = false allowAny = false origins = "\n" }
}

fn finishHandlerError<E>(
    $router own Application<E>,
    $cors corsPolicy,
    $writer own ServerWriter,
    $error E
) own ConnectionOutcome<E> {
    discard writer
    own ConnectionOutcome<E> {
        Router = router
        cors = cors
        Value = .Err(.Handler(error = error))
    }
}

fn responseForDispatch<E>(
    application Application<E>,
    $value Result<Response, DispatchError<E>>
) Result<Response, E> {
    match value {
        Ok(response): .Ok(response)
        Err(error): match error {
            NotFound: .Ok(Text(404, "not found"))
            MethodNotAllowed: .Ok(Text(405, "method not allowed"))
            Handler(error): application.ErrorResponse($error)
        }
    }
}

task writeResponse<E>(
    $router own Application<E>,
    $cors corsPolicy,
    $writer own ServerWriter,
    $response Response
) own ConnectionOutcome<E> {
    const Response { Status Headers Body } = response
    const serialized = serializeResponseHead(Status, $Headers, Body)
    const writing = writer.WriteText($serialized)
    const headerWritten = $writing.wait()
    const ServerWriteOutcome { Writer as activeWriter Value as headerValue } = headerWritten
    headerValue else error {
        return own ConnectionOutcome<E> {
            Router = router
            cors = cors
            Value = .Err(.Network(error = error))
        }
    }
    const bodyWriting = activeWriter.WriteBytes($Body)
    const bodyWritten = $bodyWriting.wait()
    const ServerWriteOutcome { Writer Value } = bodyWritten
    discard Writer
    const result Result<void, ServeError<E>> = match Value {
        Ok: .Ok
        Err(error): .Err(.Network(error = error))
    }
    own ConnectionOutcome<E> {
        Router = router
        cors = cors
        Value = result
    }
}

task readRequest($reader own ServerReader) ReadOutcome {
    const requestLineLimit u64 = 8192
    const headerLineLimit u64 = 8192
    const headerLimit i32 = 100
    const firstReading = reader.ReadLine(requestLineLimit)
    const firstOutcome = $firstReading.wait()
    const ServerReadLineOutcome { Reader as currentReader Value as first } = firstOutcome
    const firstLine = first else error {
        return ReadOutcome {
            Reader = currentReader
            Value = .Err(.Network(error = error))
        }
    }
    const requestLine = requestLineValue($firstLine) else error {
        return ReadOutcome {
            Reader = currentReader
            Value = .Err(.Protocol(error = error))
        }
    }
    const parsed = parseRequestLine($requestLine) else error {
        return ReadOutcome {
            Reader = currentReader
            Value = .Err(.Protocol(error = error))
        }
    }

    const headers = collections.NewList<HeaderValue>()
    const remainingLimit = headerLimit
    const readingHeaders = spawn readHeaders(
        $currentReader,
        $parsed,
        $headers,
        remainingLimit,
        headerLineLimit
    )
    const result = $readingHeaders.wait()
    result
}

task readHeaders(
    $reader own ServerReader,
    $request Request,
    $headers own collections.List<HeaderValue>,
    remaining i32,
    lineLimit u64
) ReadOutcome {
    const reading = reader.ReadLine(lineLimit)
    const outcome = $reading.wait()
    const ServerReadLineOutcome { Reader Value } = outcome
    const optional = Value else error {
        return ReadOutcome {
            Reader = Reader
            Value = .Err(.Network(error = error))
        }
    }
    const line = requestLineValue($optional) else error {
        return ReadOutcome {
            Reader = Reader
            Value = .Err(.Protocol(error = error))
        }
    }
    const accepting = spawn acceptHeaderLine(
        $Reader,
        $request,
        $headers,
        remaining,
        lineLimit,
        $line
    )
    const result = $accepting.wait()
    result
}

task acceptHeaderLine(
    $reader own ServerReader,
    $request Request,
    $headers own collections.List<HeaderValue>,
    remaining i32,
    lineLimit u64,
    $line String
) ReadOutcome {
    if line == "" {
        var complete = request
        complete.Headers = reverseHeaders($headers)
        if complete.ContentLength == 0 {
            return ReadOutcome { Reader = reader Value = .Ok(complete) }
        }
        const reading = reader.ReadExact(complete.ContentLength)
        const outcome = $reading.wait()
        const ServerReadOutcome { Reader Value } = outcome
        const body = Value else error {
            return bodyReadFailure($Reader, error)
        }
        complete.Body = body
        return ReadOutcome { Reader = Reader Value = .Ok(complete) }
    }
    if remaining <= 0 {
        return ReadOutcome {
            Reader = reader
            Value = .Err(.Protocol(error = .TooManyHeaders))
        }
    }
    const header = parseHeader($line) else error {
        return ReadOutcome {
            Reader = reader
            Value = .Err(.Protocol(error = error))
        }
    }
    var activeRequest = request
    const acceptedHeader = acceptBodyHeader(&activeRequest, $header) else error {
        return ReadOutcome {
            Reader = reader
            Value = .Err(.Protocol(error = error))
        }
    }
    var activeHeaders = headers
    activeHeaders.PushFront($acceptedHeader)
    const reading = spawn readHeaders(
        $reader,
        $activeRequest,
        $activeHeaders,
        remaining - 1,
        lineLimit
    )
    const result = $reading.wait()
    result
}

fn bodyReadFailure($reader own ServerReader, error net.Error) ReadOutcome {
    if netErrorIsClosed(error) {
        return ReadOutcome {
            Reader = reader
            Value = .Err(.Protocol(error = .BodyTruncated))
        }
    }
    ReadOutcome { Reader = reader Value = .Err(.Network(error = error)) }
}

fn netErrorIsClosed(error net.Error) bool {
    match error {
        InvalidAddress: false
        ResolveFailed: false
        Refused: false
        Closed: true
        Cancelled: false
        InvalidUtf8: false
        LineTooLong: false
        AddressInUse: false
        Timeout: false
        InvalidLimit: false
        Io: false
    }
}

fn requestLineValue($value Option<String>) Result<String, ProtocolError> {
    match value {
        None: .Err(.Closed)
        Some(line): .Ok(line)
    }
}

fn requiredOffset(value Option<u64>) Result<u64, ProtocolError> {
    match value {
        None: .Err(.MalformedRequestLine)
        Some(offset): .Ok(offset)
    }
}

fn headerOffset(value Option<u64>) Result<u64, ProtocolError> {
    match value {
        None: .Err(.MalformedHeader)
        Some(offset): .Ok(offset)
    }
}

fn parseRequestLine($line String) Result<Request, ProtocolError> {
    const firstSpace = requiredOffset(text.Find(line, " ")) else error {
        return .Err(error)
    }
    if firstSpace == 0 return .Err(.MalformedRequestLine)
    const afterMethod = slice(line, firstSpace + 1, text.ByteLen(line))
    const relativeSecond = requiredOffset(text.Find(afterMethod, " ")) else error {
        return .Err(error)
    }
    if relativeSecond == 0 return .Err(.MalformedRequestLine)
    const secondSpace = firstSpace + 1 + relativeSecond
    if secondSpace + 1 >= text.ByteLen(line) return .Err(.MalformedRequestLine)

    const methodText = slice(line, 0, firstSpace)
    const target = slice(line, firstSpace + 1, secondSpace)
    const version = slice(line, secondSpace + 1, text.ByteLen(line))
    const method = parseMethod(methodText) else error {
        return .Err(error)
    }
    if version != "HTTP/1.1" return .Err(.UnsupportedVersion)
    if !text.StartsWith(target, "/") return .Err(.MalformedRequestLine)
    const path = pathFromTarget(target)
    .Ok(Request {
        Method = method
        Target = target
        Path = path
        Version = version
        Headers = collections.NewList<HeaderValue>()
        Params = collections.NewList<Parameter>()
    })
}

fn parseMethod(value String) Result<Method, ProtocolError> {
    if value == "GET" return .Ok(.GET)
    if value == "POST" return .Ok(.POST)
    if value == "PUT" return .Ok(.PUT)
    if value == "PATCH" return .Ok(.PATCH)
    if value == "DELETE" return .Ok(.DELETE)
    if value == "HEAD" return .Ok(.HEAD)
    if value == "OPTIONS" return .Ok(.OPTIONS)
    .Err(.UnsupportedMethod)
}

fn pathFromTarget(target String) String {
    match text.Find(target, "?") {
        None: text.Copy(target)
        Some(offset): slice(target, 0, offset)
    }
}

fn queryValue(target String, name String) Option<String> {
    const marker = text.Find(target, "?")
    match marker {
        None: .None
        Some(offset): queryValueAfter(target, name, offset + 1)
    }
}

fn queryValueAfter(target String, name String, startAt u64) Option<String> {
    const length = text.ByteLen(target)
    var start = startAt
    while start <= length {
        var end = start
        while end < length && byteAt(target, end) != 38 {
            end = end + 1
        }
        var separator = start
        while separator < end && byteAt(target, separator) != 61 {
            separator = separator + 1
        }
        const decodedComponent { valid as keyValid value as key } = decodeComponent(
            target,
            start,
            separator
        )
        if keyValid && key == name {
            const valueStart = separator + 1 if separator < end else end
            const decodedComponent { valid value } = decodeComponent(target, valueStart, end)
            if !valid return .None
            return .Some(value)
        }
        if end == length return .None
        start = end + 1
    }
    .None
}

fn decodeComponent(value String, start u64, end u64) decodedComponent {
    var cursor = componentCursor { value = text.Copy(value) offset = start end = end }
    var builder = text.NewBuilder()
    while cursor.offset < cursor.end {
        const codePoint = decodeComponentCodePoint(&cursor) else error {
            discard error
            return decodedComponent { valid = false value = "" }
        }
        const written = builder.WriteCodePoint(codePoint) else error {
            discard error
            return decodedComponent { valid = false value = "" }
        }
        discard written
    }
    const result = builder.Finish() else error {
        discard error
        return decodedComponent { valid = false value = "" }
    }
    decodedComponent { valid = true value = result }
}

fn decodeComponentCodePoint(&cursor componentCursor) Result<u64, componentError> {
    const first = cursor.Next() else error {
        return .Err(error)
    }
    if first < 128 return .Ok(first)

    var remaining i32 = 0
    var codePoint u64 = 0
    var minimum u64 = 0
    if first >= 194 && first <= 223 {
        remaining = 1
        codePoint = first - 192
        minimum = 128
    } else {
        if first >= 224 && first <= 239 {
            remaining = 2
            codePoint = first - 224
            minimum = 2048
        } else {
            if first >= 240 && first <= 244 {
                remaining = 3
                codePoint = first - 240
                minimum = 65536
            } else {
                return .Err(.Malformed)
            }
        }
    }

    while remaining > 0 {
        const next = cursor.Next() else error {
            return .Err(error)
        }
        if next < 128 || next > 191 return .Err(.Malformed)
        codePoint = codePoint * 64 + next - 128
        remaining = remaining - 1
    }
    if codePoint < minimum || codePoint > 1114111 {
        return .Err(.Malformed)
    }
    if codePoint >= 55296 && codePoint <= 57343 {
        return .Err(.Malformed)
    }
    .Ok(codePoint)
}

fn hexValue(value u64) u64 {
    if value >= 48 && value <= 57 return value - 48
    if value >= 65 && value <= 70 return value - 55
    if value >= 97 && value <= 102 return value - 87
    16
}

fn parseHeader($line String) Result<HeaderValue, ProtocolError> {
    const separator = headerOffset(text.Find(line, ":")) else error {
        return .Err(error)
    }
    if separator == 0 return .Err(.MalformedHeader)
    const name = slice(line, 0, separator)
    var start = separator + 1
    const length = text.ByteLen(line)
    while start < length && byteAt(line, start) == 32 {
        start = start + 1
    }
    const value = slice(line, start, length)
    .Ok(HeaderValue { Name = name Value = value })
}

fn bodyHeaderError(header HeaderValue) Option<ProtocolError> {
    if equalFoldAscii(header.Name, "Transfer-Encoding") {
        return .Some(.BodyUnsupported)
    }
    if !equalFoldAscii(header.Name, "Content-Length") return .None
    const length = parse.U64(header.Value) else error {
        discard error
        return .Some(.InvalidContentLength)
    }
    if length > 1048576 return .Some(.BodyTooLarge)
    .None
}

fn acceptBodyHeader(
    &request Request,
    $header HeaderValue
) Result<HeaderValue, ProtocolError> {
    match bodyHeaderError(header) {
        None: acceptBodyLength(&request, $header)
        Some(error): .Err(error)
    }
}

fn acceptBodyLength(
    &request Request,
    $header HeaderValue
) Result<HeaderValue, ProtocolError> {
    if equalFoldAscii(header.Name, "Content-Length") {
        if request.hasContentLength return .Err(.InvalidContentLength)
        const length = parse.U64(header.Value) else error {
            discard error
            return .Err(.InvalidContentLength)
        }
        request.ContentLength = length
        request.hasContentLength = true
    }
    .Ok(header)
}

fn serializeResponseHead(
    status i32,
    $headers own collections.List<HeaderValue>,
    body bytes.Bytes
) String {
    var builder = text.NewBuilder()
    writeText(&builder, "HTTP/1.1 ")
    writeText(&builder, format.I32(status))
    writeText(&builder, " ")
    writeText(&builder, statusText(status))
    writeText(&builder, "\r\n")

    var activeHeaders = headers
    while !activeHeaders.IsEmpty() {
        const header = headerValue(activeHeaders.PopFront())
        if status != 204 || !equalFoldAscii(header.Name, "Content-Length") {
            writeText(&builder, header.Name)
            writeText(&builder, ": ")
            writeText(&builder, header.Value)
            writeText(&builder, "\r\n")
        }
    }
    if status != 204 {
        writeText(&builder, "Content-Length: ")
        writeText(&builder, format.U64(byteLength(body)))
        writeText(&builder, "\r\n")
    }
    writeText(&builder, "Connection: close\r\n\r\n")
    const result = builder.Finish() else error {
        discard error
        panic("HTTP response builder invariant failed")
    }
    result
}

fn byteLength(value bytes.Bytes) u64 {
    const length = value.Len() else error {
        discard error
        panic("HTTP response body is closed")
    }
    length
}

fn statusText(status i32) String {
    if status == 200 return "OK"
    if status == 201 return "Created"
    if status == 202 return "Accepted"
    if status == 204 return "No Content"
    if status == 400 return "Bad Request"
    if status == 401 return "Unauthorized"
    if status == 403 return "Forbidden"
    if status == 404 return "Not Found"
    if status == 405 return "Method Not Allowed"
    if status == 409 return "Conflict"
    if status == 413 return "Content Too Large"
    if status == 415 return "Unsupported Media Type"
    if status == 429 return "Too Many Requests"
    if status == 500 return "Internal Server Error"
    if status == 503 return "Service Unavailable"
    "Status"
}

fn writeText(&builder text.Builder, value String) void {
    const written = builder.Write(value) else error {
        discard error
        panic("HTTP response builder is closed")
    }
    discard written
}

fn slice(value String, start u64, end u64) String {
    const result = text.Slice(value, start, end) else error {
        discard error
        panic("HTTP parser slice invariant failed")
    }
    result
}

fn byteAt(value String, offset u64) u64 {
    const result = text.ByteAt(value, offset) else error {
        discard error
        panic("HTTP parser byte invariant failed")
    }
    result
}

fn equalFoldAscii(left String, right String) bool {
    const length = text.ByteLen(left)
    if length != text.ByteLen(right) return false
    var offset u64 = 0
    while offset < length {
        if lowerAscii(byteAt(left, offset)) != lowerAscii(byteAt(right, offset)) {
            return false
        }
        offset = offset + 1
    }
    true
}

fn jsonContentType($value String) bool {
    const length = text.ByteLen(value)
    var cursor = skipAsciiWhitespace(value, 0)
    const typeStart = cursor
    while cursor < length && mimeTokenByte(byteAt(value, cursor)) {
        cursor = cursor + 1
    }
    if cursor == typeStart || cursor >= length || byteAt(value, cursor) != 47 return false
    cursor = cursor + 1
    const subtypeStart = cursor
    while cursor < length && mimeTokenByte(byteAt(value, cursor)) {
        cursor = cursor + 1
    }
    if cursor == subtypeStart return false
    const mediaEnd = cursor
    cursor = skipAsciiWhitespace(value, cursor)
    const mediaType = slice(value, typeStart, mediaEnd)
    const mediaLength = text.ByteLen(mediaType)
    const jsonSelected = equalFoldAscii(mediaType, "application/json") ||
        mediaLength >= 5 && equalFoldAscii(
        slice(mediaType, mediaLength - 5, mediaLength),
        "+json"
    )
    if !jsonSelected return false
    validMediaParameters(value, cursor)
}

fn asciiWhitespace(value u64) bool {
    value == 32 || value == 9
}

fn skipAsciiWhitespace(value String, offset u64) u64 {
    const length = text.ByteLen(value)
    var cursor = offset
    while cursor < length && asciiWhitespace(byteAt(value, cursor)) {
        cursor = cursor + 1
    }
    cursor
}

fn validMediaParameters(value String, offset u64) bool {
    const length = text.ByteLen(value)
    var cursor = offset
    while cursor < length {
        if byteAt(value, cursor) != 59 return false
        cursor = skipAsciiWhitespace(value, cursor + 1)
        const nameStart = cursor
        while cursor < length && mimeTokenByte(byteAt(value, cursor)) {
            cursor = cursor + 1
        }
        if cursor == nameStart return false
        cursor = skipAsciiWhitespace(value, cursor)
        if cursor >= length || byteAt(value, cursor) != 61 return false
        cursor = skipAsciiWhitespace(value, cursor + 1)
        if cursor >= length return false
        if byteAt(value, cursor) == 34 {
            cursor = quotedMediaValueEnd(value, cursor + 1)
            if cursor == 0 return false
        } else {
            const valueStart = cursor
            while cursor < length && mimeTokenByte(byteAt(value, cursor)) {
                cursor = cursor + 1
            }
            if cursor == valueStart return false
        }
        cursor = skipAsciiWhitespace(value, cursor)
    }
    true
}

fn quotedMediaValueEnd(value String, offset u64) u64 {
    const length = text.ByteLen(value)
    var cursor = offset
    while cursor < length {
        const current = byteAt(value, cursor)
        if current == 34 return cursor + 1
        if current == 92 {
            cursor = cursor + 1
            if cursor >= length return 0
            cursor = cursor + 1
            continue
        }
        if current < 32 || current == 127 return 0
        cursor = cursor + 1
    }
    0
}

fn mimeTokenByte(value u64) bool {
    if value <= 32 || value >= 127 return false
    value != 40 && value != 41 && value != 60 && value != 62 && value != 64 &&
        value != 44 && value != 59 && value != 58 && value != 92 && value != 34 &&
        value != 47 && value != 91 && value != 93 && value != 63 && value != 61 &&
        value != 123 && value != 125
}

fn lowerAscii(value u64) u64 {
    if value >= 65 && value <= 90 return value + 32
    value
}

fn methodEqual(left Method, right Method) bool {
    methodCode(left) == methodCode(right)
}

fn methodCode(method Method) i32 {
    match method {
        GET: 1
        POST: 2
        PUT: 3
        PATCH: 4
        DELETE: 5
        HEAD: 6
        OPTIONS: 7
    }
}

fn middlewareScopeScore(scope middlewareScope) i32 {
    match scope {
        Global: 0
        Group: 1
        Route: 2
    }
}

fn validMiddlewareGroup(prefix String) bool {
    const length = text.ByteLen(prefix)
    if length == 0 || byteAt(prefix, 0) != 47 return false
    if length > 1 && byteAt(prefix, length - 1) == 47 return false
    !text.Contains(prefix, "{") && !text.Contains(prefix, "}") &&
        !text.Contains(prefix, "?") && !text.Contains(prefix, "#")
}

fn routeInMiddlewareGroup(routePath String, prefix String) bool {
    if prefix == "/" return text.StartsWith(routePath, "/")
    if routePath == prefix return true
    const length = text.ByteLen(prefix)
    text.StartsWith(routePath, prefix) && text.ByteLen(routePath) > length &&
        byteAt(routePath, length) == 47
}

fn middlewareApplies(
    scope middlewareScope,
    method Method,
    path String,
    expectedMethod Method,
    pattern String
) bool {
    const score = middlewareScopeScore(scope)
    if score == 1 return routeInMiddlewareGroup(pattern, path)
    if score == 2 return methodEqual(method, expectedMethod) && path == pattern
    false
}

fn newPathCursor(value String) pathCursor {
    const length = text.ByteLen(value)
    var start u64 = 0
    while start < length && byteAt(value, start) == 47 {
        start = start + 1
    }
    var end = length
    while end > start && byteAt(value, end - 1) == 47 {
        end = end - 1
    }
    pathCursor { value = text.Copy(value) offset = start end = end }
}

fn validateRoutePath(path String) Result<bool, RegistrationError> {
    var cursor = newPathCursor(path)
    var names = parameterNames { value = "|" }
    while cursor.HasNext() {
        const segment = cursor.Next()
        const accepted = validateRouteSegment(segment, !cursor.HasNext(), &names) else error {
            discard names
            return .Err(error)
        }
        discard accepted
    }
    discard names
    .Ok(true)
}

fn validateRouteSegment(
    segment String,
    last bool,
    &names parameterNames
) Result<bool, RegistrationError> {
    const hasOpen = text.Contains(segment, "{")
    const hasClose = text.Contains(segment, "}")
    if !hasOpen && !hasClose return .Ok(true)
    if !isParameterSegment(segment) return .Err(.MalformedSegment)

    if isCatchAllSegment(segment) {
        if !last return .Err(.CatchAllNotLast)
        const name = catchAllName(segment)
        if text.Contains(name, ":") return .Err(.UnsupportedConstraint)
        if !validParameterName(name) return .Err(.InvalidParameter)
        if containsName(names, name) return .Err(.DuplicateParameter)
        addName(&names, name)
        return .Ok(true)
    }

    const parameterSpec { name constraints } = parameterSpecFor(segment)
    if !validParameterName(name) return .Err(.InvalidParameter)
    if containsName(names, name) return .Err(.DuplicateParameter)
    const accepted = validateConstraints(constraints) else error {
        return .Err(error)
    }
    discard accepted
    addName(&names, name)
    .Ok(true)
}

fn validateConstraints(value String) Result<bool, RegistrationError> {
    if value == "" return .Ok(true)
    if text.StartsWith(value, "regex(") {
        if !text.EndsWith(value, ")") return .Err(.UnknownConstraint)
        const expression = slice(value, 6, text.ByteLen(value) - 1)
        if !portablePattern.IsValid(expression) return .Err(.UnknownConstraint)
        return .Ok(true)
    }

    const length = text.ByteLen(value)
    var start u64 = 0
    while start <= length {
        var end = start
        while end < length && byteAt(value, end) != 44 {
            end = end + 1
        }
        const constraint = slice(value, start, end)
        if constraint != "int" && constraint != "alpha" {
            return .Err(.UnknownConstraint)
        }
        if end == length return .Ok(true)
        start = end + 1
    }
    .Err(.UnknownConstraint)
}

fn registrationConflict<E>(
    &router Router<E>,
    method Method,
    path String
) Result<bool, RegistrationError> {
    var active = replace router.routes with newRouteList<E>()
    var reversed = newRouteList<E>()
    var result Option<RegistrationError> = .None
    while !active.IsEmpty() {
        const current = routeValue(active.PopFront())
        const route { method as currentMethod path as currentPath handler } = current
        if patternsEquivalent(currentPath, path) && methodEqual(currentMethod, method) {
            result = .Some(.DuplicateRoute)
        } else {
            if patternsAmbiguous(currentPath, path) {
                result = .Some(.AmbiguousRoute)
            }
        }
        reversed.PushFront(own route<E> {
            method = currentMethod
            path = currentPath
            handler = handler
        })
    }
    router.routes = reverseRoutes($reversed)
    match result {
        None: .Ok(true)
        Some(error): .Err(error)
    }
}

fn routerScopeExists<E>(
    &router Router<E>,
    scope middlewareScope,
    method Method,
    path String
) bool {
    var active = replace router.routes with newRouteList<E>()
    var reversed = newRouteList<E>()
    var found = false
    while !active.IsEmpty() {
        const current = routeValue(active.PopFront())
        const route { method as currentMethod path as currentPath handler } = current
        if middlewareScopeScore(scope) == 1 {
            if routeInMiddlewareGroup(currentPath, path) {
                found = true
            }
        } else {
            if currentPath == path && methodEqual(currentMethod, method) {
                found = true
            }
        }
        reversed.PushFront(own route<E> {
            method = currentMethod
            path = currentPath
            handler = handler
        })
    }
    router.routes = reverseRoutes($reversed)
    found
}

fn registerRouterMiddleware<E>(
    &router Router<E>,
    scope middlewareScope,
    method Method,
    $path String,
    order i32,
    $handler own Middleware<E>
) Result<void, MiddlewareRegistrationError> {
    if middlewareOrderExists(&router, scope, method, path, order) {
        return .Err(.DuplicateOrder)
    }
    const middleware = own routerMiddleware<E> {
        scope = scope
        method = method
        path = path
        order = order
        sequence = router.nextMiddlewareSequence
        handler = handler
    }
    router.nextMiddlewareSequence = router.nextMiddlewareSequence + 1
    insertRouterMiddleware(&router, $middleware)
    .Ok
}

fn insertRouterMiddleware<E>(
    &router Router<E>,
    $middleware own routerMiddleware<E>
) void {
    const active = replace router.middleware with newMiddlewareList<E>()
    router.middleware = insertSortedMiddleware($active, $middleware)
}

fn insertSortedMiddleware<E>(
    $values own collections.List<own routerMiddleware<E>>,
    $middleware own routerMiddleware<E>
) own collections.List<own routerMiddleware<E>> {
    var active = values
    if active.IsEmpty() {
        active.PushFront($middleware)
        return active
    }
    const current = middlewareValue(active.PopFront())
    if compareRouterMiddleware(middleware, current) < 0 {
        active.PushFront($current)
        active.PushFront($middleware)
        return active
    }
    const inserted = insertSortedMiddleware($active, $middleware)
    var result = inserted
    result.PushFront($current)
    result
}

fn middlewareOrderExists<E>(
    &router Router<E>,
    scope middlewareScope,
    method Method,
    path String,
    order i32
) bool {
    var active = replace router.middleware with newMiddlewareList<E>()
    var reversed = newMiddlewareList<E>()
    var found = false
    while !active.IsEmpty() {
        const current = middlewareValue(active.PopFront())
        const routerMiddleware {
            scope as currentScope
            method as currentMethod
            path as currentPath
            order as currentOrder
            sequence
            handler
        } = current
        if middlewareScopeScore(currentScope) == middlewareScopeScore(scope) &&
            currentPath == path && methodEqual(currentMethod, method) && currentOrder == order {
            found = true
        }
        reversed.PushFront(own routerMiddleware<E> {
            scope = currentScope
            method = currentMethod
            path = currentPath
            order = currentOrder
            sequence = sequence
            handler = handler
        })
    }
    router.middleware = reverseMiddlewares($reversed)
    found
}

fn compareRouterMiddleware<E>(
    left routerMiddleware<E>,
    right routerMiddleware<E>
) i32 {
    const leftScope = middlewareScopeScore(left.scope)
    const rightScope = middlewareScopeScore(right.scope)
    if leftScope < rightScope return -1
    if leftScope > rightScope return 1
    if leftScope == 1 {
        const leftLength = text.ByteLen(left.path)
        const rightLength = text.ByteLen(right.path)
        if leftLength < rightLength return -1
        if leftLength > rightLength return 1
    }
    const pathOrder = text.Compare(left.path, right.path)
    if pathOrder != 0 return pathOrder
    const leftMethod = methodCode(left.method)
    const rightMethod = methodCode(right.method)
    if leftMethod < rightMethod return -1
    if leftMethod > rightMethod return 1
    if left.order < right.order return -1
    if left.order > right.order return 1
    if left.sequence < right.sequence return -1
    if left.sequence > right.sequence return 1
    0
}

fn tableRegistrationConflict(
    &table RouteTable,
    id u64,
    method Method,
    path String
) Result<bool, RegistrationError> {
    var active = replace table.routes with newRoutePatternList()
    var reversed = newRoutePatternList()
    var result Option<RegistrationError> = .None
    while !active.IsEmpty() {
        const current = routePatternValue(active.PopFront())
        const routePattern {
            id as currentId
            method as currentMethod
            path as currentPath
        } = current
        if currentId == id {
            result = .Some(.DuplicateId)
        } else {
            if patternsEquivalent(currentPath, path) && methodEqual(currentMethod, method) {
                result = .Some(.DuplicateRoute)
            } else {
                if patternsAmbiguous(currentPath, path) {
                    result = .Some(.AmbiguousRoute)
                }
            }
        }
        reversed.PushFront(routePattern {
            id = currentId
            method = currentMethod
            path = currentPath
        })
    }
    table.routes = reverseRoutePatterns($reversed)
    match result {
        None: .Ok(true)
        Some(error): .Err(error)
    }
}

fn patternsEquivalent(left String, right String) bool {
    var leftCursor = newPathCursor(left)
    var rightCursor = newPathCursor(right)
    while leftCursor.HasNext() && rightCursor.HasNext() {
        if leftCursor.Next() != rightCursor.Next() return false
    }
    !leftCursor.HasNext() && !rightCursor.HasNext()
}

fn patternsAmbiguous(left String, right String) bool {
    var leftCursor = newPathCursor(left)
    var rightCursor = newPathCursor(right)
    while leftCursor.HasNext() && rightCursor.HasNext() {
        const leftSegment = leftCursor.Next()
        const rightSegment = rightCursor.Next()
        const leftParameter = isParameterSegment(leftSegment)
        const rightParameter = isParameterSegment(rightSegment)
        if !leftParameter || !rightParameter {
            if leftParameter != rightParameter return false
            if leftSegment != rightSegment return false
            continue
        }

        const leftCatchAll = isCatchAllSegment(leftSegment)
        const rightCatchAll = isCatchAllSegment(rightSegment)
        if leftCatchAll != rightCatchAll return true
        if leftCatchAll {
            if catchAllName(leftSegment) != catchAllName(rightSegment) return true
            continue
        }

        const leftSpec = parameterSpecFor(leftSegment)
        const rightSpec = parameterSpecFor(rightSegment)
        if leftSpec.name != rightSpec.name return true
        if leftSpec.constraints != rightSpec.constraints return true
    }
    false
}

fn findRoute<E>(
    &router Router<E>,
    method Method,
    path String
) routeSearch {
    var active = replace router.routes with newRouteList<E>()
    var reversed = newRouteList<E>()
    var result = routeSearch {
        found = false
        pathSeen = false
        pattern = ""
        params = collections.NewList<Parameter>()
        rank = ""
    }
    while !active.IsEmpty() {
        const current = routeValue(active.PopFront())
        const route { method as currentMethod path as currentPath handler } = current
        const inspected = match matchRoutePattern(currentPath, path) {
            None: false
            Some(matched): acceptPathMatch(&result, currentMethod, method, currentPath, $matched)
        }
        discard inspected
        reversed.PushFront(own route<E> {
            method = currentMethod
            path = currentPath
            handler = handler
        })
    }
    router.routes = reverseRoutes($reversed)
    result
}

fn findTableRoute(
    &table RouteTable,
    method Method,
    path String
) routeTableSearch {
    var active = replace table.routes with newRoutePatternList()
    var reversed = newRoutePatternList()
    var result = routeTableSearch {
        found = false
        pathSeen = false
        id = 0
        params = collections.NewList<Parameter>()
        rank = ""
    }
    while !active.IsEmpty() {
        const current = routePatternValue(active.PopFront())
        const routePattern {
            id as currentId
            method as currentMethod
            path as currentPath
        } = current
        const inspected = match matchRoutePattern(currentPath, path) {
            None: false
            Some(matched): acceptTablePathMatch(
                &result,
                currentId,
                currentMethod,
                method,
                $matched
            )
        }
        discard inspected
        reversed.PushFront(routePattern {
            id = currentId
            method = currentMethod
            path = currentPath
        })
    }
    table.routes = reverseRoutePatterns($reversed)
    result
}

fn acceptTablePathMatch(
    &result routeTableSearch,
    currentId u64,
    currentMethod Method,
    requestedMethod Method,
    $matched own pathMatch
) bool {
    result.pathSeen = true
    const pathMatch { params rank } = matched
    if methodEqual(currentMethod, requestedMethod) &&
        (!result.found || text.Compare(rank, result.rank) > 0) {
        const previous = replace result.params with params
        discard previous
        result.found = true
        result.id = currentId
        result.rank = rank
    } else {
        discard params
    }
    true
}

fn acceptPathMatch(
    &result routeSearch,
    currentMethod Method,
    requestedMethod Method,
    currentPath String,
    $matched own pathMatch
) bool {
    result.pathSeen = true
    const pathMatch { params rank } = matched
    if methodEqual(currentMethod, requestedMethod) &&
        (!result.found || text.Compare(rank, result.rank) > 0) {
        const previous = replace result.params with params
        discard previous
        result.found = true
        result.pattern = text.Copy(currentPath)
        result.rank = rank
    } else {
        discard params
    }
    true
}

fn matchRoutePattern(pattern String, path String) Option<own pathMatch> {
    var patterns = newPathCursor(pattern)
    var values = newPathCursor(path)
    var params = collections.NewList<Parameter>()
    var rank = text.NewBuilder()

    while patterns.HasNext() {
        const segment = patterns.Next()
        if isCatchAllSegment(segment) {
            writeText(&rank, "0")
            params.PushFront(Parameter {
                Name = catchAllName(segment)
                Value = values.Remaining()
            })
            return completePathMatch($params, $rank)
        }
        if !values.HasNext() {
            discard params
            discard rank.Close()
            return .None
        }

        const value = values.Next()
        if isParameterSegment(segment) {
            const parameterSpec { name constraints } = parameterSpecFor(segment)
            if !constraintsMatch(constraints, value) {
                discard params
                discard rank.Close()
                return .None
            }
            writeText(&rank, "1")
            params.PushFront(Parameter { Name = name Value = value })
        } else {
            if segment != value {
                discard params
                discard rank.Close()
                return .None
            }
            writeText(&rank, "2")
        }
    }

    if values.HasNext() {
        discard params
        discard rank.Close()
        return .None
    }
    writeText(&rank, "3")
    completePathMatch($params, $rank)
}

fn completePathMatch(
    $params own collections.List<Parameter>,
    $rank own text.Builder
) Option<own pathMatch> {
    var builder = rank
    const value = builder.Finish() else error {
        discard error
        panic("HTTP route rank builder invariant failed")
    }
    .Some(own pathMatch {
        params = reverseParameters($params)
        rank = value
    })
}

fn constraintsMatch(constraints String, value String) bool {
    if constraints == "" return true
    if text.StartsWith(constraints, "regex(") {
        return constraintMatches(constraints, value)
    }
    const length = text.ByteLen(constraints)
    var start u64 = 0
    while start <= length {
        var end = start
        while end < length && byteAt(constraints, end) != 44 {
            end = end + 1
        }
        if !constraintMatches(slice(constraints, start, end), value) return false
        if end == length return true
        start = end + 1
    }
    false
}

fn constraintMatches(constraint String, value String) bool {
    if constraint == "int" return integerConstraintMatches(value)
    if constraint == "alpha" return alphaConstraintMatches(value)
    if text.StartsWith(constraint, "regex(") && text.EndsWith(constraint, ")") {
        const expression = slice(constraint, 6, text.ByteLen(constraint) - 1)
        return portablePattern.Matches(value, expression)
    }
    false
}

fn integerConstraintMatches(value String) bool {
    if text.StartsWith(value, "+") {
        if text.ByteLen(value) == 1 return false
        return integerParsed(slice(value, 1, text.ByteLen(value)))
    }
    integerParsed(value)
}

fn integerParsed(value String) bool {
    match parse.I64(value) {
        Ok(number): true
        Err(error): false
    }
}

fn alphaConstraintMatches(value String) bool {
    const length = text.ByteLen(value)
    var offset u64 = 0
    while offset < length {
        const byte = byteAt(value, offset)
        if !((byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)) {
            return false
        }
        offset = offset + 1
    }
    true
}

fn isParameterSegment(value String) bool {
    const length = text.ByteLen(value)
    length >= 3 && byteAt(value, 0) == 123 && byteAt(value, length - 1) == 125
}

fn isCatchAllSegment(value String) bool {
    isParameterSegment(value) && text.ByteLen(value) >= 4 && byteAt(value, 1) == 42
}

fn catchAllName(value String) String {
    slice(value, 2, text.ByteLen(value) - 1)
}

fn parameterSpecFor(value String) parameterSpec {
    const inner = slice(value, 1, text.ByteLen(value) - 1)
    match text.Find(inner, ":") {
        None: parameterSpec { name = inner constraints = "" }
        Some(offset): parameterSpec {
            name = slice(inner, 0, offset)
            constraints = slice(inner, offset + 1, text.ByteLen(inner))
        }
    }
}

fn validParameterName(value String) bool {
    const length = text.ByteLen(value)
    if length == 0 return false
    const first = byteAt(value, 0)
    if first != 95 && !asciiLetter(first) return false
    var offset u64 = 1
    while offset < length {
        const byte = byteAt(value, offset)
        if byte != 95 && !asciiLetter(byte) && (byte < 48 || byte > 57) {
            return false
        }
        offset = offset + 1
    }
    true
}

fn asciiLetter(value u64) bool {
    (value >= 65 && value <= 90) || (value >= 97 && value <= 122)
}

fn containsName(names parameterNames, expected String) bool {
    var builder = text.NewBuilder()
    writeText(&builder, "|")
    writeText(&builder, expected)
    writeText(&builder, "|")
    const needle = builder.Finish() else error {
        discard error
        panic("HTTP route name builder invariant failed")
    }
    text.Contains(names.value, needle)
}

fn addName(&names parameterNames, name String) void {
    var builder = text.NewBuilder()
    writeText(&builder, names.value)
    writeText(&builder, name)
    writeText(&builder, "|")
    const value = builder.Finish() else error {
        discard error
        panic("HTTP route names builder invariant failed")
    }
    names.value = value
}

fn moveRemainingRoutes<E>(
    &target collections.List<own route<E>>,
    $source own collections.List<own route<E>>
) void {
    var remaining = source
    while !remaining.IsEmpty() {
        target.PushFront(routeValue(remaining.PopFront()))
    }
}

fn reverseRoutes<E>(
    $values own collections.List<own route<E>>
) own collections.List<own route<E>> {
    var source = values
    var result = newRouteList<E>()
    while !source.IsEmpty() {
        result.PushFront(routeValue(source.PopFront()))
    }
    result
}

fn reverseMiddlewares<E>(
    $values own collections.List<own routerMiddleware<E>>
) own collections.List<own routerMiddleware<E>> {
    var source = values
    var result = newMiddlewareList<E>()
    while !source.IsEmpty() {
        result.PushFront(middlewareValue(source.PopFront()))
    }
    result
}

fn reverseRoutePatterns(
    $values own collections.List<routePattern>
) own collections.List<routePattern> {
    var source = values
    var result = newRoutePatternList()
    while !source.IsEmpty() {
        result.PushFront(routePatternValue(source.PopFront()))
    }
    result
}

fn reverseHeaders(
    $values own collections.List<HeaderValue>
) own collections.List<HeaderValue> {
    var source = values
    var result = collections.NewList<HeaderValue>()
    while !source.IsEmpty() {
        result.PushFront(headerValue(source.PopFront()))
    }
    result
}

fn reverseParameters(
    $values own collections.List<Parameter>
) own collections.List<Parameter> {
    var source = values
    var result = collections.NewList<Parameter>()
    while !source.IsEmpty() {
        result.PushFront(parameterValue(source.PopFront()))
    }
    result
}

fn newRouteList<E>() own collections.List<own route<E>> {
    collections.NewList<own route<E>>()
}

fn newMiddlewareList<E>() own collections.List<own routerMiddleware<E>> {
    collections.NewList<own routerMiddleware<E>>()
}

fn newRoutePatternList() own collections.List<routePattern> {
    collections.NewList<routePattern>()
}

fn routeValue<E>($value Option<own route<E>>) own route<E> {
    match value {
        None: missingRoute<E>()
        Some(current): current
    }
}

fn middlewareValue<E>(
    $value Option<own routerMiddleware<E>>
) own routerMiddleware<E> {
    match value {
        None: missingMiddleware<E>()
        Some(current): current
    }
}

fn routePatternValue($value Option<routePattern>) routePattern {
    match value {
        None: missingRoutePattern()
        Some(current): current
    }
}

fn missingRoute<E>() own route<E> {
    panic("HTTP router entry invariant failed")
}

fn missingMiddleware<E>() own routerMiddleware<E> {
    panic("HTTP middleware entry invariant failed")
}

fn missingRoutePattern() routePattern {
    panic("HTTP route table entry invariant failed")
}

fn headerValue($value Option<HeaderValue>) HeaderValue {
    match value {
        None: missingHeader()
        Some(header): header
    }
}

fn parameterValue($value Option<Parameter>) Parameter {
    match value {
        None: missingParameter()
        Some(parameter): parameter
    }
}

fn missingParameter() Parameter {
    panic("HTTP parameter invariant failed")
}

fn missingHeader() HeaderValue {
    panic("HTTP header invariant failed")
}
