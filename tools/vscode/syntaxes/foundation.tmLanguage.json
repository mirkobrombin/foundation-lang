{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Foundation",
    "scopeName": "source.foundation",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#structDefinitions" },
        { "include": "#enumDefinitions" },
        { "include": "#functionDefinitions" },
        { "include": "#bindings" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#builtins" },
        { "include": "#structLiterals" },
        { "include": "#enumConstructors" },
        { "include": "#fieldAccess" },
        { "include": "#functionCalls" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#punctuation" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.foundation",
                    "begin": "//",
                    "end": "$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.foundation",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.foundation",
                            "match": "\\\\[nrt\"\\\\]"
                        },
                        {
                            "name": "invalid.illegal.escape.foundation",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "structDefinitions": {
            "patterns": [
                {
                    "name": "meta.struct.definition.foundation",
                    "begin": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
                    "beginCaptures": {
                        "1": { "name": "keyword.declaration.struct.foundation" },
                        "2": { "name": "entity.name.type.struct.foundation" },
                        "3": { "name": "punctuation.section.block.begin.foundation" }
                    },
                    "end": "\\}",
                    "endCaptures": {
                        "0": { "name": "punctuation.section.block.end.foundation" }
                    },
                    "patterns": [
                        {
                            "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*)",
                            "captures": {
                                "1": { "name": "variable.other.member.foundation" },
                                "2": { "name": "punctuation.separator.foundation" },
                                "3": { "name": "entity.name.type.foundation" }
                            }
                        }
                    ]
                }
            ]
        },
        "enumDefinitions": {
            "patterns": [
                {
                    "name": "meta.enum.definition.foundation",
                    "begin": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
                    "beginCaptures": {
                        "1": { "name": "keyword.declaration.enum.foundation" },
                        "2": { "name": "entity.name.type.enum.foundation" },
                        "3": { "name": "punctuation.section.block.begin.foundation" }
                    },
                    "end": "\\}",
                    "endCaptures": {
                        "0": { "name": "punctuation.section.block.end.foundation" }
                    },
                    "patterns": [
                        {
                            "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(\\()\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(\\)))?",
                            "captures": {
                                "1": { "name": "variable.other.enummember.foundation" },
                                "2": { "name": "punctuation.section.parens.begin.foundation" },
                                "3": { "name": "variable.parameter.foundation" },
                                "4": { "name": "punctuation.separator.foundation" },
                                "5": { "name": "entity.name.type.foundation" },
                                "6": { "name": "punctuation.section.parens.end.foundation" }
                            }
                        }
                    ]
                }
            ]
        },
        "functionDefinitions": {
            "patterns": [
                {
                    "name": "meta.function.definition.foundation",
                    "begin": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
                    "beginCaptures": {
                        "1": { "name": "keyword.declaration.function.foundation" },
                        "2": { "name": "entity.name.function.foundation" },
                        "3": { "name": "punctuation.section.parens.begin.foundation" }
                    },
                    "end": "\\)",
                    "endCaptures": {
                        "0": { "name": "punctuation.section.parens.end.foundation" }
                    },
                    "patterns": [
                        {
                            "name": "variable.parameter.foundation",
                            "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*:)"
                        },
                        {
                            "name": "entity.name.type.foundation",
                            "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
                        },
                        { "include": "#types" },
                        { "include": "#punctuation" }
                    ]
                }
            ]
        },
        "bindings": {
            "patterns": [
                {
                    "match": "\\b(let|var)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*))?",
                    "captures": {
                        "1": { "name": "storage.type.foundation" },
                        "2": { "name": "variable.other.readwrite.foundation" },
                        "3": { "name": "punctuation.separator.foundation" },
                        "4": { "name": "entity.name.type.foundation" }
                    }
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.foundation",
                    "match": "\\b(return|if|else|while|match)\\b"
                },
                {
                    "name": "constant.language.boolean.foundation",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "support.type.foundation",
                    "match": "\\b(i32|bool|String|void)\\b"
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "name": "support.function.builtin.foundation",
                    "match": "\\b(print)\\b"
                }
            ]
        },
        "structLiterals": {
            "patterns": [
                {
                    "name": "entity.name.type.struct.foundation",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\{\\s*[A-Za-z_][A-Za-z0-9_]*\\s*:)"
                },
                {
                    "name": "variable.other.member.foundation",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*:)"
                },
                {
                    "match": "(->)\\s*([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.operator.foundation" },
                        "2": { "name": "entity.name.type.foundation" }
                    }
                }
            ]
        },
        "enumConstructors": {
            "patterns": [
                {
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(::)([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "entity.name.type.enum.foundation" },
                        "2": { "name": "punctuation.accessor.foundation" },
                        "3": { "name": "variable.other.enummember.foundation" }
                    }
                }
            ]
        },
        "fieldAccess": {
            "patterns": [
                {
                    "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "punctuation.accessor.foundation" },
                        "2": { "name": "variable.other.member.foundation" }
                    }
                }
            ]
        },
        "functionCalls": {
            "patterns": [
                {
                    "name": "entity.name.function.call.foundation",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\()"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.integer.foundation",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.foundation",
                    "match": "=>|->|::|==|!=|<=|>=|&&|\\|\\||[=+\\-*/%!<>]"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.separator.foundation",
                    "match": "[,;:]"
                },
                {
                    "name": "punctuation.section.foundation",
                    "match": "[(){}]"
                }
            ]
        }
    }
}
