{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Foundation",
    "scopeName": "source.foundation",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#packageDeclarations" },
        { "include": "#cAbiDeclarations" },
        { "include": "#contractDefinitions" },
        { "include": "#structDefinitions" },
        { "include": "#enumDefinitions" },
        { "include": "#functionDefinitions" },
        { "include": "#functionTypes" },
        { "include": "#captureClauses" },
        { "include": "#structPatterns" },
        { "include": "#bindings" },
        { "include": "#ownership" },
        { "include": "#keywords" },
        { "include": "#builtins" },
        { "include": "#structLiterals" },
        { "include": "#qualifiedFunctionCalls" },
        { "include": "#qualifiedTypes" },
        { "include": "#enumConstructors" },
        { "include": "#matchPatterns" },
        { "include": "#typePositions" },
        { "include": "#genericFunctionApplications" },
        { "include": "#genericTypeApplications" },
        { "include": "#languageVariables" },
        { "include": "#methodCalls" },
        { "include": "#fieldAccess" },
        { "include": "#functionCalls" },
        { "include": "#types" },
        { "include": "#typeParameters" },
        { "include": "#nominalTypes" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#punctuation" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.foundation",
                    "begin": "//",
                    "end": "$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.foundation",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.foundation",
                            "match": "\\\\[0nrt\"\\\\]"
                        },
                        {
                            "name": "invalid.illegal.escape.foundation",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "blocks": {
            "patterns": [
                {
                    "name": "meta.block.foundation",
                    "begin": "\\{",
                    "beginCaptures": {
                        "0": { "name": "punctuation.section.block.begin.foundation" }
                    },
                    "end": "\\}",
                    "endCaptures": {
                        "0": { "name": "punctuation.section.block.end.foundation" }
                    },
                    "patterns": [
                        { "include": "$self" }
                    ]
                }
            ]
        },
        "packageDeclarations": {
            "patterns": [
                {
                    "match": "\\b(package)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
                    "captures": {
                        "1": { "name": "keyword.declaration.module.foundation" },
                        "2": { "name": "entity.name.namespace.foundation" }
                    }
                },
                {
                    "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)(?:\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
                    "captures": {
                        "1": { "name": "keyword.declaration.module.foundation" },
                        "2": { "name": "entity.name.namespace.foundation" },
                        "3": { "name": "keyword.control.import.as.foundation" },
                        "4": { "name": "variable.other.alias.foundation" }
                    }
                }
            ]
        },
        "structDefinitions": {
            "patterns": [
                {
                    "name": "meta.struct.definition.foundation",
                    "begin": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(<)\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*)\\s*(>))?(?:\\s+(implements)\\s+([^\\{]+?))?\\s*(\\{)",
                    "beginCaptures": {
                        "1": { "name": "keyword.declaration.struct.foundation" },
                        "2": { "name": "entity.name.type.struct.foundation" },
                        "3": { "name": "punctuation.definition.type-parameters.begin.foundation" },
                        "4": { "name": "entity.name.type.parameter.foundation" },
                        "5": { "name": "punctuation.definition.type-parameters.end.foundation" },
                        "6": { "name": "keyword.declaration.implementation.foundation" },
                        "7": { "name": "entity.other.inherited-class.foundation" },
                        "8": { "name": "punctuation.section.block.begin.foundation" }
                    },
                    "end": "\\}",
                    "endCaptures": {
                        "0": { "name": "punctuation.section.block.end.foundation" }
                    },
                    "patterns": [
                        { "include": "#functionDefinitions" },
                        { "include": "#blocks" },
                        {
                            "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s+[A-Za-z_][A-Za-z0-9_]*(?:\\s*<[^>{}\\n]+>)?\\s*$)",
                            "captures": {
                                "1": { "name": "variable.other.member.foundation" }
                            }
                        },
                        { "include": "#genericTypeApplications" },
                        { "include": "#ownership" },
                        { "include": "#types" },
                        { "include": "#typeParameters" },
                        { "include": "#nominalTypes" },
                        { "include": "#operators" },
                        { "include": "#punctuation" }
                    ]
                }
            ]
        },
        "cAbiDeclarations": {
            "patterns": [
                {
                    "name": "meta.function.external.foundation",
                    "begin": "\\b(extern)\\s+(c)(?=\\s+fn\\b)",
                    "beginCaptures": {
                        "1": { "name": "storage.modifier.extern.foundation" },
                        "2": { "name": "constant.language.abi.foundation" }
                    },
                    "end": "$",
                    "patterns": [
                        { "include": "#functionDefinitions" },
                        {
                            "match": "\\b(as)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                            "captures": {
                                "1": { "name": "keyword.control.import.as.foundation" },
                                "2": { "name": "entity.name.function.external.foundation" }
                            }
                        },
                        { "include": "#genericTypeApplications" },
                        { "include": "#ownership" },
                        { "include": "#types" },
                        { "include": "#typeParameters" },
                        { "include": "#nominalTypes" },
                        { "include": "#keywords" },
                        { "include": "#punctuation" }
                    ]
                }
            ]
        },
        "contractDefinitions": {
            "patterns": [
                {
                    "name": "meta.contract.definition.foundation",
                    "begin": "\\b(contract)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(<)\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*)\\s*(>))?\\s*(\\{)",
                    "beginCaptures": {
                        "1": { "name": "keyword.declaration.contract.foundation" },
                        "2": { "name": "entity.name.type.interface.foundation" },
                        "3": { "name": "punctuation.definition.type-parameters.begin.foundation" },
                        "4": { "name": "entity.name.type.parameter.foundation" },
                        "5": { "name": "punctuation.definition.type-parameters.end.foundation" },
                        "6": { "name": "punctuation.section.block.begin.foundation" }
                    },
                    "end": "\\}",
                    "endCaptures": {
                        "0": { "name": "punctuation.section.block.end.foundation" }
                    },
                    "patterns": [
                        { "include": "#functionDefinitions" },
                        { "include": "#genericTypeApplications" },
                        { "include": "#ownership" },
                        { "include": "#types" },
                        { "include": "#typeParameters" },
                        { "include": "#nominalTypes" },
                        { "include": "#punctuation" }
                    ]
                }
            ]
        },
        "enumDefinitions": {
            "patterns": [
                {
                    "name": "meta.enum.definition.foundation",
                    "begin": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(<)\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*)\\s*(>))?\\s*(\\{)",
                    "beginCaptures": {
                        "1": { "name": "keyword.declaration.enum.foundation" },
                        "2": { "name": "entity.name.type.enum.foundation" },
                        "3": { "name": "punctuation.definition.type-parameters.begin.foundation" },
                        "4": { "name": "entity.name.type.parameter.foundation" },
                        "5": { "name": "punctuation.definition.type-parameters.end.foundation" },
                        "6": { "name": "punctuation.section.block.begin.foundation" }
                    },
                    "end": "\\}",
                    "endCaptures": {
                        "0": { "name": "punctuation.section.block.end.foundation" }
                    },
                    "patterns": [
                        {
                            "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)",
                            "captures": {
                                "1": { "name": "variable.other.enummember.foundation" }
                            }
                        },
                        {
                            "match": "(?<=\\()\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\s*<[^(){}\\n]+>)?)\\s*(?=\\))",
                            "captures": {
                                "1": { "name": "entity.name.type.foundation" }
                            }
                        },
                        { "include": "#genericTypeApplications" },
                        { "include": "#ownership" },
                        { "include": "#types" },
                        { "include": "#typeParameters" },
                        { "include": "#nominalTypes" },
                        { "include": "#operators" },
                        { "include": "#punctuation" }
                    ]
                }
            ]
        },
        "functionDefinitions": {
            "patterns": [
                {
                    "name": "meta.function.definition.foundation",
                    "begin": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(<)\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*)\\s*(>))?\\s*(\\()",
                    "beginCaptures": {
                        "1": { "name": "keyword.declaration.function.foundation" },
                        "2": { "name": "entity.name.function.foundation" },
                        "3": { "name": "punctuation.definition.type-parameters.begin.foundation" },
                        "4": { "name": "entity.name.type.parameter.foundation" },
                        "5": { "name": "punctuation.definition.type-parameters.end.foundation" },
                        "6": { "name": "punctuation.section.parens.begin.foundation" }
                    },
                    "end": "\\)",
                    "endCaptures": {
                        "0": { "name": "punctuation.section.parens.end.foundation" }
                    },
                    "patterns": [
                        {
                            "name": "variable.parameter.foundation",
                            "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s+(?:(?:own|view|edit)\\s+)?(?:\\[[^,()\\n]+\\](?:[A-Za-z_][A-Za-z0-9_]*)?|[A-Za-z_][A-Za-z0-9_]*(?:\\s*<[^(){}\\n]+>)?)\\s*(?:,|\\)))"
                        },
                        { "include": "#genericTypeApplications" },
                        { "include": "#ownership" },
                        { "include": "#types" },
                        { "include": "#typeParameters" },
                        { "include": "#nominalTypes" },
                        { "include": "#punctuation" }
                    ]
                }
            ]
        },
        "functionTypes": {
            "patterns": [
                {
                    "name": "meta.type.function.foundation",
                    "begin": "\\b(fn)\\s*(\\()",
                    "beginCaptures": {
                        "1": { "name": "keyword.declaration.function.foundation" },
                        "2": { "name": "punctuation.section.parens.begin.foundation" }
                    },
                    "end": "\\)",
                    "endCaptures": {
                        "0": { "name": "punctuation.section.parens.end.foundation" }
                    },
                    "patterns": [
                        {
                            "name": "variable.parameter.foundation",
                            "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s+(?:(?:own|view|edit)\\s+)?(?:fn\\s*\\(|\\[[^,()\\n]+\\]|[A-Za-z_][A-Za-z0-9_]*(?:\\s*<[^(){}\\n]+>)?)\\s*(?:,|\\)))"
                        },
                        { "include": "#functionTypes" },
                        { "include": "#genericTypeApplications" },
                        { "include": "#ownership" },
                        { "include": "#types" },
                        { "include": "#typeParameters" },
                        { "include": "#nominalTypes" },
                        { "include": "#punctuation" }
                    ]
                }
            ]
        },
        "captureClauses": {
            "patterns": [
                {
                    "name": "meta.function.captures.foundation",
                    "begin": "\\b(capture)\\b",
                    "beginCaptures": {
                        "1": { "name": "keyword.control.capture.foundation" }
                    },
                    "end": "(?=\\{)",
                    "patterns": [
                        { "include": "#ownership" },
                        {
                            "name": "variable.other.capture.foundation",
                            "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
                        },
                        { "include": "#punctuation" }
                    ]
                }
            ]
        },
        "bindings": {
            "patterns": [
                {
                    "match": "\\b(let|var)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "storage.type.foundation" },
                        "2": { "name": "variable.other.readwrite.foundation" }
                    }
                },
                {
                    "match": "\\belse\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\{)",
                    "captures": {
                        "1": { "name": "variable.other.readwrite.foundation" }
                    }
                }
            ]
        },
        "structPatterns": {
            "patterns": [
                {
                    "name": "meta.struct.pattern.foundation",
                    "begin": "\\b(let)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\s*(\\{)",
                    "beginCaptures": {
                        "1": { "name": "storage.type.foundation" },
                        "2": { "name": "entity.name.type.struct.foundation" },
                        "3": { "name": "punctuation.section.block.begin.foundation" }
                    },
                    "end": "\\}",
                    "endCaptures": {
                        "0": { "name": "punctuation.section.block.end.foundation" }
                    },
                    "patterns": [
                        {
                            "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
                            "captures": {
                                "1": { "name": "variable.other.member.foundation" },
                                "2": { "name": "keyword.control.pattern.as.foundation" },
                                "3": { "name": "variable.other.readwrite.foundation" }
                            }
                        }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.declaration.foundation",
                    "match": "\\b(extern|struct|enum|contract|implements|fn)\\b"
                },
                {
                    "name": "keyword.declaration.module.foundation",
                    "match": "\\b(package|import|as)\\b"
                },
                {
                    "name": "keyword.control.foundation",
                    "match": "\\b(return|discard|if|else|while|match|capture|replace|with)\\b"
                },
                {
                    "name": "constant.language.boolean.foundation",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "ownership": {
            "patterns": [
                {
                    "name": "storage.modifier.ownership.foundation",
                    "match": "\\b(own|view|edit)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "support.type.foundation",
                    "match": "\\b(i32|bool|String|void|Option|Result)\\b"
                }
            ]
        },
        "nominalTypes": {
            "patterns": [
                {
                    "name": "entity.name.type.foundation",
                    "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
                }
            ]
        },
        "typeParameters": {
            "patterns": [
                {
                    "name": "entity.name.type.parameter.foundation",
                    "match": "\\b[A-Z]\\b"
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "name": "support.function.builtin.foundation",
                    "match": "\\b(print|panic)\\b"
                }
            ]
        },
        "structLiterals": {
            "patterns": [
                {
                    "name": "entity.name.type.struct.foundation",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\{\\s*(?:\\}|[A-Za-z_][A-Za-z0-9_]*\\s*=))"
                },
                {
                    "name": "variable.other.member.foundation",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*=)"
                }
            ]
        },
        "enumConstructors": {
            "patterns": [
                {
                    "match": "\\b([A-Z][A-Za-z0-9_]*)(\\.)([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "entity.name.type.enum.foundation" },
                        "2": { "name": "punctuation.accessor.foundation" },
                        "3": { "name": "variable.other.enummember.foundation" }
                    }
                },
                {
                    "match": "(?<![A-Za-z0-9_])(\\.)([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "punctuation.accessor.foundation" },
                        "2": { "name": "variable.other.enummember.foundation" }
                    }
                }
            ]
        },
        "qualifiedFunctionCalls": {
            "patterns": [
                {
                    "match": "\\b([a-z_][A-Za-z0-9_]*)(\\.)([A-Z][A-Za-z0-9_]*)(?=\\s*(?:<[^;{}()]*>)?\\s*\\()",
                    "captures": {
                        "1": { "name": "entity.name.namespace.foundation" },
                        "2": { "name": "punctuation.accessor.foundation" },
                        "3": { "name": "entity.name.function.call.foundation" }
                    }
                }
            ]
        },
        "qualifiedTypes": {
            "patterns": [
                {
                    "match": "\\b([a-z_][A-Za-z0-9_]*)(\\.)([A-Z][A-Za-z0-9_]*)(?=\\s*(?:<[^;{}()]*>)?\\s*(?:\\{|\\.))",
                    "captures": {
                        "1": { "name": "entity.name.namespace.foundation" },
                        "2": { "name": "punctuation.accessor.foundation" },
                        "3": { "name": "entity.name.type.foundation" }
                    }
                }
            ]
        },
        "genericTypeApplications": {
            "patterns": [
                {
                    "name": "meta.type.application.foundation",
                    "begin": "\\b([A-Z][A-Za-z0-9_]*|i32|bool|String|void)\\s*(<)",
                    "beginCaptures": {
                        "1": { "name": "entity.name.type.foundation" },
                        "2": { "name": "punctuation.definition.type-arguments.begin.foundation" }
                    },
                    "end": ">",
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.type-arguments.end.foundation" }
                    },
                    "patterns": [
                        { "include": "#genericTypeApplications" },
                        { "include": "#ownership" },
                        { "include": "#types" },
                        { "include": "#typeParameters" },
                        { "include": "#nominalTypes" },
                        { "include": "#punctuation" }
                    ]
                }
            ]
        },
        "genericFunctionApplications": {
            "patterns": [
                {
                    "name": "meta.function.specialization.foundation",
                    "begin": "\\b([a-z_][A-Za-z0-9_]*)\\s*(<)(?=[^\\n{};]*>\\s*(?:\\(|\\.|\\{|,|\\)|\\]|\\}|$))",
                    "beginCaptures": {
                        "1": { "name": "entity.name.function.call.foundation" },
                        "2": { "name": "punctuation.definition.type-arguments.begin.foundation" }
                    },
                    "end": ">(?=\\s*(?:\\(|\\.|\\{|,|\\)|\\]|\\}|$))",
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.type-arguments.end.foundation" }
                    },
                    "patterns": [
                        { "include": "#genericTypeApplications" },
                        { "include": "#ownership" },
                        { "include": "#functionTypes" },
                        { "include": "#types" },
                        { "include": "#typeParameters" },
                        { "include": "#nominalTypes" },
                        { "include": "#punctuation" }
                    ]
                }
            ]
        },
        "matchPatterns": {
            "patterns": [
                {
                    "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(\\()\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(\\)))?\\s*(:)",
                    "captures": {
                        "1": { "name": "variable.other.enummember.foundation" },
                        "2": { "name": "punctuation.section.parens.begin.foundation" },
                        "3": { "name": "variable.parameter.foundation" },
                        "4": { "name": "punctuation.section.parens.end.foundation" },
                        "5": { "name": "punctuation.separator.foundation" }
                    }
                }
            ]
        },
        "languageVariables": {
            "patterns": [
                {
                    "name": "variable.language.self.foundation",
                    "match": "\\bself\\b"
                }
            ]
        },
        "methodCalls": {
            "patterns": [
                {
                    "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
                    "captures": {
                        "1": { "name": "punctuation.accessor.foundation" },
                        "2": { "name": "entity.name.function.call.method.foundation" }
                    }
                }
            ]
        },
        "typePositions": {
            "patterns": [
                {
                    "match": "\\b(?:let|var)\\s+[A-Za-z_][A-Za-z0-9_]*\\s+((?:(?:own|view|edit)\\s+)?[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[^={};\\n]+>)?)\\s*(?==)",
                    "captures": {
                        "1": { "name": "entity.name.type.foundation" }
                    }
                },
                {
                    "match": "(?<=\\))\\s*((?:(?:own|view|edit)\\s+)?[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[^(){};\\n]+>)?)\\s*(?=\\{|as\\b)",
                    "captures": {
                        "1": { "name": "entity.name.type.foundation" }
                    }
                }
            ]
        },
        "fieldAccess": {
            "patterns": [
                {
                    "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "punctuation.accessor.foundation" },
                        "2": { "name": "variable.other.member.foundation" }
                    }
                }
            ]
        },
        "functionCalls": {
            "patterns": [
                {
                    "name": "entity.name.function.call.foundation",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*(?:<[^;{}()]*>)?\\s*\\()"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.integer.foundation",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.foundation",
                    "match": "==|!=|<=|>=|&&|\\|\\||[=+\\-*/%!<>]"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.separator.foundation",
                    "match": "[,:]"
                },
                {
                    "name": "punctuation.section.foundation",
                    "match": "[(){}\\[\\]]"
                }
            ]
        }
    }
}
