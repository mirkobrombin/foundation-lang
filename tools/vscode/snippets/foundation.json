            "const ${1:background} = worker.NewSupervisor()",
            "${1:background}.Start(spawn ${2:work}(${3}))",
            "${1:background}.Shutdown()"
        ],
        "description": "Detach Task<void> under an explicit join policy"
    },
    "Parallel task pool": {
        "prefix": "workerpool",
        "body": [
            "const ${1:pool} = worker.NewPool(${2:4})",
            "${1:pool}.Start(spawn ${3:work}(${4}))",
            "${1:pool}.Shutdown()"
        ],
        "description": "Run directly spawned Foundation tasks on a bounded parallel pool"
    },
    "State machine": {
        "prefix": "statemachine",
        "body": [
            "state_machine ${1:Name} {",
            "    state ${2:Initial}",
            "    state ${3:Done}",
            "",
            "    on ${4:Complete} from ${2:Initial} to ${3:Done}",
            "}"
        ],
        "description": "Declare typed states and transitions"
    },
    "Channel select": {
        "prefix": "select",
        "body": [
            "select {",
            "    const ${1:value} = ${2:receiver}.receive(): ${3}",
            "    timeout ${4:5.seconds}: ${5}",
            "    else ${6:error}: ${7:return .Err(error)}",
            "}"
        ],
        "description": "Wait for a channel operation or timeout"
    },
    "Pipeline": {
        "prefix": "pipeline",
        "body": [
            "pipeline ${1:Name}(${2:input} ${3:Input}) ${4:Result<Output, Error>} {",
            "    step ${5:name} using ${6:function}",
            "}"
        ],
        "description": "Declare a typed processing pipeline"
