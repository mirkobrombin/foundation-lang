{
    "Package declaration": {
        "prefix": "package",
        "body": "package ${1:example.app}",
        "description": "Declare the source package"
    },
    "Package import": {
        "prefix": "import",
        "body": "import ${1:example.library}${2: as ${3:library}}",
        "description": "Import a Foundation package"
    },
    "Read environment value": {
        "prefix": "envget",
        "body": [
            "const ${1:key} = \"${2:NAME}\"",
            "const ${3:value} = env.Get(${1:key}) else ${4:error} {",
            "    ${5:return 1}",
            "}"
        ],
        "description": "Read an environment value with explicit failure handling"
    },
    "Join path": {
        "prefix": "pathjoin",
        "body": "path.Join(${1:base}, ${2:child})",
        "description": "Join two portable path components"
    },
    "Open line reader": {
        "prefix": "openlines",
        "body": [
            "const ${1:opened} = fs.OpenLines(${2:path}) else ${3:error} {",
            "    ${4:return 1}",
            "}",
            "var ${5:reader} = ${1:opened}"
        ],
        "description": "Open a read-only streaming line reader"
    },
    "Read text task": {
        "prefix": "readtext",
        "body": [
            "const ${1:reading} = spawn fs.ReadText(${2:path})",
            "const ${3:result} = \\$${1:reading}.wait()"
        ],
        "description": "Read one UTF-8 file without blocking the Foundation executor"
    },
    "TCP client tasks": {
        "prefix": "tcpclient",
        "body": [
            "const ${1:connecting} = spawn net.Connect(${2:host}, ${3:port})",
            "const ${4:connection} = \\$${1:connecting}.wait() else ${5:error} {",
            "    ${6:return 1}",
            "}",
            "const ${7:pair} = ${4:connection}.Split() else ${8:error} {",
            "    ${9:return 1}",
            "}",
            "const net.StreamPair { Reader as ${10:reader} Writer as ${11:writer} } = ${7:pair}"
        ],
        "description": "Connect and split an owned TCP stream"
    },
    "TCP listener task": {
        "prefix": "tcplistener",
        "body": [
            "const ${1:listener} = net.Listen(${2:\"127.0.0.1\"}, ${3:0}) else ${4:error} {",
            "    ${5:return 1}",
            "}",
            "const ${6:accepting} = spawn net.Accept(${1:listener})",
            "const ${7:outcome} = \\$${6:accepting}.wait()"
        ],
        "description": "Bind and accept one owned TCP connection"
    },
    "HTTP handler": {
        "prefix": "webhandler",
        "body": [
            "struct ${1:Handler} implements web.Handler<${2:Error}> {}",
            "",
            "methods ${1:Handler} {",
            "    fn Handle(self, \\$${3:request} web.Request) Result<web.Response, ${2:Error}> {",
            "        ${4:.Ok(web.Text(200, \"ok\"))}",
            "    }",
            "}"
        ],
        "description": "Implement a typed Foundation HTTP handler"
    },
    "Generated HTTP route": {
        "prefix": "webroute",
        "body": [
            "@web.Route(${1|.GET,.POST,.PUT,.PATCH,.DELETE,.HEAD,.OPTIONS|}, \"${2:/items/{id}}\")",
            "fn ${3:GetItem}(",
            "    @web.Path(\"${4:id}\") ${4:id} String,",
            "    @web.Query(\"${5:limit}\") ${5:limit} i32",
            ") web.Response {",
            "    ${6:web.Text(200, \"ok\")}",
            "}"
        ],
        "description": "Declare a compiler-generated typed HTTP route"
    },
    "Global HTTP middleware": {
        "prefix": "webmiddlewareglobal",
        "body": [
            "@web.GlobalMiddleware(${1:10})",
            "fn ${2:requestMiddleware}<E>(",
            "    \\$${3:request} web.Request,",
            "    ${4:next} fn(\\$web.Request) Result<web.Response, web.DispatchError<E>>",
            ") Result<web.Response, web.DispatchError<E>> {",
            "    ${4:next}(\\$${3:request})",
            "}"
        ],
        "description": "Declare typed global middleware for a generated HTTP application"
