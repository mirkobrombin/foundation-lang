{
    "Package declaration": {
        "prefix": "package",
        "body": "package ${1:example.app}",
        "description": "Declare the source package"
    },
    "Package import": {
        "prefix": "import",
        "body": "import ${1:example.library}${2: as ${3:library}}",
        "description": "Import a Foundation package"
    },
    "C ABI import": {
        "prefix": "externimport",
        "body": "extern c fn ${1:nativeCall}(${2}) ${3:i32} as ${4:foundation_native_call}",
        "description": "Import a C function through the stable ABI"
    },
    "C ABI export": {
        "prefix": "externexport",
        "body": [
            "extern c fn ${1:FoundationCall}(${2}) ${3:i32} as ${4:foundation_call} {",
            "    ${5:0}",
            "}"
        ],
        "description": "Export a Foundation function through the stable C ABI"
    },
    "Enum": {
        "prefix": "enum",
        "body": [
            "enum ${1:Name} {",
            "    ${2:Empty}",
            "    ${3:Value}(${4:i32})",
            "}"
        ],
        "description": "Declare an algebraic enum"
    },
    "Generic enum": {
        "prefix": "enumg",
        "body": [
            "enum ${1:Choice}<${2:T}> {",
            "    ${3:None}",
            "    ${4:Some}(${2:T})",
            "}"
        ],
        "description": "Declare a generic algebraic enum"
    },
    "Match expression": {
        "prefix": "match",
        "body": [
            "match ${1:value} {",
            "    ${2:Variant}: ${3:result}",
            "}"
        ],
        "description": "Match an enum value"
    },
    "Struct": {
        "prefix": "struct",
        "body": [
            "struct ${1:Name} {",
            "    ${2:field} ${3:i32}",
            "}"
        ],
        "description": "Declare a value struct"
    },
    "Generic struct": {
        "prefix": "structg",
        "body": [
            "struct ${1:Box}<${2:T}> {",
            "    ${3:value} ${2:T}",
            "}"
        ],
        "description": "Declare a generic value struct"
    },
    "Contract": {
        "prefix": "contract",
        "body": [
            "contract ${1:Name} {",
            "    fn ${2:method}(view${3}) ${4:void}",
            "}"
        ],
        "description": "Declare a compile-time contract"
    },
    "Generic contract": {
        "prefix": "contractg",
        "body": [
            "contract ${1:Name}<${2:T}> {",
            "    fn ${3:method}(view, ${4:value} ${2:T}) ${5:void}",
            "}"
        ],
        "description": "Declare a generic compile-time contract"
    },
    "Contract implementation": {
        "prefix": "implements",
        "body": "struct ${1:Name} implements ${2:Contract} {\n    ${3}\n}",
        "description": "Declare a struct that implements a contract"
    },
    "View method": {
        "prefix": "methodview",
        "body": [
            "fn ${1:name}(view${2}) ${3:void} {",
            "    ${4}",
            "}"
        ],
        "description": "Declare a read-only method"
    },
    "Edit method": {
        "prefix": "methodedit",
        "body": [
            "fn ${1:name}(edit${2}) ${3:void} {",
            "    ${4}",
            "}"
        ],
        "description": "Declare a mutable method"
    },
    "Own method": {
        "prefix": "methodown",
        "body": [
            "fn ${1:name}(own${2}) ${3:void} {",
            "    ${4}",
            "}"
        ],
        "description": "Declare a consuming method"
    },
    "Main function": {
        "prefix": "main",
        "body": [
            "fn main() i32 {",
            "    ${1:0}",
            "}"
        ],
        "description": "Create the program entry point"
    },
    "Function": {
        "prefix": "fn",
        "body": [
            "fn ${1:name}(${2}) ${3:void} {",
            "    ${4}",
            "}"
        ],
        "description": "Declare a function"
    },
    "Generic function": {
        "prefix": "fng",
        "body": [
            "fn ${1:identity}<${2:T}>(${3:value} ${2:T}) ${2:T} {",
            "    ${3:value}",
            "}"
        ],
        "description": "Declare a generic function"
    },
    "Function value type": {
        "prefix": "fntype",
        "body": "fn(${1:i32}) ${2:i32}",
        "description": "Declare a function value type"
    },
    "Closure": {
        "prefix": "closure",
        "body": [
            "fn(${1:value} ${2:i32}) ${3:i32} capture ${4:captured} {",
            "    ${5:value}",
            "}"
        ],
        "description": "Create a closure with explicit captures"
    },
    "Owning closure": {
        "prefix": "closureown",
        "body": [
            "fn(${1:value} ${2:i32}) ${3:i32} capture own ${4:captured} {",
            "    ${5:value}",
            "}"
        ],
        "description": "Create a closure that owns a captured value"
    },
    "If statement": {
        "prefix": "if",
        "body": [
            "if ${1:condition} {",
            "    ${2}",
            "}"
        ],
        "description": "Create an if statement"
    },
    "If else statement": {
        "prefix": "ifelse",
        "body": [
            "if ${1:condition} {",
            "    ${2}",
            "} else {",
            "    ${3}",
            "}"
        ],
        "description": "Create an if else statement"
    },
    "While loop": {
        "prefix": "while",
        "body": [
            "while ${1:condition} {",
            "    ${2}",
            "}"
        ],
        "description": "Create a while loop"
    },
    "Immutable binding": {
        "prefix": "let",
        "body": "let ${1:name} = ${2:value}",
        "description": "Declare an immutable local binding"
    },
    "Mutable binding": {
        "prefix": "var",
        "body": "var ${1:name} = ${2:value}",
        "description": "Declare a mutable local binding"
    },
    "Result binding": {
        "prefix": "letelse",
        "body": [
            "let ${1:value} = ${2:result} else ${3:error} {",
            "    ${4:return .Err(${3:error})}",
            "}"
        ],
        "description": "Unwrap a Result with an explicit error path"
    },
    "Discard value": {
        "prefix": "discard",
        "body": "discard ${1:value}",
        "description": "Explicitly consume an unused value"
    },
    "Owned value": {
        "prefix": "own",
        "body": "own ${1:value}",
        "description": "Allocate an exclusive owned value"
    },
    "View parameter": {
        "prefix": "view",
        "body": "${1:value} view ${2:Type}",
        "description": "Declare a shared borrowed parameter"
    },
    "Edit parameter": {
        "prefix": "edit",
        "body": "${1:value} edit ${2:Type}",
        "description": "Declare an exclusive mutable borrowed parameter"
    },
    "Fixed array binding": {
        "prefix": "array",
        "body": "${1:values} [${2:N}]${3:Type} = [${4}]",
        "description": "Declare a fixed array value"
    },
    "View slice parameter": {
        "prefix": "viewslice",
        "body": "${1:values} view [${2:Type}]",
        "description": "Declare a shared slice parameter"
    },
    "Edit slice parameter": {
        "prefix": "editslice",
        "body": "${1:values} edit [${2:Type}]",
        "description": "Declare a mutable slice parameter"
    },
    "Indexed assignment": {
        "prefix": "indexset",
        "body": "${1:values}[${2:index}] = ${3:value}",
        "description": "Replace an indexed element"
    },
    "Print": {
        "prefix": "print",
        "body": "print(${1:\"message\"})",
        "description": "Print a string"
    },
    "Panic": {
        "prefix": "panic",
        "body": "panic(${1:\"message\"})",
        "description": "Terminate with a Foundation source trace"
    }
}
