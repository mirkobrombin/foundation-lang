{
    "Struct": {
        "prefix": "struct",
        "body": [
            "struct ${1:Name} {",
            "    ${2:field}: ${3:i32}",
            "}"
        ],
        "description": "Declare a value struct"
    },
    "Main function": {
        "prefix": "main",
        "body": [
            "fn main() -> i32 {",
            "    ${1:return 0;}",
            "}"
        ],
        "description": "Create the program entry point"
    },
    "Function": {
        "prefix": "fn",
        "body": [
            "fn ${1:name}(${2}) -> ${3:void} {",
            "    ${4}",
            "}"
        ],
        "description": "Declare a function"
    },
    "If statement": {
        "prefix": "if",
        "body": [
            "if ${1:condition} {",
            "    ${2}",
            "}"
        ],
        "description": "Create an if statement"
    },
    "If else statement": {
        "prefix": "ifelse",
        "body": [
            "if ${1:condition} {",
            "    ${2}",
            "} else {",
            "    ${3}",
            "}"
        ],
        "description": "Create an if else statement"
    },
    "While loop": {
        "prefix": "while",
        "body": [
            "while ${1:condition} {",
            "    ${2}",
            "}"
        ],
        "description": "Create a while loop"
    },
    "Immutable binding": {
        "prefix": "let",
        "body": "let ${1:name} = ${2:value};",
        "description": "Declare an immutable local binding"
    },
    "Mutable binding": {
        "prefix": "var",
        "body": "var ${1:name} = ${2:value};",
        "description": "Declare a mutable local binding"
    },
    "Print": {
        "prefix": "print",
        "body": "print(${1:\"message\"});",
        "description": "Print a string"
    }
}
