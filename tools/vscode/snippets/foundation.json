{
    "Package declaration": {
        "prefix": "package",
        "body": "package ${1:example.app}",
        "description": "Declare the source package"
    },
    "Package import": {
        "prefix": "import",
        "body": "import ${1:example.library}${2: as ${3:library}}",
        "description": "Import a Foundation package"
    },
    "Read environment value": {
        "prefix": "envget",
        "body": [
            "const ${1:key} = \"${2:NAME}\"",
            "const ${3:value} = env.Get(${1:key}) else ${4:error} {",
            "    ${5:return 1}",
            "}"
        ],
        "description": "Read an environment value with explicit failure handling"
    },
    "Join path": {
        "prefix": "pathjoin",
        "body": "path.Join(${1:base}, ${2:child})",
        "description": "Join two portable path components"
    },
    "Open line reader": {
        "prefix": "openlines",
        "body": [
            "const ${1:opened} = fs.OpenLines(${2:path}) else ${3:error} {",
            "    ${4:return 1}",
            "}",
            "var ${5:reader} = ${1:opened}"
        ],
        "description": "Open a read-only streaming line reader"
    },
    "Parse JSON value": {
        "prefix": "jsonparse",
        "body": [
            "const ${1:value} = json.Parse(${2:source}) else ${3:error} {",
            "    ${4:return 1}",
            "}"
        ],
        "description": "Parse JSON with an explicit error path"
    },
    "String builder": {
        "prefix": "stringbuilder",
        "body": [
            "var ${1:builder} = text.NewBuilder()",
            "discard ${1:builder}.Write(${2:value})",
            "const ${3:result} = ${1:builder}.Finish() else ${4:error} {",
            "    ${5:return 1}",
            "}"
        ],
        "description": "Build one owned String incrementally"
    },
    "Format UTC time": {
        "prefix": "timeutc",
        "body": [
            "const ${1:instant} = time.FromUnix(${2:seconds})",
            "const ${3:formatted} = ${1:instant}.FormatUtc() else ${4:error} {",
            "    ${5:return 1}",
            "}"
        ],
        "description": "Format a Unix timestamp as UTC with explicit failure handling"
    },
    "C ABI import": {
        "prefix": "externimport",
        "body": "extern c fn ${1:nativeCall}(${2}) ${3:i32} as ${4:foundation_native_call}",
        "description": "Import a C function through the stable ABI"
    },
    "C ABI export": {
        "prefix": "externexport",
        "body": [
            "extern c fn ${1:FoundationCall}(${2}) ${3:i32} as ${4:foundation_call} {",
            "    ${5:0}",
            "}"
        ],
        "description": "Export a Foundation function through the stable C ABI"
    },
    "Target declaration": {
        "prefix": "target",
        "body": [
            "@target(${1|linux,macos,windows|})",
            "fn ${2:name}() ${3:void} {",
            "    ${4:return}",
            "}"
        ],
        "description": "Select a declaration for one compilation target"
    },
    "Typed attribute declaration": {
        "prefix": "attribute",
        "body": "attribute ${1:Route}(${2:path String}) targets(${3|fn,struct,enum,contract,method,field,variant,parameter|})${4: repeatable}",
        "description": "Declare typed compile-time metadata"
    },
    "Typed attribute application": {
        "prefix": "applyattribute",
        "body": "@${1:Route}(${2})",
        "description": "Apply typed compile-time metadata"
    },
    "Enum": {
        "prefix": "enum",
        "body": [
            "enum ${1:Name} {",
            "    ${2:Empty}",
            "    ${3:Value}(${4:i32})",
            "}"
        ],
        "description": "Declare an algebraic enum"
    },
    "Generic enum": {
        "prefix": "enumg",
        "body": [
            "enum ${1:Choice}<${2:T}> {",
            "    ${3:None}",
            "    ${4:Some}(${2:T})",
            "}"
        ],
        "description": "Declare a generic algebraic enum"
    },
    "Match expression": {
        "prefix": "match",
        "body": [
            "match ${1:value} {",
            "    ${2:Variant}: ${3:result}",
            "}"
        ],
        "description": "Match an enum value"
    },
    "Struct": {
        "prefix": "struct",
        "body": [
            "struct ${1:Name} {",
            "    ${2:field} ${3:i32}",
            "}"
        ],
        "description": "Declare a value struct"
    },
    "Generic struct": {
        "prefix": "structg",
        "body": [
            "struct ${1:Box}<${2:T}> {",
            "    ${3:value} ${2:T}",
            "}"
        ],
        "description": "Declare a generic value struct"
    },
    "Contract": {
        "prefix": "contract",
        "body": [
            "contract ${1:Name} {",
            "    fn ${2:method}(self${3}) ${4:void}",
            "}"
        ],
        "description": "Declare a compile-time contract"
    },
    "Generic contract": {
        "prefix": "contractg",
        "body": [
            "contract ${1:Name}<${2:T}> {",
            "    fn ${3:method}(self, ${4:value} ${2:T}) ${5:void}",
            "}"
        ],
        "description": "Declare a generic compile-time contract"
    },
    "Contract implementation": {
        "prefix": "implements",
        "body": "struct ${1:Name} implements ${2:Contract} {\n    ${3}\n}",
        "description": "Declare a struct that implements a contract"
    },
    "Extended contract": {
        "prefix": "extends",
        "body": "contract ${1:Name} extends ${2:Parent} {\n    ${3}\n}",
        "description": "Declare a contract that inherits requirements"
    },
    "Delegated contract implementation": {
        "prefix": "implementsby",
        "body": "struct ${1:Name} implements ${2:Contract} {\n    ${3:field} ${4:Implementation}\n\n    forward ${2:Contract} as ${3:field}\n    ${5}\n}",
        "description": "Delegate a contract implementation to a field"
    },
    "Contract default method": {
        "prefix": "contractdefault",
        "body": [
            "fn ${1:name}(self${2}) ${3:void} {",
            "    ${4}",
            "}"
        ],
        "description": "Declare a contract method with a default body"
    },
    "View method": {
        "prefix": "methodview",
        "body": [
            "fn ${1:name}(self${2}) ${3:void} {",
            "    ${4}",
            "}"
        ],
        "description": "Declare a read-only method"
    },
    "Edit method": {
        "prefix": "methodedit",
        "body": [
            "fn ${1:name}(&self${2}) ${3:void} {",
            "    ${4}",
            "}"
        ],
        "description": "Declare a mutable method"
    },
    "Own method": {
        "prefix": "methodown",
        "body": [
            "fn ${1:name}(\\$self${2}) ${3:void} {",
            "    ${4}",
            "}"
        ],
        "description": "Declare a consuming method"
    },
    "Main function": {
        "prefix": "main",
        "body": [
            "fn main() i32 {",
            "    ${1:0}",
            "}"
        ],
        "description": "Create the program entry point"
    },
    "Main function with arguments": {
        "prefix": "mainargs",
        "body": [
            "fn main(args [String]) i32 {",
            "    ${1:0}",
            "}"
        ],
        "description": "Create an entry point with command-line arguments"
    },
    "Function": {
        "prefix": "fn",
        "body": [
            "fn ${1:name}(${2}) ${3:void} {",
            "    ${4}",
            "}"
        ],
        "description": "Declare a function"
    },
    "Generic function": {
        "prefix": "fng",
        "body": [
            "fn ${1:identity}<${2:T}>(${3:value} ${2:T}) ${2:T} {",
            "    ${3:value}",
            "}"
        ],
        "description": "Declare a generic function"
    },
    "Function value type": {
        "prefix": "fntype",
        "body": "fn(${1:i32}) ${2:i32}",
        "description": "Declare a function value type"
    },
    "Closure": {
        "prefix": "closure",
        "body": [
            "fn(${1:value} ${2:i32}) ${3:i32} capture(${4:captured}) {",
            "    ${5:value}",
            "}"
        ],
        "description": "Create a closure with explicit captures"
    },
    "Owning closure": {
        "prefix": "closureown",
        "body": [
            "fn(${1:value} ${2:i32}) ${3:i32} capture(\\$${4:captured}) {",
            "    ${5:value}",
            "}"
        ],
        "description": "Create a closure that owns a captured value"
    },
    "If statement": {
        "prefix": "if",
        "body": [
            "if ${1:condition} {",
            "    ${2}",
            "}"
        ],
        "description": "Create an if statement"
    },
    "If else statement": {
        "prefix": "ifelse",
        "body": [
            "if ${1:condition} {",
            "    ${2}",
            "} else {",
            "    ${3}",
            "}"
        ],
        "description": "Create an if else statement"
    },
    "While loop": {
        "prefix": "while",
        "body": [
            "while ${1:condition} {",
            "    ${2}",
            "}"
        ],
        "description": "Create a while loop"
    },
    "Immutable binding": {
        "prefix": "const",
        "body": "const ${1:name} = ${2:value}",
        "description": "Declare an immutable local binding"
    },
    "Mutable binding": {
        "prefix": "var",
        "body": "var ${1:name} = ${2:value}",
        "description": "Declare a mutable local binding"
    },
    "Result binding": {
        "prefix": "constelse",
        "body": [
            "const ${1:value} = ${2:result} else ${3:error} {",
            "    ${4:return .Err(${3:error})}",
            "}"
        ],
        "description": "Unwrap a Result with an explicit error path"
    },
    "Discard value": {
        "prefix": "discard",
        "body": "discard ${1:value}",
        "description": "Explicitly consume an unused value"
    },
    "Replace place": {
        "prefix": "replace",
        "body": "replace ${1:place} with ${2:value}",
        "description": "Replace a mutable place and return its previous value"
    },
    "Struct destructuring": {
        "prefix": "destructure",
        "body": "const ${1:Type} { ${2:field}${3: as ${4:name}} } = ${5:value}",
        "description": "Consume every field of a struct value"
    },
    "Deterministic drop": {
        "prefix": "drop",
        "body": [
            "fn drop(&self) void {",
            "    ${1}",
            "}"
        ],
        "description": "Define compiler-managed deterministic cleanup"
    },
    "Standard list": {
        "prefix": "list",
        "body": "var ${1:values} = collections.NewList<${2:Type}>()",
        "description": "Create a standard dynamic list"
    },
    "New owned value": {
        "prefix": "new",
        "body": "new ${1:Type} {\n    ${2}\n}",
        "description": "Construct a fresh owned value"
    },
    "Read parameter": {
        "prefix": "readparam",
        "body": "${1:value} ${2:Type}",
        "description": "Declare a read-only parameter"
    },
    "Edit parameter": {
        "prefix": "editparam",
        "body": "&${1:value} ${2:Type}",
        "description": "Declare an exclusive mutable borrowed parameter"
    },
    "Fixed array binding": {
        "prefix": "array",
        "body": "${1:values} [${2:N}]${3:Type} = [${4}]",
        "description": "Declare a fixed array value"
    },
    "Read slice parameter": {
        "prefix": "readslice",
        "body": "${1:values} [${2:Type}]",
        "description": "Declare a shared slice parameter"
    },
    "Edit slice parameter": {
        "prefix": "editslice",
        "body": "&${1:values} [${2:Type}]",
        "description": "Declare a mutable slice parameter"
    },
    "Transfer parameter": {
        "prefix": "transferparam",
        "body": "\\$${1:value} ${2:Type}",
        "description": "Declare a consuming parameter"
    },
    "Methods block": {
        "prefix": "methods",
        "body": [
            "methods ${1:Type} {",
            "    fn ${2:name}(self) ${3:void} {",
            "        ${4}",
            "    }",
            "}"
        ],
        "description": "Add methods to a package-owned type"
    },
    "Short guard": {
        "prefix": "guard",
        "body": "if ${1:condition} return ${2:value}",
        "description": "Exit through a one-line divergent guard"
    },
    "Postfix conditional": {
        "prefix": "ifvalue",
        "body": "${1:value} if ${2:condition} else ${3:fallback}",
        "description": "Choose between two simple values"
    },
    "For loop": {
        "prefix": "for",
        "body": [
            "for ${1:value} in ${2:values} {",
            "    ${3}",
            "}"
        ],
        "description": "Iterate over a sequence or iterator"
    },
    "Service": {
        "prefix": "service",
        "body": [
            "service ${1:Name} {",
            "    ${2}",
            "}"
        ],
        "description": "Declare a Foundation service"
    },
    "Action": {
        "prefix": "action",
        "body": [
            "action ${1:Name}(${2:command} ${3:Command}) Result<${4:void}, ${5:Error}> {",
            "    ${6:.Ok}",
            "}"
        ],
        "description": "Declare a typed action handler"
    },
    "Task": {
        "prefix": "task",
        "body": [
            "task ${1:name}(${2}) ${3:Result<void, Error>} {",
            "    ${4:.Ok}",
            "}"
        ],
        "description": "Declare a suspendable typed function"
    },
    "State machine": {
        "prefix": "statemachine",
        "body": [
            "state_machine ${1:Name} {",
            "    state ${2:Initial}",
            "    state ${3:Done}",
            "",
            "    on ${4:Complete} from ${2:Initial} to ${3:Done}",
            "}"
        ],
        "description": "Declare typed states and transitions"
    },
    "Channel select": {
        "prefix": "select",
        "body": [
            "select {",
            "    const ${1:value} = ${2:receiver}.receive(): ${3}",
            "    timeout ${4:5.seconds}: ${5}",
            "}"
        ],
        "description": "Wait for a channel operation or timeout"
    },
    "Pipeline": {
        "prefix": "pipeline",
        "body": [
            "pipeline ${1:Name}(${2:input} ${3:Input}) ${4:Result<Output, Error>} {",
            "    step ${5:name} using ${6:function}",
            "}"
        ],
        "description": "Declare a typed processing pipeline"
    },
    "Saga": {
        "prefix": "saga",
        "body": [
            "saga ${1:Name}(${2:input} ${3:Input}) ${4:Result<Output, Error>} {",
            "    step ${5:name} using ${6:function}",
            "        compensate ${7:compensation}",
            "}"
        ],
        "description": "Declare a compensated workflow"
    },
    "Test": {
        "prefix": "test",
        "body": [
            "test \"${1:description}\" {",
            "    ${2}",
            "}"
        ],
        "description": "Declare an executable Foundation test"
    },
    "Unsafe block": {
        "prefix": "unsafe",
        "body": [
            "// SAFETY: ${1:proof}",
            "unsafe {",
            "    ${2}",
            "}"
        ],
        "description": "Bound raw pointer or unsafe native operations"
    },
    "Indexed assignment": {
        "prefix": "indexset",
        "body": "${1:values}[${2:index}] = ${3:value}",
        "description": "Replace an indexed element"
    },
    "Print": {
        "prefix": "print",
        "body": "print(${1:\"message\"})",
        "description": "Print a string"
    },
    "Panic": {
        "prefix": "panic",
        "body": "panic(${1:\"message\"})",
        "description": "Terminate with a Foundation source trace"
    }
}
