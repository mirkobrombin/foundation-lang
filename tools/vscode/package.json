{
    "name": "foundation-lang",
    "displayName": "Foundation Lang",
    "description": "Language support for Foundation Lang",
    "version": "0.125.0",
    "publisher": "mirkobrombin",
    "license": "MIT",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:foundation",
        "onCommand:foundation.openCompositeType",
        "onCommand:foundation.openTypeDefinition",
        "onCommand:foundation.showOutput"
    ],
    "main": "./src/extension.js",
    "scripts": {
        "test": "node --test test/extension.test.js"
    },
    "contributes": {
        "languages": [
            {
                "id": "foundation",
                "aliases": [
                    "Foundation",
                    "foundation"
                ],
                "extensions": [
                    ".fn"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "foundation-package",
                "aliases": [
                    "Foundation Package"
                ],
                "filenames": [
                    "foundation.package"
                ],
                "configuration": "./package-language-configuration.json"
            },
            {
                "id": "foundation-lock",
                "aliases": [
                    "Foundation Lock"
                ],
                "filenames": [
                    "foundation.lock"
                ],
                "configuration": "./package-language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "foundation",
                "scopeName": "source.foundation",
                "path": "./syntaxes/foundation.tmLanguage.json"
            },
            {
                "language": "foundation-package",
                "scopeName": "source.foundation.package",
                "path": "./syntaxes/foundation-package.tmLanguage.json"
            },
            {
                "language": "foundation-lock",
                "scopeName": "source.foundation.lock",
                "path": "./syntaxes/foundation-lock.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "foundation",
                "path": "./snippets/foundation.json"
            }
        ],
        "commands": [
            {
                "command": "foundation.openCompositeType",
                "title": "Foundation: Peek Composite Type",
                "category": "Foundation"
            },
            {
                "command": "foundation.openTypeDefinition",
                "title": "Foundation: Go to Type Definition",
                "category": "Foundation"
            },
            {
                "command": "foundation.showOutput",
                "title": "Foundation: Show Language Server Output",
                "category": "Foundation"
            }
        ],
        "configuration": {
            "title": "Foundation",
            "properties": {
                "foundation.languageServer.path": {
                    "type": "string",
                    "default": "",
                    "description": "Path to foundation-ls. Empty uses the SDK or workspace build."
                },
                "foundation.inlayHints.emptyTests": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show the resolved is empty meaning after typed !value tests."
                }
            }
        }
    }
}
