package std.process

import std.bytes
import std.concurrent

enum Error {
    NotFound
    Permission
    InvalidArgument
    InvalidEnvironment
    InvalidWorkingDirectory
    OutputLimit
    ResourceLimit
    Io
    Closed
    Unavailable
}

struct Options {
    WorkingDirectory Option<String>
    InheritEnvironment bool
    OutputLimit u64
}

struct Output {
    ExitCode i32
    Stdout own bytes.Bytes
    Stderr own bytes.Bytes

    fn StdoutText(self) Result<String, bytes.Error> {
        self.Stdout.Text()
    }

    fn StderrText(self) Result<String, bytes.Error> {
        self.Stderr.Text()
    }
}

@concurrent.Transferable()
struct Command {
    handle u64

    fn AddArgument(&self, argument String) Result<void, Error> {
        const status = addArgumentNative(self.handle, argument)
        if status == 0 return .Ok
        .Err(errorFor(status))
    }

    fn SetWorkingDirectory(&self, workingDirectory String) Result<void, Error> {
        const status = setWorkingDirectoryNative(self.handle, workingDirectory)
        if status == 0 return .Ok
        .Err(errorFor(status))
    }

    fn AddEnvironment(&self, entry String) Result<void, Error> {
        const status = addEnvironmentNative(self.handle, entry)
        if status == 0 return .Ok
        .Err(errorFor(status))
    }

    fn Capture(&self) Result<own Output, Error> {
        var handle = replace self.handle with 0
        if handle == 0 return .Err(.Closed)

        var exitCode i32 = 0
        var stdoutHandle u64 = 0
        var stderrHandle u64 = 0
        const status = runNative(
            handle,
            &exitCode,
            &stdoutHandle,
            &stderrHandle
        )
        closeNative(&handle)
        if status != 0 return .Err(errorFor(status))

        const stdout = bytes.ClaimRuntimeHandle(stdoutHandle) else error {
            discard error
            return .Err(.Io)
        }
        const stderr = bytes.ClaimRuntimeHandle(stderrHandle) else error {
            discard error
            discard stdout
            return .Err(.Io)
        }
        .Ok(own Output {
            ExitCode = exitCode
            Stdout = stdout
            Stderr = stderr
        })
    }

    fn drop(&self) void {
        closeNative(&self.handle)
    }
}

extern c fn openNative(
    program String,
    outputLimit u64,
    inheritEnvironment bool,
    &handle u64
) i32 as foundation_runtime_process_open
extern c fn addArgumentNative(
    handle u64,
    argument String
) i32 as foundation_runtime_process_add_argument
extern c fn setWorkingDirectoryNative(
    handle u64,
    workingDirectory String
) i32 as foundation_runtime_process_set_working_directory
extern c fn addEnvironmentNative(
    handle u64,
    entry String
) i32 as foundation_runtime_process_add_environment
extern c fn runNative(
    handle u64,
    &exitCode i32,
    &stdoutHandle u64,
    &stderrHandle u64
) i32 as foundation_runtime_process_run
extern c fn closeNative(
    &handle u64
) void as foundation_runtime_process_close

fn errorFor(status i32) Error {
    if status == 1 return .NotFound
    if status == 2 return .Permission
    if status == 3 return .InvalidArgument
    if status == 4 return .InvalidEnvironment
    if status == 5 return .InvalidWorkingDirectory
    if status == 6 return .OutputLimit
    if status == 7 return .ResourceLimit
    if status == 9 return .Closed
    if status == 10 return .Unavailable
    .Io
}

fn DefaultOptions() Options {
    Options {
        WorkingDirectory = .None
        InheritEnvironment = true
        OutputLimit = 16777216
    }
}

fn Open(
    program String,
    $options Options
) Result<own Command, Error> {
    const Options {
        WorkingDirectory
        InheritEnvironment
        OutputLimit
    } = options
    var handle u64 = 0
    const status = openNative(
        program,
        OutputLimit,
        InheritEnvironment,
        &handle
    )
    if status != 0 return .Err(errorFor(status))

    var command = own Command { handle = handle }
    match WorkingDirectory {
        None: {}
        Some(workingDirectory): {
            command.SetWorkingDirectory(workingDirectory) else error {
                return .Err(error)
            }
        }
    }
    .Ok(command)
}

// Runs one program directly with argv semantics and separate bounded output.
fn Run(
    program String,
    arguments [String],
    environment [String],
    $options Options
) Result<own Output, Error> {
    const opened = Open(program, $options) else error {
        return .Err(error)
    }
    var command = opened
    for argument in arguments {
        command.AddArgument(argument) else error {
            return .Err(error)
        }
    }
    for entry in environment {
        command.AddEnvironment(entry) else error {
            return .Err(error)
        }
    }
    command.Capture()
}
