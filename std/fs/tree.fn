package std.fs

import std.bytes
import std.concurrent

extern c fn openTreeNative(
    path String,
    maxEntries u64,
    maxPathLength u64,
    &handle u64
) i32 as foundation_runtime_fs_tree_open
extern c fn nextTreeNative(
    handle u64,
    &path String,
    &kind u32,
    &executable bool,
    &size u64,
    &permissions u32,
    &modified u64
) i32 as foundation_runtime_fs_tree_next_metadata
extern c fn readTreeNative(
    handle u64,
    path String,
    limit u64,
    &result u64
) i32 as foundation_runtime_fs_tree_read
extern c fn readTreeSymbolicLinkNative(
    handle u64,
    path String,
    limit u64,
    &target String,
    &directory bool
) i32 as foundation_runtime_fs_tree_read_symbolic_link
extern c fn closeTreeNative(
    &handle u64
) i32 as foundation_runtime_fs_tree_close
extern c fn openRootNative(
    path String,
    &handle u64
) i32 as foundation_runtime_fs_root_open
extern c fn createRootDirectoryNative(
    handle u64,
    path String
) i32 as foundation_runtime_fs_root_create_directory
extern c fn createRootDirectoryEntryNative(
    handle u64,
    path String,
    permissions u32
) i32 as foundation_runtime_fs_root_create_directory_entry
extern c fn writeRootFileNative(
    handle u64,
    path String,
    bytesHandle u64,
    permissions u32
) i32 as foundation_runtime_fs_root_write_file
extern c fn createRootSymbolicLinkNative(
    handle u64,
    path String,
    target String,
    directory bool
) i32 as foundation_runtime_fs_root_create_symbolic_link
extern c fn removeRootFileNative(
    handle u64,
    path String
) i32 as foundation_runtime_fs_root_remove_file
extern c fn removeRootEmptyDirectoryNative(
    handle u64,
    path String
) i32 as foundation_runtime_fs_root_remove_empty_directory
extern c fn renameRootEntryNative(
    handle u64,
    source String,
    destination String
) i32 as foundation_runtime_fs_root_rename
extern c fn setRootPermissionsNative(
    handle u64,
    path String,
    permissions u32
) i32 as foundation_runtime_fs_root_set_permissions
extern c fn setRootModifiedNative(
    handle u64,
    path String,
    modified u64
) i32 as foundation_runtime_fs_root_set_modified
extern c fn closeRootNative(
    &handle u64
) i32 as foundation_runtime_fs_root_close

// Classifies one directory-tree entry without following symbolic links.
enum TreeKind {
    // A regular file with readable byte contents.
    File

    // A directory that may contain later entries.
    Directory

    // A symbolic link that the tree reader never follows.
    SymbolicLink

    // A filesystem object unsupported by portable tree operations.
    Other
}

// Describes one deterministic relative entry beneath a secure directory root.
struct TreeEntry {
    // Relative path using forward slashes.
    Path String

    // Portable classification of the filesystem object.
    Kind TreeKind

    // Whether a regular file has at least one executable permission bit.
    Executable bool

    // Regular-file length in bytes, or zero for other entry kinds.
    Size u64

    // Lower nine portable permission bits.
    Permissions u32 = 0

    // Last modification time in whole Unix seconds.
    Modified u64 = 0
}

// Describes the stored target and target kind of one symbolic link.
struct SymbolicLinkInfo {
    // Target text exactly as stored by the filesystem.
    Target String

    // Whether the link was created for a directory target.
    Directory bool
}

// Enumerates one bounded directory tree and reads regular files beneath its
// root.
struct TreeReader {
    handle u64

    // Returns the next entry in bytewise relative-path order.
    fn Next(&self) Result<Option<TreeEntry>, Error> {
        if self.handle == 0 return .Err(.Closed)
        var path = ""
        var kind u32 = 0
        var executable = false
        var size u64 = 0
        var permissions u32 = 0
        var modified u64 = 0
        const status = nextTreeNative(
            self.handle,
            &path,
            &kind,
            &executable,
            &size,
            &permissions,
            &modified
        )
        if status == 0 return .Ok(.None)
        if status != 1 return .Err(treeErrorFor(status))
        .Ok(.Some(TreeEntry {
            Path = path
            Kind = treeKind(kind)
            Executable = executable
            Size = size
            Permissions = permissions
            Modified = modified
        }))
    }

    // Reads one symbolic link without following any relative path component.
    fn ReadSymbolicLink(
        self,
        path String,
        limit u64
    ) Result<SymbolicLinkInfo, Error> {
        if self.handle == 0 return .Err(.Closed)
        var target = ""
        var directory = false
        const status = readTreeSymbolicLinkNative(
            self.handle,
            path,
            limit,
            &target,
            &directory
        )
        if status != 0 return .Err(treeErrorFor(status))
        .Ok(SymbolicLinkInfo { Target = target Directory = directory })
    }

    // Reads one regular file without following any relative path component.
    fn ReadFile(self, path String, limit u64) Result<own bytes.Bytes, Error> {
        if self.handle == 0 return .Err(.Closed)
        var result u64 = 0
        const status = readTreeNative(self.handle, path, limit, &result)
        if status != 0 return .Err(treeErrorFor(status))
        const claimed = bytes.ClaimRuntimeHandle(result) else error {
            discard error
            return .Err(.Io)
        }
        .Ok(claimed)
    }

    // Closes the tree exactly once.
    fn Close(&self) Result<bool, Error> {
        if self.handle == 0 return .Ok(false)
        const status = closeTreeNative(&self.handle)
        if status != 0 return .Err(treeErrorFor(status))
        .Ok(true)
    }

    fn drop(&self) void {
        discard closeTreeNative(&self.handle)
    }
}

// Creates directories and atomically writes files beneath one secure root.
@concurrent.Transferable()
struct RootWriter {
    handle u64

    // Creates a relative directory tree without following symbolic links.
    fn CreateDirectory(&self, path String) Result<void, Error> {
        if self.handle == 0 return .Err(.Closed)
        const status = createRootDirectoryNative(self.handle, path)
        if status == 0 return .Ok
        .Err(treeErrorFor(status))
    }

    // Creates exactly one relative directory and fails when it exists.
    fn CreateDirectoryEntry(
        &self,
        path String,
        permissions u32
    ) Result<void, HostError> {
        if self.handle == 0 return .Err(.Closed)
        const status = createRootDirectoryEntryNative(
            self.handle,
            path,
            permissions
        )
        if status == 0 return .Ok
        .Err(hostErrorFor(status))
    }

    // Atomically writes one file with portable permission bits.
    fn WriteFile(
        self,
        path String,
        value bytes.Bytes,
        permissions u32
    ) Result<void, Error> {
        if self.handle == 0 return .Err(.Closed)
        const status = writeRootFileNative(
            self.handle,
            path,
            bytes.RuntimeHandle(value),
            permissions
        )
        if status == 0 return .Ok
        .Err(treeErrorFor(status))
    }

    // Creates one symbolic link beneath the root without following parents.
    fn CreateSymbolicLink(
        &self,
        path String,
        target String,
        directory bool
    ) Result<void, Error> {
        if self.handle == 0 return .Err(.Closed)
        const status = createRootSymbolicLinkNative(
            self.handle,
            path,
            target,
            directory
        )
        if status == 0 return .Ok
        .Err(treeErrorFor(status))
    }

    // Removes one regular file or symbolic link beneath the root.
    fn RemoveFile(&self, path String) Result<void, Error> {
        if self.handle == 0 return .Err(.Closed)
        const status = removeRootFileNative(self.handle, path)
        if status == 0 return .Ok
        .Err(treeErrorFor(status))
    }

    // Removes one empty directory beneath the root.
    fn RemoveEmptyDirectory(&self, path String) Result<void, Error> {
        if self.handle == 0 return .Err(.Closed)
        const status = removeRootEmptyDirectoryNative(self.handle, path)
        if status == 0 return .Ok
        .Err(treeErrorFor(status))
    }

    // Removes one file and preserves the native error category.
    fn RemoveFileDetailed(&self, path String) Result<void, HostError> {
        if self.handle == 0 return .Err(.Closed)
        const status = removeRootFileNative(self.handle, path)
        if status == 0 return .Ok
        .Err(hostErrorFor(status))
    }

    // Removes one empty directory and preserves the native error category.
    fn RemoveEmptyDirectoryDetailed(
        &self,
        path String
    ) Result<void, HostError> {
        if self.handle == 0 return .Err(.Closed)
        const status = removeRootEmptyDirectoryNative(self.handle, path)
        if status == 0 return .Ok
        .Err(hostErrorFor(status))
    }

    // Moves one entry between two relative paths without following parents.
    fn Rename(
        &self,
        source String,
        destination String
    ) Result<void, HostError> {
        if self.handle == 0 return .Err(.Closed)
        const status = renameRootEntryNative(
            self.handle,
            source,
            destination
        )
        if status == 0 return .Ok
        .Err(hostErrorFor(status))
    }

    // Applies lower-nine permission bits without following symbolic links.
    fn SetPermissions(
        &self,
        path String,
        permissions u32
    ) Result<void, Error> {
        if self.handle == 0 return .Err(.Closed)
        const status = setRootPermissionsNative(
            self.handle,
            path,
            permissions
        )
        if status == 0 return .Ok
        .Err(treeErrorFor(status))
    }

    // Sets the last modification time in whole Unix seconds.
    fn SetModified(&self, path String, modified u64) Result<void, Error> {
        if self.handle == 0 return .Err(.Closed)
        const status = setRootModifiedNative(self.handle, path, modified)
        if status == 0 return .Ok
        .Err(treeErrorFor(status))
    }

    // Closes the root exactly once.
    fn Close(&self) Result<bool, Error> {
        if self.handle == 0 return .Ok(false)
        const status = closeRootNative(&self.handle)
        if status != 0 return .Err(treeErrorFor(status))
        .Ok(true)
    }

    fn drop(&self) void {
        discard closeRootNative(&self.handle)
    }
}

// Opens a deterministic bounded tree rooted at an existing directory.
fn OpenTree(
    path String,
    maxEntries u64,
    maxPathLength u64
) Result<own TreeReader, Error> {
    var handle u64 = 0
    const status = openTreeNative(path, maxEntries, maxPathLength, &handle)
    if status == 0 return .Ok(own TreeReader { handle = handle })
    .Err(treeErrorFor(status))
}

// Creates or opens one destination root for secure relative writes.
fn OpenRoot(path String) Result<own RootWriter, Error> {
    var handle u64 = 0
    const status = openRootNative(path, &handle)
    if status == 0 return .Ok(own RootWriter { handle = handle })
    .Err(treeErrorFor(status))
}

fn treeKind(value u32) TreeKind {
    if value == 1 return .File
    if value == 2 return .Directory
    if value == 3 return .SymbolicLink
    if value == 4 return .Other
    panic("filesystem tree returned an invalid entry kind")
}

fn treeErrorFor(status i32) Error {
    if status == 5 return .TooLarge
    if status == 6 return .InvalidUtf8
    errorFor(status)
}
