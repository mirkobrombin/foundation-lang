package std.fs

import std.bytes

enum Error {
    NotFound
    Permission
    InvalidPath
    InvalidUtf8
    LineTooLong
    TooLarge
    InvalidInterval
    ResourceLimit
    Cancelled
    Closed
    Io
}

enum HostError {
    NotFound
    Permission
    InvalidPath
    InvalidUtf8
    TooLarge
    Io
    AlreadyExists
    NotDirectory
    IsDirectory
    Unsupported
    NotEmpty
    CrossDevice
}

enum EntryKind {
    Missing
    File
    Directory
    SymbolicLink
    Other
}

extern c fn openLinesNative(path String, &handle u64) i32 as foundation_runtime_fs_open_lines
extern c fn nextLineLimitedNative(handle u64, limit u64, &line String) i32 as foundation_runtime_fs_next_line_limited
extern c fn closeNative(handle u64) i32 as foundation_runtime_fs_close
extern c fn sizeNative(path String, &size u64) i32 as foundation_runtime_fs_size
extern c fn openDirectoryNative(path String, &handle u64) i32 as foundation_runtime_fs_open_directory
extern c fn nextDirectoryNative(handle u64, &name String) i32 as foundation_runtime_fs_next_directory
extern c fn closeDirectoryNative(handle u64) i32 as foundation_runtime_fs_close_directory
extern c fn isDirectoryNative(path String, &result bool) i32 as foundation_runtime_fs_is_directory
extern c fn modifiedNative(path String, &result u64) i32 as foundation_runtime_fs_modified
@callback(cancel = foundation_runtime_fs_watch_cancel)
extern c fn watchNative(
    path String,
    intervalMilliseconds u64,
    &kind u32,
    &eventPath String
) i32 as foundation_runtime_fs_watch_start
@blocking
extern c fn createPrivateDirectoryNative(path String) i32 as foundation_runtime_fs_create_private_directory

@blocking
extern c fn readTextLimitedNative(path String, limit u64, &result String) i32 as foundation_runtime_fs_read_text_limited

@blocking
extern c fn readPrivateTextLimitedNative(path String, limit u64, &result String) i32 as foundation_runtime_fs_read_private_text_limited

@blocking
extern c fn writePrivateTextAtomicNative(path String, value String, limit u64) i32 as foundation_runtime_fs_write_private_text_atomic

@blocking
extern c fn deletePrivateFileNative(path String) i32 as foundation_runtime_fs_delete_private_file
extern c fn readTextSyncLimitedNative(path String, limit u64, &result String) i32 as foundation_runtime_fs_read_text_sync_limited
extern c fn readBytesSyncLimitedNative(path String, limit u64, &result u64) i32 as foundation_runtime_fs_read_bytes_sync_limited
extern c fn writeTextAtomicNative(path String, value String, limit u64) i32 as foundation_runtime_fs_write_text_atomic
extern c fn createDirectoryTreeNative(path String) i32 as foundation_runtime_fs_create_directory_tree
extern c fn existsNative(path String, &result bool) i32 as foundation_runtime_fs_exists
extern c fn kindNative(path String, &kind u32) i32 as foundation_runtime_fs_kind
extern c fn canonicalizeNative(path String, &result String) i32 as foundation_runtime_fs_canonicalize
extern c fn renameNative(source String, destination String) i32 as foundation_runtime_fs_rename
extern c fn replaceNative(source String, destination String) i32 as foundation_runtime_fs_replace
extern c fn copyFileNative(source String, destination String) i32 as foundation_runtime_fs_copy_file
extern c fn removeFileNative(path String) i32 as foundation_runtime_fs_remove_file
extern c fn removeEmptyDirectoryNative(path String) i32 as foundation_runtime_fs_remove_empty_directory
extern c fn removeTreeNative(path String, maxEntries u64, maxDepth u64) i32 as foundation_runtime_fs_remove_tree
extern c fn createTempDirectoryNative(parent String, prefix String, &result String) i32 as foundation_runtime_fs_create_temp_directory
extern c fn createTempFileNative(parent String, prefix String, &result String) i32 as foundation_runtime_fs_create_temp_file
extern c fn isExecutableNative(path String, &result bool) i32 as foundation_runtime_fs_is_executable
extern c fn setExecutableNative(path String, executable bool) i32 as foundation_runtime_fs_set_executable

fn errorFor(status i32) Error {
    if status == 1 {
        return .NotFound
    }
    if status == 2 {
        return .Permission
    }
    if status == 3 {
        return .InvalidPath
    }
    .Io
}

fn hostErrorFor(status i32) HostError {
    if status == 1 return .NotFound
    if status == 2 return .Permission
    if status == 3 return .InvalidPath
    if status == 7 return .AlreadyExists
    if status == 8 return .NotDirectory
    if status == 9 return .IsDirectory
    if status == 10 return .Unsupported
    if status == 11 return .NotEmpty
    if status == 12 return .CrossDevice
    .Io
}

fn readHostErrorFor(status i32) HostError {
    if status == 5 return .TooLarge
    if status == 6 return .InvalidUtf8
    hostErrorFor(status)
}

fn readErrorFor(status i32) Error {
    if status == 5 {
        return .TooLarge
    }
    if status == 6 {
        return .InvalidUtf8
    }
    errorFor(status)
}

fn watchErrorFor(status i32) Error {
    if status == 2 return .Cancelled
    if status == 3 return .InvalidPath
    if status == 4 return .ResourceLimit
    .Io
}

// Reads one UTF-8 file without blocking the Foundation executor.
task ReadText($path String) Result<String, Error> {
    const defaultLimit u64 = 16777216
    var result = ""
    const status = readTextLimitedNative(path, defaultLimit, &result)
    if status == 0 {
        return .Ok(result)
    }
    .Err(readErrorFor(status))
}

// Reads one UTF-8 file up to the caller-provided byte limit.
task ReadTextLimited($path String, limit u64) Result<String, Error> {
    var result = ""
    const status = readTextLimitedNative(path, limit, &result)
    if status == 0 {
        return .Ok(result)
    }
    .Err(readErrorFor(status))
}

// Reads one bounded UTF-8 regular file without following symbolic links or reparse points.
task ReadPrivateTextLimited($path String, limit u64) Result<String, Error> {
    var result = ""
    const status = readPrivateTextLimitedNative(path, limit, &result)
    if status == 0 return .Ok(result)
    .Err(readErrorFor(status))
}

// Creates a directory tree with owner-only permissions where the platform supports them.
task CreatePrivateDirectory($path String) Result<void, Error> {
    const status = createPrivateDirectoryNative(path)
    if status == 0 return .Ok
    .Err(errorFor(status))
}

// Atomically replaces one UTF-8 file with owner-only permissions and a size limit.
task WritePrivateTextAtomic(
    $path String,
    $value String,
    limit u64
) Result<void, Error> {
    const status = writePrivateTextAtomicNative(path, value, limit)
    if status == 0 return .Ok
    .Err(readErrorFor(status))
}

// Deletes one regular file without following symbolic links or reparse points.
task DeletePrivateFile($path String) Result<void, Error> {
    const status = deletePrivateFileNative(path)
    if status == 0 return .Ok
    .Err(errorFor(status))
}

// Reads one bounded UTF-8 file synchronously.
fn ReadTextSync(path String, limit u64) Result<String, HostError> {
    var result = ""
    const status = readTextSyncLimitedNative(path, limit, &result)
    if status == 0 return .Ok(result)
    .Err(readHostErrorFor(status))
}

// Reads one bounded binary regular file without following its final link.
fn ReadBytesSync(path String, limit u64) Result<own bytes.Bytes, HostError> {
    var result u64 = 0
    const status = readBytesSyncLimitedNative(path, limit, &result)
    if status != 0 return .Err(readHostErrorFor(status))
    const claimed = bytes.ClaimRuntimeHandle(result) else error {
        discard error
        return .Err(.Io)
    }
    .Ok(claimed)
}

// Atomically replaces one bounded UTF-8 file.
fn WriteTextAtomic(path String, value String, limit u64) Result<void, HostError> {
    const status = writeTextAtomicNative(path, value, limit)
    if status == 0 return .Ok
    .Err(readHostErrorFor(status))
}

// Creates every missing directory component.
fn CreateDirectory(path String) Result<void, HostError> {
    const status = createDirectoryTreeNative(path)
    if status == 0 return .Ok
    .Err(hostErrorFor(status))
}

fn Exists(path String) Result<bool, HostError> {
    var result = false
    const status = existsNative(path, &result)
    if status == 0 return .Ok(result)
    .Err(hostErrorFor(status))
}

// Classifies the final path component without following a link.
fn Kind(path String) Result<EntryKind, HostError> {
    var result u32 = 0
    const status = kindNative(path, &result)
    if status != 0 return .Err(hostErrorFor(status))
    if result == 0 return .Ok(.Missing)
    if result == 1 return .Ok(.File)
    if result == 2 return .Ok(.Directory)
    if result == 3 return .Ok(.SymbolicLink)
    if result == 4 return .Ok(.Other)
    .Err(.Io)
}

// Resolves an existing path and rejects a symbolic final component.
fn Canonicalize(path String) Result<String, HostError> {
    var result = ""
    const status = canonicalizeNative(path, &result)
    if status == 0 return .Ok(result)
    .Err(hostErrorFor(status))
}

// Renames one path and fails when the destination exists.
fn Rename(source String, destination String) Result<void, HostError> {
    const status = renameNative(source, destination)
    if status == 0 return .Ok
    .Err(hostErrorFor(status))
}

// Atomically replaces the destination with the source where the platform permits it.
fn Replace(source String, destination String) Result<void, HostError> {
    const status = replaceNative(source, destination)
    if status == 0 return .Ok
    .Err(hostErrorFor(status))
}

// Copies one regular file without following its final symbolic link.
fn CopyFile(source String, destination String) Result<void, HostError> {
    const status = copyFileNative(source, destination)
    if status == 0 return .Ok
    .Err(hostErrorFor(status))
}

fn RemoveFile(path String) Result<void, HostError> {
    const status = removeFileNative(path)
    if status == 0 return .Ok
    .Err(hostErrorFor(status))
}

fn RemoveEmptyDirectory(path String) Result<void, HostError> {
    const status = removeEmptyDirectoryNative(path)
    if status == 0 return .Ok
    .Err(hostErrorFor(status))
}

// Removes one bounded tree without traversing directory links. Dot components,
// filesystem roots, and depths above 128 are rejected. The root counts as one
// entry at depth one. The caller must prevent concurrent namespace changes. An
// error may leave visited entries removed.
fn RemoveTree(
    path String,
    maxEntries u64,
    maxDepth u64
) Result<void, HostError> {
    const status = removeTreeNative(path, maxEntries, maxDepth)
    if status == 0 return .Ok
    .Err(readHostErrorFor(status))
}

// Creates a collision-safe directory beneath an existing parent.
fn CreateTempDirectory(parent String, prefix String) Result<String, HostError> {
    var result = ""
    const status = createTempDirectoryNative(parent, prefix, &result)
    if status == 0 return .Ok(result)
    .Err(hostErrorFor(status))
}

// Creates a collision-safe empty file beneath an existing parent.
fn CreateTempFile(parent String, prefix String) Result<String, HostError> {
    var result = ""
    const status = createTempFileNative(parent, prefix, &result)
    if status == 0 return .Ok(result)
    .Err(hostErrorFor(status))
}

fn IsExecutable(path String) Result<bool, HostError> {
    var result = false
    const status = isExecutableNative(path, &result)
    if status == 0 return .Ok(result)
    .Err(hostErrorFor(status))
}

// Sets executable permission bits on platforms that expose them.
fn SetExecutable(path String, executable bool) Result<void, HostError> {
    const status = setExecutableNative(path, executable)
    if status == 0 return .Ok
    .Err(hostErrorFor(status))
}

struct LineReader {
    handle u64

    fn Next(&self) Result<Option<String>, Error> {
        const defaultLimit u64 = 16777216
        self.NextLimited(defaultLimit)
    }

    fn NextLimited(&self, limit u64) Result<Option<String>, Error> {
        if self.handle == 0 {
            return .Err(.Closed)
        }
        var line = ""
        const status = nextLineLimitedNative(self.handle, limit, &line)
        if status == 0 {
            return .Ok(.None)
        }
        if status == 1 {
            return .Ok(.Some(line))
        }
        if status == 3 {
            return .Err(.InvalidUtf8)
        }
        if status == 5 {
            return .Err(.LineTooLong)
        }
        .Err(.Io)
    }

    fn Close(&self) Result<bool, Error> {
        const handle = replace self.handle with 0
        if handle == 0 {
            return .Ok(false)
        }
        if closeNative(handle) == 0 {
            return .Ok(true)
        }
        .Err(.Io)
    }

    fn drop(&self) void {
        const handle = replace self.handle with 0
        if handle != 0 {
            discard closeNative(handle)
        }
    }
}

struct DirReader {
    handle u64

    fn Next(&self) Result<Option<String>, Error> {
        if self.handle == 0 {
            return .Err(.Closed)
        }
        var name = ""
        const status = nextDirectoryNative(self.handle, &name)
        if status == 0 {
            return .Ok(.None)
        }
        if status == 1 {
            return .Ok(.Some(name))
        }
        if status == 2 {
            return .Err(.InvalidUtf8)
        }
        .Err(.Io)
    }

    fn Close(&self) Result<bool, Error> {
        const handle = replace self.handle with 0
        if handle == 0 {
            return .Ok(false)
        }
        if closeDirectoryNative(handle) == 0 {
            return .Ok(true)
        }
        .Err(.Io)
    }

    fn drop(&self) void {
        const handle = replace self.handle with 0
        if handle != 0 {
            discard closeDirectoryNative(handle)
        }
    }
}

fn OpenLines(path String) Result<own LineReader, Error> {
    var handle u64 = 0
    const status = openLinesNative(path, &handle)
    if status == 0 {
        return .Ok(own LineReader { handle = handle })
    }
    .Err(errorFor(status))
}

fn Size(path String) Result<u64, Error> {
    var size u64 = 0
    const status = sizeNative(path, &size)
    if status == 0 {
        return .Ok(size)
    }
    .Err(errorFor(status))
}

fn OpenDir(path String) Result<own DirReader, Error> {
    var handle u64 = 0
    const status = openDirectoryNative(path, &handle)
    if status == 0 {
        return .Ok(own DirReader { handle = handle })
    }
    .Err(errorFor(status))
}

fn IsDirectory(path String) Result<bool, Error> {
    var result = false
    const status = isDirectoryNative(path, &result)
    if status == 0 {
        return .Ok(result)
    }
    .Err(errorFor(status))
}

fn Modified(path String) Result<u64, Error> {
    var result u64 = 0
    const status = modifiedNative(path, &result)
    if status == 0 {
        return .Ok(result)
    }
    .Err(errorFor(status))
}

enum EventKind {
    Created
    Modified
    Removed
}

struct Event {
    Kind EventKind
    Path String
}

// Waits for the next observed change without blocking the Foundation executor.
task WatchNext($path String, intervalMilliseconds u64) Result<Event, Error> {
    if intervalMilliseconds == 0 return .Err(.InvalidInterval)
    var kind u32 = 0
    var eventPath = ""
    const status = watchNative(path, intervalMilliseconds, &kind, &eventPath)
    if status != 0 return .Err(watchErrorFor(status))
    if kind == 1 return .Ok(Event { Kind = .Created Path = eventPath })
    if kind == 2 return .Ok(Event { Kind = .Modified Path = eventPath })
    if kind == 3 return .Ok(Event { Kind = .Removed Path = eventPath })
    .Err(.Io)
}
