package std.path

import std.text

@target(linux)
fn Separator() String {
    "/"
}

@target(macos)
fn Separator() String {
    "/"
}

@target(windows)
fn Separator() String {
    "\\"
}

@target(linux)
fn SeparatorFor(left String) String {
    Separator()
}

@target(macos)
fn SeparatorFor(left String) String {
    Separator()
}

@target(windows)
fn SeparatorFor(left String) String {
    const forward = "/"
    if text.Contains(left, forward) {
        return forward
    }
    Separator()
}

fn Join(left String, right String) String {
    if text.IsEmpty(left) {
        return text.Copy(right)
    }
    if text.IsEmpty(right) {
        return text.Copy(left)
    }

    const separator = SeparatorFor(left)
    const leftEnds = text.EndsWith(left, separator)
    const rightStarts = text.StartsWith(right, separator)
    const leftCopy = text.Copy(left)
    const rightCopy = text.Copy(right)
    if leftEnds && rightStarts {
        const rightLength = text.ByteLen(right)
        const trimmed = text.Slice(right, 1, rightLength) else error {
            discard error
            panic("invalid path boundary")
        }
        return leftCopy + trimmed
    }
    if leftEnds || rightStarts {
        return leftCopy + rightCopy
    }
    leftCopy + separator + rightCopy
}
