package std.collections

import std.concurrent

struct listNode<T> {
    value T
    next Option<own listNode<T>>
}

@concurrent.Transferable()
struct List<T> {
    head Option<own listNode<T>>
    length i32

    fn Len(self) i32 {
        self.length
    }

    fn IsEmpty(self) bool {
        self.length == 0
    }

    fn PushFront(&self, $value T) void {
        const previous = replace self.head with .None
        self.head = .Some(own listNode { value = value next = previous })
        self.length = self.length + 1
    }

    fn PopFront(&self) Option<T> {
        const current = replace self.head with .None
        match current {
            None: .None
            Some(node): popNode(&self, $node)
        }
    }

    fn clear(&self) void {
        while self.length > 0 {
            discard self.PopFront()
        }
    }

    fn Clear(&self) void {
        self.clear()
    }

    fn drop(&self) void {
        self.clear()
    }
}

fn popNode<T>(&list List<T>, $node own listNode<T>) Option<T> {
    const listNode { value next } = node
    list.head = next
    list.length = list.length - 1
    .Some(value)
}

fn NewList<T>() own List<T> {
    own List<T> { head = .None length = 0 }
}

fn optionValue<T>($value Option<T>) T {
    match value {
        None: missingValue<T>()
        Some(item): item
    }
}

fn missingValue<T>() T {
    panic("collection option invariant failed")
}

fn Sort<T>(
    $values own List<T>,
    compare fn(T, T) i32
) own List<T> {
    var pending = values
    var selected = NewList<T>()
    while !pending.IsEmpty() {
        var best = optionValue(pending.PopFront())
        var remaining = NewList<T>()
        while !pending.IsEmpty() {
            const candidate = optionValue(pending.PopFront())
            if compare(candidate, best) < 0 {
                remaining.PushFront($best)
                best = candidate
            } else {
                remaining.PushFront($candidate)
            }
        }
        selected.PushFront($best)
        const empty = replace pending with remaining
        discard empty
    }

    var result = NewList<T>()
    while !selected.IsEmpty() {
        result.PushFront(optionValue(selected.PopFront()))
    }
    result
}
