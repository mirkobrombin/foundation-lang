package std.collections

struct listNode<T> {
    value T
    next Option<own listNode<T>>
}

struct List<T> {
    head Option<own listNode<T>>
    length i32

    fn Len(view) i32 {
        self.length
    }

    fn IsEmpty(view) bool {
        self.length == 0
    }

    fn PushFront(edit, value T) void {
        let previous = replace self.head with .None
        self.head = .Some(own listNode { value = value next = previous })
        self.length = self.length + 1
    }

    fn PopFront(edit) Option<T> {
        let current = replace self.head with .None
        match current {
            None: .None
            Some(node): popNode(edit self, node)
        }
    }

    fn clear(edit) void {
        while self.length > 0 {
            discard self.PopFront()
        }
    }

    fn Clear(edit) void {
        self.clear()
    }

    fn drop(edit) void {
        self.clear()
    }
}

fn popNode<T>(list edit List<T>, node own listNode<T>) Option<T> {
    let listNode { value next } = node
    list.head = next
    list.length = list.length - 1
    .Some(value)
}

fn NewList<T>() own List<T> {
    own List<T> { head = .None length = 0 }
}

fn optionValue<T>(value Option<T>) T {
    match value {
        None: missingValue<T>()
        Some(item): item
    }
}

fn missingValue<T>() T {
    panic("collection option invariant failed")
}

fn Sort<T>(
    values own List<T>,
    compare view fn(view T, view T) i32
) own List<T> {
    var pending = values
    var selected = NewList<T>()
    while !pending.IsEmpty() {
        var best = optionValue(pending.PopFront())
        var remaining = NewList<T>()
        while !pending.IsEmpty() {
            let candidate = optionValue(pending.PopFront())
            if compare(view candidate, view best) < 0 {
                remaining.PushFront(best)
                best = candidate
            } else {
                remaining.PushFront(candidate)
            }
        }
        selected.PushFront(best)
        let empty = replace pending with remaining
        discard empty
    }

    var result = NewList<T>()
    while !selected.IsEmpty() {
        result.PushFront(optionValue(selected.PopFront()))
    }
    result
}
