// Owns arbitrary bytes and clears their storage before release.
@concurrent.Transferable()
struct Bytes {
    handle u64

    // Copies the complete byte sequence into independent owned storage.
    fn Copy(self) Result<own Bytes, Error> {
        var result u64 = 0
        if copyNative(self.handle, &result) != 0 {
            return .Err(.Closed)
        }
        .Ok(own Bytes { handle = result })
    }

    // Returns the number of bytes in this value.
    fn Len(self) Result<u64, Error> {
        var result u64 = 0
        if lengthNative(self.handle, &result) != 0 {
            return .Err(.Closed)
        }
        .Ok(result)
    }

    // Returns one byte without exposing the backing storage.
    fn At(self, index u64) Result<u64, Error> {
        var result u64 = 0
        const status = atNative(self.handle, index, &result)
        if status == 0 {
            return .Ok(result)
        }
        if status == 1 {
            return .Err(.Closed)
        }
        .Err(.OutOfBounds)
    }

    // Copies these bytes into a String after validating UTF-8.
    fn Text(self) Result<String, Error> {
        var result = ""
        const status = toTextNative(self.handle, &result)
        if status == 0 {
            return .Ok(result)
        }
        if status == 1 {
            return .Err(.Closed)
        }
        .Err(.InvalidUTF8)
    }

    // Copies one byte range into independent owned storage.
    fn Slice(self, start u64, end u64) Result<own Bytes, Error> {
        var result u64 = 0
        const status = sliceNative(self.handle, start, end, &result)
        if status == 0 {
            return .Ok(own Bytes { handle = result })
        }
        if status == 1 {
            return .Err(.Closed)
        }
        .Err(.OutOfBounds)
    }

    // Releases and clears this byte sequence exactly once.
    fn Close(&self) bool {
        if self.handle == 0 {
            return false
        }
        closeNative(&self.handle)
        true
    }

    fn drop(&self) void {
        closeNative(&self.handle)
    }
}

// Builds bounded binary values without exposing mutable backing storage.
struct Builder {
    handle u64

    // Returns the number of bytes written so far.
    fn Len(self) Result<u64, Error> {
        var result u64 = 0
        if builderLengthNative(self.handle, &result) != 0 {
            return .Err(.Closed)
        }
        .Ok(result)
    }

    // Appends one byte in the inclusive range 0 through 255.
    fn WriteByte(&self, value u64) Result<void, Error> {
        const status = appendByteNative(self.handle, value)
        if status == 0 {
            return .Ok
        }
        if status == 1 {
            return .Err(.Closed)
        }
        if status == 2 {
            return .Err(.TooLarge)
        }
        .Err(.OutOfBounds)
    }

    // Appends a copy of one complete byte sequence.
    fn Write(&self, value Bytes) Result<void, Error> {
        const status = appendNative(self.handle, value.handle)
        if status == 0 {
            return .Ok
        }
        if status == 1 {
            return .Err(.Closed)
        }
        .Err(.TooLarge)
    }

    // Closes the builder and returns its complete owned byte sequence.
    fn Finish(&self) Result<own Bytes, Error> {
        var result u64 = 0
        if finishBuilderNative(&self.handle, &result) != 0 {
            return .Err(.Closed)
        }
        .Ok(own Bytes { handle = result })
    }

    // Releases an unfinished builder exactly once.
    fn Close(&self) bool {
        if self.handle == 0 {
            return false
        }
        closeBuilderNative(&self.handle)
        true
    }

    fn drop(&self) void {
        closeBuilderNative(&self.handle)
    }
}

// Computes one SHA-256 digest from incrementally supplied text and bytes.
struct Sha256 {
    handle u64

    // Adds UTF-8 text exactly as encoded in the String.
    fn WriteText(&self, value String) Result<void, Error> {
        const status = updateSha256TextNative(self.handle, value)
        if status == 0 return .Ok
        if status == 1 return .Err(.Closed)
        .Err(.TooLarge)
    }

    // Adds one complete binary value.
    fn WriteBytes(&self, value Bytes) Result<void, Error> {
        const status = updateSha256BytesNative(self.handle, value.handle)
        if status == 0 return .Ok
        if status == 1 return .Err(.Closed)
        .Err(.TooLarge)
    }

    // Closes the stream and returns its 32-byte digest.
    fn Finish(&self) Result<own Bytes, Error> {
        var result u64 = 0
        if finishSha256Native(&self.handle, &result) != 0 {
            return .Err(.Closed)
        }
        .Ok(own Bytes { handle = result })
    }

    // Releases an unfinished stream exactly once.
    fn Close(&self) bool {
        if self.handle == 0 return false
        closeSha256Native(&self.handle)
        true
    }

    fn drop(&self) void {
        closeSha256Native(&self.handle)
    }
}

// Owns a cloneable, task-safe map whose values are copied and cleared in native
// memory.
@concurrent.Transferable()
struct SecretMemory {
    handle u64

    // Retains the shared memory region for an independent owner.
    fn Clone(self) Result<own SecretMemory, SecretMemoryError> {
        const retained = retainSecretMemoryNative(self.handle)
        if retained == 0 {
            return .Err(.Closed)
        }
        .Ok(own SecretMemory { handle = retained })
    }

    // Copies one owned byte value into the shared memory region.
    fn Set(self, key String, $value own Bytes) Result<void, SecretMemoryError> {
        const status = setSecretMemoryNative(self.handle, key, value.handle)
        discard value
        if status == 0 {
            return .Ok
        }
        if status == 3 {
            return .Err(.InvalidKey)
        }
        .Err(.Closed)
    }

    // Returns an independent owned copy of one stored value.
    fn Get(self, key String) Result<own Bytes, SecretMemoryError> {
        var value u64 = 0
        const status = getSecretMemoryNative(self.handle, key, &value)
        if status == 0 {
            return .Ok(own Bytes { handle = value })
        }
        if status == 2 {
            return .Err(.NotFound)
        }
        if status == 3 {
            return .Err(.InvalidKey)
        }
        .Err(.Closed)
    }

    // Removes one value and clears its backing memory when present.
    fn Delete(self, key String) Result<void, SecretMemoryError> {
        const status = deleteSecretMemoryNative(self.handle, key)
        if status == 0 {
            return .Ok
        }
        if status == 3 {
            return .Err(.InvalidKey)
        }
        .Err(.Closed)
    }

    fn drop(&self) void {
        closeSecretMemoryNative(&self.handle)
    }
}

// Copies UTF-8 text into an owned byte sequence.
fn FromText(value String) own Bytes {
    own Bytes { handle = fromTextNative(value) }
}

// Returns bytes filled by the operating system cryptographic random source.
fn Random(length u64) Result<own Bytes, RandomError> {
    var result u64 = 0
    const status = randomNative(length, &result)
    if status == 0 return .Ok(own Bytes { handle = result })
    if status == 2 return .Err(.TooLarge)
    .Err(.EntropyUnavailable)
}

// Creates an empty builder with a hard output-size limit.
fn NewBuilder(limit u64) Result<own Builder, Error> {
    var result u64 = 0
    if openBuilderNative(limit, &result) != 0 {
        return .Err(.TooLarge)
    }
    .Ok(own Builder { handle = result })
}

// Opens an empty streaming SHA-256 computation.
fn NewSha256() own Sha256 {
    own Sha256 { handle = openSha256Native() }
}

// Borrows the opaque SDK handle for one synchronous native adapter call.
fn RuntimeHandle(value Bytes) u64 {
    value.handle
}

// Transfers the opaque SDK handle out of an owned byte sequence.
fn TakeRuntimeHandle($value own Bytes) u64 {
    var active = value
    replace active.handle with 0
}

// Claims exclusive ownership of an opaque handle returned by the SDK runtime.
fn ClaimRuntimeHandle(handle u64) Result<own Bytes, Error> {
    if handle == 0 return .Err(.Closed)
    .Ok(own Bytes { handle = handle })
}

// Creates an empty task-safe region for secret bytes.
fn NewSecretMemory() own SecretMemory {
    own SecretMemory { handle = openSecretMemoryNative() }
}

// Encodes bytes with the unpadded RFC 4648 URL alphabet.
fn EncodeBase64URL(value Bytes) Result<String, Error> {
    var result = ""
    const status = encodeBase64URLNative(value.handle, &result)
    if status == 0 {
        return .Ok(result)
    }
    if status == 1 {
        return .Err(.Closed)
    }
    .Err(.TooLarge)
}

// Decodes canonical unpadded RFC 4648 URL text.
fn DecodeBase64URL(value String) Result<own Bytes, Error> {
    var result u64 = 0
    const status = decodeBase64URLNative(value, &result)
    if status == 0 {
        return .Ok(own Bytes { handle = result })
    }
    .Err(.InvalidEncoding)
}

// Encodes bytes with the padded RFC 4648 standard alphabet.
fn EncodeBase64(value Bytes) Result<String, Error> {
    var result = ""
    const status = encodeBase64Native(value.handle, &result)
    if status == 0 {
        return .Ok(result)
    }
    if status == 1 {
        return .Err(.Closed)
    }
    .Err(.TooLarge)
}

// Decodes canonical padded RFC 4648 standard text.
fn DecodeBase64(value String) Result<own Bytes, Error> {
    var result u64 = 0
    const status = decodeBase64Native(value, &result)
    if status == 0 {
        return .Ok(own Bytes { handle = result })
    }
    .Err(.InvalidEncoding)
}

// Computes HMAC-SHA256 without exposing key or digest storage.
fn HmacSha256(key Bytes, value Bytes) Result<own Bytes, Error> {
    var result u64 = 0
    if hmacSha256Native(key.handle, value.handle, &result) != 0 {
        return .Err(.Closed)
    }
    .Ok(own Bytes { handle = result })
}

// Encrypts bytes with AES-256-GCM and binds the result to associated text.
fn EncryptAES256GCM(
    key Bytes,
    value Bytes,
    associatedData String
) Result<own Bytes, Error> {
    var result u64 = 0
    const status = aes256GcmEncryptNative(
        key.handle,
        value.handle,
        associatedData,
        &result
    )
    if status == 0 {
        return .Ok(own Bytes { handle = result })
    }
    if status == 1 {
        return .Err(.Closed)
    }
    if status == 2 {
        return .Err(.InvalidEncoding)
    }
    .Err(.TooLarge)
}

// Authenticates and decrypts AES-256-GCM bytes bound to associated text.
fn DecryptAES256GCM(
    key Bytes,
    value Bytes,
    associatedData String
) Result<own Bytes, Error> {
    var result u64 = 0
    const status = aes256GcmDecryptNative(
        key.handle,
        value.handle,
        associatedData,
        &result
    )
    if status == 0 {
        return .Ok(own Bytes { handle = result })
    }
    if status == 1 {
        return .Err(.Closed)
    }
    if status == 4 {
        return .Err(.InvalidEncoding)
    }
    if status == 2 {
        return .Err(.InvalidEncoding)
    }
    .Err(.TooLarge)
}

// Compares complete byte sequences without data-dependent early exit.
fn ConstantTimeEqual(left Bytes, right Bytes) bool {
    constantTimeEqualNative(left.handle, right.handle)
}
