package std.bytes

import std.concurrent

// Classifies failures while reading or transforming owned binary data.
enum Error {
    // The value has already released its backing storage.
    Closed

    // A requested byte or range falls outside the value.
    OutOfBounds

    // The byte sequence is not valid UTF-8.
    InvalidUTF8

    // Encoded input is not canonical for the selected format.
    InvalidEncoding

    // An operation would exceed its configured bound.
    TooLarge
}

// Classifies failures while requesting cryptographic random bytes.
enum RandomError {
    // The requested output exceeds the fixed random-byte bound.
    TooLarge

    // The operating system could not supply cryptographic entropy.
    EntropyUnavailable
}

// Classifies operations on a shared memory region that clears secret bytes on
// release.
enum SecretMemoryError {
    // The shared memory region has already been released.
    Closed

    // The requested key is absent.
    NotFound

    // The key is empty or exceeds the runtime bound.
    InvalidKey
}

