package std.bytes

import std.concurrent

// Classifies failures while reading or transforming owned binary data.
enum Error {
    Closed
    OutOfBounds
    InvalidUTF8
    InvalidEncoding
    TooLarge
}

// Classifies operations on a shared memory region that clears secret bytes on release.
enum SecretMemoryError {
    Closed
    NotFound
    InvalidKey
}

extern c fn fromTextNative(value String) u64 as foundation_runtime_bytes_from_text
extern c fn copyNative(handle u64, &result u64) i32 as foundation_runtime_bytes_copy
extern c fn lengthNative(handle u64, &result u64) i32 as foundation_runtime_bytes_length
extern c fn atNative(handle u64, index u64, &result u64) i32 as foundation_runtime_bytes_at
extern c fn toTextNative(handle u64, &result String) i32 as foundation_runtime_bytes_to_text
extern c fn closeNative(&handle u64) void as foundation_runtime_bytes_close
extern c fn encodeBase64URLNative(
    handle u64,
    &result String
) i32 as foundation_runtime_base64url_encode
extern c fn decodeBase64URLNative(
    value String,
    &result u64
) i32 as foundation_runtime_base64url_decode
extern c fn encodeBase64Native(
    handle u64,
    &result String
) i32 as foundation_runtime_base64_encode
extern c fn decodeBase64Native(
    value String,
    &result u64
) i32 as foundation_runtime_base64_decode
extern c fn hmacSha256Native(key u64, value u64, &result u64) i32 as foundation_runtime_hmac_sha256
extern c fn aes256GcmEncryptNative(
    key u64,
    value u64,
    associatedData String,
    &result u64
) i32 as foundation_runtime_aes256_gcm_encrypt
extern c fn aes256GcmDecryptNative(
    key u64,
    value u64,
    associatedData String,
    &result u64
) i32 as foundation_runtime_aes256_gcm_decrypt
extern c fn constantTimeEqualNative(
    left u64,
    right u64
) bool as foundation_runtime_bytes_constant_time_equal
extern c fn openSecretMemoryNative() u64 as foundation_runtime_secret_memory_open
extern c fn retainSecretMemoryNative(handle u64) u64 as foundation_runtime_secret_memory_retain
extern c fn setSecretMemoryNative(
    handle u64,
    key String,
    value u64
) i32 as foundation_runtime_secret_memory_set
extern c fn getSecretMemoryNative(
    handle u64,
    key String,
    &value u64
) i32 as foundation_runtime_secret_memory_get
extern c fn deleteSecretMemoryNative(
    handle u64,
    key String
) i32 as foundation_runtime_secret_memory_delete
extern c fn closeSecretMemoryNative(
    &handle u64
) void as foundation_runtime_secret_memory_close

// Owns arbitrary bytes and clears their storage before release.
@concurrent.Transferable()
struct Bytes {
    handle u64

    // Copies the complete byte sequence into independent owned storage.
    fn Copy(self) Result<own Bytes, Error> {
        var result u64 = 0
        if copyNative(self.handle, &result) != 0 {
            return .Err(.Closed)
        }
        .Ok(own Bytes { handle = result })
    }

    // Returns the number of bytes in this value.
    fn Len(self) Result<u64, Error> {
        var result u64 = 0
        if lengthNative(self.handle, &result) != 0 {
            return .Err(.Closed)
        }
        .Ok(result)
    }

    // Returns one byte without exposing the backing storage.
    fn At(self, index u64) Result<u64, Error> {
        var result u64 = 0
        const status = atNative(self.handle, index, &result)
        if status == 0 {
            return .Ok(result)
        }
        if status == 1 {
            return .Err(.Closed)
        }
        .Err(.OutOfBounds)
    }

    // Copies these bytes into a String after validating UTF-8.
    fn Text(self) Result<String, Error> {
        var result = ""
        const status = toTextNative(self.handle, &result)
        if status == 0 {
            return .Ok(result)
        }
        if status == 1 {
            return .Err(.Closed)
        }
        .Err(.InvalidUTF8)
    }

    // Releases and clears this byte sequence exactly once.
    fn Close(&self) bool {
        if self.handle == 0 {
            return false
        }
        closeNative(&self.handle)
        true
    }

    fn drop(&self) void {
        closeNative(&self.handle)
    }
}

// Owns a cloneable, task-safe map whose values are copied and cleared in native memory.
@concurrent.Transferable()
struct SecretMemory {
    handle u64

    // Retains the shared memory region for an independent owner.
    fn Clone(self) Result<own SecretMemory, SecretMemoryError> {
        const retained = retainSecretMemoryNative(self.handle)
        if retained == 0 {
            return .Err(.Closed)
        }
        .Ok(own SecretMemory { handle = retained })
    }

    // Copies one owned byte value into the shared memory region.
    fn Set(self, key String, $value own Bytes) Result<void, SecretMemoryError> {
        const status = setSecretMemoryNative(self.handle, key, value.handle)
        discard value
        if status == 0 {
            return .Ok
        }
        if status == 3 {
            return .Err(.InvalidKey)
        }
        .Err(.Closed)
    }

    // Returns an independent owned copy of one stored value.
    fn Get(self, key String) Result<own Bytes, SecretMemoryError> {
        var value u64 = 0
        const status = getSecretMemoryNative(self.handle, key, &value)
        if status == 0 {
            return .Ok(own Bytes { handle = value })
        }
        if status == 2 {
            return .Err(.NotFound)
        }
        if status == 3 {
            return .Err(.InvalidKey)
        }
        .Err(.Closed)
    }

    // Removes one value and clears its backing memory when present.
    fn Delete(self, key String) Result<void, SecretMemoryError> {
        const status = deleteSecretMemoryNative(self.handle, key)
        if status == 0 {
            return .Ok
        }
        if status == 3 {
            return .Err(.InvalidKey)
        }
        .Err(.Closed)
    }

    fn drop(&self) void {
        closeSecretMemoryNative(&self.handle)
    }
}

// Copies UTF-8 text into an owned byte sequence.
fn FromText(value String) own Bytes {
    own Bytes { handle = fromTextNative(value) }
}

// Creates an empty task-safe region for secret bytes.
fn NewSecretMemory() own SecretMemory {
    own SecretMemory { handle = openSecretMemoryNative() }
}

// Encodes bytes with the unpadded RFC 4648 URL alphabet.
fn EncodeBase64URL(value Bytes) Result<String, Error> {
    var result = ""
    const status = encodeBase64URLNative(value.handle, &result)
    if status == 0 {
        return .Ok(result)
    }
    if status == 1 {
        return .Err(.Closed)
    }
    .Err(.TooLarge)
}

// Decodes canonical unpadded RFC 4648 URL text.
fn DecodeBase64URL(value String) Result<own Bytes, Error> {
    var result u64 = 0
    const status = decodeBase64URLNative(value, &result)
    if status == 0 {
        return .Ok(own Bytes { handle = result })
    }
    .Err(.InvalidEncoding)
}

// Encodes bytes with the padded RFC 4648 standard alphabet.
fn EncodeBase64(value Bytes) Result<String, Error> {
    var result = ""
    const status = encodeBase64Native(value.handle, &result)
    if status == 0 {
        return .Ok(result)
    }
    if status == 1 {
        return .Err(.Closed)
    }
    .Err(.TooLarge)
}

// Decodes canonical padded RFC 4648 standard text.
fn DecodeBase64(value String) Result<own Bytes, Error> {
    var result u64 = 0
    const status = decodeBase64Native(value, &result)
    if status == 0 {
        return .Ok(own Bytes { handle = result })
    }
    .Err(.InvalidEncoding)
}

// Computes HMAC-SHA256 without exposing key or digest storage.
fn HmacSha256(key Bytes, value Bytes) Result<own Bytes, Error> {
    var result u64 = 0
    if hmacSha256Native(key.handle, value.handle, &result) != 0 {
        return .Err(.Closed)
    }
    .Ok(own Bytes { handle = result })
}

// Encrypts bytes with AES-256-GCM and binds the result to associated text.
fn EncryptAES256GCM(
    key Bytes,
    value Bytes,
    associatedData String
) Result<own Bytes, Error> {
    var result u64 = 0
    const status = aes256GcmEncryptNative(
        key.handle,
        value.handle,
        associatedData,
        &result
    )
    if status == 0 {
        return .Ok(own Bytes { handle = result })
    }
    if status == 1 {
        return .Err(.Closed)
    }
    if status == 2 {
        return .Err(.InvalidEncoding)
    }
    .Err(.TooLarge)
}

// Authenticates and decrypts AES-256-GCM bytes bound to associated text.
fn DecryptAES256GCM(
    key Bytes,
    value Bytes,
    associatedData String
) Result<own Bytes, Error> {
    var result u64 = 0
    const status = aes256GcmDecryptNative(
        key.handle,
        value.handle,
        associatedData,
        &result
    )
    if status == 0 {
        return .Ok(own Bytes { handle = result })
    }
    if status == 1 {
        return .Err(.Closed)
    }
    if status == 4 {
        return .Err(.InvalidEncoding)
    }
    if status == 2 {
        return .Err(.InvalidEncoding)
    }
    .Err(.TooLarge)
}

// Compares complete byte sequences without data-dependent early exit.
fn ConstantTimeEqual(left Bytes, right Bytes) bool {
    constantTimeEqualNative(left.handle, right.handle)
}
