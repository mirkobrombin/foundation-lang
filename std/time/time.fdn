package std.time

extern c fn nowNative() u64 as foundation_runtime_time_unix_seconds
extern c fn monotonicNative() u64 as foundation_runtime_time_monotonic_nanoseconds
extern c fn formatUtcNative(seconds u64, &result String) i32 as foundation_runtime_time_format_utc
extern c fn parseDurationNative(value String, &result i64) i32 as foundation_runtime_time_parse_duration

enum Error {
    BeforeReference
    OutOfRange
}

enum DurationError {
    Empty
    Invalid
    OutOfRange
}

struct Duration {
    nanoseconds i64

    fn Seconds(self) i64 {
        self.nanoseconds / 1000000000
    }

    fn Nanoseconds(self) i64 {
        self.nanoseconds
    }

    fn IsNegative(self) bool {
        self.nanoseconds < 0
    }
}

methods Duration {
    // Parses a signed sequence of decimal values with ns, us, microsecond, ms, s, m, or h units.
    fn Parse(value String) Result<Duration, DurationError> {
        var nanoseconds i64 = 0
        const status = parseDurationNative(value, &nanoseconds)
        if status == 0 return .Ok(Duration { nanoseconds = nanoseconds })
        if status == 1 return .Err(.Empty)
        if status == 3 return .Err(.OutOfRange)
        .Err(.Invalid)
    }
}

struct MonotonicInstant {
    nanoseconds u64

    fn Since(self, earlier MonotonicInstant) Result<Duration, Error> {
        if self.nanoseconds < earlier.nanoseconds {
            return .Err(.BeforeReference)
        }
        .Ok(fromNanoseconds(self.nanoseconds - earlier.nanoseconds))
    }
}

struct Instant {
    unixSeconds u64

    fn Unix(self) u64 {
        self.unixSeconds
    }

    fn Before(self, other Instant) bool {
        self.unixSeconds < other.unixSeconds
    }

    fn After(self, other Instant) bool {
        self.unixSeconds > other.unixSeconds
    }

    fn Since(self, earlier Instant) Result<Duration, Error> {
        if self.unixSeconds < earlier.unixSeconds {
            return .Err(.BeforeReference)
        }
        .Ok(fromSeconds(self.unixSeconds - earlier.unixSeconds))
    }

    fn FormatUtc(self) Result<String, Error> {
        var result = ""
        if formatUtcNative(self.unixSeconds, &result) != 0 {
            return .Err(.OutOfRange)
        }
        .Ok(result)
    }
}

fn FromUnix(seconds u64) Instant {
    Instant { unixSeconds = seconds }
}

fn Now() Instant {
    FromUnix(nowNative())
}

fn MonotonicNow() MonotonicInstant {
    MonotonicInstant { nanoseconds = monotonicNative() }
}

fn Zero() Duration {
    Duration { nanoseconds = 0 }
}

fn Nanoseconds(value u64) Duration {
    fromNanoseconds(value)
}

fn Milliseconds(value u64) Duration {
    if value > 9223372036854 return maximumDuration()
    fromNanoseconds(value * 1000000)
}

fn Seconds(value u64) Duration {
    if value > 9223372036 return maximumDuration()
    fromNanoseconds(value * 1000000000)
}

fn fromNanoseconds(value u64) Duration {
    const converted = i64.From(value) else error {
        discard error
        return maximumDuration()
    }
    Duration { nanoseconds = converted }
}

fn fromSeconds(value u64) Duration {
    if value > 9223372036 return maximumDuration()
    fromNanoseconds(value * 1000000000)
}

fn maximumDuration() Duration {
    Duration { nanoseconds = 9223372036854775807 }
}
