package std.parse

import std.text

enum IntegerError {
    Empty
    Invalid
    Overflow
}

enum BooleanError {
    Empty
    Invalid
}

// Parses an ASCII boolean token after trimming ASCII whitespace.
fn Bool(value String) Result<bool, BooleanError> {
    var start u64 = 0
    var end = text.ByteLen(value)
    while start < end && isASCIIWhitespace(byteAt(value, start)) {
        start = start + 1
    }
    while end > start && isASCIIWhitespace(byteAt(value, end - 1)) {
        end = end - 1
    }
    if start == end {
        return .Err(.Empty)
    }
    if tokenEquals(value, start, end, "1") || tokenEquals(value, start, end, "t") ||
        tokenEquals(value, start, end, "true") || tokenEquals(value, start, end, "yes") ||
        tokenEquals(value, start, end, "y") || tokenEquals(value, start, end, "on") {
        return .Ok(true)
    }
    if tokenEquals(value, start, end, "0") || tokenEquals(value, start, end, "f") ||
        tokenEquals(value, start, end, "false") || tokenEquals(value, start, end, "no") ||
        tokenEquals(value, start, end, "n") || tokenEquals(value, start, end, "off") {
        return .Ok(false)
    }
    .Err(.Invalid)
}

fn U64(value String) Result<u64, IntegerError> {
    const length = text.ByteLen(value)
    if length == 0 {
        return .Err(.Empty)
    }
    const maximum u64 = 18446744073709551615
    var result u64 = 0
    var offset u64 = 0
    while offset < length {
        const byte = text.ByteAt(value, offset) else error {
            discard error
            panic("integer parser byte invariant failed")
        }
        if byte < 48 || byte > 57 {
            return .Err(.Invalid)
        }
        const digit = byte - 48
        if result > (maximum - digit) / 10 {
            return .Err(.Overflow)
        }
        result = result * 10 + digit
        offset = offset + 1
    }
    .Ok(result)
}

fn I64(value String) Result<i64, IntegerError> {
    const length = text.ByteLen(value)
    if length == 0 {
        return .Err(.Empty)
    }
    const first = text.ByteAt(value, 0) else error {
        discard error
        panic("integer parser byte invariant failed")
    }
    const negative = first == 45
    var offset u64 = 0
    if negative {
        if length == 1 {
            return .Err(.Invalid)
        }
        offset = 1
    }
    const maximum u64 = 9223372036854775808 if negative else 9223372036854775807
    var magnitude u64 = 0
    while offset < length {
        const byte = text.ByteAt(value, offset) else error {
            discard error
            panic("integer parser byte invariant failed")
        }
        if byte < 48 || byte > 57 {
            return .Err(.Invalid)
        }
        const digit = byte - 48
        if magnitude > (maximum - digit) / 10 {
            return .Err(.Overflow)
        }
        magnitude = magnitude * 10 + digit
        offset = offset + 1
    }
    if negative && magnitude == 9223372036854775808 {
        return .Ok(-9223372036854775807 - 1)
    }
    const signed = i64.From(magnitude) else error {
        discard error
        return .Err(.Overflow)
    }
    .Ok(-signed if negative else signed)
}

fn I8(value String) Result<i8, IntegerError> {
    const parsed = I64(value) else error {
        return .Err(error)
    }
    const converted = i8.From(parsed) else error {
        discard error
        return .Err(.Overflow)
    }
    .Ok(converted)
}

fn I16(value String) Result<i16, IntegerError> {
    const parsed = I64(value) else error {
        return .Err(error)
    }
    const converted = i16.From(parsed) else error {
        discard error
        return .Err(.Overflow)
    }
    .Ok(converted)
}

fn I32(value String) Result<i32, IntegerError> {
    const parsed = I64(value) else error {
        return .Err(error)
    }
    const converted = i32.From(parsed) else error {
        discard error
        return .Err(.Overflow)
    }
    .Ok(converted)
}

fn Isize(value String) Result<isize, IntegerError> {
    const parsed = I64(value) else error {
        return .Err(error)
    }
    .Ok(isize.From(parsed))
}

fn U8(value String) Result<u8, IntegerError> {
    const parsed = U64(value) else error {
        return .Err(error)
    }
    const converted = u8.From(parsed) else error {
        discard error
        return .Err(.Overflow)
    }
    .Ok(converted)
}

fn U16(value String) Result<u16, IntegerError> {
    const parsed = U64(value) else error {
        return .Err(error)
    }
    const converted = u16.From(parsed) else error {
        discard error
        return .Err(.Overflow)
    }
    .Ok(converted)
}

fn U32(value String) Result<u32, IntegerError> {
    const parsed = U64(value) else error {
        return .Err(error)
    }
    const converted = u32.From(parsed) else error {
        discard error
        return .Err(.Overflow)
    }
    .Ok(converted)
}

fn Usize(value String) Result<usize, IntegerError> {
    const parsed = U64(value) else error {
        return .Err(error)
    }
    .Ok(usize.From(parsed))
}

fn tokenEquals(value String, start u64, end u64, expected String) bool {
    const length = end - start
    if length != text.ByteLen(expected) {
        return false
    }
    var offset u64 = 0
    while offset < length {
        if asciiLower(byteAt(value, start + offset)) != byteAt(expected, offset) {
            return false
        }
        offset = offset + 1
    }
    true
}

fn byteAt(value String, index u64) u64 {
    const byte = text.ByteAt(value, index) else error {
        discard error
        panic("boolean parser byte invariant failed")
    }
    byte
}

fn asciiLower(value u64) u64 {
    value + 32 if value >= 65 && value <= 90 else value
}

fn isASCIIWhitespace(value u64) bool {
    value == 32 || (value >= 9 && value <= 13)
}
