package std.parse

import std.text

extern c fn parseF32Native(value String, &result f32) i32 as foundation_runtime_parse_f32
extern c fn parseF64Native(value String, &result f64) i32 as foundation_runtime_parse_f64

enum IntegerError {
    Empty
    Invalid
    Overflow
}

enum BooleanError {
    Empty
    Invalid
}

enum FloatError {
    Empty
    Invalid
    OutOfRange
}

// Parses an ASCII boolean token after trimming Unicode whitespace.
fn Bool(value String) Result<bool, BooleanError> {
    var start u64 = 0
    var end = text.ByteLen(value)
    var width = whitespaceWidthForward(value, start, end)
    while width != 0 {
        start = start + width
        width = whitespaceWidthForward(value, start, end)
    }
    width = whitespaceWidthBackward(value, start, end)
    while width != 0 {
        end = end - width
        width = whitespaceWidthBackward(value, start, end)
    }
    if start == end {
        return .Err(.Empty)
    }
    if tokenEquals(value, start, end, "1") || tokenEquals(value, start, end, "t") ||
        tokenEquals(value, start, end, "true") || tokenEquals(value, start, end, "yes") ||
        tokenEquals(value, start, end, "y") || tokenEquals(value, start, end, "on") {
        return .Ok(true)
    }
    if tokenEquals(value, start, end, "0") || tokenEquals(value, start, end, "f") ||
        tokenEquals(value, start, end, "false") || tokenEquals(value, start, end, "no") ||
        tokenEquals(value, start, end, "n") || tokenEquals(value, start, end, "off") {
        return .Ok(false)
    }
    .Err(.Invalid)
}

// Parses a decimal, hexadecimal, or special IEEE 754 binary32 value.
fn F32(value String) Result<f32, FloatError> {
    var result f32 = 0.0
    const status = parseF32Native(value, &result)
    if status == 0 return .Ok(result)
    .Err(floatError(status))
}

// Parses a decimal, hexadecimal, or special IEEE 754 binary64 value.
fn F64(value String) Result<f64, FloatError> {
    var result f64 = 0.0
    const status = parseF64Native(value, &result)
    if status == 0 return .Ok(result)
    .Err(floatError(status))
}

fn U64(value String) Result<u64, IntegerError> {
    const length = text.ByteLen(value)
    if length == 0 {
        return .Err(.Empty)
    }
    const maximum u64 = 18446744073709551615
    var result u64 = 0
    var offset u64 = 0
    while offset < length {
        const byte = text.ByteAt(value, offset) else error {
            discard error
            panic("integer parser byte invariant failed")
        }
        if byte < 48 || byte > 57 {
            return .Err(.Invalid)
        }
        const digit = byte - 48
        if result > (maximum - digit) / 10 {
            return .Err(.Overflow)
        }
        result = result * 10 + digit
        offset = offset + 1
    }
    .Ok(result)
}

fn I64(value String) Result<i64, IntegerError> {
    const length = text.ByteLen(value)
    if length == 0 {
        return .Err(.Empty)
    }
    const first = text.ByteAt(value, 0) else error {
        discard error
        panic("integer parser byte invariant failed")
    }
    const negative = first == 45
    var offset u64 = 0
    if negative {
        if length == 1 {
            return .Err(.Invalid)
        }
        offset = 1
    }
    const maximum u64 = 9223372036854775808 if negative else 9223372036854775807
    var magnitude u64 = 0
    while offset < length {
        const byte = text.ByteAt(value, offset) else error {
            discard error
            panic("integer parser byte invariant failed")
        }
        if byte < 48 || byte > 57 {
            return .Err(.Invalid)
        }
        const digit = byte - 48
        if magnitude > (maximum - digit) / 10 {
            return .Err(.Overflow)
        }
        magnitude = magnitude * 10 + digit
        offset = offset + 1
    }
    if negative && magnitude == 9223372036854775808 {
        return .Ok(-9223372036854775807 - 1)
    }
    const signed = i64.From(magnitude) else error {
        discard error
        return .Err(.Overflow)
    }
    .Ok(-signed if negative else signed)
}

fn I8(value String) Result<i8, IntegerError> {
    const parsed = I64(value) else error {
        return .Err(error)
    }
    const converted = i8.From(parsed) else error {
        discard error
        return .Err(.Overflow)
    }
    .Ok(converted)
}

fn I16(value String) Result<i16, IntegerError> {
    const parsed = I64(value) else error {
        return .Err(error)
    }
    const converted = i16.From(parsed) else error {
        discard error
        return .Err(.Overflow)
    }
    .Ok(converted)
}

fn I32(value String) Result<i32, IntegerError> {
    const parsed = I64(value) else error {
        return .Err(error)
    }
    const converted = i32.From(parsed) else error {
        discard error
        return .Err(.Overflow)
    }
    .Ok(converted)
}

fn Isize(value String) Result<isize, IntegerError> {
    const parsed = I64(value) else error {
        return .Err(error)
    }
    .Ok(isize.From(parsed))
}

fn U8(value String) Result<u8, IntegerError> {
    const parsed = U64(value) else error {
        return .Err(error)
    }
    const converted = u8.From(parsed) else error {
        discard error
        return .Err(.Overflow)
    }
    .Ok(converted)
}

fn U16(value String) Result<u16, IntegerError> {
    const parsed = U64(value) else error {
        return .Err(error)
    }
    const converted = u16.From(parsed) else error {
        discard error
        return .Err(.Overflow)
    }
    .Ok(converted)
}

fn U32(value String) Result<u32, IntegerError> {
    const parsed = U64(value) else error {
        return .Err(error)
    }
    const converted = u32.From(parsed) else error {
        discard error
        return .Err(.Overflow)
    }
    .Ok(converted)
}

fn Usize(value String) Result<usize, IntegerError> {
    const parsed = U64(value) else error {
        return .Err(error)
    }
    .Ok(usize.From(parsed))
}

fn floatError(status i32) FloatError {
    if status == 1 return .Empty
    if status == 3 return .OutOfRange
    .Invalid
}

fn tokenEquals(value String, start u64, end u64, expected String) bool {
    const length = end - start
    if length != text.ByteLen(expected) {
        return false
    }
    var offset u64 = 0
    while offset < length {
        if asciiLower(byteAt(value, start + offset)) != byteAt(expected, offset) {
            return false
        }
        offset = offset + 1
    }
    true
}

fn byteAt(value String, index u64) u64 {
    const byte = text.ByteAt(value, index) else error {
        discard error
        panic("boolean parser byte invariant failed")
    }
    byte
}

fn asciiLower(value u64) u64 {
    value + 32 if value >= 65 && value <= 90 else value
}

fn isASCIIWhitespace(value u64) bool {
    value == 32 || (value >= 9 && value <= 13)
}

fn whitespaceWidthForward(value String, start u64, end u64) u64 {
    if start >= end {
        return 0
    }
    const first = byteAt(value, start)
    if isASCIIWhitespace(first) {
        return 1
    }
    const remaining = end - start
    if remaining >= 2 && first == 194 {
        const second = byteAt(value, start + 1)
        if second == 133 || second == 160 {
            return 2
        }
    }
    if remaining < 3 {
        return 0
    }
    const second = byteAt(value, start + 1)
    const third = byteAt(value, start + 2)
    if first == 225 && second == 154 && third == 128 {
        return 3
    }
    if first == 226 && second == 128 &&
        ((third >= 128 && third <= 138) || third == 168 || third == 169 || third == 175) {
        return 3
    }
    if first == 226 && second == 129 && third == 159 {
        return 3
    }
    3 if first == 227 && second == 128 && third == 128 else 0
}

fn whitespaceWidthBackward(value String, start u64, end u64) u64 {
    if end <= start {
        return 0
    }
    const last = byteAt(value, end - 1)
    if isASCIIWhitespace(last) {
        return 1
    }
    const remaining = end - start
    if remaining >= 2 && byteAt(value, end - 2) == 194 && (last == 133 || last == 160) {
        return 2
    }
    if remaining < 3 {
        return 0
    }
    const first = byteAt(value, end - 3)
    const second = byteAt(value, end - 2)
    if first == 225 && second == 154 && last == 128 {
        return 3
    }
    if first == 226 && second == 128 &&
        ((last >= 128 && last <= 138) || last == 168 || last == 169 || last == 175) {
        return 3
    }
    if first == 226 && second == 129 && last == 159 {
        return 3
    }
    3 if first == 227 && second == 128 && last == 128 else 0
}
