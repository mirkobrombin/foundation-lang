package std.json

import std.text

enum ErrorKind {
    UnexpectedEnd
    UnexpectedToken
    InvalidString
    InvalidEscape
    InvalidNumber
    DuplicateKey
    DepthLimit
    TrailingData
}

enum ObjectError {
    DuplicateKey
}

enum WriteErrorKind {
    InvalidNumber
    DepthLimit
    Builder
}

struct WriteError {
    Kind WriteErrorKind
}

struct Error {
    Kind ErrorKind
    Offset u64
}

struct item {
    value Value
    next Option<own item>
}

struct field {
    key String
    value Value
    next Option<own field>
}

struct itemReverse {
    current Option<own item>
    result Option<own item>

    fn step(&self, $selected Option<own item>) bool {
        match selected {
            None: false
            Some(node): self.accept($node)
        }
    }

    fn accept(&self, $node own item) bool {
        const item { value next } = node
        const previous = replace self.result with .None
        self.result = .Some(own item { value = value next = previous })
        self.current = next
        true
    }
}

struct fieldReverse {
    current Option<own field>
    result Option<own field>

    fn step(&self, $selected Option<own field>) bool {
        match selected {
            None: false
            Some(node): self.accept($node)
        }
    }

    fn accept(&self, $node own field) bool {
        const field { key value next } = node
        const previous = replace self.result with .None
        self.result = .Some(own field { key = key value = value next = previous })
        self.current = next
        true
    }
}

struct fieldSearch {
    current Option<own field>
    result Option<own field>
    found bool

    fn step(&self, expected String, $selected Option<own field>) bool {
        match selected {
            None: false
            Some(node): self.accept(expected, $node)
        }
    }

    fn accept(&self, expected String, $node own field) bool {
        const field { key value next } = node
        if text.Equal(key, expected) {
            self.found = true
        }
        const previous = replace self.result with .None
        self.result = .Some(own field { key = key value = value next = previous })
        self.current = next
        true
    }
}

struct fieldTake {
    current Option<own field>
    remaining Option<own field>
    value Option<Value>
    found bool

    fn step(&self, expected String, $selected Option<own field>) bool {
        match selected {
            None: false
            Some(node): self.accept(expected, $node)
        }
    }

    fn accept(&self, expected String, $node own field) bool {
        const field { key value next } = node
        if !self.found && text.Equal(key, expected) {
            self.value = .Some(value)
            self.found = true
        } else {
            const previous = replace self.remaining with .None
            self.remaining = .Some(own field {
                key = key
                value = value
                next = previous
            })
        }
        self.current = next
        true
    }
}

struct Array {
    head Option<own item>
    length u64

    fn Len(self) u64 {
        self.length
    }

    fn pushFront(&self, $value Value) void {
        const previous = replace self.head with .None
        self.head = .Some(own item { value = value next = previous })
        self.length = self.length + 1
    }

    fn reverse(&self) void {
        var state = itemReverse {
            current = replace self.head with .None
            result = .None
        }
        var running = true
        while running {
            const selected = replace state.current with .None
            running = state.step($selected)
        }
        const itemReverse { current result } = state
        discard current
        self.head = result
    }

    fn PopFront(&self) Option<Value> {
        const current = replace self.head with .None
        match current {
            None: .None
            Some(node): popItem(&self, $node)
        }
    }

    fn Add(&self, $value Value) void {
        self.reverse()
        self.pushFront($value)
        self.reverse()
    }
}

struct Object {
    fields Option<own field>
    length u64

    fn Len(self) u64 {
        self.length
    }

    // Copies the first remaining key without removing its value.
    fn FirstKey(&self) Option<String> {
        const selected = replace self.fields with .None
        match selected {
            None: .None
            Some(node): restoreFirstField(&self, $node)
        }
    }

    fn pushFront(&self, $key String, $value Value) void {
        const previous = replace self.fields with .None
        self.fields = .Some(own field { key = key value = value next = previous })
        self.length = self.length + 1
    }

    fn reverse(&self) void {
        var state = fieldReverse {
            current = replace self.fields with .None
            result = .None
        }
        var running = true
        while running {
            const selected = replace state.current with .None
            running = state.step($selected)
        }
        const fieldReverse { current result } = state
        discard current
        self.fields = result
    }

    fn hasKey(&self, expected String) bool {
        var state = fieldSearch {
            current = replace self.fields with .None
            result = .None
            found = false
        }
        var running = true
        while running {
            const selected = replace state.current with .None
            running = state.step(expected, $selected)
        }
        const fieldSearch { current result found } = state
        discard current
        self.fields = result
        found
    }

    fn Take(&self, expected String) Option<Value> {
        var state = fieldTake {
            current = replace self.fields with .None
            remaining = .None
            value = .None
            found = false
        }
        var running = true
        while running {
            const selected = replace state.current with .None
            running = state.step(expected, $selected)
        }
        const fieldTake { current remaining value found } = state
        discard current
        self.fields = remaining
        if found {
            self.length = self.length - 1
        }
        value
    }

    fn Set(&self, $key String, $value Value) Result<void, ObjectError> {
        if self.hasKey(key) {
            discard key
            discard value
            return .Err(.DuplicateKey)
        }
        self.pushFront($key, $value)
        .Ok
    }

    fn sort(&self) void {
        var state = fieldSort {
            pending = replace self.fields with .None
            sorted = .None
        }
        while state.step() {}
        state.reverse()
        const fieldSort { pending sorted } = state
        discard pending
        self.fields = sorted
    }

    fn popFront(&self) Option<entry> {
        const selected = replace self.fields with .None
        match selected {
            None: .None
            Some(node): popField(&self, $node)
        }
    }
}

struct entry {
    key String
    value Value
}

struct fieldSort {
    pending Option<own field>
    sorted Option<own field>

    fn step(&self) bool {
        const selected = replace self.pending with .None
        match selected {
            None: false
            Some(node): self.choose($node)
        }
    }

    fn choose(&self, $node own field) bool {
        const field { key value next } = node
        var choice = fieldChoice {
            bestKey = key
            bestValue = value
            candidates = next
            remaining = .None
        }
        while choice.step() {}
        const fieldChoice { bestKey bestValue candidates remaining } = choice
        discard candidates
        const previous = replace self.sorted with .None
        self.sorted = .Some(own field {
            key = bestKey
            value = bestValue
            next = previous
        })
        self.pending = remaining
        true
    }

    fn reverse(&self) void {
        var state = fieldReverse {
            current = replace self.sorted with .None
            result = .None
        }
        var running = true
        while running {
            const selected = replace state.current with .None
            running = state.step($selected)
        }
        const fieldReverse { current result } = state
        discard current
        self.sorted = result
    }
}

struct fieldChoice {
    bestKey String
    bestValue Value
    candidates Option<own field>
    remaining Option<own field>

    fn step(&self) bool {
        const selected = replace self.candidates with .None
        match selected {
            None: false
            Some(node): self.accept($node)
        }
    }

    fn accept(&self, $node own field) bool {
        const field { key value next } = node
        self.candidates = next
        if text.Compare(key, self.bestKey) < 0 {
            const previous = replace self.remaining with .None
            self.remaining = .Some(own field {
                key = replace self.bestKey with key
                value = replace self.bestValue with value
                next = previous
            })
        } else {
            const previous = replace self.remaining with .None
            self.remaining = .Some(own field {
                key = key
                value = value
                next = previous
            })
        }
        true
    }
}

fn restoreFirstField(&object Object, $node own field) Option<String> {
    const field { key value next } = node
    const result = text.Copy(key)
    object.fields = .Some(own field { key = key value = value next = next })
    .Some(result)
}

enum Value {
    Null
    Bool(bool)
    Number(String)
    Text(String)
    Array(own Array)
    Object(own Object)
}

struct parser {
    offset u64
    length u64

    fn skipWhitespace(&self, source String) void {
        var running = true
        while running && self.offset < self.length {
            const byte = readByte(source, self.offset)
            if byte == 32 || byte == 9 || byte == 10 || byte == 13 {
                self.offset = self.offset + 1
            } else {
                running = false
            }
        }
    }

    fn consume(&self, source String, expected String) bool {
        const end = self.offset + text.ByteLen(expected)
        if end > self.length {
            return false
        }
        const selected = readSlice(source, self.offset, end)
        if !text.Equal(selected, expected) {
            return false
        }
        self.offset = end
        true
    }

    fn parseHex(&self, source String) Result<u64, Error> {
        var result u64 = 0
        var count u64 = 0
        while count < 4 {
            if self.offset >= self.length {
                return .Err(parseError(.UnexpectedEnd, self.offset))
            }
            const digit = hexDigit(readByte(source, self.offset))
            if digit >= 16 {
                return .Err(parseError(.InvalidEscape, self.offset))
            }
            result = result * 16 + digit
            self.offset = self.offset + 1
            count = count + 1
        }
        .Ok(result)
    }

    fn parseString(&self, source String) Result<String, Error> {
        self.offset = self.offset + 1
        var builder = text.NewBuilder()
        var segment = self.offset
        while self.offset < self.length {
            const byte = readByte(source, self.offset)
            if byte == 34 {
                const appended = appendRange(&builder, source, segment, self.offset) else error {
                    discard error
                    return .Err(parseError(.InvalidString, self.offset))
                }
                discard appended
                self.offset = self.offset + 1
                const value = builder.Finish() else error {
                    discard error
                    return .Err(parseError(.InvalidString, self.offset))
                }
                return .Ok(value)
            }
            if byte < 32 {
                return .Err(parseError(.InvalidString, self.offset))
            }
            if byte != 92 {
                self.offset = self.offset + 1
            } else {
                const appended = appendRange(&builder, source, segment, self.offset) else error {
                    discard error
                    return .Err(parseError(.InvalidString, self.offset))
                }
                discard appended
                self.offset = self.offset + 1
                if self.offset >= self.length {
                    return .Err(parseError(.UnexpectedEnd, self.offset))
                }
                const escaped = readByte(source, self.offset)
                self.offset = self.offset + 1
                var codePoint u64 = 0
                const simple = simpleEscape(escaped)
                if simple != 0 {
                    codePoint = simple
                } else {
                    if escaped != 117 {
                        return .Err(parseError(.InvalidEscape, self.offset - 1))
                    }
                    const first = self.parseHex(source) else error {
                        return .Err(error)
                    }
                    if first >= 55296 && first <= 56319 {
                        if self.offset + 2 > self.length ||
                            readByte(source, self.offset) != 92 ||
                            readByte(source, self.offset + 1) != 117 {
                            return .Err(parseError(.InvalidEscape, self.offset))
                        }
                        self.offset = self.offset + 2
                        const second = self.parseHex(source) else error {
                            return .Err(error)
                        }
                        if second < 56320 || second > 57343 {
                            return .Err(parseError(.InvalidEscape, self.offset - 4))
                        }
                        codePoint = 65536 + (first - 55296) * 1024 + (second - 56320)
                    } else {
                        if first >= 56320 && first <= 57343 {
                            return .Err(parseError(.InvalidEscape, self.offset - 4))
                        } else {
                            codePoint = first
                        }
                    }
                }
                const wrote = builder.WriteCodePoint(codePoint) else error {
                    discard error
                    return .Err(parseError(.InvalidEscape, self.offset))
                }
                discard wrote
                segment = self.offset
            }
        }
        .Err(parseError(.UnexpectedEnd, self.offset))
    }

    fn parseNumber(&self, source String) Result<Value, Error> {
        const start = self.offset
        if readByte(source, self.offset) == 45 {
            self.offset = self.offset + 1
            if self.offset >= self.length {
                return .Err(parseError(.InvalidNumber, self.offset))
            }
        }
        const first = readByte(source, self.offset)
        if first == 48 {
            self.offset = self.offset + 1
            if self.offset < self.length && isDigit(readByte(source, self.offset)) {
                return .Err(parseError(.InvalidNumber, self.offset))
            }
        } else {
            if first >= 49 && first <= 57 {
                self.offset = self.offset + 1
                while self.offset < self.length && isDigit(readByte(source, self.offset)) {
                    self.offset = self.offset + 1
                }
            } else {
                return .Err(parseError(.InvalidNumber, self.offset))
            }
        }
        if self.offset < self.length && readByte(source, self.offset) == 46 {
            self.offset = self.offset + 1
            if self.offset >= self.length || !isDigit(readByte(source, self.offset)) {
                return .Err(parseError(.InvalidNumber, self.offset))
            }
            while self.offset < self.length && isDigit(readByte(source, self.offset)) {
                self.offset = self.offset + 1
            }
        }
        if self.offset < self.length &&
            (readByte(source, self.offset) == 101 || readByte(source, self.offset) == 69) {
            self.offset = self.offset + 1
            if self.offset < self.length &&
                (readByte(source, self.offset) == 43 || readByte(source, self.offset) == 45) {
                self.offset = self.offset + 1
            }
            if self.offset >= self.length || !isDigit(readByte(source, self.offset)) {
                return .Err(parseError(.InvalidNumber, self.offset))
            }
            while self.offset < self.length && isDigit(readByte(source, self.offset)) {
                self.offset = self.offset + 1
            }
        }
        .Ok(.Number(readSlice(source, start, self.offset)))
    }

    fn parseArray(&self, source String, depth u64) Result<own Array, Error> {
        self.offset = self.offset + 1
        self.skipWhitespace(source)
        var result = newArray()
        if self.offset < self.length && readByte(source, self.offset) == 93 {
            self.offset = self.offset + 1
            return .Ok(result)
        }
        var running = true
        while running {
            const value = self.parseValue(source, depth + 1) else error {
                return .Err(error)
            }
            result.pushFront($value)
            self.skipWhitespace(source)
            if self.offset >= self.length {
                return .Err(parseError(.UnexpectedEnd, self.offset))
            }
            const delimiter = readByte(source, self.offset)
            self.offset = self.offset + 1
            if delimiter == 93 {
                running = false
            } else {
                if delimiter != 44 {
                    return .Err(parseError(.UnexpectedToken, self.offset - 1))
                } else {
                    self.skipWhitespace(source)
                }
            }
        }
        result.reverse()
        .Ok(result)
    }

    fn parseObject(&self, source String, depth u64) Result<own Object, Error> {
        self.offset = self.offset + 1
        self.skipWhitespace(source)
        var result = newObject()
        if self.offset < self.length && readByte(source, self.offset) == 125 {
            self.offset = self.offset + 1
            return .Ok(result)
        }
        var running = true
        while running {
            if self.offset >= self.length {
                return .Err(parseError(.UnexpectedEnd, self.offset))
            }
            if readByte(source, self.offset) != 34 {
                return .Err(parseError(.UnexpectedToken, self.offset))
            }
            const key = self.parseString(source) else error {
                return .Err(error)
            }
            if result.hasKey(key) {
                return .Err(parseError(.DuplicateKey, self.offset))
            }
            self.skipWhitespace(source)
            if self.offset >= self.length || readByte(source, self.offset) != 58 {
                return .Err(parseError(.UnexpectedToken, self.offset))
            }
            self.offset = self.offset + 1
            self.skipWhitespace(source)
            const value = self.parseValue(source, depth + 1) else error {
                return .Err(error)
            }
            result.pushFront($key, $value)
            self.skipWhitespace(source)
            if self.offset >= self.length {
                return .Err(parseError(.UnexpectedEnd, self.offset))
            }
            const delimiter = readByte(source, self.offset)
            self.offset = self.offset + 1
            if delimiter == 125 {
                running = false
            } else {
                if delimiter != 44 {
                    return .Err(parseError(.UnexpectedToken, self.offset - 1))
                } else {
                    self.skipWhitespace(source)
                }
            }
        }
        result.reverse()
        .Ok(result)
    }

    fn parseValue(&self, source String, depth u64) Result<Value, Error> {
        if depth > 128 {
            return .Err(parseError(.DepthLimit, self.offset))
        }
        self.skipWhitespace(source)
        if self.offset >= self.length {
            return .Err(parseError(.UnexpectedEnd, self.offset))
        }
        const byte = readByte(source, self.offset)
        if byte == 34 {
            const value = self.parseString(source) else error {
                return .Err(error)
            }
            return .Ok(.Text(value))
        }
        if byte == 91 {
            const value = self.parseArray(source, depth) else error {
                return .Err(error)
            }
            return .Ok(.Array(value))
        }
        if byte == 123 {
            const value = self.parseObject(source, depth) else error {
                return .Err(error)
            }
            return .Ok(.Object(value))
        }
        const nullValue = "null"
        if byte == 110 && self.consume(source, nullValue) {
            return .Ok(.Null)
        }
        const trueValue = "true"
        if byte == 116 && self.consume(source, trueValue) {
            return .Ok(.Bool(true))
        }
        const falseValue = "false"
        if byte == 102 && self.consume(source, falseValue) {
            return .Ok(.Bool(false))
        }
        if byte == 45 || isDigit(byte) {
            return self.parseNumber(source)
        }
        .Err(parseError(.UnexpectedToken, self.offset))
    }
}

fn popItem(&array Array, $node own item) Option<Value> {
    const item { value next } = node
    array.head = next
    array.length = array.length - 1
    .Some(value)
}

fn popField(&object Object, $node own field) Option<entry> {
    const field { key value next } = node
    object.fields = next
    object.length = object.length - 1
    .Some(entry { key = key value = value })
}

fn newArray() own Array {
    own Array { head = .None length = 0 }
}

fn newObject() own Object {
    own Object { fields = .None length = 0 }
}

fn parseError(kind ErrorKind, offset u64) Error {
    Error { Kind = kind Offset = offset }
}

fn readByte(source String, offset u64) u64 {
    const value = text.ByteAt(source, offset) else error {
        discard error
        panic("JSON parser byte invariant failed")
    }
    value
}

fn readSlice(source String, start u64, end u64) String {
    const value = text.Slice(source, start, end) else error {
        discard error
        panic("JSON parser slice invariant failed")
    }
    value
}

fn appendRange(
    &builder text.Builder,
    source String,
    start u64,
    end u64
) Result<bool, text.BuilderError> {
    if start == end {
        return .Ok(true)
    }
    const value = readSlice(source, start, end)
    builder.Write(value)
}

fn isDigit(value u64) bool {
    value >= 48 && value <= 57
}

fn simpleEscape(value u64) u64 {
    if value == 34 || value == 47 || value == 92 {
        return value
    }
    if value == 98 {
        return 8
    }
    if value == 102 {
        return 12
    }
    if value == 110 {
        return 10
    }
    if value == 114 {
        return 13
    }
    if value == 116 {
        return 9
    }
    0
}

fn hexDigit(value u64) u64 {
    if value >= 48 && value <= 57 {
        return value - 48
    }
    if value >= 65 && value <= 70 {
        return value - 55
    }
    if value >= 97 && value <= 102 {
        return value - 87
    }
    16
}

fn Parse(source String) Result<Value, Error> {
    var state = parser { offset = 0 length = text.ByteLen(source) }
    const rootDepth u64 = 0
    const value = state.parseValue(source, rootDepth) else error {
        return .Err(error)
    }
    state.skipWhitespace(source)
    if state.offset != state.length {
        return .Err(parseError(.TrailingData, state.offset))
    }
    .Ok(value)
}

fn NewArray() own Array {
    newArray()
}

fn NewObject() own Object {
    newObject()
}

fn Stringify($value Value) Result<String, WriteError> {
    var builder = text.NewBuilder()
    writeValue(&builder, $value, 0) else error {
        discard builder.Close()
        return .Err(error)
    }
    const result = builder.Finish() else error {
        discard error
        return .Err(WriteError { Kind = .Builder })
    }
    .Ok(result)
}

fn writeValue(
    &builder text.Builder,
    $value Value,
    depth u64
) Result<void, WriteError> {
    if depth > 128 {
        discard value
        return .Err(WriteError { Kind = .DepthLimit })
    }
    match value {
        Null: writeRaw(&builder, "null")
        Bool(state): writeRaw(&builder, "true" if state else "false")
        Number(number): writeNumber(&builder, number)
        Text(value): writeString(&builder, value)
        Array(array): writeArray(&builder, $array, depth)
        Object(object): writeObject(&builder, $object, depth)
    }
}

fn writeArray(
    &builder text.Builder,
    $array own Array,
    depth u64
) Result<void, WriteError> {
    var values = array
    writeRaw(&builder, "[") else error {
        return .Err(error)
    }
    var first = true
    while values.Len() > 0 {
        if !first {
            writeRaw(&builder, ",") else error {
                return .Err(error)
            }
        }
        const selected = values.PopFront()
        const value = match selected {
            None: missingValue()
            Some(current): current
        }
        writeValue(&builder, $value, depth + 1) else error {
            return .Err(error)
        }
        first = false
    }
    writeRaw(&builder, "]")
}

fn writeObject(
    &builder text.Builder,
    $object own Object,
    depth u64
) Result<void, WriteError> {
    var fields = object
    fields.sort()
    writeRaw(&builder, "{") else error {
        return .Err(error)
    }
    var first = true
    while fields.Len() > 0 {
        if !first {
            writeRaw(&builder, ",") else error {
                return .Err(error)
            }
        }
        const selected = fields.popFront()
        const current = match selected {
            None: missingEntry()
            Some(found): found
        }
        const entry { key value } = current
        writeString(&builder, key) else error {
            discard value
            return .Err(error)
        }
        writeRaw(&builder, ":") else error {
            discard value
            return .Err(error)
        }
        writeValue(&builder, $value, depth + 1) else error {
            return .Err(error)
        }
        first = false
    }
    writeRaw(&builder, "}")
}

fn writeNumber(
    &builder text.Builder,
    value String
) Result<void, WriteError> {
    const parsed = Parse(value) else error {
        discard error
        return .Err(WriteError { Kind = .InvalidNumber })
    }
    const valid = match parsed {
        Number(canonical): text.Equal(canonical, value)
        Null: false
        Bool(state): state && false
        Text(textValue): !textValue && false
        Array(array): array.Len() == 0 && false
        Object(object): object.Len() == 0 && false
    }
    if !valid {
        return .Err(WriteError { Kind = .InvalidNumber })
    }
    writeRaw(&builder, value)
}

fn writeString(
    &builder text.Builder,
    value String
) Result<void, WriteError> {
    writeRaw(&builder, "\"") else error {
        return .Err(error)
    }
    const length = text.ByteLen(value)
    var segment u64 = 0
    var offset u64 = 0
    while offset < length {
        const byte = readByte(value, offset)
        if byte == 34 || byte == 92 || byte < 32 {
            writeRange(&builder, value, segment, offset) else error {
                return .Err(error)
            }
            writeEscapedByte(&builder, byte) else error {
                return .Err(error)
            }
            segment = offset + 1
        }
        offset = offset + 1
    }
    writeRange(&builder, value, segment, length) else error {
        return .Err(error)
    }
    writeRaw(&builder, "\"")
}

fn writeEscapedByte(
    &builder text.Builder,
    value u64
) Result<void, WriteError> {
    if value == 34 return writeRaw(&builder, "\\\"")
    if value == 92 return writeRaw(&builder, "\\\\")
    if value == 8 return writeRaw(&builder, "\\b")
    if value == 9 return writeRaw(&builder, "\\t")
    if value == 10 return writeRaw(&builder, "\\n")
    if value == 12 return writeRaw(&builder, "\\f")
    if value == 13 return writeRaw(&builder, "\\r")
    writeRaw(&builder, "\\u00") else error {
        return .Err(error)
    }
    writeHexDigit(&builder, value / 16) else error {
        return .Err(error)
    }
    writeHexDigit(&builder, value % 16)
}

fn writeHexDigit(
    &builder text.Builder,
    value u64
) Result<void, WriteError> {
    const code = value + 48 if value < 10 else value + 87
    const written = builder.WriteCodePoint(code) else error {
        discard error
        return .Err(WriteError { Kind = .Builder })
    }
    if !written {
        return .Err(WriteError { Kind = .Builder })
    }
    .Ok
}

fn writeRange(
    &builder text.Builder,
    value String,
    start u64,
    end u64
) Result<void, WriteError> {
    if start == end return .Ok
    const part = readSlice(value, start, end)
    writeRaw(&builder, part)
}

fn writeRaw(
    &builder text.Builder,
    value String
) Result<void, WriteError> {
    const written = builder.Write(value) else error {
        discard error
        return .Err(WriteError { Kind = .Builder })
    }
    if !written {
        return .Err(WriteError { Kind = .Builder })
    }
    .Ok
}

fn missingValue() Value {
    panic("JSON writer value invariant failed")
}

fn missingEntry() entry {
    panic("JSON writer object invariant failed")
}
