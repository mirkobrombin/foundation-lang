package std.env

enum Error {
    InvalidName
    InvalidUtf8
    Platform
}

extern c fn read(name String, &value String) i32 as foundation_runtime_env_read

fn Get(name String) Result<Option<String>, Error> {
    var value = ""
    const status = read(name, &value)
    if status == 0 {
        return .Ok(.None)
    }
    if status == 1 {
        return .Ok(.Some(value))
    }
    if status == 2 {
        return .Err(.InvalidName)
    }
    if status == 3 {
        return .Err(.InvalidUtf8)
    }
    .Err(.Platform)
}

@target(linux)
fn Home() Result<Option<String>, Error> {
    const name = "HOME"
    Get(name)
}

@target(macos)
fn Home() Result<Option<String>, Error> {
    const name = "HOME"
    Get(name)
}

@target(windows)
fn Home() Result<Option<String>, Error> {
    const name = "USERPROFILE"
    Get(name)
}
