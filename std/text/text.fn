package std.text

enum RangeError {
    OutOfBounds
    InvalidBoundary
}

enum BuilderError {
    Closed
    InvalidCodePoint
}

extern c fn copyNative(value String) String as foundation_runtime_string_copy
extern c fn byteLengthNative(value String) u64 as foundation_runtime_string_byte_length
extern c fn containsNative(value String, part String) bool as foundation_runtime_string_contains
extern c fn startsWithNative(value String, prefix String) bool as foundation_runtime_string_starts_with
extern c fn endsWithNative(value String, suffix String) bool as foundation_runtime_string_ends_with
extern c fn sliceNative(value String, start u64, end u64, &result String) i32 as foundation_runtime_string_slice
extern c fn byteAtNative(value String, index u64, &result u64) i32 as foundation_runtime_string_byte_at
extern c fn findNative(value String, part String, &result u64) bool as foundation_runtime_string_find
extern c fn compareNative(left String, right String) i32 as foundation_runtime_string_compare
extern c fn openBuilderNative() u64 as foundation_runtime_string_builder_open
extern c fn appendBuilderNative(handle u64, value String) void as foundation_runtime_string_builder_append
extern c fn appendCodePointNative(handle u64, value u64) bool as foundation_runtime_string_builder_append_code_point
extern c fn finishBuilderNative(handle u64) String as foundation_runtime_string_builder_finish
extern c fn closeBuilderNative(handle u64) void as foundation_runtime_string_builder_close

struct Builder {
    handle u64

    fn Write(&self, value String) Result<bool, BuilderError> {
        if self.handle == 0 {
            return .Err(.Closed)
        }
        appendBuilderNative(self.handle, value)
        .Ok(true)
    }

    fn WriteCodePoint(&self, value u64) Result<bool, BuilderError> {
        if self.handle == 0 {
            return .Err(.Closed)
        }
        if appendCodePointNative(self.handle, value) {
            return .Ok(true)
        }
        .Err(.InvalidCodePoint)
    }

    fn Finish(&self) Result<String, BuilderError> {
        const handle = replace self.handle with 0
        if handle == 0 {
            return .Err(.Closed)
        }
        .Ok(finishBuilderNative(handle))
    }

    fn Close(&self) bool {
        const handle = replace self.handle with 0
        if handle == 0 {
            return false
        }
        closeBuilderNative(handle)
        true
    }

    fn drop(&self) void {
        const handle = replace self.handle with 0
        if handle != 0 {
            closeBuilderNative(handle)
        }
    }
}

fn NewBuilder() own Builder {
    own Builder { handle = openBuilderNative() }
}

fn Copy(value String) String {
    copyNative(value)
}

fn ByteLen(value String) u64 {
    byteLengthNative(value)
}

fn IsEmpty(value String) bool {
    ByteLen(value) == 0
}

fn Contains(value String, part String) bool {
    containsNative(value, part)
}

fn StartsWith(value String, prefix String) bool {
    startsWithNative(value, prefix)
}

fn EndsWith(value String, suffix String) bool {
    endsWithNative(value, suffix)
}

fn Slice(value String, start u64, end u64) Result<String, RangeError> {
    var result = ""
    const status = sliceNative(value, start, end, &result)
    if status == 0 {
        return .Ok(result)
    }
    if status == 1 {
        return .Err(.OutOfBounds)
    }
    .Err(.InvalidBoundary)
}

fn ByteAt(value String, index u64) Result<u64, RangeError> {
    var result u64 = 0
    const status = byteAtNative(value, index, &result)
    if status == 0 {
        return .Ok(result)
    }
    .Err(.OutOfBounds)
}

fn Find(value String, part String) Option<u64> {
    var result u64 = 0
    if findNative(value, part, &result) {
        return .Some(result)
    }
    .None
}

fn Compare(left String, right String) i32 {
    compareNative(left, right)
}

fn Equal(left String, right String) bool {
    Compare(left, right) == 0
}
