package std.net

import std.bytes
import std.concurrent
import std.time

// Classifies portable DNS, TCP, deadline, and stream failures.
enum Error {
    // Rejects an empty host, invalid port, or malformed local address.
    InvalidAddress
    // Reports that the platform resolver could not produce an address.
    ResolveFailed
    // Reports that every resolved address refused the connection.
    Refused
    // Reports use of a closed stream or closure by its peer.
    Closed
    // Reports structured cancellation of a pending operation.
    Cancelled
    // Reports bytes that cannot form a Foundation String.
    InvalidUtf8
    // Reports a line beyond its explicit byte bound.
    LineTooLong
    // Reports a local listener address already bound by another socket.
    AddressInUse
    // Reports expiry of an absolute monotonic deadline.
    Timeout
    // Rejects a zero or platform-unrepresentable byte limit.
    InvalidLimit
    // Reports another platform networking failure.
    Io
}

@blocking
extern c fn resolveNative(
    host String,
    port u64,
    &addresses u64
) i32 as foundation_runtime_net_resolve

extern c fn closeAddressesNative(
    addresses u64
) void as foundation_runtime_net_addresses_close

extern c fn listenNative(
    address String,
    port u64,
    backlog u64,
    &listener u64,
    &boundPort u64
) i32 as foundation_runtime_net_listen

extern c fn closeListenerNative(
    listener u64
) void as foundation_runtime_net_listener_close

@callback(cancel = foundation_runtime_net_accept_cancel)
extern c fn acceptNative(
    listener u64,
    &connection u64
) i32 as foundation_runtime_net_accept_start

@callback(cancel = foundation_runtime_net_connect_cancel)
extern c fn connectNative(
    addresses u64,
    &connection u64
) i32 as foundation_runtime_net_connect_start

@callback(cancel = foundation_runtime_net_connect_cancel)
extern c fn connectUntilNative(
    addresses u64,
    deadline u64,
    &connection u64
) i32 as foundation_runtime_net_connect_until_start

extern c fn splitNative(
    connection u64,
    &reader u64,
    &writer u64
) i32 as foundation_runtime_net_split
extern c fn peerAddressNative(
    connection u64,
    &address String
) i32 as foundation_runtime_net_peer_address
extern c fn closeConnectionNative(
    connection u64
) void as foundation_runtime_net_connection_close
extern c fn closeReaderNative(
    reader u64
) void as foundation_runtime_net_reader_close
extern c fn closeWriterNative(
    writer u64
) void as foundation_runtime_net_writer_close

@callback(cancel = foundation_runtime_net_read_line_cancel)
extern c fn readLineNative(
    reader u64,
    limit u64,
    &line String
) i32 as foundation_runtime_net_read_line_start

@callback(cancel = foundation_runtime_net_read_line_cancel)
extern c fn readLineUntilNative(
    reader u64,
    limit u64,
    deadline u64,
    &line String
) i32 as foundation_runtime_net_read_line_until_start

@callback(cancel = foundation_runtime_net_read_exact_cancel)
extern c fn readExactNative(
    reader u64,
    length u64,
    &text String
) i32 as foundation_runtime_net_read_exact_start

@callback(cancel = foundation_runtime_net_read_exact_cancel)
extern c fn readExactUntilNative(
    reader u64,
    length u64,
    deadline u64,
    &text String
) i32 as foundation_runtime_net_read_exact_until_start

@callback(cancel = foundation_runtime_net_read_exact_cancel)
extern c fn readExactBytesNative(
    reader u64,
    length u64,
    &value u64
) i32 as foundation_runtime_net_read_exact_bytes_start

@callback(cancel = foundation_runtime_net_read_exact_cancel)
extern c fn readExactBytesUntilNative(
    reader u64,
    length u64,
    deadline u64,
    &value u64
) i32 as foundation_runtime_net_read_exact_bytes_until_start

@callback(cancel = foundation_runtime_net_read_some_bytes_cancel)
extern c fn readSomeBytesNative(
    reader u64,
    limit u64,
    &value u64
) i32 as foundation_runtime_net_read_some_bytes_start

@callback(cancel = foundation_runtime_net_read_some_bytes_cancel)
extern c fn readSomeBytesUntilNative(
    reader u64,
    limit u64,
    deadline u64,
    &value u64
) i32 as foundation_runtime_net_read_some_bytes_until_start

@callback(cancel = foundation_runtime_net_write_all_cancel)
extern c fn writeAllNative(
    writer u64,
    text String
) i32 as foundation_runtime_net_write_all_start

@callback(cancel = foundation_runtime_net_write_all_cancel)
extern c fn writeAllUntilNative(
    writer u64,
    text String,
    deadline u64
) i32 as foundation_runtime_net_write_all_until_start

@callback(cancel = foundation_runtime_net_write_all_cancel)
extern c fn writeAllBytesNative(
    writer u64,
    value u64
) i32 as foundation_runtime_net_write_all_bytes_start

@callback(cancel = foundation_runtime_net_write_all_cancel)
extern c fn writeAllBytesUntilNative(
    writer u64,
    value u64,
    deadline u64
) i32 as foundation_runtime_net_write_all_bytes_until_start

fn errorFor(status i32) Error {
    if status == 1 {
        return .InvalidAddress
    }
    if status == 2 {
        return .ResolveFailed
    }
    if status == 3 {
        return .Refused
    }
    if status == 4 {
        return .Closed
    }
    if status == 5 {
        return .Cancelled
    }
    if status == 6 {
        return .InvalidUtf8
    }
    if status == 7 {
        return .LineTooLong
    }
    if status == 9 {
        return .Closed
    }
    if status == 10 {
        return .AddressInUse
    }
    if status == 11 {
        return .Timeout
    }
    if status == 12 {
        return .InvalidLimit
    }
    .Io
}

// Stores one absolute monotonic deadline for a complete network operation set.
struct Deadline {
    nanoseconds u64
}

// Owns one bound TCP listening socket.
struct TcpListener {
    handle u64
    // Reports the actual local port, including an OS-selected port.
    Port u64

    // Closes a pending accept explicitly so an owning server lifecycle can stop promptly.
    fn Close(&self) bool {
        const handle = replace self.handle with 0
        if handle == 0 return false
        closeListenerNative(handle)
        true
    }

    fn drop(&self) void {
        const handle = replace self.handle with 0
        if handle != 0 {
            closeListenerNative(handle)
        }
    }
}

// Owns one connected TCP socket before it is split into stream halves.
struct TcpConnection {
    handle u64

    // Returns the numeric peer IP address without its transport port.
    fn PeerAddress(self) Result<String, Error> {
        var address = ""
        const status = peerAddressNative(self.handle, &address)
        if status == 0 return .Ok(address)
        .Err(errorFor(status))
    }

    // Consumes the connection and produces independent stream halves.
    fn Split($self) Result<StreamPair, Error> {
        var reader u64 = 0
        var writer u64 = 0
        const status = splitNative(self.handle, &reader, &writer)
        if status == 0 {
            return .Ok(StreamPair {
                Reader = own TcpReader { handle = reader }
                Writer = own TcpWriter { handle = writer }
            })
        }
        .Err(errorFor(status))
    }

    fn drop(&self) void {
        const handle = replace self.handle with 0
        if handle != 0 {
            closeConnectionNative(handle)
        }
    }
}

// Owns the readable half of one TCP connection.
@concurrent.Transferable()
struct TcpReader {
    handle u64

    fn drop(&self) void {
        const handle = replace self.handle with 0
        if handle != 0 {
            closeReaderNative(handle)
        }
    }
}

// Owns the writable half of one TCP connection.
@concurrent.Transferable()
struct TcpWriter {
    handle u64

    fn drop(&self) void {
        const handle = replace self.handle with 0
        if handle != 0 {
            closeWriterNative(handle)
        }
    }
}

// Returns independent read and write owners for one connection.
@concurrent.Transferable()
struct StreamPair {
    // Owns all future reads from the connection.
    Reader own TcpReader
    // Owns all future writes to the connection.
    Writer own TcpWriter
}

// Restores a listener owner beside one accepted connection result.
struct AcceptOutcome {
    // Restores the listener for another acceptance operation.
    Listener own TcpListener
    // Contains the accepted connection or its typed failure.
    Value Result<own TcpConnection, Error>
}

// Restores a reader owner beside one optional line result.
struct ReadLineOutcome {
    // Restores the reader after completion, EOF, timeout, or failure.
    Reader own TcpReader
    // Distinguishes a line, EOF, and a typed stream failure.
    Value Result<Option<String>, Error>
}

// Restores a reader owner beside one exact text result.
struct ReadOutcome {
    // Restores the reader after completion, timeout, or failure.
    Reader own TcpReader
    // Contains the exact UTF-8 bytes or a typed stream failure.
    Value Result<String, Error>
}

// Restores a reader owner beside one exact binary result.
struct ReadBytesOutcome {
    // Restores the reader after completion, timeout, or failure.
    Reader own TcpReader
    // Contains arbitrary bytes without applying UTF-8 validation.
    Value Result<own bytes.Bytes, Error>
}

// Restores a reader owner beside one bounded binary chunk or clean EOF.
struct ReadSomeBytesOutcome {
    // Restores the reader after completion, EOF, timeout, or failure.
    Reader own TcpReader
    // Distinguishes a non-empty arbitrary byte chunk, EOF, and failure.
    Value Result<Option<own bytes.Bytes>, Error>
}

// Restores a writer owner beside one complete-write result.
struct WriteOutcome {
    // Restores the writer after completion, timeout, or failure.
    Writer own TcpWriter
    // Confirms a complete write or preserves its typed failure.
    Value Result<void, Error>
}

// Binds one local address. Port zero asks the OS to choose.
fn Listen($address String, port u64) Result<own TcpListener, Error> {
    const defaultBacklog u64 = 128
    var listener u64 = 0
    var boundPort u64 = 0
    const status = listenNative(
        address,
        port,
        defaultBacklog,
        &listener,
        &boundPort
    )
    if status == 0 {
        return .Ok(own TcpListener { handle = listener Port = boundPort })
    }
    .Err(errorFor(status))
}

// Creates one absolute monotonic deadline from a positive duration.
fn DeadlineAfter(duration time.Duration) Result<Deadline, Error> {
    const signed = duration.Nanoseconds()
    if signed <= 0 return .Err(.Timeout)
    const durationNanoseconds = u64.From(signed) else error {
        discard error
        return .Err(.Timeout)
    }
    const now = time.MonotonicNow().Nanoseconds()
    const maximum u64 = 18446744073709551614
    const deadline = if durationNanoseconds > maximum - now {
        maximum
    } else {
        now + durationNanoseconds
    }
    .Ok(Deadline { nanoseconds = deadline })
}

// Accepts one connection and restores the listener for the next call.
task Accept($listener own TcpListener) AcceptOutcome {
    var connection u64 = 0
    const status = acceptNative(listener.handle, &connection)
    if status == 0 {
        return AcceptOutcome {
            Listener = listener
            Value = .Ok(own TcpConnection { handle = connection })
        }
    }
    AcceptOutcome { Listener = listener Value = .Err(errorFor(status)) }
}

// Resolves and opens one TCP connection outside the Foundation executor.
task Connect($host String, port u64) Result<own TcpConnection, Error> {
    var addresses u64 = 0
    const resolveStatus = resolveNative(host, port, &addresses)
    if resolveStatus != 0 {
        return .Err(errorFor(resolveStatus))
    }

    var connection u64 = 0
    const connectStatus = connectNative(addresses, &connection)
    closeAddressesNative(addresses)
    if connectStatus == 0 {
        return .Ok(own TcpConnection { handle = connection })
    }
    .Err(errorFor(connectStatus))
}

// Resolves and connects before one absolute monotonic deadline.
task ConnectUntil(
    $host String,
    port u64,
    deadline Deadline
) Result<own TcpConnection, Error> {
    var addresses u64 = 0
    const resolveStatus = resolveNative(host, port, &addresses)
    if resolveStatus != 0 {
        return .Err(errorFor(resolveStatus))
    }

    var connection u64 = 0
    const connectStatus = connectUntilNative(
        addresses,
        deadline.nanoseconds,
        &connection
    )
    closeAddressesNative(addresses)
    if connectStatus == 0 {
        return .Ok(own TcpConnection { handle = connection })
    }
    .Err(errorFor(connectStatus))
}

// Reads one UTF-8 line and returns ownership of the reader with the result.
task ReadLine($reader own TcpReader) ReadLineOutcome {
    const defaultLimit u64 = 16777216
    var line = ""
    const status = readLineNative(reader.handle, defaultLimit, &line)
    if status == 0 {
        return ReadLineOutcome { Reader = reader Value = .Ok(.Some(line)) }
    }
    if status == 9 {
        return ReadLineOutcome { Reader = reader Value = .Ok(.None) }
    }
    ReadLineOutcome { Reader = reader Value = .Err(errorFor(status)) }
}

// Reads one UTF-8 line up to the caller-provided byte limit.
task ReadLineLimited($reader own TcpReader, limit u64) ReadLineOutcome {
    var line = ""
    const status = readLineNative(reader.handle, limit, &line)
    if status == 0 {
        return ReadLineOutcome { Reader = reader Value = .Ok(.Some(line)) }
    }
    if status == 9 {
        return ReadLineOutcome { Reader = reader Value = .Ok(.None) }
    }
    ReadLineOutcome { Reader = reader Value = .Err(errorFor(status)) }
}

// Reads one bounded UTF-8 line before an absolute monotonic deadline.
task ReadLineLimitedUntil(
    $reader own TcpReader,
    limit u64,
    deadline Deadline
) ReadLineOutcome {
    var line = ""
    const status = readLineUntilNative(
        reader.handle,
        limit,
        deadline.nanoseconds,
        &line
    )
    if status == 0 {
        return ReadLineOutcome { Reader = reader Value = .Ok(.Some(line)) }
    }
    if status == 9 {
        return ReadLineOutcome { Reader = reader Value = .Ok(.None) }
    }
    ReadLineOutcome { Reader = reader Value = .Err(errorFor(status)) }
}

// Reads exactly length UTF-8 bytes and returns ownership of the reader.
task ReadExact($reader own TcpReader, length u64) ReadOutcome {
    var text = ""
    const status = readExactNative(reader.handle, length, &text)
    if status == 0 {
        return ReadOutcome { Reader = reader Value = .Ok(text) }
    }
    ReadOutcome { Reader = reader Value = .Err(errorFor(status)) }
}

// Reads exactly length UTF-8 bytes before an absolute monotonic deadline.
task ReadExactUntil(
    $reader own TcpReader,
    length u64,
    deadline Deadline
) ReadOutcome {
    var text = ""
    const status = readExactUntilNative(
        reader.handle,
        length,
        deadline.nanoseconds,
        &text
    )
    if status == 0 {
        return ReadOutcome { Reader = reader Value = .Ok(text) }
    }
    ReadOutcome { Reader = reader Value = .Err(errorFor(status)) }
}

// Reads exactly length arbitrary bytes and returns ownership of the reader.
task ReadExactBytes(
    $reader own TcpReader,
    length u64
) ReadBytesOutcome {
    var handle u64 = 0
    const status = readExactBytesNative(reader.handle, length, &handle)
    if status == 0 {
        const value = bytes.ClaimRuntimeHandle(handle) else error {
            discard error
            return ReadBytesOutcome {
                Reader = reader
                Value = .Err(.Io)
            }
        }
        return ReadBytesOutcome { Reader = reader Value = .Ok(value) }
    }
    ReadBytesOutcome { Reader = reader Value = .Err(errorFor(status)) }
}

// Reads exactly length arbitrary bytes before a monotonic deadline.
task ReadExactBytesUntil(
    $reader own TcpReader,
    length u64,
    deadline Deadline
) ReadBytesOutcome {
    var handle u64 = 0
    const status = readExactBytesUntilNative(
        reader.handle,
        length,
        deadline.nanoseconds,
        &handle
    )
    if status == 0 {
        const value = bytes.ClaimRuntimeHandle(handle) else error {
            discard error
            return ReadBytesOutcome {
                Reader = reader
                Value = .Err(.Io)
            }
        }
        return ReadBytesOutcome { Reader = reader Value = .Ok(value) }
    }
    ReadBytesOutcome { Reader = reader Value = .Err(errorFor(status)) }
}

// Reads one non-empty arbitrary byte chunk up to the caller-provided limit.
task ReadSomeBytes(
    $reader own TcpReader,
    limit u64
) ReadSomeBytesOutcome {
    var handle u64 = 0
    const status = readSomeBytesNative(reader.handle, limit, &handle)
    if status == 0 {
        const value = bytes.ClaimRuntimeHandle(handle) else error {
            discard error
            return ReadSomeBytesOutcome {
                Reader = reader
                Value = .Err(.Io)
            }
        }
        return ReadSomeBytesOutcome {
            Reader = reader
            Value = .Ok(.Some(value))
        }
    }
    if status == 9 {
        return ReadSomeBytesOutcome { Reader = reader Value = .Ok(.None) }
    }
    ReadSomeBytesOutcome { Reader = reader Value = .Err(errorFor(status)) }
}

// Reads one non-empty arbitrary byte chunk before a monotonic deadline.
task ReadSomeBytesUntil(
    $reader own TcpReader,
    limit u64,
    deadline Deadline
) ReadSomeBytesOutcome {
    var handle u64 = 0
    const status = readSomeBytesUntilNative(
        reader.handle,
        limit,
        deadline.nanoseconds,
        &handle
    )
    if status == 0 {
        const value = bytes.ClaimRuntimeHandle(handle) else error {
            discard error
            return ReadSomeBytesOutcome {
                Reader = reader
                Value = .Err(.Io)
            }
        }
        return ReadSomeBytesOutcome {
            Reader = reader
            Value = .Ok(.Some(value))
        }
    }
    if status == 9 {
        return ReadSomeBytesOutcome { Reader = reader Value = .Ok(.None) }
    }
    ReadSomeBytesOutcome { Reader = reader Value = .Err(errorFor(status)) }
}

// Writes the complete UTF-8 string and returns ownership of the writer.
task WriteAll($writer own TcpWriter, $text String) WriteOutcome {
    const status = writeAllNative(writer.handle, text)
    if status == 0 {
        return WriteOutcome { Writer = writer Value = .Ok }
    }
    WriteOutcome { Writer = writer Value = .Err(errorFor(status)) }
}

// Writes the complete UTF-8 string before an absolute monotonic deadline.
task WriteAllUntil(
    $writer own TcpWriter,
    $text String,
    deadline Deadline
) WriteOutcome {
    const status = writeAllUntilNative(
        writer.handle,
        text,
        deadline.nanoseconds
    )
    if status == 0 {
        return WriteOutcome { Writer = writer Value = .Ok }
    }
    WriteOutcome { Writer = writer Value = .Err(errorFor(status)) }
}

// Writes complete arbitrary bytes and returns ownership of the writer.
task WriteAllBytes(
    $writer own TcpWriter,
    $value own bytes.Bytes
) WriteOutcome {
    const status = writeAllBytesNative(
        writer.handle,
        bytes.RuntimeHandle(value)
    )
    discard value
    if status == 0 {
        return WriteOutcome { Writer = writer Value = .Ok }
    }
    WriteOutcome { Writer = writer Value = .Err(errorFor(status)) }
}

// Writes complete arbitrary bytes before a monotonic deadline.
task WriteAllBytesUntil(
    $writer own TcpWriter,
    $value own bytes.Bytes,
    deadline Deadline
) WriteOutcome {
    const status = writeAllBytesUntilNative(
        writer.handle,
        bytes.RuntimeHandle(value),
        deadline.nanoseconds
    )
    discard value
    if status == 0 {
        return WriteOutcome { Writer = writer Value = .Ok }
    }
    WriteOutcome { Writer = writer Value = .Err(errorFor(status)) }
}
