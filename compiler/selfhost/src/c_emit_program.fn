package foundation.compiler

import std.text

fn cExportedFunction(&program firProgram, id u64) bool {
    const function = match program.functions.take(id) {
        None: panic("FIR function slot is empty")
        Some(found): found
    }
    const exported = function.hasBody && optionStringPresent(function.cSymbol)
    program.functions.restore(id, $function)
    exported
}

// Monomorphizes for one backend: from the test entry, from main, or, for a
// native library, from the C exports of one package. A library program has
// no main function.
fn cBackendProgram(
    &source firProgram,
    testEntry Option<u64>,
    library Option<String>
) own firProgram {
    match library {
        Some(packageName): {
            return monomorphizeLibraryProgram(&source, packageName)
        }
        None: {}
    }
    match testEntry {
        None: monomorphizeProgram(&source)
        Some(entry): monomorphizeProgramEntry(&source, entry)
    }
}

fn emitSelfHostedCImpl(
    &source firProgram,
    sourcePath String,
    testEntry Option<u64>,
    library Option<String>,
    freestanding bool
) String {
    const libraryBuild = optionStringPresent(library)
    var program = cBackendProgram(&source, testEntry, library)
    var collected = cCollectTypes(&program)
    var contractUses = cCollectContractUses(&program)
    var builder = text.NewBuilder()
    if freestanding {
        cEmitFreestandingPreamble(&builder)
    } else {
        cEmitPreamble(&builder, true)
    }
    cEmitTypeForwards(&builder, &program, &collected)
    cEmitFunctionTypeDefinitions(&builder, &collected)
    cEmitSliceDefinitions(&builder, &collected)
    cEmitInlineTypeDefinitions(&builder, &program, &collected)
    cEmitContractDefinitions(&builder, &program)
    var functionIndex u64 = 0
    while functionIndex < program.functions.len() {
        cEmitClosureEnvironmentDefinition(
            &builder, &program, functionIndex)
        functionIndex += 1
    }
    cEmitAllFunctionPrototypes(&builder, &program)
    cEmitAllTaskDeclarations(&builder, &program)
    cEmitOwnershipPrototypes(&builder, &program, &collected)
    cEmitOwnershipDefinitions(&builder, &program, &collected)
    cEmitChannelPayloadDrops(&builder, &program, &collected)
    functionIndex = 0
    while functionIndex < program.functions.len() {
        cEmitClosureDrop(&builder, &program, functionIndex)
        functionIndex += 1
    }
    cEmitAllContractAdapters(&builder, &program, &contractUses)
    cEmitFunctions(&builder, &program, sourcePath)
    cEmitAllTaskWorkDefinitions(&builder, &program, sourcePath)
    cEmitAllTaskSupport(&builder, &program, sourcePath)
    functionIndex = 0
    while functionIndex < program.functions.len() {
        if cExportedFunction(&program, functionIndex) {
            cWrite(&builder, "\n")
            cEmitExportedWrapper(&builder, &program, functionIndex, sourcePath)
        }
        functionIndex += 1
    }
    if libraryBuild return cFinish(&builder)
    match testEntry {
        None: cEmitMainWrapper(&builder, &program)
        Some(entry): {
            discard entry
            cEmitTestMainWrapper(&builder, &program)
        }
    }
    cFinish(&builder)
}

fn emitSelfHostedC(
    &source firProgram,
    sourcePath String
) String {
    emitSelfHostedCImpl(&source, sourcePath, .None, .None, false)
}

// Emits freestanding C: the C exports of the root package and everything they
// reach, against the runtime core only.
fn emitSelfHostedFreestandingC(
    &source firProgram,
    sourcePath String,
    packageName String
) String {
    emitSelfHostedCImpl(&source, sourcePath, .None, .Some(text.Copy(packageName)), true)
}

fn emitSelfHostedTestC(
    &source firProgram,
    test u64,
    sourcePath String
) String {
    emitSelfHostedCImpl(&source, sourcePath, .Some(test), .None, false)
}

// Emits the C translation unit of a native library: the C exports of one
// package and everything they reach, without a main function.
fn emitSelfHostedLibraryC(
    &source firProgram,
    packageName String,
    sourcePath String
) String {
    emitSelfHostedCImpl(&source, sourcePath, .None, .Some(text.Copy(packageName)), false)
}
