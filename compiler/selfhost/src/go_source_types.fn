package foundation.compiler

import std.format
import std.text

fn goSameType(&value semanticType, $expected semanticType) bool {
    var target = expected
    sameSemanticType(&value, &target)
}

fn goIsStringType(&value semanticType) bool {
    goSameType(&value, stringSemanticType())
}

fn goIsVoidType(&value semanticType) bool {
    goSameType(&value, voidSemanticType())
}

fn goIsBoolType(&value semanticType) bool {
    goSameType(&value, boolSemanticType())
}

fn goLoanKind(&value semanticType) bool {
    value.kind.Matches("View") || value.kind.Matches("Edit")
}

fn goOwnershipKind(&value semanticType) bool {
    value.kind.Matches("Own") || goLoanKind(&value)
}

fn goSequenceKind(&value semanticType) bool {
    value.kind.Matches("Array") || value.kind.Matches("Slice")
}

// Removes one view.
fn goWithoutView(&value semanticType) semanticType {
    if value.kind.Matches("View") && value.arguments.len() == 1 {
        return semanticTypeArgument(&value, 0)
    }
    copySemanticType(&value)
}

// Removes one view or edit loan.
fn goWithoutLoan(&value semanticType) semanticType {
    if goLoanKind(&value) && value.arguments.len() == 1 {
        return semanticTypeArgument(&value, 0)
    }
    copySemanticType(&value)
}

// Removes one owner, view, or edit wrapper.
fn goWithoutOwnership(&value semanticType) semanticType {
    if goOwnershipKind(&value) && value.arguments.len() == 1 {
        return semanticTypeArgument(&value, 0)
    }
    copySemanticType(&value)
}

// Removes every owner, view, and edit wrapper.
fn goOwnedValue(&value semanticType) semanticType {
    var result = copySemanticType(&value)
    while goOwnershipKind(&result) && result.arguments.len() == 1 {
        const inner = semanticTypeArgument(&result, 0)
        result = inner
    }
    result
}

// Keys a type by kind code and declaration, which orders the reachable
// declarations of the generated source.
fn goSourceTypeKey(&value semanticType) String {
    var result = format.U64(cPackageTypeKindCode(value.kind)) + ":" +
        format.U64(value.declaration)
    if value.arguments.len() != 0 {
        result = result + "<"
        var index u64 = 0
        while index < value.arguments.len() {
            var argument = semanticTypeArgument(&value, index)
            result = result + goSourceTypeKey(&argument) + ";"
            index += 1
        }
        result = result + ">"
    }
    result
}

fn goSourceTypeTag(&value semanticType) String {
    var selected = goWithoutView(&value)
    match selected.kind {
        I8: "I8"
        I16: "I16"
        I32: "I32"
        I64: "I64"
        Isize: "Isize"
        U8: "U8"
        U16: "U16"
        U32: "U32"
        U64: "U64"
        Usize: "Usize"
        _: ""
    }
}

fn goScalarType(&value semanticType) Option<String> {
    var selected = goWithoutView(&value)
    match selected.kind {
        Void: .Some("")
        I8: .Some("int8")
        I16: .Some("int16")
        I32: .Some("int32")
        I64: .Some("int64")
        Isize: .Some("int")
        U8: .Some("uint8")
        U16: .Some("uint16")
        U32: .Some("uint32")
        U64: .Some("uint64")
        Usize: .Some("uint")
        F32: .Some("float32")
        F64: .Some("float64")
        Bool: .Some("bool")
        StringValue: .Some("string")
        _: .None
    }
}

fn goScalarText(&value semanticType) String {
    match goScalarType(&value) {
        None: panic("go-source scalar type was not validated")
        Some(found): found
    }
}

// An edit loan becomes a Go pointer, except for a slice or a contract, whose
// Go values already share what they refer to.
fn goPointerParameter(&value semanticType) bool {
    if !value.kind.Matches("Edit") || value.arguments.len() != 1 return false
    var target = semanticTypeArgument(&value, 0)
    !target.kind.Matches("Slice") && !target.kind.Matches("ContractValue")
}

fn goIntegerTypeWidth(&value semanticType) String {
    match value.kind {
        I8: "8"
        U8: "8"
        I16: "16"
        U16: "16"
        I32: "32"
        U32: "32"
        I64: "64"
        U64: "64"
        _: "uint(32) << (^uint(0) >> 63)"
    }
}

fn goQuotedByte(byte u64) String {
    if byte == 92 return "\\\\"
    if byte == 34 return "\\\""
    if byte == 10 return "\\n"
    if byte == 13 return "\\r"
    if byte == 9 return "\\t"
    if byte < 32 || byte == 127 {
        return "\\x" + exportByteText(packageHexDigit(byte >> 4)) +
            exportByteText(packageHexDigit(byte & 15))
    }
    ""
}

// Quotes a string for Go. Escaped bytes are rewritten; every other byte,
// including each byte of a multibyte UTF-8 sequence, is copied unchanged.
fn goQuotedString(value String) String {
    var builder = text.NewBuilder()
    goWrite(&builder, "\"")
    const length = text.ByteLen(value)
    var start u64 = 0
    var index u64 = 0
    while index < length {
        const escaped = goQuotedByte(applicationByteAt(value, index))
        if !text.IsEmpty(escaped) {
            goWrite(&builder, applicationSlice(value, start, index))
            goWrite(&builder, escaped)
            start = index + 1
        }
        index += 1
    }
    goWrite(&builder, applicationSlice(value, start, length))
    goWrite(&builder, "\"")
    goFinish(&builder)
}

// Drops the parentheses that enclose a whole rendered condition, leaving a
// value whose outer parentheses close earlier unchanged.
fn goCondition(value String) String {
    const length = text.ByteLen(value)
    if length < 2 || applicationByteAt(value, 0) != 40 ||
        applicationByteAt(value, length - 1) != 41 {
        return text.Copy(value)
    }
    var depth u64 = 0
    var quoted = false
    var escaped = false
    var index u64 = 0
    while index < length {
        const character = applicationByteAt(value, index)
        if quoted {
            if escaped {
                escaped = false
            } else {
                if character == 92 {
                    escaped = true
                } else {
                    if character == 34 {
                        quoted = false
                    }
                }
            }
        } else {
            if character == 34 {
                quoted = true
            } else {
                if character == 40 {
                    depth += 1
                } else {
                    if character == 41 {
                        if depth == 0 return text.Copy(value)
                        depth -= 1
                        if depth == 0 && index + 1 != length return text.Copy(value)
                    }
                }
            }
        }
        index += 1
    }
    if quoted || depth != 0 return text.Copy(value)
    applicationSlice(value, 1, length - 1)
}
