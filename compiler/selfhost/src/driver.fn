package foundation.compiler

import std.io
import std.text

fn compilerUsage() String {
    "usage:\n" +
        "  foundationc-selfhost check <source-or-project> " +
        "[--target <platform>]\n" +
        "  foundationc-selfhost format <source>\n" +
        "  foundationc-selfhost format --check <source-or-project>\n" +
        "  foundationc-selfhost format --write <source-or-project>\n" +
        "  foundationc-selfhost imports <source>\n" +
        "  foundationc-selfhost imports --check <source-or-project>\n" +
        "  foundationc-selfhost imports --write <source-or-project>\n" +
        "  foundationc-selfhost emit-c <source-or-project> -o <output.c> " +
        "[--target <platform>]\n" +
        "  foundationc-selfhost emit-c-header <source-or-project> -o <output.h> " +
        "[--target <platform>]\n" +
        "  foundationc-selfhost emit-app-host <source-or-project> " +
        "-o <output.fn> [--target <platform>]\n" +
        "  foundationc-selfhost emit-llvm <source-or-project> -o <output.ll>\n" +
        "  foundationc-selfhost emit-metadata <source-or-project> -o <output.json> " +
        "[--target <platform>]\n" +
        "  foundationc-selfhost emit-pii <project> -o <output.json> " +
        "[--triple <llvm-triple>] [--cpu <name>] [--features <list>]\n" +
        "  foundationc-selfhost emit-fsm <source-or-project> -o <output> " +
        "--format <mermaid|graphviz> [--machine <name>]\n" +
        "  foundationc-selfhost emit-app-plan <source-or-project> -o <output.json>\n" +
        "  foundationc-selfhost emit-openapi <source-or-project> -o <output.json> " +
        "[--title <title>] [--version <version>]\n" +
        "  foundationc-selfhost build <source-or-project> -o <executable> " +
        "[--backend <llvm|c>] [--native <input>] " +
        "[--native-link <library>]...\n" +
        "  foundationc-selfhost run <source-or-project> " +
        "[--backend <llvm|c>] [--native <input>] " +
        "[--native-link <library>]... [-- <argument>...]\n" +
        "  foundationc-selfhost test <source-or-project> " +
        "[--backend <llvm|c>] [--native <input>] " +
        "[--native-link <library>]...\n" +
        "  foundationc-selfhost package " +
        "<init|resolve|fetch|requirements|locked|select|check|verify|inspect|snapshot|prune> " +
        "...\n" +
        "  foundationc-selfhost version\n"
}

fn compilerArgument(args [String], index usize) String {
    if index >= len(args) return ""
    text.Copy(args[index])
}

fn parseCompilerTarget(value String) Option<targetPlatform> {
    parseTargetPlatformText(value)
}

fn parseCompilerBackend(value String) Option<compilerBackend> {
    if value == "llvm" return .Some(.Llvm)
    if value == "c" return .Some(.C)
    .None
}

fn compilerNativeLinkValid(value String) bool {
    const length = text.ByteLen(value)
    if length == 0 return false
    var index u64 = 0
    while index < length {
        const selected = text.ByteAt(value, index) else error {
            discard error
            return false
        }
        const letter = (selected >= 65 && selected <= 90) ||
            (selected >= 97 && selected <= 122)
        const digit = selected >= 48 && selected <= 57
        if !letter && !digit && selected != 95 return false
        index += 1
    }
    true
}

fn parseCompilerTargetArguments(
    args [String],
    start usize
) Option<targetPlatform> {
    if start == len(args) return .Some(hostTargetPlatform())
    if start + 2 != len(args) || compilerArgument(args, start) != "--target" {
        return .None
    }
    parseCompilerTarget(compilerArgument(args, start + 1))
}

fn parseCompilerOutputTarget(args [String]) Option<targetPlatform> {
    if len(args) < 4 || compilerArgument(args, 2) != "-o" return .None
    parseCompilerTargetArguments(args, 4)
}

fn parseCompilerNativeOption(
    args [String],
    index usize,
    &options compilerNativeOptions
) bool {
    if index + 1 >= len(args) return false
    const option = compilerArgument(args, index)
    const value = compilerArgument(args, index + 1)
    if option == "--native" {
        discard options.inputs.add($value)
        return true
    }
    if option == "--native-link" && compilerNativeLinkValid(value) {
        discard options.links.add($value)
        return true
    }
    if option == "--backend" && !options.backendSeen {
        const parsed = parseCompilerBackend(value)
        match parsed {
            None: false
            Some(backend): {
                options.backend = backend
                options.backendSeen = true
                true
            }
        }
    } else {
        false
    }
}

fn parseCompilerBuildArguments(
    args [String],
    &options compilerNativeOptions,
    &output Option<String>
) bool {
    var index usize = 2
    while index < len(args) {
        if index + 1 >= len(args) return false
        const option = compilerArgument(args, index)
        if option == "-o" {
            match output {
                Some(value): {
                    discard value
                    return false
                }
                None: {
                    output = .Some(compilerArgument(args, index + 1))
                }
            }
        } else {
            if !parseCompilerNativeOption(
                args,
                index,
                &options
            ) {
                return false
            }
        }
        index += 2
    }
    match output {
        None: false
        Some(value): {
            discard value
            true
        }
    }
}

fn parseCompilerRunArguments(
    args [String],
    &options compilerNativeOptions,
    &programArguments arena<String>
) bool {
    var index usize = 2
    while index < len(args) {
        if compilerArgument(args, index) == "--" {
            index += 1
            while index < len(args) {
                discard programArguments.add(compilerArgument(args, index))
                index += 1
            }
            return true
        }
        if !parseCompilerNativeOption(
            args,
            index,
            &options
        ) {
            return false
        }
        index += 2
    }
    true
}

fn parseCompilerTestArguments(
    args [String],
    &options compilerNativeOptions
) bool {
    var index usize = 2
    while index < len(args) {
        if !parseCompilerNativeOption(
            args,
            index,
            &options
        ) {
            return false
        }
        index += 2
    }
    true
}

fn compilerPackageArguments(args [String]) own arena<String> {
    var result = newArena<String>()
    var index usize = 1
    while index < len(args) {
        discard result.add(compilerArgument(args, index))
        index += 1
    }
    result
}

fn runCompilerCommand(args [String]) Option<i32> {
    const command = compilerArgument(args, 0)
    if (command == "version" || command == "--version") && len(args) == 1 {
        discard io.WriteStdoutText("foundationc 1.0.0\n")
        return .Some(0)
    }
    if (command == "help" || command == "--help" || command == "-h") &&
        len(args) == 1 {
        discard io.WriteStdoutText(compilerUsage())
        return .Some(0)
    }
    if command == "package" {
        var packageArguments = compilerPackageArguments(args)
        return .Some(runPackageCommand(&packageArguments))
    }
    if command == "format" && len(args) == 2 {
        return .Some(runCompilerFormat(compilerArgument(args, 1), .Stdout))
    }
    if command == "format" && len(args) == 3 {
        match parseCompilerFormatMode(compilerArgument(args, 1)) {
            None: {}
            Some(mode): {
                return .Some(runCompilerFormat(compilerArgument(args, 2), mode))
            }
        }
    }
    if command == "imports" && len(args) == 2 {
        return .Some(runCompilerImports(compilerArgument(args, 1), .Stdout))
    }
    if command == "imports" && len(args) == 3 {
        match parseCompilerFormatMode(compilerArgument(args, 1)) {
            None: {}
            Some(mode): {
                return .Some(runCompilerImports(compilerArgument(args, 2), mode))
            }
        }
    }
    if command == "check" && len(args) >= 2 {
        const target = parseCompilerTargetArguments(args, 2)
        match target {
            None: {
                return .None
            }
            Some(value): {
                return .Some(runCompilerCheck(
                        compilerArgument(args, 1), value))
            }
        }
    }
    if command == "emit-c" && len(args) >= 4 {
        const target = parseCompilerOutputTarget(args)
        match target {
            None: {
                return .None
            }
            Some(value): {
                return .Some(runCompilerEmitC(
                        compilerArgument(args, 1),
                        compilerArgument(args, 3),
                        value))
            }
        }
    }
    if command == "emit-c-header" && len(args) >= 4 {
        const target = parseCompilerOutputTarget(args)
        match target {
            None: {
                return .None
            }
            Some(value): {
                return .Some(runCompilerEmitCHeader(
                        compilerArgument(args, 1),
                        compilerArgument(args, 3),
                        value))
            }
        }
    }
    if command == "emit-metadata" {
        const target = parseCompilerOutputTarget(args)
        match target {
            None: {
                return .None
            }
            Some(value): {
                return .Some(runCompilerEmitMetadata(
                        compilerArgument(args, 1),
                        compilerArgument(args, 3),
                        value))
            }
        }
    }
    if command == "emit-pii" {
        match parseCompilerInterfaceArguments(args) {
            None: {
                return .None
            }
            Some(freestanding): {
                return .Some(runCompilerEmitPackageInterface(
                        compilerArgument(args, 1),
                        compilerArgument(args, 3),
                        freestanding))
            }
        }
    }
    if command == "emit-app-plan" && len(args) == 4 &&
        compilerArgument(args, 2) == "-o" {
        return .Some(runCompilerEmitApplicationPlan(
                compilerArgument(args, 1),
                compilerArgument(args, 3)))
    }
    if command == "emit-fsm" {
        var machine Option<String> = .None
        var diagram stateMachineDiagramFormat = .Mermaid
        if !parseCompilerStateMachineArguments(args, &machine, &diagram) return .None
        return .Some(runCompilerEmitStateMachine(
                compilerArgument(args, 1),
                compilerArgument(args, 3),
                machine,
                diagram))
    }
    if command == "emit-openapi" {
        var title Option<String> = .None
        var version Option<String> = .None
        if !parseCompilerOpenAPIArguments(args, &title, &version) return .None
        return .Some(runCompilerEmitOpenAPI(
                compilerArgument(args, 1),
                compilerArgument(args, 3),
                title,
                version))
    }
    if command == "emit-app-host" && len(args) >= 4 {
        const target = parseCompilerOutputTarget(args)
        match target {
            None: {
                return .None
            }
            Some(value): {
                return .Some(runCompilerEmitApplicationHost(
                        compilerArgument(args, 1),
                        compilerArgument(args, 3),
                        value))
            }
        }
    }
    if command == "emit-llvm" && len(args) == 4 &&
        compilerArgument(args, 2) == "-o" {
        return .Some(runCompilerEmitLlvm(
                compilerArgument(args, 1),
                compilerArgument(args, 3)))
    }
    if command == "build" && len(args) >= 4 {
        var options = newCompilerNativeOptions()
        var output Option<String> = .None
        if !parseCompilerBuildArguments(args, &options, &output) return .None
        match output {
            None: {
                return .None
            }
            Some(value): {
                return .Some(runCompilerBuild(
                        compilerArgument(args, 1), value, &options))
            }
        }
    }
    if command == "run" && len(args) >= 2 {
        var options = newCompilerNativeOptions()
        var programArguments = newArena<String>()
        if !parseCompilerRunArguments(
            args,
            &options,
            &programArguments
        ) {
            return .None
        }
        return .Some(runCompilerRun(
                compilerArgument(args, 1),
                &options,
                &programArguments))
    }
    if command == "test" && len(args) >= 2 {
        var options = newCompilerNativeOptions()
        if !parseCompilerTestArguments(args, &options) return .None
        return .Some(runCompilerTests(compilerArgument(args, 1), &options))
    }
    .None
}

fn main(args [String]) i32 {
    match runCompilerCommand(args) {
        Some(status): status
        None: {
            discard io.WriteStderrText(compilerUsage())
            2
        }
    }
}
