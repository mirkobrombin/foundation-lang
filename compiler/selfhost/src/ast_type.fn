package foundation.compiler

import std.collections

struct typeSyntax {
    name String
    arguments own collections.List<typeSyntax>
    span sourceSpan
    arrayLength u64
}

enum attributeTarget {
    Function
    Struct
    Service
    Enum
    Contract
    Method
    Constructor
    Action
    Field
    Variant
    Parameter
}

struct attributeArgument {
    name Option<String>
    value u64
    span sourceSpan
}

struct attributeApplication {
    name String
    arguments own collections.List<attributeArgument>
    span sourceSpan
    parenthesized bool
}

enum unaryOperator {
    Negate
    Not
    BitwiseNot
    Dereference
}

enum ownershipOperator {
    Own
    View
    Edit
    Transfer
    New
}

enum parameterMode {
    TypeEncoded
    Read
    Edit
    Transfer
}

enum captureMode {
    Copy
    Own
    View
    Edit
}

enum receiverKind {
    View
    Edit
    Own
}

enum binaryOperator {
    Add
    Subtract
    Multiply
    Divide
    Remainder
    ShiftLeft
    ShiftRight
    BitwiseAnd
    BitwiseXor
    BitwiseOr
    Equal
    NotEqual
    Less
    LessEqual
    Greater
    GreaterEqual
    And
    Or
}

enum assignmentOperator {
    Assign
    Add
    Subtract
    Multiply
    Divide
    Remainder
    ShiftLeft
    ShiftRight
}

methods unaryOperator {
    fn Matches(self, name String) bool {
        match self {
            Negate: name == "Negate"
            Not: name == "Not"
            BitwiseNot: name == "BitwiseNot"
            Dereference: name == "Dereference"
        }
    }
}

methods ownershipOperator {
    fn Matches(self, name String) bool {
        match self {
            Own: name == "Own"
            View: name == "View"
            Edit: name == "Edit"
            Transfer: name == "Transfer"
            New: name == "New"
        }
    }
}

methods parameterMode {
    fn Name(self) String {
        match self {
            TypeEncoded: "TypeEncoded"
            Read: "Read"
            Edit: "Edit"
            Transfer: "Transfer"
        }
    }

    fn Matches(self, name String) bool {
        self.Name() == name
    }
}

methods receiverKind {
    fn Name(self) String {
        match self {
            View: "View"
            Edit: "Edit"
            Own: "Own"
        }
    }

    fn Matches(self, name String) bool {
        self.Name() == name
    }
}

methods binaryOperator {
    fn Matches(self, name String) bool {
        match self {
            Add: name == "Add"
            Subtract: name == "Subtract"
            Multiply: name == "Multiply"
            Divide: name == "Divide"
            Remainder: name == "Remainder"
            ShiftLeft: name == "ShiftLeft"
            ShiftRight: name == "ShiftRight"
            BitwiseAnd: name == "BitwiseAnd"
            BitwiseXor: name == "BitwiseXor"
            BitwiseOr: name == "BitwiseOr"
            Equal: name == "Equal"
            NotEqual: name == "NotEqual"
            Less: name == "Less"
            LessEqual: name == "LessEqual"
            Greater: name == "Greater"
            GreaterEqual: name == "GreaterEqual"
            And: name == "And"
            Or: name == "Or"
        }
    }
}

methods assignmentOperator {
    fn Matches(self, name String) bool {
        match self {
            Assign: name == "Assign"
            Add: name == "Add"
            Subtract: name == "Subtract"
            Multiply: name == "Multiply"
            Divide: name == "Divide"
            Remainder: name == "Remainder"
            ShiftLeft: name == "ShiftLeft"
            ShiftRight: name == "ShiftRight"
        }
    }
}

fn emptyType(span sourceSpan) typeSyntax {
    typeSyntax {
        name = "void"
        arguments = collections.NewList<typeSyntax>()
        span = span
        arrayLength = 0
    }
}
