package foundation.compiler

import std.format
import std.parse
import std.text

struct applicationWebParameterParts {
    name String
    constraints String
}

struct applicationWebRoutePattern {
    method String
    path String
}

fn applicationWebIdentifier(value String) bool {
    if text.IsEmpty(value) return false
    const first = applicationByteAt(value, 0)
    if first != 95 && !applicationASCIIAlpha(first) return false
    var index u64 = 1
    while index < text.ByteLen(value) {
        const byte = applicationByteAt(value, index)
        if byte != 95 && !applicationASCIIAlphaNumeric(byte) return false
        index += 1
    }
    true
}

fn applicationWebConstraints(value String) bool {
    if text.IsEmpty(value) return true
    if text.StartsWith(value, "regex(") {
        if !text.EndsWith(value, ")") return false
        return applicationValidValidationPattern(
            applicationSlice(value, 6, text.ByteLen(value) - 1))
    }
    var start u64 = 0
    while start <= text.ByteLen(value) {
        var end = text.ByteLen(value)
        var cursor = start
        while cursor < text.ByteLen(value) {
            if applicationByteAt(value, cursor) == 44 {
                end = cursor
                cursor = text.ByteLen(value)
            } else {
                cursor += 1
            }
        }
        const constraint = applicationSlice(value, start, end)
        if constraint != "int" && constraint != "alpha" return false
        if end == text.ByteLen(value) return true
        start = end + 1
    }
    false
}

fn applicationValidateWebRoutePath(
    path String,
    &reason String
) bool {
    if text.IsEmpty(path) || applicationByteAt(path, 0) != 47 {
        reason = "path must begin with /"
        return false
    }
    var names = newArena<String>()
    var start u64 = 1
    while start <= text.ByteLen(path) {
        var end = text.ByteLen(path)
        var cursor = start
        while cursor < text.ByteLen(path) {
            if applicationByteAt(path, cursor) == 47 {
                end = cursor
                cursor = text.ByteLen(path)
            } else {
                cursor += 1
            }
        }
        const segment = applicationSlice(path, start, end)
        const hasOpen = text.Contains(segment, "{")
        const hasClose = text.Contains(segment, "}")
        if hasOpen || hasClose {
            if text.ByteLen(segment) < 3 || applicationByteAt(segment, 0) != 123 ||
                applicationByteAt(segment, text.ByteLen(segment) - 1) != 125 ||
                text.Contains(applicationSlice(segment, 1, text.ByteLen(segment)), "{") ||
                text.Contains(applicationSlice(segment, 0, text.ByteLen(segment) - 1), "}") {
                reason = "parameter braces must occupy one complete segment"
                return false
            }
            var inner = applicationSlice(segment, 1, text.ByteLen(segment) - 1)
            const catchAll = !text.IsEmpty(inner) && applicationByteAt(inner, 0) == 42
            if catchAll {
                inner = applicationSlice(inner, 1, text.ByteLen(inner))
                if end != text.ByteLen(path) {
                    reason = "catch-all parameter must be the last segment"
                    return false
                }
                if text.Contains(inner, ":") {
                    reason = "catch-all parameter cannot declare constraints"
                    return false
                }
            }
            var colon = text.ByteLen(inner)
            match text.Find(inner, ":") {
                None: {}
                Some(value): { colon = value }
            }
            const name = applicationSlice(inner, 0, colon)
            const constraints = applicationSlice(
                inner,
                colon + 1 if colon < text.ByteLen(inner) else colon,
                text.ByteLen(inner)
            )
            if !applicationWebIdentifier(name) {
                reason = "route parameter name is invalid"
                return false
            }
            if applicationStringContains(&names, name) {
                reason = "route parameter name is duplicated"
                return false
            }
            discard names.add(text.Copy(name))
            if !catchAll && !applicationWebConstraints(constraints) {
                reason = "route constraint is unsupported"
                return false
            }
        }
        if end == text.ByteLen(path) return true
        start = end + 1
    }
    true
}

fn applicationValidateWebGroupPrefix(prefix String) bool {
    if text.IsEmpty(prefix) || applicationByteAt(prefix, 0) != 47 return false
    if text.ByteLen(prefix) > 1 &&
        applicationByteAt(prefix, text.ByteLen(prefix) - 1) == 47 {
        return false
    }
    !text.Contains(prefix, "{") && !text.Contains(prefix, "}") &&
        !text.Contains(prefix, "?") && !text.Contains(prefix, "#")
}

fn applicationWebRouteInGroup(route String, prefix String) bool {
    if prefix == "/" return text.StartsWith(route, "/")
    if route == prefix return true
    text.ByteLen(route) > text.ByteLen(prefix) && text.StartsWith(route, prefix) &&
        applicationByteAt(route, text.ByteLen(prefix)) == 47
}

fn applicationWebRouteSegments(path String) own arena<String> {
    var result = newArena<String>()
    var start u64 = 1
    while start < text.ByteLen(path) {
        var end = text.ByteLen(path)
        var cursor = start
        while cursor < text.ByteLen(path) {
            if applicationByteAt(path, cursor) == 47 {
                end = cursor
                cursor = text.ByteLen(path)
            } else {
                cursor += 1
            }
        }
        discard result.add(applicationSlice(path, start, end))
        if end == text.ByteLen(path) return result
        start = end + 1
    }
    result
}

fn applicationWebParameterSegment(segment String) bool {
    text.ByteLen(segment) >= 3 && applicationByteAt(segment, 0) == 123 &&
        applicationByteAt(segment, text.ByteLen(segment) - 1) == 125
}

fn applicationWebCatchAllSegment(segment String) bool {
    applicationWebParameterSegment(segment) && applicationByteAt(segment, 1) == 42
}

fn applicationWebParameterPartsOf(segment String) applicationWebParameterParts {
    var inner = applicationSlice(segment, 1, text.ByteLen(segment) - 1)
    if !text.IsEmpty(inner) && applicationByteAt(inner, 0) == 42 {
        inner = applicationSlice(inner, 1, text.ByteLen(inner))
    }
    var colon = text.ByteLen(inner)
    match text.Find(inner, ":") {
        None: {}
        Some(value): { colon = value }
    }
    applicationWebParameterParts {
        name = applicationSlice(inner, 0, colon)
        constraints = applicationSlice(
            inner,
            colon + 1 if colon < text.ByteLen(inner) else colon,
            text.ByteLen(inner)
        )
    }
}

fn applicationWebRoutePatternsAmbiguous(left String, right String) bool {
    var leftSegments = applicationWebRouteSegments(left)
    var rightSegments = applicationWebRouteSegments(right)
    const count = leftSegments.len() if leftSegments.len() < rightSegments.len()
    else rightSegments.len()
    var index u64 = 0
    while index < count {
        const leftSegment = match leftSegments.take(index) {
            None: panic("web route segment slot is empty")
            Some(value): value
        }
        const rightSegment = match rightSegments.take(index) {
            None: panic("web route segment slot is empty")
            Some(value): value
        }
        const leftParameter = applicationWebParameterSegment(leftSegment)
        const rightParameter = applicationWebParameterSegment(rightSegment)
        var ambiguous = false
        var distinct = false
        if !leftParameter || !rightParameter {
            distinct = leftParameter != rightParameter || leftSegment != rightSegment
        } else {
            const leftCatchAll = applicationWebCatchAllSegment(leftSegment)
            const rightCatchAll = applicationWebCatchAllSegment(rightSegment)
            if leftCatchAll != rightCatchAll {
                ambiguous = true
            } else {
                const leftParts = applicationWebParameterPartsOf(leftSegment)
                const rightParts = applicationWebParameterPartsOf(rightSegment)
                ambiguous = leftParts.name != rightParts.name ||
                    leftParts.constraints != rightParts.constraints
            }
        }
        leftSegments.restore(index, $leftSegment)
        rightSegments.restore(index, $rightSegment)
        if distinct return false
        if ambiguous return true
        index += 1
    }
    false
}

fn applicationWebRouteHasParameter(path String, expected String) bool {
    var segments = applicationWebRouteSegments(path)
    var index u64 = 0
    while index < segments.len() {
        const segment = match segments.take(index) {
            None: panic("web route segment slot is empty")
            Some(value): value
        }
        var found = false
        if applicationWebParameterSegment(segment) {
            const parts = applicationWebParameterPartsOf(segment)
            found = parts.name == expected
        }
        segments.restore(index, $segment)
        if found return true
        index += 1
    }
    false
}

fn applicationWebSourceTypeSupported(
    &program firProgram,
    &type semanticType
) bool {
    var base = applicationBaseType(&type)
    if base.kind.Matches("StringValue") || base.kind.Matches("Bool") ||
        isSemanticInteger(&base) {
        return true
    }
    if !applicationBuiltinOption(&program, &base) return false
    var child = semanticTypeArgument(&base, 0)
    child.kind.Matches("StringValue")
}

fn applicationWebIntegerParser(&type semanticType) String {
    var base = applicationBaseType(&type)
    match base.kind {
        I8: "I8"
        I16: "I16"
        I32: "I32"
        I64: "I64"
        Isize: "Isize"
        U8: "U8"
        U16: "U16"
        U32: "U32"
        U64: "U64"
        Usize: "Usize"
        Invalid: ""
        Void: ""
        Never: ""
        Bool: ""
        F32: ""
        F64: ""
        StringValue: ""
        StructValue: ""
        EnumValue: ""
        ContractValue: ""
        Function: ""
        Task: ""
        Channel: ""
        Sender: ""
        Receiver: ""
        Array: ""
        Slice: ""
        Own: ""
        View: ""
        Edit: ""
        Raw: ""
        RawConst: ""
        Parameter: ""
    }
}

fn applicationWebBodyTypeSupported(
    &program firProgram,
    &type semanticType,
    routePackage String
) bool {
    var base = applicationBaseType(&type)
    if base.kind.Matches("StringValue") return true
    if !base.kind.Matches("StructValue") ||
        base.declaration >= program.structs.len() || base.arguments.len() != 0 {
        return false
    }
    var declaration = match program.structs.take(base.declaration) {
        None: panic("struct slot is empty")
        Some(value): value
    }
    const supported = declaration.typeParameterCount == 0 &&
        applicationPackageName(declaration.name) == routePackage &&
        applicationHasAttribute(
        &program, &declaration.attributes, "foundation.bind.Bindable")
    program.structs.restore(base.declaration, $declaration)
    supported
}

fn applicationWebUseSignedInteger(
    &use firAttributeUse,
    argument u64
) Option<i64> {
    if argument >= use.arguments.len() return .None
    var selected = match use.arguments.take(argument) {
        None: panic("attribute argument slot is empty")
        Some(value): value
    }
    var result Option<i64> = .None
    if selected.value.kind.Matches("Integer") {
        var literal = format.U64(selected.value.magnitude)
        if selected.value.negative {
            literal = "-" + literal
        }
        const value = parse.I64(literal) else error {
            discard error
            use.arguments.restore(argument, $selected)
            return .None
        }
        result = .Some(value)
    }
    use.arguments.restore(argument, $selected)
    result
}

fn applicationWebUseEnum(
    &program firProgram,
    &use firAttributeUse,
    argument u64
) Option<String> {
    if argument >= use.arguments.len() return .None
    var selected = match use.arguments.take(argument) {
        None: panic("attribute argument slot is empty")
        Some(value): value
    }
    var result Option<String> = .None
    if selected.value.kind.Matches("EnumValue") &&
        selected.value.type.kind.Matches("EnumValue") &&
        selected.value.type.declaration < program.enums.len() {
        var declaration = match program.enums.take(selected.value.type.declaration) {
            None: panic("enum slot is empty")
            Some(value): value
        }
        if selected.value.variant < declaration.variants.len() {
            var variant = match declaration.variants.take(selected.value.variant) {
                None: panic("enum variant slot is empty")
                Some(value): value
            }
            result = .Some(text.Copy(variant.name))
            declaration.variants.restore(selected.value.variant, $variant)
        }
        program.enums.restore(selected.value.type.declaration, $declaration)
    }
    use.arguments.restore(argument, $selected)
    result
}

fn applicationWebMiddlewareSignature(
    &program firProgram,
    &function firFunction
) bool {
    if !function.generic || function.typeParameterCount != 1 ||
        function.parameters.len() != 2 {
        return false
    }
    var request = applicationParameter(&function, 0)
    var next = applicationParameter(&function, 1)
    if !applicationParameterMode(&function, 0).Matches("Transfer") ||
        !applicationParameterMode(&function, 1).Matches("Read") ||
        !applicationNamedStruct(
        &program, &request.type, "foundation.web.Request") {
        return false
    }
    var nextType = applicationBaseType(&next.type)
    if !nextType.kind.Matches("Function") || nextType.arguments.len() != 2 {
        return false
    }
    var nextReturn = semanticTypeArgument(&nextType, 0)
    var nextRequest = semanticTypeArgument(&nextType, 1)
    if !sameSemanticType(&nextReturn, &function.returnType) ||
        !applicationNamedStruct(
        &program, &nextRequest, "foundation.web.Request") {
        return false
    }
    var result = applicationBaseType(&function.returnType)
    if !applicationNamedEnum(&program, &result, "Result") ||
        result.arguments.len() != 2 {
        return false
    }
    var success = semanticTypeArgument(&result, 0)
    var dispatchError = semanticTypeArgument(&result, 1)
    if !applicationNamedStruct(
        &program, &success, "foundation.web.Response") ||
        !applicationNamedEnum(
        &program, &dispatchError, "foundation.web.DispatchError") ||
        dispatchError.arguments.len() != 1 {
        return false
    }
    var error = semanticTypeArgument(&dispatchError, 0)
    error.kind.Matches("Parameter") && error.declaration == 0
}

fn applicationWebOpenAPISchemaType(
    &program firProgram,
    &type semanticType
) String {
    var value = applicationBaseType(&type)
    if applicationBuiltinOption(&program, &value) {
        var child = semanticTypeArgument(&value, 0)
        value = applicationBaseType(&child)
    }
    if value.kind.Matches("StringValue") return "string"
    if value.kind.Matches("Bool") return "boolean"
    if isSemanticInteger(&value) return "integer"
    if value.kind.Matches("F32") || value.kind.Matches("F64") return "number"
    ""
}

fn applicationWebResponseContains(
    &responses arena<applicationWebResponse>,
    status u64
) bool {
    var index u64 = 0
    while index < responses.len() {
        var response = match responses.take(index) {
            None: panic("web response slot is empty")
            Some(value): value
        }
        const found = response.status == status
        responses.restore(index, $response)
        if found return true
        index += 1
    }
    false
}

fn applicationWebRouteKeyContains(
    &patterns arena<applicationWebRoutePattern>,
    method String,
    path String
) bool {
    var index u64 = 0
    while index < patterns.len() {
        var pattern = match patterns.take(index) {
            None: panic("web route pattern slot is empty")
            Some(value): value
        }
        const found = pattern.method == method && pattern.path == path
        patterns.restore(index, $pattern)
        if found return true
        index += 1
    }
    false
}

fn applicationWebAmbiguousPattern(
    &patterns arena<applicationWebRoutePattern>,
    path String
) Option<applicationWebRoutePattern> {
    var index u64 = 0
    while index < patterns.len() {
        var pattern = match patterns.take(index) {
            None: panic("web route pattern slot is empty")
            Some(value): value
        }
        const found = applicationWebRoutePatternsAmbiguous(pattern.path, path)
        const result = applicationWebRoutePattern {
            method = text.Copy(pattern.method)
            path = text.Copy(pattern.path)
        }
        patterns.restore(index, $pattern)
        if found return .Some(result)
        index += 1
    }
    .None
}

fn applicationWebBindingAttribute(
    &program firProgram,
    &attributes arena<firAttributeUse>,
    &source applicationWebBindingSource,
    &use firAttributeUse
) bool {
    var count u64 = 0
    var index u64 = 0
    while index < attributes.len() {
        var candidate = match attributes.take(index) {
            None: panic("parameter attribute slot is empty")
            Some(value): value
        }
        const name = applicationAttributeUseName(&program, &candidate)
        var selected = false
        var candidateSource applicationWebBindingSource = .Path
        if name == "foundation.web.Path" {
            selected = true
            candidateSource = .Path
        } else {
            if name == "foundation.web.Query" {
                selected = true
                candidateSource = .Query
            } else {
                if name == "foundation.web.Header" {
                    selected = true
                    candidateSource = .Header
                } else {
                    if name == "foundation.web.Form" {
                        selected = true
                        candidateSource = .Form
                    } else {
                        if name == "foundation.web.Body" {
                            selected = true
                            candidateSource = .Body
                        } else {
                            if name == "foundation.web.Inject" {
                                selected = true
                                candidateSource = .Inject
                            }
                        }
                    }
                }
            }
        }
        if selected {
            count += 1
            source = candidateSource
            use = copyFirAttributeUse(&candidate)
        }
        attributes.restore(index, $candidate)
        index += 1
    }
    count == 1
}

fn applicationPlanWebMiddlewareUse(
    &program firProgram,
    &model applicationModel,
    functionID u64,
    &function firFunction,
    &use firAttributeUse,
    &diagnostics diagnostics
) void {
    const name = applicationAttributeUseName(&program, &use)
    if name != "foundation.web.GlobalMiddleware" &&
        name != "foundation.web.GroupMiddleware" &&
        name != "foundation.web.RouteMiddleware" {
        return
    }
    if function.method || function.taskFunction ||
        !applicationWebMiddlewareSignature(&program, &function) {
        diagnostics.reportError(
            "FDN2397",
            "web middleware requires a generic free function with signature " +
            "fn<E>($web.Request, fn($web.Request) " +
            "Result<web.Response, web.DispatchError<E>>) " +
            "Result<web.Response, web.DispatchError<E>>",
            function.sourceSpan
        )
        return
    }
    var orderIndex u64 = 0
    if name == "foundation.web.GroupMiddleware" {
        orderIndex = 1
    } else {
        if name == "foundation.web.RouteMiddleware" {
            orderIndex = 2
        }
    }
    const selectedOrder = applicationWebUseSignedInteger(&use, orderIndex)
    const order = match selectedOrder {
        None: {
            diagnostics.reportError(
                "FDN2398", "invalid web middleware order", function.sourceSpan)
            return
        }
        Some(value): value
    }
    var middleware = applicationWebMiddleware {
        function = functionID
        scope = .Global
        method = ""
        path = ""
        order = order
    }
    if name == "foundation.web.GroupMiddleware" {
        middleware.scope = .Group
        match applicationUseString(&use, 0) {
            None: {}
            Some(value): { middleware.path = value }
        }
        if !applicationValidateWebGroupPrefix(middleware.path) {
            diagnostics.reportError(
                "FDN2398",
                "web middleware group prefix must be an absolute static path " +
                "without a trailing slash",
                function.sourceSpan
            )
            return
        }
    } else {
        if name == "foundation.web.RouteMiddleware" {
            middleware.scope = .Route
            match applicationWebUseEnum(&program, &use, 0) {
                None: {}
                Some(value): { middleware.method = value }
            }
            match applicationUseString(&use, 1) {
                None: {}
                Some(value): { middleware.path = value }
            }
            var reason = ""
            if text.IsEmpty(middleware.method) ||
                !applicationValidateWebRoutePath(middleware.path, &reason) {
                diagnostics.reportError(
                    "FDN2398", "invalid web middleware route scope",
                    function.sourceSpan)
                return
            }
        }
    }
    discard model.webMiddlewares.add($middleware)
}

fn applicationWebOpenAPIMetadata(
    &program firProgram,
    &attributes arena<firAttributeUse>
) bool {
    applicationHasAttribute(
        &program, &attributes, "foundation.openapi.Summary") ||
        applicationHasAttribute(
        &program, &attributes, "foundation.openapi.Description") ||
        applicationHasAttribute(
        &program, &attributes, "foundation.openapi.Response")
}

fn applicationWebSourceKey(
    source applicationWebBindingSource,
    name String
) String {
    source.Name() + ":" + name
}

fn applicationPlanWebParameter(
    &program firProgram,
    &model applicationModel,
    &function firFunction,
    parameterIndex u64,
    routePath String,
    &required arena<u64>,
    &sourceNames arena<String>,
    &bodyBindings u64,
    &formBindings u64,
    &diagnostics diagnostics
) Option<applicationWebParameter> {
    var value = applicationParameter(&function, parameterIndex)
    var attributes = applicationParameterAttributes(&function, parameterIndex)
    var source applicationWebBindingSource = .Path
    var use = newFirAttributeUse(0)
    if !applicationWebBindingAttribute(
        &program, &attributes, &source, &use) {
        diagnostics.reportError(
            "FDN2355",
            "web route parameter requires exactly one binding attribute",
            function.sourceSpan
        )
        return .None
    }
    var binding = applicationWebParameter {
        index = parameterIndex
        source = source
        name = ""
        provider = .None
        description = ""
        minimum = .None
        enumValues = newArena<String>()
    }
    if source.Matches("Inject") {
        const mode = applicationParameterMode(&function, parameterIndex)
        if mode.Matches("Edit") ||
            (!function.taskFunction && !mode.Matches("Read")) {
            diagnostics.reportError(
                "FDN2356",
                "task web injection requires read or transfer access" if
                function.taskFunction else
                "injected web services require read access",
                function.sourceSpan
            )
        }
        var candidates = applicationProviderCandidates(
            &program, &value.type, .None)
        if candidates.len() == 0 {
            var base = applicationBaseType(&value.type)
            diagnostics.reportError(
                "FDN2357",
                "no service provides " +
                applicationSourceTypeName(&program, &model, &base) +
                " for web route parameter " + value.name,
                function.sourceSpan
            )
        } else {
            if candidates.len() != 1 {
                diagnostics.reportError(
                    "FDN2358",
                    "ambiguous providers for web route parameter " + value.name +
                    ": " + applicationProviderNames(&program, &candidates),
                    function.sourceSpan
                )
            } else {
                const provider = match candidates.take(0) {
                    None: panic("web provider slot is empty")
                    Some(value): value
                }
                candidates.restore(0, provider)
                binding.provider = .Some(provider)
                applicationRequireService(&required, provider)
            }
        }
    } else {
        if applicationParameterMode(&function, parameterIndex).Matches("Edit") {
            diagnostics.reportError(
                "FDN2356", "web source binding cannot use edit access",
                function.sourceSpan)
        }
        if !source.Matches("Body") &&
            !applicationWebSourceTypeSupported(&program, &value.type) {
            diagnostics.reportError(
                "FDN2359",
                "web source binding requires String, Option<String>, bool, or integer",
                function.sourceSpan
            )
        }
        if source.Matches("Body") &&
            !applicationWebBodyTypeSupported(
            &program, &value.type, function.packageName) {
            diagnostics.reportError(
                "FDN2368",
                "body binding requires String or a local concrete @bind.Bindable struct",
                function.sourceSpan
            )
        }
        if !source.Matches("Body") {
            match applicationUseString(&use, 0) {
                None: {}
                Some(name): { binding.name = name }
            }
            if text.IsEmpty(binding.name) {
                diagnostics.reportError(
                    "FDN2360", "web source binding name cannot be empty",
                    function.sourceSpan)
            }
            if source.Matches("Path") &&
                !applicationWebRouteHasParameter(routePath, binding.name) {
                diagnostics.reportError(
                    "FDN2367",
                    "path binding is not declared by route: " + binding.name,
                    function.sourceSpan
                )
            }
            const sourceKey = applicationWebSourceKey(source, binding.name)
            if applicationStringContains(&sourceNames, sourceKey) {
                diagnostics.reportError(
                    "FDN2365", "duplicate web source binding " + binding.name,
                    function.sourceSpan)
            } else {
                discard sourceNames.add($sourceKey)
            }
        } else {
            bodyBindings += 1
        }
        if source.Matches("Form") {
            formBindings += 1
        }
    }

    const hasDescription = applicationHasAttribute(
        &program, &attributes, "foundation.openapi.Description")
    const hasMinimum = applicationHasAttribute(
        &program, &attributes, "foundation.openapi.Minimum")
    const hasEnumValues = applicationHasAttribute(
        &program, &attributes, "foundation.openapi.EnumValue")
    const exposed = source.Matches("Path") || source.Matches("Query") ||
        source.Matches("Header")
    if !exposed && (hasDescription || hasMinimum || hasEnumValues) {
        diagnostics.reportError(
            "FDN2403",
            "OpenAPI parameter metadata requires a path, query, or header binding",
            function.sourceSpan
        )
    } else {
        if exposed {
            match applicationAttributeString(
                &program,
                &attributes,
                "foundation.openapi.Description",
                0
            ) {
                None: {}
                Some(value): { binding.description = value }
            }
            if hasDescription && text.IsEmpty(binding.description) {
                diagnostics.reportError(
                    "FDN2403", "@openapi.Description requires non-empty text",
                    function.sourceSpan)
            }
            const minimumIndex = applicationAttributeIndex(
                &program, &attributes, "foundation.openapi.Minimum")
            match minimumIndex {
                None: {}
                Some(index): {
                    var minimumUse = match attributes.take(index) {
                        None: panic("OpenAPI minimum slot is empty")
                        Some(value): value
                    }
                    const numeric = applicationUseNumeric(&minimumUse, 0)
                    const schema = applicationWebOpenAPISchemaType(
                        &program, &value.type)
                    if (schema != "integer" && schema != "number") ||
                        !optionApplicationNumericPresent(numeric) {
                        diagnostics.reportError(
                            "FDN2403",
                            "@openapi.Minimum requires a numeric web parameter",
                            function.sourceSpan
                        )
                    } else {
                        match numeric {
                            None: {}
                            Some(selected): {
                                binding.minimum = .Some(text.Copy(selected.literal))
                            }
                        }
                    }
                    attributes.restore(index, $minimumUse)
                }
            }
            var values = newArena<String>()
            var attributeIndex u64 = 0
            while attributeIndex < attributes.len() {
                var enumUse = match attributes.take(attributeIndex) {
                    None: panic("parameter attribute slot is empty")
                    Some(value): value
                }
                if applicationAttributeUseName(&program, &enumUse) ==
                    "foundation.openapi.EnumValue" {
                    const enumValue = applicationUseString(&enumUse, 0)
                    var valid = applicationWebOpenAPISchemaType(
                        &program, &value.type) == "string"
                    var selected = ""
                    match enumValue {
                        None: { valid = false }
                        Some(found): {
                            selected = found
                            if text.IsEmpty(selected) {
                                valid = false
                            }
                        }
                    }
                    if !valid {
                        diagnostics.reportError(
                            "FDN2403",
                            "@openapi.EnumValue requires a non-empty String " +
                            "web parameter value",
                            function.sourceSpan
                        )
                    } else {
                        if applicationStringContains(&values, selected) {
                            diagnostics.reportError(
                                "FDN2403",
                                "duplicate OpenAPI enum value " + selected,
                                function.sourceSpan
                            )
                        } else {
                            discard values.add(text.Copy(selected))
                            discard binding.enumValues.add($selected)
                        }
                    }
                }
                attributes.restore(attributeIndex, $enumUse)
                attributeIndex += 1
            }
        }
    }
    .Some(binding)
}

fn optionApplicationNumericPresent(
    value Option<applicationNumericAttribute>
) bool {
    match value {
        None: false
        Some(selected): {
            discard selected
            true
        }
    }
}

fn applicationWebInjectedProviderCount(
    &route applicationWebRoute,
    provider u64
) u64 {
    var count u64 = 0
    var index u64 = 0
    while index < route.parameters.len() {
        var parameter = match route.parameters.take(index) {
            None: panic("web parameter slot is empty")
            Some(value): value
        }
        if parameter.source.Matches("Inject") {
            match parameter.provider {
                None: {}
                Some(value): {
                    if value == provider {
                        count += 1
                    }
                }
            }
        }
        route.parameters.restore(index, $parameter)
        index += 1
    }
    count
}

fn applicationSortWebResponses(&responses arena<applicationWebResponse>) void {
    var leftIndex u64 = 0
    while leftIndex < responses.len() {
        var rightIndex = leftIndex + 1
        while rightIndex < responses.len() {
            var left = match responses.take(leftIndex) {
                None: panic("web response slot is empty")
                Some(value): value
            }
            var right = match responses.take(rightIndex) {
                None: panic("web response slot is empty")
                Some(value): value
            }
            if right.status < left.status {
                responses.restore(leftIndex, $right)
                responses.restore(rightIndex, $left)
            } else {
                responses.restore(leftIndex, $left)
                responses.restore(rightIndex, $right)
            }
            rightIndex += 1
        }
        leftIndex += 1
    }
}

fn applicationPlanWebRoute(
    &program firProgram,
    &model applicationModel,
    functionID u64,
    &function firFunction,
    &routeUse firAttributeUse,
    &required arena<u64>,
    &patterns arena<applicationWebRoutePattern>,
    &diagnostics diagnostics
) void {
    var route = applicationWebRoute {
        function = functionID
        method = ""
        path = ""
        hostMethod = ""
        parameters = newArena<applicationWebParameter>()
        taskFunction = function.taskFunction
        executionError = .None
        activationError = .None
        summary = ""
        description = ""
        responses = newArena<applicationWebResponse>()
    }
    match applicationWebUseEnum(&program, &routeUse, 0) {
        None: {}
        Some(value): { route.method = value }
    }
    match applicationUseString(&routeUse, 1) {
        None: {}
        Some(value): { route.path = value }
    }
    match applicationAttributeString(
        &program, &function.attributes, "foundation.openapi.Summary", 0) {
        None: {}
        Some(value): { route.summary = value }
    }
    match applicationAttributeString(
        &program, &function.attributes, "foundation.openapi.Description", 0) {
        None: {}
        Some(value): { route.description = value }
    }
    var attributeIndex u64 = 0
    while attributeIndex < function.attributes.len() {
        var responseUse = match function.attributes.take(attributeIndex) {
            None: panic("function attribute slot is empty")
            Some(value): value
        }
        if applicationAttributeUseName(&program, &responseUse) ==
            "foundation.openapi.Response" {
            const selectedStatus = applicationWebUseSignedInteger(&responseUse, 0)
            const selectedDescription = applicationUseString(&responseUse, 1)
            var valid = true
            var status i64 = 0
            var description = ""
            match selectedStatus {
                None: { valid = false }
                Some(value): {
                    status = value
                    if value < 100 || value > 599 {
                        valid = false
                    }
                }
            }
            match selectedDescription {
                None: { valid = false }
                Some(value): {
                    description = value
                    if text.IsEmpty(description) {
                        valid = false
                    }
                }
            }
            if !valid {
                diagnostics.reportError(
                    "FDN2402",
                    "@openapi.Response requires status 100 through 599 and a " +
                    "non-empty description",
                    function.sourceSpan
                )
            } else {
                const unsignedStatus = parse.U64(format.I64(status)) else error {
                    discard error
                    panic("validated OpenAPI response status is invalid")
                }
                if applicationWebResponseContains(
                    &route.responses, unsignedStatus) {
                    diagnostics.reportError(
                        "FDN2402",
                        "duplicate OpenAPI response status " +
                        format.U64(unsignedStatus),
                        function.sourceSpan
                    )
                } else {
                    discard route.responses.add(applicationWebResponse {
                        status = unsignedStatus
                        description = description
                    })
                }
            }
        }
        function.attributes.restore(attributeIndex, $responseUse)
        attributeIndex += 1
    }
    applicationSortWebResponses(&route.responses)
    if function.method {
        diagnostics.reportError(
            "FDN2350", "@web.Route requires a free function", function.sourceSpan)
    }
    if function.generic {
        diagnostics.reportError(
            "FDN2351", "@web.Route function cannot be generic", function.sourceSpan)
    }
    if text.IsEmpty(route.method) || text.IsEmpty(route.path) {
        diagnostics.reportError(
            "FDN2353", "@web.Route requires a method and non-empty path",
            function.sourceSpan)
    } else {
        var reason = ""
        if !applicationValidateWebRoutePath(route.path, &reason) {
            diagnostics.reportError(
                "FDN2364", "invalid generated web route: " + reason,
                function.sourceSpan)
        } else {
            match applicationWebAmbiguousPattern(&patterns, route.path) {
                None: {}
                Some(other): {
                    diagnostics.reportError(
                        "FDN2369",
                        "ambiguous generated web routes " + other.method + " " +
                        other.path + " and " + route.method + " " + route.path,
                        function.sourceSpan
                    )
                }
            }
            discard patterns.add(applicationWebRoutePattern {
                method = text.Copy(route.method)
                path = text.Copy(route.path)
            })
        }
        if applicationWebRouteKeyContains(&patterns, route.method, route.path) {
            var matches u64 = 0
            var patternIndex u64 = 0
            while patternIndex < patterns.len() {
                var pattern = match patterns.take(patternIndex) {
                    None: panic("web route pattern slot is empty")
                    Some(value): value
                }
                if pattern.method == route.method && pattern.path == route.path {
                    matches += 1
                }
                patterns.restore(patternIndex, $pattern)
                patternIndex += 1
            }
            if matches > 1 {
                diagnostics.reportError(
                    "FDN2354",
                    "duplicate generated web route " + route.method + " " + route.path,
                    function.sourceSpan
                )
            }
        }
    }
    var bodyBindings u64 = 0
    var formBindings u64 = 0
    var sourceNames = newArena<String>()
    var parameterIndex u64 = 0
    while parameterIndex < function.parameters.len() {
        const planned = applicationPlanWebParameter(
            &program,
            &model,
            &function,
            parameterIndex,
            route.path,
            &required,
            &sourceNames,
            &bodyBindings,
            &formBindings,
            &diagnostics
        )
        match planned {
            None: {}
            Some(value): { discard route.parameters.add($value) }
        }
        parameterIndex += 1
    }
    if bodyBindings > 1 || (bodyBindings != 0 && formBindings != 0) {
        diagnostics.reportError(
            "FDN2366",
            "web route cannot combine repeated body binding with form binding",
            function.sourceSpan
        )
    }
    parameterIndex = 0
    while parameterIndex < route.parameters.len() {
        var parameter = match route.parameters.take(parameterIndex) {
            None: panic("web parameter slot is empty")
            Some(value): value
        }
        const ownedInjection = parameter.source.Matches("Inject") &&
            applicationParameterMode(
            &function, parameter.index).Matches("Transfer")
        const selectedProvider = parameter.provider
        route.parameters.restore(parameterIndex, $parameter)
        if ownedInjection {
            match selectedProvider {
                None: {}
                Some(provider): {
                    if applicationServiceLifetime(
                        &program, provider).Matches("Singleton") {
                        diagnostics.reportError(
                            "FDN2395",
                            "task web route cannot take ownership of singleton service " +
                            applicationServiceName(&program, provider),
                            function.sourceSpan
                        )
                    } else {
                        if applicationWebInjectedProviderCount(&route, provider) != 1 {
                            diagnostics.reportError(
                                "FDN2396",
                                "owned task web service must be injected exactly once: " +
                                applicationServiceName(&program, provider),
                                function.sourceSpan
                            )
                        }
                    }
                    discard provider
                }
            }
        }
        parameterIndex += 1
    }
    discard model.webRoutes.add($route)
}

fn applicationPlanWebDeclarations(
    &program firProgram,
    &model applicationModel,
    &required arena<u64>,
    &diagnostics diagnostics
) void {
    var patterns = newArena<applicationWebRoutePattern>()
    var functionIndex u64 = 0
    while functionIndex < program.functions.len() {
        var function = match program.functions.take(functionIndex) {
            None: panic("function slot is empty")
            Some(value): value
        }
        var attributeIndex u64 = 0
        while attributeIndex < function.attributes.len() {
            var middlewareUse = match function.attributes.take(attributeIndex) {
                None: panic("function attribute slot is empty")
                Some(value): value
            }
            var selectedMiddleware = copyFirAttributeUse(&middlewareUse)
            function.attributes.restore(attributeIndex, $middlewareUse)
            applicationPlanWebMiddlewareUse(
                &program,
                &model,
                functionIndex,
                &function,
                &selectedMiddleware,
                &diagnostics
            )
            attributeIndex += 1
        }
        const selectedRoute = applicationAttributeIndex(
            &program, &function.attributes, "foundation.web.Route")
        match selectedRoute {
            None: {
                if applicationWebOpenAPIMetadata(
                    &program, &function.attributes) {
                    diagnostics.reportError(
                        "FDN2401",
                        "OpenAPI operation metadata requires an @web.Route function",
                        function.sourceSpan
                    )
                }
            }
            Some(routeIndex): {
                var routeUse = match function.attributes.take(routeIndex) {
                    None: panic("web route attribute slot is empty")
                    Some(value): value
                }
                var selectedUse = copyFirAttributeUse(&routeUse)
                function.attributes.restore(routeIndex, $routeUse)
                applicationPlanWebRoute(
                    &program,
                    &model,
                    functionIndex,
                    &function,
                    &selectedUse,
                    &required,
                    &patterns,
                    &diagnostics
                )
            }
        }
        program.functions.restore(functionIndex, $function)
        functionIndex += 1
    }
}

fn applicationWebRouteExists(
    &model applicationModel,
    method String,
    path String
) bool {
    var index u64 = 0
    while index < model.webRoutes.len() {
        var route = match model.webRoutes.take(index) {
            None: panic("web route slot is empty")
            Some(value): value
        }
        const found = route.method == method && route.path == path
        model.webRoutes.restore(index, $route)
        if found return true
        index += 1
    }
    false
}

fn applicationWebGroupHasRoute(
    &model applicationModel,
    prefix String
) bool {
    var index u64 = 0
    while index < model.webRoutes.len() {
        var route = match model.webRoutes.take(index) {
            None: panic("web route slot is empty")
            Some(value): value
        }
        const found = applicationWebRouteInGroup(route.path, prefix)
        model.webRoutes.restore(index, $route)
        if found return true
        index += 1
    }
    false
}

fn applicationWebScopeRank(scope applicationWebMiddlewareScope) u64 {
    match scope {
        Global: 0
        Group: 1
        Route: 2
    }
}

fn applicationWebMiddlewareLess(
    &program firProgram,
    &left applicationWebMiddleware,
    &right applicationWebMiddleware
) bool {
    const leftRank = applicationWebScopeRank(left.scope)
    const rightRank = applicationWebScopeRank(right.scope)
    if leftRank != rightRank return leftRank < rightRank
    if left.scope.Matches("Group") &&
        text.ByteLen(left.path) != text.ByteLen(right.path) {
        return text.ByteLen(left.path) < text.ByteLen(right.path)
    }
    if left.path != right.path return applicationStringLess(left.path, right.path)
    if left.method != right.method {
        return applicationStringLess(left.method, right.method)
    }
    if left.order != right.order return left.order < right.order
    if left.function == right.function return false
    var leftFunction = match program.functions.take(left.function) {
        None: panic("web middleware function slot is empty")
        Some(value): value
    }
    var rightFunction = match program.functions.take(right.function) {
        None: panic("web middleware function slot is empty")
        Some(value): value
    }
    const result = applicationStringLess(leftFunction.name, rightFunction.name)
    program.functions.restore(left.function, $leftFunction)
    program.functions.restore(right.function, $rightFunction)
    result
}

fn applicationSortWebMiddlewares(
    &program firProgram,
    &values arena<applicationWebMiddleware>
) void {
    var leftIndex u64 = 0
    while leftIndex < values.len() {
        var rightIndex = leftIndex + 1
        while rightIndex < values.len() {
            var left = match values.take(leftIndex) {
                None: panic("web middleware slot is empty")
                Some(value): value
            }
            var right = match values.take(rightIndex) {
                None: panic("web middleware slot is empty")
                Some(value): value
            }
            if applicationWebMiddlewareLess(&program, &right, &left) {
                values.restore(leftIndex, $right)
                values.restore(rightIndex, $left)
            } else {
                values.restore(leftIndex, $left)
                values.restore(rightIndex, $right)
            }
            rightIndex += 1
        }
        leftIndex += 1
    }
}

fn applicationSortWebRoutes(&values arena<applicationWebRoute>) void {
    var leftIndex u64 = 0
    while leftIndex < values.len() {
        var rightIndex = leftIndex + 1
        while rightIndex < values.len() {
            var left = match values.take(leftIndex) {
                None: panic("web route slot is empty")
                Some(value): value
            }
            var right = match values.take(rightIndex) {
                None: panic("web route slot is empty")
                Some(value): value
            }
            var less = applicationStringLess(right.path, left.path)
            if right.path == left.path {
                less = applicationStringLess(right.method, left.method)
                if right.method == left.method {
                    less = right.function < left.function
                }
            }
            if less {
                values.restore(leftIndex, $right)
                values.restore(rightIndex, $left)
            } else {
                values.restore(leftIndex, $left)
                values.restore(rightIndex, $right)
            }
            rightIndex += 1
        }
        leftIndex += 1
    }
}

fn applicationFinalizeWebMiddlewares(
    &program firProgram,
    &model applicationModel,
    &diagnostics diagnostics
) void {
    var index u64 = 0
    while index < model.webMiddlewares.len() {
        var middleware = match model.webMiddlewares.take(index) {
            None: panic("web middleware slot is empty")
            Some(value): value
        }
        var previous u64 = 0
        while previous < index {
            var other = match model.webMiddlewares.take(previous) {
                None: panic("web middleware slot is empty")
                Some(value): value
            }
            const duplicate = other.scope.Matches(middleware.scope.Name()) &&
                other.method == middleware.method && other.path == middleware.path &&
                other.order == middleware.order
            model.webMiddlewares.restore(previous, $other)
            if duplicate {
                diagnostics.reportError(
                    "FDN2399", "duplicate web middleware order in one scope",
                    applicationFunctionSpan(&program, middleware.function))
            }
            previous += 1
        }
        if middleware.scope.Matches("Route") &&
            !applicationWebRouteExists(
            &model, middleware.method, middleware.path) {
            diagnostics.reportError(
                "FDN2400",
                "web middleware targets an unknown route " + middleware.method +
                " " + middleware.path,
                applicationFunctionSpan(&program, middleware.function)
            )
        }
        if middleware.scope.Matches("Group") &&
            !applicationWebGroupHasRoute(&model, middleware.path) {
            diagnostics.reportError(
                "FDN2400",
                "web middleware group matches no route " + middleware.path,
                applicationFunctionSpan(&program, middleware.function)
            )
        }
        model.webMiddlewares.restore(index, $middleware)
        index += 1
    }
    applicationSortWebMiddlewares(&program, &model.webMiddlewares)
}

fn applicationBindingPlanIndex(
    &model applicationModel,
    typeID u64
) Option<u64> {
    var index u64 = 0
    while index < model.bindings.len() {
        var plan = match model.bindings.take(index) {
            None: panic("application binding plan slot is empty")
            Some(value): value
        }
        const found = plan.type == typeID
        model.bindings.restore(index, $plan)
        if found return .Some(index)
        index += 1
    }
    .None
}

fn applicationBindingFieldPlanned(
    &plan applicationBindingPlan,
    field u64
) bool {
    var index u64 = 0
    while index < plan.fields.len() {
        var value = match plan.fields.take(index) {
            None: panic("application binding field slot is empty")
            Some(value): value
        }
        const found = value.field == field
        plan.fields.restore(index, $value)
        if found return true
        index += 1
    }
    false
}

fn applicationValidateWebBodyInitializer(
    &program firProgram,
    &model applicationModel,
    typeID u64,
    &checked arena<u64>,
    &active arena<u64>,
    &diagnostics diagnostics
) bool {
    if applicationRequiredServiceContains(&checked, typeID) return true
    if applicationRequiredServiceContains(&active, typeID) {
        diagnostics.reportError(
            "FDN2383", "recursive typed web body cannot be initialized",
            applicationServiceSpan(&program, typeID))
        return false
    }
    const selectedPlan = applicationBindingPlanIndex(&model, typeID)
    const planIndex = match selectedPlan {
        None: { return false }
        Some(value): value
    }
    const activeLength = active.len()
    discard active.add(typeID)
    var plan = match model.bindings.take(planIndex) {
        None: panic("application binding plan slot is empty")
        Some(value): value
    }
    var type = match program.structs.take(typeID) {
        None: panic("web body struct slot is empty")
        Some(value): value
    }
    var valid = true
    var fieldIndex u64 = 0
    while fieldIndex < type.fields.len() {
        var field = match type.fields.take(fieldIndex) {
            None: panic("web body field slot is empty")
            Some(value): value
        }
        if !field.hasDefault &&
            !applicationBindingFieldPlanned(&plan, fieldIndex) {
            var nestedValid = false
            match plan.jsonBodyField {
                None: {}
                Some(jsonField): {
                    if jsonField == fieldIndex {
                        var nested = applicationBaseType(&field.type)
                        if nested.kind.Matches("StructValue") {
                            nestedValid = applicationValidateWebBodyInitializer(
                                &program,
                                &model,
                                nested.declaration,
                                &checked,
                                &active,
                                &diagnostics
                            )
                        }
                    }
                }
            }
            if !nestedValid {
                diagnostics.reportError(
                    "FDN2382",
                    "typed web body field requires a default or generated binding " +
                    "value: " + type.name + "." + field.name,
                    type.sourceSpan
                )
                valid = false
            }
        }
        type.fields.restore(fieldIndex, $field)
        fieldIndex += 1
    }
    program.structs.restore(typeID, $type)
    model.bindings.restore(planIndex, $plan)
    active.truncate(activeLength)
    if valid {
        applicationRequireService(&checked, typeID)
    }
    valid
}

struct applicationWebActivationState {
    visited own arena<u64>
    selected Option<semanticType>
}

fn applicationInspectWebActivation(
    &program firProgram,
    &model applicationModel,
    serviceID u64,
    &state applicationWebActivationState,
    &diagnostics diagnostics
) void {
    const selectedPlan = applicationServicePlanIndex(&model, serviceID)
    const planIndex = match selectedPlan {
        None: { return }
        Some(value): value
    }
    var plan = match model.services.take(planIndex) {
        None: panic("application service plan slot is empty")
        Some(value): value
    }
    if plan.lifetime.Matches("Singleton") ||
        applicationRequiredServiceContains(&state.visited, serviceID) {
        model.services.restore(planIndex, $plan)
        return
    }
    discard state.visited.add(serviceID)
    var constructor = match program.functions.take(plan.constructor) {
        None: panic("web activation constructor slot is empty")
        Some(value): value
    }
    if plan.fallible {
        var candidate = semanticTypeArgument(&constructor.returnType, 1)
        const previous = replace state.selected with .None
        match previous {
            None: {
                state.selected = .Some(copySemanticType(&candidate))
            }
            Some(current): {
                var selected = current
                if !sameSemanticType(&selected, &candidate) {
                    diagnostics.reportError(
                        "FDN2394",
                        "fallible constructors in one web activation must use the " +
                        "same error type",
                        constructor.sourceSpan
                    )
                }
                state.selected = .Some(selected)
            }
        }
    }
    const dependencyCount = plan.dependencies.len()
    const constructorSpan = constructor.sourceSpan
    program.functions.restore(plan.constructor, $constructor)
    model.services.restore(planIndex, $plan)
    var index u64 = 0
    while index < dependencyCount {
        var active = match model.services.take(planIndex) {
            None: panic("application service plan slot is empty")
            Some(value): value
        }
        var dependency = match active.dependencies.take(index) {
            None: panic("application dependency slot is empty")
            Some(value): value
        }
        if dependency.input {
            diagnostics.reportError(
                "FDN2393",
                "web activation cannot supply DI input " + dependency.parameter +
                " for " + applicationServiceName(&program, serviceID),
                constructorSpan
            )
        }
        const selectedProvider = replace dependency.provider with .None
        var providerPresent = false
        var providerID u64 = 0
        match selectedProvider {
            None: {}
            Some(value): {
                providerPresent = true
                providerID = value
                dependency.provider = .Some(value)
            }
        }
        active.dependencies.restore(index, $dependency)
        model.services.restore(planIndex, $active)
        if providerPresent {
            applicationInspectWebActivation(
                &program, &model, providerID, &state, &diagnostics)
        }
        index += 1
    }
}

fn applicationFindWebResponse(&program firProgram) Option<u64> {
    var index u64 = 0
    while index < program.structs.len() {
        var type = match program.structs.take(index) {
            None: panic("struct slot is empty")
            Some(value): value
        }
        const found = type.name == "foundation.web.Response"
        program.structs.restore(index, $type)
        if found return .Some(index)
        index += 1
    }
    .None
}

fn applicationWebAssignMethods(
    &program firProgram,
    &model applicationModel
) void {
    var used = newArena<String>()
    var index u64 = 0
    while index < model.webRoutes.len() {
        var route = match model.webRoutes.take(index) {
            None: panic("web route slot is empty")
            Some(value): value
        }
        var function = match program.functions.take(route.function) {
            None: panic("web route function slot is empty")
            Some(value): value
        }
        const base = applicationHostIdentifier(
            applicationShortName(function.name), true)
        var candidate = text.Copy(base)
        var suffix u64 = 2
        while applicationStringContains(&used, candidate) {
            candidate = base + format.U64(suffix)
            suffix += 1
        }
        discard used.add(text.Copy(candidate))
        route.hostMethod = candidate
        program.functions.restore(route.function, $function)
        model.webRoutes.restore(index, $route)
        index += 1
    }
}

fn applicationFinalizeWebRoutes(
    &program firProgram,
    &model applicationModel,
    &diagnostics diagnostics
) void {
    if model.webRoutes.len() == 0 {
        applicationFinalizeWebMiddlewares(&program, &model, &diagnostics)
        return
    }
    model.includeApplicationHost = true
    const response = applicationFindWebResponse(&program)
    const responseID u64 = match response {
        None: {
            var first = match model.webRoutes.take(0) {
                None: panic("web route slot is empty")
                Some(value): value
            }
            diagnostics.reportError(
                "FDN2361", "generated web routes require foundation.web.Response",
                applicationFunctionSpan(&program, first.function))
            model.webRoutes.restore(0, $first)
            0
        }
        Some(value): value
    }
    var routeIndex u64 = 0
    while routeIndex < model.webRoutes.len() {
        var route = match model.webRoutes.take(routeIndex) {
            None: panic("web route slot is empty")
            Some(value): value
        }
        var function = match program.functions.take(route.function) {
            None: panic("web route function slot is empty")
            Some(value): value
        }
        match response {
            None: {}
            Some(value): {
                var expected = declaredSemanticType(.StructValue, responseID)
                if sameSemanticType(&function.returnType, &expected) {
                    route.executionError = .None
                } else {
                    var result = applicationBaseType(&function.returnType)
                    var valid = false
                    if applicationNamedEnum(&program, &result, "Result") &&
                        result.arguments.len() == 2 {
                        var success = semanticTypeArgument(&result, 0)
                        if sameSemanticType(&success, &expected) {
                            var error = semanticTypeArgument(&result, 1)
                            route.executionError = .Some(copySemanticType(&error))
                            valid = true
                        }
                    }
                    if !valid {
                        diagnostics.reportError(
                            "FDN2362",
                            "web route must return web.Response or Result of it",
                            function.sourceSpan
                        )
                    }
                }
                discard value
            }
        }
        var activation = applicationWebActivationState {
            visited = newArena<u64>()
            selected = .None
        }
        var parameterIndex u64 = 0
        while parameterIndex < route.parameters.len() {
            var parameter = match route.parameters.take(parameterIndex) {
                None: panic("web parameter slot is empty")
                Some(value): value
            }
            const provider = replace parameter.provider with .None
            match provider {
                None: {}
                Some(value): {
                    parameter.provider = .Some(value)
                    applicationInspectWebActivation(
                        &program, &model, value, &activation, &diagnostics)
                }
            }
            route.parameters.restore(parameterIndex, $parameter)
            parameterIndex += 1
        }
        route.activationError = replace activation.selected with .None
        applicationAddImport(&model, function.packageName)
        applicationCollectTypeImports(&program, &model, &function.returnType)
        parameterIndex = 0
        while parameterIndex < function.parameters.len() {
            var parameter = applicationParameter(&function, parameterIndex)
            applicationCollectTypeImports(&program, &model, &parameter.type)
            parameterIndex += 1
        }
        program.functions.restore(route.function, $function)
        model.webRoutes.restore(routeIndex, $route)
        routeIndex += 1
    }
    applicationFinalizeWebMiddlewares(&program, &model, &diagnostics)
    var middlewareIndex u64 = 0
    while middlewareIndex < model.webMiddlewares.len() {
        var middleware = match model.webMiddlewares.take(middlewareIndex) {
            None: panic("web middleware slot is empty")
            Some(value): value
        }
        var function = match program.functions.take(middleware.function) {
            None: panic("web middleware function slot is empty")
            Some(value): value
        }
        applicationAddImport(&model, function.packageName)
        applicationCollectTypeImports(&program, &model, &function.returnType)
        var parameterIndex u64 = 0
        while parameterIndex < function.parameters.len() {
            var parameter = applicationParameter(&function, parameterIndex)
            applicationCollectTypeImports(&program, &model, &parameter.type)
            parameterIndex += 1
        }
        program.functions.restore(middleware.function, $function)
        model.webMiddlewares.restore(middlewareIndex, $middleware)
        middlewareIndex += 1
    }
    applicationAddImport(&model, "foundation.web")
    applicationAddImport(&model, "std.text")
    var usesParse = false
    var checkedBodies = newArena<u64>()
    var activeBodies = newArena<u64>()
    routeIndex = 0
    while routeIndex < model.webRoutes.len() {
        var route = match model.webRoutes.take(routeIndex) {
            None: panic("web route slot is empty")
            Some(value): value
        }
        var function = match program.functions.take(route.function) {
            None: panic("web route function slot is empty")
            Some(value): value
        }
        var parameterIndex u64 = 0
        while parameterIndex < route.parameters.len() {
            var parameter = match route.parameters.take(parameterIndex) {
                None: panic("web parameter slot is empty")
                Some(value): value
            }
            var value = applicationParameter(&function, parameter.index)
            var base = applicationBaseType(&value.type)
            if !parameter.source.Matches("Inject") &&
                !parameter.source.Matches("Body") &&
                (base.kind.Matches("Bool") || isSemanticInteger(&base)) {
                usesParse = true
            }
            if parameter.source.Matches("Body") &&
                base.kind.Matches("StructValue") {
                discard applicationValidateWebBodyInitializer(
                    &program,
                    &model,
                    base.declaration,
                    &checkedBodies,
                    &activeBodies,
                    &diagnostics
                )
            }
            route.parameters.restore(parameterIndex, $parameter)
            parameterIndex += 1
        }
        program.functions.restore(route.function, $function)
        model.webRoutes.restore(routeIndex, $route)
        routeIndex += 1
    }
    if usesParse {
        applicationAddImport(&model, "std.parse")
    }
    applicationSortWebRoutes(&model.webRoutes)
    applicationWebAssignMethods(&program, &model)
}
