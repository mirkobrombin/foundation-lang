package fuzz.baseline

import fuzz.support as support

@target(linux)
fn selectedTarget() String {
    "linux"
}

@target(macos)
fn selectedTarget() String {
    "macos"
}

@target(windows)
fn selectedTarget() String {
    "windows"
}

extern c fn unusedNative() i32 as foundation_fuzz_native

extern c fn FoundationFuzzProbe(value i32) i32 as foundation_fuzz_probe {
    value
}

enum Maybe<T> {
    None
    Some(T)
}

contract Readable {
    fn read(self) i32
}

contract CounterValue extends Readable {
    fn increment(&self) void

    fn incrementTwice(&self) void {
        self.increment()
        self.increment()
    }
}

struct Counter implements CounterValue {
    value i32

    fn read(self) i32 {
        self.value
    }

    fn increment(&self) void {
        self.value = self.value + 1
    }
}

struct CounterWrapper implements CounterValue {
    counter Counter

    delegate counter as CounterValue
}

struct Packet {
    value String
    count i32
}

struct Resource {
    value String

    fn drop(&self) void {
        self.value = "released"
    }
}

fn identity<T>(value T) T {
    value
}

fn first(values [String]) void {
    print(values[0])
}

fn makeReadable(value i32) own Readable {
    own Counter { value = value }
}

fn main(args [String]) i32 {
    print("fuzz seed")
    print(selectedTarget())
    const bytes u64 = 11925602363
    discard bytes
    const values = ["array", "slice"]
    first(values)
    var counter = CounterWrapper { counter = Counter { value = 40 } }
    counter.incrementTwice()
    print(counter.read())
    const dynamic = makeReadable(42)
    print(dynamic.read())
    discard dynamic
    var message = "before"
    const previous = replace message with "after"
    discard previous
    const Packet { value count as itemCount } = Packet { value = message count = 1 }
    discard value
    discard itemCount
    discard Resource { value = "live" }
    const value = Maybe.Some(identity(0))
    match value {
        None: 1
        Some(number): number
    }
}
