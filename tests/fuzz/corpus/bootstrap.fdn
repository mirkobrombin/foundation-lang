package fuzz.bootstrap

import fuzz.support as support

@target(linux)
fn selectedTarget() String {
    "linux"
}

@target(macos)
fn selectedTarget() String {
    "macos"
}

@target(windows)
fn selectedTarget() String {
    "windows"
}

extern c fn unusedNative() i32 as foundation_fuzz_native

extern c fn FoundationFuzzProbe(value i32) i32 as foundation_fuzz_probe {
    value
}

enum Maybe<T> {
    None
    Some(T)
}

contract Readable {
    fn read(view) i32
}

struct Counter implements Readable {
    value i32

    fn read(view) i32 {
        self.value
    }
}

struct Packet {
    value String
    count i32
}

struct Resource {
    value String

    fn drop(edit) void {
        self.value = "released"
    }
}

fn identity<T>(value T) T {
    value
}

fn first(values view [String]) void {
    print(values[0])
}

fn main(args view [String]) i32 {
    print("fuzz seed")
    print(selectedTarget())
    let bytes u64 = 11925602363
    discard bytes
    let values = ["array", "slice"]
    first(view values)
    let counter = Counter { value = 42 }
    print(counter.read())
    var message = "before"
    let previous = replace message with "after"
    discard previous
    let Packet { value count as itemCount } = Packet { value = message count = 1 }
    discard value
    discard itemCount
    discard Resource { value = "live" }
    let value = Maybe.Some(identity(0))
    match value {
        None: 1
        Some(number): number
    }
}
