package fuzz.bootstrap

import fuzz.support as support

enum Maybe<T> {
    None
    Some(T)
}

contract Readable {
    fn read(view) i32
}

struct Counter implements Readable {
    value i32

    fn read(view) i32 {
        self.value
    }
}

fn identity<T>(value T) T {
    value
}

fn first(values view [String]) void {
    print(values[0])
}

fn main() i32 {
    print("fuzz seed")
    let values = ["array", "slice"]
    first(view values)
    let counter = Counter { value = 42 }
    print(counter.read())
    let value = Maybe.Some(identity(0))
    match value {
        None: 1
        Some(number): number
    }
}
