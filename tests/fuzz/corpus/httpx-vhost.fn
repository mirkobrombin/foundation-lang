import foundation.httpx
import foundation.web

enum Failure {
    Rejected
}

struct application implements web.Application<Failure> {
    fn Dispatch(
        &self,
        $request web.Request
    ) Result<web.Response, web.DispatchError<Failure>> {
        discard request
        .Ok(web.Empty(204))
    }
}

fn main() i32 {
    const host = httpx.NewVirtualHost<Failure>(
        "example.com",
        own application {}
    )
    discard host
    0
}
