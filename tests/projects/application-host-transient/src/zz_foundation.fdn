package test.host.transient

struct FoundationApplication {
    foundationSeed Seed
}

fn BuildFoundationApplication(foundationSeedInitial i32) FoundationApplication {
    const foundationSeed = Seed.New(foundationSeedInitial)
    FoundationApplication { foundationSeed = foundationSeed }
}

methods FoundationApplication {
    fn Next(self, foundationStepAmount i32, foundationCounterOffset i32) i32 {
        const foundationStep = Step.New(foundationStepAmount)
        var foundationCounter = Counter.New(self.foundationSeed, $foundationStep, foundationCounterOffset)
        foundationCounter.Next()
    }
}

struct FoundationNextAction {
    foundationStepAmount i32
    foundationCounterOffset i32
}

enum FoundationAction {
    Next(FoundationNextAction)
}

struct FoundationActionKeyBinding {
    key String
    actionName String
}

enum FoundationActionResult {
    Next(value i32)
}

enum FoundationDispatchError {
    UnknownName
    UnknownKey
    ActionMismatch
}

methods FoundationApplication {
    fn HasAction(self, name String) bool {
        name == "next"
    }

    fn ActionNames(self) [1]String {
        ["next"]
    }

    fn ActionKeyBindings(self) [0]FoundationActionKeyBinding {
        []
    }
}

methods FoundationApplication {
    fn foundationDispatchNext(self, $payload FoundationNextAction) Result<FoundationActionResult, FoundationDispatchError> {
        const FoundationNextAction { foundationStepAmount foundationCounterOffset } = payload
        .Ok(.Next(value = self.Next(foundationStepAmount, foundationCounterOffset)))
    }

    fn foundationDispatchNameNext(self, foundationDispatchName String, $payload FoundationNextAction) Result<FoundationActionResult, FoundationDispatchError> {
        if foundationDispatchName != "next" return .Err(.ActionMismatch)
        self.foundationDispatchNext($payload)
    }

    fn foundationDispatchKeyNext(self, foundationDispatchKey String, $payload FoundationNextAction) Result<FoundationActionResult, FoundationDispatchError> {
        if true return .Err(.ActionMismatch)
        self.foundationDispatchNext($payload)
    }
}

methods FoundationApplication {
    fn Dispatch(self, $request FoundationAction) Result<FoundationActionResult, FoundationDispatchError> {
        match request {
            Next(payload): self.foundationDispatchNext($payload)
        }
    }
}

methods FoundationApplication {
    fn DispatchName(self, foundationDispatchName String, $request FoundationAction) Result<FoundationActionResult, FoundationDispatchError> {
        if foundationDispatchName != "next" return .Err(.UnknownName)
        match request {
            Next(payload): self.foundationDispatchNameNext(foundationDispatchName, $payload)
        }
    }
}

// foundation:generated application/v1
