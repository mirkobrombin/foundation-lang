{
  "openapi": "3.0.3",
  "info": {
    "title": "test.openapi",
    "version": "1.2.3"
  },
  "paths": {
    "/assets/{path}": {
      "get": {
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "summary": "Find a user",
        "description": "Finds one user by the public identifier.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "minimum_age",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 18
            }
          },
          {
            "name": "role",
            "in": "query",
            "description": "Optional role filter.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["admin", "member"]
            }
          },
          {
            "name": "X-Trace",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User found"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    }
  }
}
