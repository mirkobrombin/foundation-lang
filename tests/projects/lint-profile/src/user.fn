package lint.fixture

// Stores a user score.
struct User {
    // The visible score.
    Score i32
}

methods User {
    fn MissingMethod(self) i32 {
        self.Score
    }
}

fn consumeResult(
    $result Result<own Documented, i32>
) i32 {
    match result {
        Ok(value): value.Value
        Err(error): error
    }
}
