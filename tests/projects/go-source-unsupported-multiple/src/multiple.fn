package sample.multiple

struct Token {
    Value i32

    fn Consume($self) i32 {
        self.Value
    }
}

fn makeToken() own Token {
    own Token { Value = 42 }
}

fn twice(value i32) i32 {
    value * 2
}

fn RejectedStatements(value Option<i32>) i32 {
    const Token { Value } = makeToken()
    const escaped = twice(match value {
        None: {
            return 1
        }
        Some(inner): inner
    })
    Value + escaped
}

fn PanicArgument() i32 {
    twice(panic("no value"))
}

fn RangeTotal() i32 {
    var total = 0
    for value in range(0, 3, 1) {
        total = total + value
    }
    total
}
