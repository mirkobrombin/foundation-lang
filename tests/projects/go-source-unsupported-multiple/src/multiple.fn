package sample.multiple

struct Chain {
    Value i32
    Next own Chain
}

fn twice(value i32) i32 {
    value * 2
}

fn ChainValue(chain Chain) i32 {
    chain.Value
}

fn RejectedStatements(value Option<i32>) i32 {
    const escaped = twice(match value {
        None: {
            return 1
        }
        Some(inner): inner
    })
    escaped + 1
}

fn PanicArgument() i32 {
    twice(panic("no value"))
}

fn RangeTotal() i32 {
    var total = 0
    for value in range(0, 3, 1) {
        total = total + value
    }
    total
}
