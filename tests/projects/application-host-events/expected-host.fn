package test.host.events

import foundation.events as foundationHost0

struct FoundationApplication {
    foundationAccounts Accounts
}

fn BuildFoundationApplication() FoundationApplication {
    const foundationAccounts = Accounts.New()
    FoundationApplication { foundationAccounts = foundationAccounts }
}

methods FoundationApplication {
    fn AccountsRegister(&self, $name String, reject bool) Result<void, foundationHost0.PublishError<DeliveryError>> {
        self.foundationAccounts.Register($name, reject)
    }
}

struct FoundationAccountsRegisterAction {
    name String
    reject bool
}

enum FoundationAction {
    AccountsRegister(FoundationAccountsRegisterAction)
}

struct FoundationActionKeyBinding {
    key String
    actionName String
}

enum FoundationActionResult {
    AccountsRegister
}

enum FoundationDispatchError {
    UnknownName
    UnknownKey
    ActionMismatch
    AccountsRegisterFailed(error foundationHost0.PublishError<DeliveryError>)
}

methods FoundationApplication {
    fn HasAction(self, name String) bool {
        name == "accounts.register"
    }

    fn ActionNames(self) [1]String {
        ["accounts.register"]
    }

    fn ActionKeyBindings(self) [0]FoundationActionKeyBinding {
        []
    }
}

methods FoundationApplication {
    fn foundationDispatchAccountsRegister(&self, $payload FoundationAccountsRegisterAction) Result<FoundationActionResult, FoundationDispatchError> {
        const FoundationAccountsRegisterAction { name reject } = payload
        match self.AccountsRegister($name, reject) {
            Ok: .Ok(.AccountsRegister)
            Err(error): .Err(.AccountsRegisterFailed(error = error))
        }
    }

    fn foundationDispatchNameAccountsRegister(&self, foundationDispatchName String, $payload FoundationAccountsRegisterAction) Result<FoundationActionResult, FoundationDispatchError> {
        if foundationDispatchName != "accounts.register" return .Err(.ActionMismatch)
        self.foundationDispatchAccountsRegister($payload)
    }

    fn foundationDispatchKeyAccountsRegister(&self, foundationDispatchKey String, $payload FoundationAccountsRegisterAction) Result<FoundationActionResult, FoundationDispatchError> {
        if true return .Err(.ActionMismatch)
        self.foundationDispatchAccountsRegister($payload)
    }
}

methods FoundationApplication {
    fn Dispatch(&self, $request FoundationAction) Result<FoundationActionResult, FoundationDispatchError> {
        match request {
            AccountsRegister(payload): self.foundationDispatchAccountsRegister($payload)
        }
    }
}

methods FoundationApplication {
    fn DispatchName(&self, foundationDispatchName String, $request FoundationAction) Result<FoundationActionResult, FoundationDispatchError> {
        if foundationDispatchName != "accounts.register" return .Err(.UnknownName)
        match request {
            AccountsRegister(payload): self.foundationDispatchNameAccountsRegister(foundationDispatchName, $payload)
        }
    }
}

