package test.host.scope

struct FoundationApplication {
    foundationSeed Seed
}

struct FoundationScope {
    foundationRepository Repository
    foundationHandler Handler
}

fn BuildFoundationApplication($foundationSeedLabel String) FoundationApplication {
    const foundationSeed = Seed.New($foundationSeedLabel)
    FoundationApplication { foundationSeed = foundationSeed }
}

methods FoundationApplication {
    fn NewScope(self, foundationRepositorySuffix String) Result<FoundationScope, ScopeError> {
        const foundationRepository = Repository.New(self.foundationSeed, foundationRepositorySuffix) else error {
            return .Err(error)
        }
        const foundationHandler = Handler.New(foundationRepository)
        .Ok(FoundationScope { foundationRepository = foundationRepository foundationHandler = foundationHandler })
    }

    fn Read(self, foundationScope FoundationScope) i32 {
        const foundationReader = Reader.New(foundationScope.foundationHandler)
        foundationReader.Read()
    }

    fn Run(self, &foundationScope FoundationScope) i32 {
        foundationScope.foundationHandler.Run()
    }
}

enum FoundationScopedAction {
    Read
    Run
}

struct FoundationActionKeyBinding {
    key String
    actionName String
}

enum FoundationActionResult {
    Read(value i32)
    Run(value i32)
}

enum FoundationDispatchError {
    UnknownName
    UnknownKey
    ActionMismatch
}

methods FoundationApplication {
    fn HasAction(self, name String) bool {
        name == "read" || name == "run"
    }

    fn ActionNames(self) [2]String {
        ["read", "run"]
    }

    fn ActionKeyBindings(self) [0]FoundationActionKeyBinding {
        []
    }
}

methods FoundationApplication {
    fn foundationDispatchRead(self, foundationScope FoundationScope) Result<FoundationActionResult, FoundationDispatchError> {
        .Ok(.Read(value = self.Read(foundationScope)))
    }

    fn foundationDispatchNameRead(self, foundationScope FoundationScope, foundationDispatchName String) Result<FoundationActionResult, FoundationDispatchError> {
        if foundationDispatchName != "read" return .Err(.ActionMismatch)
        self.foundationDispatchRead(foundationScope)
    }

    fn foundationDispatchKeyRead(self, foundationScope FoundationScope, foundationDispatchKey String) Result<FoundationActionResult, FoundationDispatchError> {
        if true return .Err(.ActionMismatch)
        self.foundationDispatchRead(foundationScope)
    }

    fn foundationDispatchRun(self, &foundationScope FoundationScope) Result<FoundationActionResult, FoundationDispatchError> {
        .Ok(.Run(value = self.Run(&foundationScope)))
    }

    fn foundationDispatchNameRun(self, &foundationScope FoundationScope, foundationDispatchName String) Result<FoundationActionResult, FoundationDispatchError> {
        if foundationDispatchName != "run" return .Err(.ActionMismatch)
        self.foundationDispatchRun(&foundationScope)
    }

    fn foundationDispatchKeyRun(self, &foundationScope FoundationScope, foundationDispatchKey String) Result<FoundationActionResult, FoundationDispatchError> {
        if true return .Err(.ActionMismatch)
        self.foundationDispatchRun(&foundationScope)
    }
}

methods FoundationApplication {
    fn DispatchScoped(self, &foundationScope FoundationScope, $request FoundationScopedAction) Result<FoundationActionResult, FoundationDispatchError> {
        match request {
            Read: self.foundationDispatchRead(foundationScope)
            Run: self.foundationDispatchRun(&foundationScope)
        }
    }
}

methods FoundationApplication {
    fn DispatchNameScoped(self, &foundationScope FoundationScope, foundationDispatchName String, $request FoundationScopedAction) Result<FoundationActionResult, FoundationDispatchError> {
        if foundationDispatchName != "read" && foundationDispatchName != "run" return .Err(.UnknownName)
        match request {
            Read: self.foundationDispatchNameRead(foundationScope, foundationDispatchName)
            Run: self.foundationDispatchNameRun(&foundationScope, foundationDispatchName)
        }
    }
}

// foundation:generated application/v1
