package test.host.web

import foundation.bind as foundationHost0
import foundation.web as foundationHost1
import std.collections as foundationHost2
import std.json as foundationHost3
import std.parse as foundationHost4
import std.text as foundationHost5

methods ProfileInput {
    fn Bind(
