        if source.Contains("DisplayName") {
            const value = source.Required("DisplayName")
            self.DisplayName = value
        }
        if source.Contains("Age") {
            const value = source.Required("Age")
            const bindingParsed1 = foundationHost4.U8(value) else error {
                const bindingKind1 foundationHost0.ErrorKind = match error {
                    Empty: .Empty
                    Invalid: .Invalid
                    Overflow: .OutOfRange
                }
                return .Err(foundationHost0.Error {
                    Kind = bindingKind1
                    Field = "Age"
                    Key = "Age"
                    Value = value
                })
            }
            self.Age = bindingParsed1
        }
        if source.Contains("Enabled") {
            const value = source.Required("Enabled")
            const bindingParsed2 = foundationHost4.Bool(value) else error {
                const bindingKind2 foundationHost0.ErrorKind = match error {
                    Empty: .Empty
                    Invalid: .Invalid
                }
                return .Err(foundationHost0.Error {
                    Kind = bindingKind2
                    Field = "Enabled"
                    Key = "Enabled"
                    Value = value
