enum FoundationWebBindingSource {
    Path
    Query
    Header
    Form
    Body
}

enum FoundationWebBindingKind {
    Missing
    Invalid
    UnsupportedMediaType
}

struct FoundationWebBindingError {
    Kind FoundationWebBindingKind
    Source FoundationWebBindingSource
    Name String
}

enum FoundationWebError {
    Binding(error FoundationWebBindingError)
    JSON(error foundationHost0.Error)
    CreateUserFailed(error RouteError)
}

struct FoundationApplication implements foundationHost1.Application<FoundationWebError> {
    foundationRoutes own foundationHost1.RouteTable
    foundationPrefix Prefix
}

fn BuildFoundationApplication() own FoundationApplication {
    var foundationRoutes = foundationHost1.NewRouteTable()
    foundationRequireWebRoute($foundationRoutes.Add(1, .POST, "/forms"))
    foundationRequireWebRoute($foundationRoutes.Add(2, .POST, "/profiles"))
    foundationRequireWebRoute($foundationRoutes.Add(3, .POST, "/users/{id:alpha}"))
    const foundationPrefix = Prefix.New()
    own FoundationApplication { foundationRoutes = foundationRoutes foundationPrefix = foundationPrefix }
}

fn foundationRequireWebRoute(
    $value Result<void, foundationHost1.RegistrationError>
) void {
    const accepted = match value {
        Ok: true
        Err(error): foundationWebRouteInvariant($error)
    }
    discard accepted
}

fn foundationWebRouteInvariant(
    $error foundationHost1.RegistrationError
) never {
    discard error
    panic("generated web route invariant failed")
}

fn foundationRequireWebValue(
    $value Option<String>,
    source FoundationWebBindingSource,
    name String
) Result<String, FoundationWebBindingError> {
    match value {
        None: .Err(FoundationWebBindingError {
            Kind = .Missing
            Source = source
            Name = foundationHost5.Copy(name)
        })
        Some(found): .Ok(found)
    }
}

fn foundationParseWebBool(
    $value String,
    source FoundationWebBindingSource,
    name String
) Result<bool, FoundationWebBindingError> {
    const parsed = foundationHost4.Bool(value) else error {
        discard error
        discard value
        return .Err(FoundationWebBindingError {
            Kind = .Invalid
            Source = source
            Name = foundationHost5.Copy(name)
        })
    }
    discard value
    .Ok(parsed)
}

fn foundationRequireWebJSON(
    $value Result<void, foundationHost0.Error>
) Result<bool, foundationHost0.Error> {
    match value {
        Ok: .Ok(true)
        Err(error): .Err(error)
    }
}

fn foundationWebJSONErrorResponse(
    $error foundationHost0.Error
) Result<foundationHost1.Response, FoundationWebError> {
    discard error
    .Ok(foundationHost1.Text(400, "invalid request body"))
}

methods FoundationApplication {
    fn foundationDispatchWebSubmitForm(
        &self,
        $foundationRequest foundationHost1.Request
    ) Result<foundationHost1.Response, foundationHost1.DispatchError<FoundationWebError>> {
        var foundationActiveRequest = foundationRequest
        const foundationWebParameter0 = foundationRequireWebValue($foundationActiveRequest.Form("name"), .Form, "name") else error {
            return .Err(.Handler(error = .Binding(error = error)))
        }
        discard foundationActiveRequest
        .Ok(SubmitForm(foundationWebParameter0))
    }

    fn foundationDispatchWebCreateProfile(
        &self,
        $foundationRequest foundationHost1.Request
    ) Result<foundationHost1.Response, foundationHost1.DispatchError<FoundationWebError>> {
        var foundationActiveRequest = foundationRequest
        if !foundationActiveRequest.IsJSON() {
            return .Err(.Handler(error = .Binding(error = FoundationWebBindingError { Kind = .UnsupportedMediaType Source = .Body Name = "Content-Type" })))
        }
        var foundationWebParameter0 = ProfileInput { DisplayName = "" Age = 0 Tags = foundationHost2.NewList<String>() }
        const foundationWebParameter0Bound = foundationRequireWebJSON($foundationWebParameter0.BindJSON(foundationActiveRequest.Body)) else error {
            return .Err(.Handler(error = .JSON(error = error)))
        }
        discard foundationWebParameter0Bound
        discard foundationActiveRequest
        .Ok(CreateProfile($foundationWebParameter0))
    }

    fn foundationDispatchWebCreateUser(
        &self,
        $foundationRequest foundationHost1.Request
    ) Result<foundationHost1.Response, foundationHost1.DispatchError<FoundationWebError>> {
        var foundationActiveRequest = foundationRequest
        const foundationWebParameter0 = foundationRequireWebValue($foundationActiveRequest.Param("id"), .Path, "id") else error {
            return .Err(.Handler(error = .Binding(error = error)))
        }
        const foundationWebParameter1 = foundationRequireWebValue($foundationActiveRequest.Query("source"), .Query, "source") else error {
            return .Err(.Handler(error = .Binding(error = error)))
        }
        const foundationWebParameter2Text = foundationRequireWebValue($foundationActiveRequest.Query("limit"), .Query, "limit") else error {
            return .Err(.Handler(error = .Binding(error = error)))
        }
        const foundationWebParameter2 = foundationHost4.I32(foundationWebParameter2Text) else error {
            discard error
            return .Err(.Handler(error = .Binding(error = FoundationWebBindingError { Kind = .Invalid Source = .Query Name = "limit" })))
        }
        discard foundationWebParameter2Text
        const foundationWebParameter3 = foundationActiveRequest.Query("note")
        const foundationWebParameter4 = foundationRequireWebValue($foundationActiveRequest.Header("X-Trace"), .Header, "X-Trace") else error {
            return .Err(.Handler(error = .Binding(error = error)))
        }
        const foundationWebParameter5Text = foundationRequireWebValue($foundationActiveRequest.Header("X-Enabled"), .Header, "X-Enabled") else error {
            return .Err(.Handler(error = .Binding(error = error)))
        }
        const foundationWebParameter5 = foundationParseWebBool($foundationWebParameter5Text, .Header, "X-Enabled") else error {
            return .Err(.Handler(error = .Binding(error = error)))
        }
        const foundationWebParameter6 = foundationHost5.Copy(foundationActiveRequest.Body)
        discard foundationActiveRequest
        match CreateUser(foundationWebParameter0, foundationWebParameter1, foundationWebParameter2, $foundationWebParameter3, foundationWebParameter4, foundationWebParameter5, foundationWebParameter6, self.foundationPrefix) {
            Ok(response): .Ok(response)
            Err(error): .Err(.Handler(error = .CreateUserFailed(error = error)))
        }
    }

    fn Dispatch(
        &self,
        $foundationRequest foundationHost1.Request
    ) Result<foundationHost1.Response, foundationHost1.DispatchError<FoundationWebError>> {
        var foundationActiveRequest = foundationRequest
        const foundationMatched = self.foundationRoutes.Match(
            foundationActiveRequest.Method,
            foundationActiveRequest.Path
        ) else error {
            return match error {
                NotFound: .Err(.NotFound)
                MethodNotAllowed: .Err(.MethodNotAllowed)
            }
        }
        const foundationHost1.RouteMatch { Id Params } = foundationMatched
        const foundationPreviousParams = replace foundationActiveRequest.Params with Params
        discard foundationPreviousParams
        if Id == 1 return self.foundationDispatchWebSubmitForm($foundationActiveRequest)
        if Id == 2 return self.foundationDispatchWebCreateProfile($foundationActiveRequest)
        if Id == 3 return self.foundationDispatchWebCreateUser($foundationActiveRequest)
        discard foundationActiveRequest
        .Err(.NotFound)
    }

    fn ErrorResponse(
        self,
        $error FoundationWebError
    ) Result<foundationHost1.Response, FoundationWebError> {
        match error {
            Binding(error): match error.Kind {
                Missing: .Ok(foundationHost1.Text(400, "missing request value"))
                Invalid: .Ok(foundationHost1.Text(400, "invalid request value"))
                UnsupportedMediaType: .Ok(foundationHost1.Text(415, "unsupported media type"))
            }
            JSON(error): foundationWebJSONErrorResponse($error)
            CreateUserFailed(error): .Err(.CreateUserFailed(error = error))
        }
    }
}

