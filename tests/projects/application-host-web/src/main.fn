package test.host.web

import foundation.bind
import foundation.di
import foundation.validation
import foundation.web
import std.collections
import std.json
import std.net
import std.text

enum RouteError {
    Rejected
}

@di.Scope(.Singleton)
service Prefix {
    value String

    ctor New() {
        Prefix { value = "bound" }
    }

    fn Value(self) String {
        text.Copy(self.value)
    }
}

@bind.Bindable()
@validation.Validatable()
struct ProfileInput {
    @bind.JsonName("display_name")
    @validation.Required()
    DisplayName String
    @validation.Min(18)
    @validation.Max(99)
    Age u8
    @validation.Required()
    @validation.Email()
    Email String
    Enabled bool = true
    @validation.Required()
    Tags own collections.List<String>
}

@web.Route(.POST, "/profiles")
fn CreateProfile(@web.Body() $body ProfileInput) web.Response {
    const ProfileInput { DisplayName Age Email Enabled Tags } = body
    const valid = DisplayName == "Ada" && Age == 42 &&
        Email == "ada@example.com" && Enabled && Tags.Len() == 2
    discard Email
    discard Tags
    if !valid return web.Text(400, "invalid profile")
    web.Json(201, $DisplayName)
}

@web.Route(.POST, "/users/{id:alpha}")
fn CreateUser(
    @web.Path("id") id String,
    @web.Query("source") source String,
    @web.Query("limit") limit i32,
    @web.Query("note") $note Option<String>,
    @web.Header("X-Trace") trace String,
    @web.Header("X-Enabled") enabled bool,
    @web.Body() body String,
    @web.Inject() prefix Prefix
) Result<web.Response, RouteError> {
    const noteMatched = match note {
        None: true
        Some(value): value == "optional"
    }
    if id != "Ada" || source != "test" || limit != 7 || !noteMatched ||
        trace != "trace-id" || !enabled || prefix.Value() != "bound" {
        return .Err(.Rejected)
    }
    .Ok(web.Text(200, text.Copy(body)))
}

@web.Route(.POST, "/forms")
fn SubmitForm(@web.Form("name") name String) web.Response {
    web.Text(200, text.Copy(name))
}

fn request(method web.Method, $target String, $path String) web.Request {
    web.Request {
        Method = method
        Target = target
        Path = path
        Version = "HTTP/1.1"
        Headers = collections.NewList<web.HeaderValue>()
        Params = collections.NewList<web.Parameter>()
    }
}

fn responseBody(
    $value Result<web.Response, web.DispatchError<FoundationWebError>>
) String {
    match value {
        Ok(response): takeBody($response)
        Err(error): dispatchFailure(error)
    }
}

fn takeBody($response web.Response) String {
    const web.Response { Status Headers Body } = response
    discard Status
    discard Headers
    const body = Body.Text() else error {
        discard error
        panic("response body must contain UTF-8 text")
    }
    body
}

fn takeStatus($response web.Response) i32 {
    const web.Response { Status Headers Body } = response
    discard Headers
    discard Body
    Status
}

fn mappedStatus(
    application FoundationApplication,
    $value Result<web.Response, web.DispatchError<FoundationWebError>>
) i32 {
    match value {
        Ok(response): takeStatus($response)
        Err(error): mappedDispatchStatus(application, $error)
    }
}

fn mappedDispatchStatus(
    application FoundationApplication,
    $error web.DispatchError<FoundationWebError>
) i32 {
    match error {
        NotFound: 0
        MethodNotAllowed: 0
        Handler(error): mappedHandlerStatus(application, $error)
    }
}

fn mappedHandlerStatus(
    application FoundationApplication,
    $error FoundationWebError
) i32 {
    const response = application.ErrorResponse($error) else preserved {
        discard preserved
        return 0
    }
    takeStatus($response)
}

fn dispatchFailure(error web.DispatchError<FoundationWebError>) String {
    discard error
    ""
}

fn bindingFailure(
    $value Result<web.Response, web.DispatchError<FoundationWebError>>,
    kind FoundationWebBindingKind,
    source FoundationWebBindingSource,
    name String
) bool {
    match value {
        Ok(response): unexpectedResponse($response)
        Err(error): dispatchBindingFailure($error, kind, source, name)
    }
}

fn unexpectedResponse($response web.Response) bool {
    discard response
    false
}

fn dispatchBindingFailure(
    $error web.DispatchError<FoundationWebError>,
    kind FoundationWebBindingKind,
    source FoundationWebBindingSource,
    name String
) bool {
    match error {
        NotFound: false
        MethodNotAllowed: false
        Handler(error): webBindingFailure($error, kind, source, name)
    }
}

fn webBindingFailure(
    $value FoundationWebError,
    kind FoundationWebBindingKind,
    source FoundationWebBindingSource,
    name String
) bool {
    match value {
        Binding(error): bindingMatches($error, kind, source, name)
        JSON(error): unexpectedJSONError($error)
        Validation(errors): unexpectedValidationErrors($errors)
        CreateUserFailed(error): routeFailure(error)
    }
}

fn unexpectedJSONError($error bind.Error) bool {
    discard error
    false
}

fn unexpectedValidationErrors($errors own validation.Errors) bool {
    discard errors
    false
}

fn bindingMatches(
    $value FoundationWebBindingError,
    kind FoundationWebBindingKind,
    source FoundationWebBindingSource,
    name String
) bool {
    const FoundationWebBindingError { Kind Source Name } = value
    sameBindingKind(Kind, kind) && sameBindingSource(Source, source) && Name == name
}

fn sameBindingKind(left FoundationWebBindingKind, right FoundationWebBindingKind) bool {
    match left {
        Missing: match right {
            Missing: true
            Invalid: false
            UnsupportedMediaType: false
        }
        Invalid: match right {
            Missing: false
            Invalid: true
            UnsupportedMediaType: false
        }
        UnsupportedMediaType: match right {
            Missing: false
            Invalid: false
            UnsupportedMediaType: true
        }
    }
}

fn sameBindingSource(
    left FoundationWebBindingSource,
    right FoundationWebBindingSource
) bool {
    match left {
        Path: match right {
            Path: true
            Query: false
            Header: false
            Form: false
            Body: false
        }
        Query: match right {
            Path: false
            Query: true
            Header: false
            Form: false
            Body: false
        }
        Header: match right {
            Path: false
            Query: false
            Header: true
            Form: false
            Body: false
        }
        Form: match right {
            Path: false
            Query: false
            Header: false
            Form: true
            Body: false
        }
        Body: match right {
            Path: false
            Query: false
            Header: false
            Form: false
            Body: true
        }
    }
}

fn jsonFailure(
    $value Result<web.Response, web.DispatchError<FoundationWebError>>,
    kind bind.ErrorKind,
    jsonKind json.ErrorKind,
    field String,
    key String
) bool {
    match value {
        Ok(response): unexpectedResponse($response)
        Err(error): dispatchJSONFailure($error, kind, jsonKind, field, key)
    }
}

fn dispatchJSONFailure(
    $error web.DispatchError<FoundationWebError>,
    kind bind.ErrorKind,
    jsonKind json.ErrorKind,
    field String,
    key String
) bool {
    match error {
        NotFound: false
        MethodNotAllowed: false
        Handler(error): webJSONFailure($error, kind, jsonKind, field, key)
    }
}

fn webJSONFailure(
    $value FoundationWebError,
    kind bind.ErrorKind,
    jsonKind json.ErrorKind,
    field String,
    key String
) bool {
    match value {
        Binding(error): unexpectedBindingError($error)
        JSON(error): bindJSONFailure($error, kind, jsonKind, field, key)
        Validation(errors): unexpectedValidationErrors($errors)
        CreateUserFailed(error): routeFailure(error)
    }
}

fn unexpectedBindingError($error FoundationWebBindingError) bool {
    discard error
    false
}

fn bindJSONFailure(
    $error bind.Error,
    kind bind.ErrorKind,
    jsonKind json.ErrorKind,
    field String,
    key String
) bool {
    const same = bindErrorKindCode(error.Kind) == bindErrorKindCode(kind) &&
        error.Field == field && error.Key == key
    if !same return false
    if bindErrorKindCode(kind) != 4 return true
    jsonErrorKindCode(error.JsonKind) == jsonErrorKindCode(jsonKind) && error.Offset != 0
}

fn bindErrorKindCode(kind bind.ErrorKind) i32 {
    match kind {
        Empty: 1
        Invalid: 2
        OutOfRange: 3
        JsonSyntax: 4
        JsonType: 5
        JsonUnknownField: 6
    }
}

fn jsonErrorKindCode(kind json.ErrorKind) i32 {
    match kind {
        UnexpectedEnd: 1
        UnexpectedToken: 2
        InvalidString: 3
        InvalidEscape: 4
        InvalidNumber: 5
        DuplicateKey: 6
        DepthLimit: 7
        TrailingData: 8
    }
}

fn routeFailure(error RouteError) bool {
    discard error
    false
}

fn validationFailure(
    $value Result<web.Response, web.DispatchError<FoundationWebError>>,
    maximum bool
) bool {
    match value {
        Ok(response): unexpectedResponse($response)
        Err(error): dispatchValidationFailure($error, maximum)
    }
}

fn dispatchValidationFailure(
    $error web.DispatchError<FoundationWebError>,
    maximum bool
) bool {
    match error {
        NotFound: false
        MethodNotAllowed: false
        Handler(error): webValidationFailure($error, maximum)
    }
}

fn webValidationFailure($value FoundationWebError, maximum bool) bool {
    match value {
        Binding(error): unexpectedBindingError($error)
        JSON(error): unexpectedJSONError($error)
        Validation(errors): selectedValidationErrorsMatch($errors, maximum)
        CreateUserFailed(error): routeFailure(error)
    }
}

fn selectedValidationErrorsMatch(
    $errors own validation.Errors,
    maximum bool
) bool {
    if maximum return maximumValidationErrorsMatch($errors)
    validationErrorsMatch($errors)
}

fn validationErrorsMatch($errors own validation.Errors) bool {
    var values = errors
    if values.Len() != 4 return false
    const displayName = validationError(values.TakeFirst())
    const age = validationError(values.TakeFirst())
    const email = validationError(values.TakeFirst())
    const tags = validationError(values.TakeFirst())
    displayName.Field == "DisplayName" && displayName.Message == "required" &&
        validationKindCode(displayName.Kind) == 1 && age.Field == "Age" &&
        age.Message == "min 18" && validationKindCode(age.Kind) == 2 &&
        email.Field == "Email" && email.Message == "invalid email" &&
        validationKindCode(email.Kind) == 4 && tags.Field == "Tags" &&
        tags.Message == "required" && validationKindCode(tags.Kind) == 1
}

fn validationError($value Option<validation.Error>) validation.Error {
    match value {
        None: panic("missing generated validation error")
        Some(error): error
    }
}

fn validationKindCode(kind validation.ErrorKind) i32 {
    match kind {
        Required: 1
        Min: 2
        Max: 3
        Email: 4
        Pattern: 5
        Custom: 6
    }
}

fn maximumValidationErrorsMatch($errors own validation.Errors) bool {
    var values = errors
    if values.Len() != 1 return false
    const age = validationError(values.TakeFirst())
    age.Field == "Age" && age.Message == "max 99" &&
        validationKindCode(age.Kind) == 3
}

fn profileRequest($body String, contentType String) web.Request {
    var value = request(.POST, "/profiles", "/profiles")
    value.ContentLength = text.ByteLen(body)
    value.Body = body
    if contentType != "" {
        value.Headers.PushFront(web.HeaderValue {
            Name = "Content-Type"
            Value = text.Copy(contentType)
        })
    }
    value
}

fn lineOr($value Result<Option<String>, net.Error>) String {
    const line = value else error {
        discard error
        panic("generated HTTP response read failed")
    }
    match line {
        None: panic("generated HTTP response ended early")
        Some(found): found
    }
}

fn serverOr(
    $value Result<own web.Server<FoundationWebError>, net.Error>
) own web.Server<FoundationWebError> {
    const server = value else error {
        discard error
        panic("generated HTTP server bind failed")
    }
    server
}

fn connectionOr(
    $value Result<own net.TcpConnection, net.Error>
) own net.TcpConnection {
    const connection = value else error {
        discard error
        panic("generated HTTP client connection failed")
    }
    connection
}

fn pairOr($value Result<net.StreamPair, net.Error>) net.StreamPair {
    const pair = value else error {
        discard error
        panic("generated HTTP client split failed")
    }
    pair
}

fn served($value Result<void, web.ServeError<FoundationWebError>>) bool {
    match value {
        Ok: true
        Err(error): false
    }
}

fn main() i32 {
    var application = BuildFoundationApplication()
    var createRequest = request(
        .POST,
        "/users/Ada?source=test&limit=7&note=optional",
        "/users/Ada"
    )
    createRequest.Body = "payload"
    createRequest.ContentLength = 7
    createRequest.Headers.PushFront(web.HeaderValue {
        Name = "X-Trace"
        Value = "trace-id"
    })
    createRequest.Headers.PushFront(web.HeaderValue {
        Name = "X-Enabled"
        Value = "true"
    })
    if responseBody($application.Dispatch($createRequest)) != "payload" return 1

    var missingRequest = request(.POST, "/users/Ada?limit=7", "/users/Ada")
    missingRequest.Body = "payload"
    missingRequest.Headers.PushFront(web.HeaderValue {
        Name = "X-Trace"
        Value = "trace-id"
    })
    missingRequest.Headers.PushFront(web.HeaderValue {
        Name = "X-Enabled"
        Value = "true"
    })
    if !bindingFailure(
        $application.Dispatch($missingRequest),
        .Missing,
        .Query,
        "source"
    ) {
        return 2
    }

    var invalidLimitRequest = request(
        .POST,
        "/users/Ada?source=test&limit=seven",
        "/users/Ada"
    )
    invalidLimitRequest.Body = "payload"
    invalidLimitRequest.Headers.PushFront(web.HeaderValue {
        Name = "X-Trace"
        Value = "trace-id"
    })
    invalidLimitRequest.Headers.PushFront(web.HeaderValue {
        Name = "X-Enabled"
        Value = "true"
    })
    if !bindingFailure(
        $application.Dispatch($invalidLimitRequest),
        .Invalid,
        .Query,
        "limit"
    ) {
        return 3
    }

    var invalidBoolRequest = request(
        .POST,
        "/users/Ada?source=test&limit=7",
        "/users/Ada"
    )
    invalidBoolRequest.Body = "payload"
    invalidBoolRequest.Headers.PushFront(web.HeaderValue {
        Name = "X-Trace"
        Value = "trace-id"
    })
    invalidBoolRequest.Headers.PushFront(web.HeaderValue {
        Name = "X-Enabled"
        Value = "maybe"
    })
    if !bindingFailure(
        $application.Dispatch($invalidBoolRequest),
        .Invalid,
        .Header,
        "X-Enabled"
    ) {
        return 4
    }

    var formRequest = request(.POST, "/forms", "/forms")
    formRequest.Body = "name=Ada+Lovelace"
    if responseBody($application.Dispatch($formRequest)) != "Ada Lovelace" return 5

    const acceptedProfile = profileRequest(
        "{\"display_name\":\"Ada\",\"Age\":42," +
        "\"Email\":\"ada@example.com\"," +
        "\"Tags\":[\"compiler\",\"foundation\"]}",
        "Application/Problem+JSON; charset=\"utf-8\""
    )
    if responseBody($application.Dispatch($acceptedProfile)) != "Ada" return 6

    const missingContentType = profileRequest("{}", "")
    if !bindingFailure(
        $application.Dispatch($missingContentType),
        .UnsupportedMediaType,
        .Body,
        "Content-Type"
    ) {
        return 7
    }

    const malformedContentType = profileRequest("{}", "application/json; charset")
    if !bindingFailure(
        $application.Dispatch($malformedContentType),
        .UnsupportedMediaType,
        .Body,
        "Content-Type"
    ) {
        return 8
    }

    const unknownField = profileRequest("{\"extra\":true}", "application/json")
    if !jsonFailure(
        $application.Dispatch($unknownField),
        .JsonUnknownField,
        .UnexpectedEnd,
        "",
        "extra"
    ) {
        return 9
    }

    const wrongType = profileRequest("{\"Age\":\"forty-two\"}", "application/json")
    if !jsonFailure(
        $application.Dispatch($wrongType),
        .JsonType,
        .UnexpectedEnd,
        "Age",
        "Age"
    ) {
        return 10
    }

    const duplicateField = profileRequest("{\"Age\":1,\"Age\":2}", "application/json")
    if !jsonFailure(
        $application.Dispatch($duplicateField),
        .JsonSyntax,
        .DuplicateKey,
        "",
        ""
    ) {
        return 11
    }

    const trailingData = profileRequest("{\"Age\":1}{\"Age\":2}", "application/json")
    if !jsonFailure(
        $application.Dispatch($trailingData),
        .JsonSyntax,
        .TrailingData,
        "",
        ""
    ) {
        return 12
    }

    const invalidProfile = profileRequest(
        "{\"display_name\":\"\",\"Age\":12,\"Email\":\"invalid\",\"Tags\":[]}",
        "application/json"
    )
    if !validationFailure($application.Dispatch($invalidProfile), false) return 13
    const mappedInvalidProfile = profileRequest(
        "{\"display_name\":\"\",\"Age\":12,\"Email\":\"invalid\",\"Tags\":[]}",
        "application/json"
    )
    if mappedStatus(application, $application.Dispatch($mappedInvalidProfile)) != 422 return 14
    const maximumProfile = profileRequest(
        "{\"display_name\":\"Ada\",\"Age\":120," +
        "\"Email\":\"ada@example.com\",\"Tags\":[\"foundation\"]}",
        "application/json"
    )
    if !validationFailure($application.Dispatch($maximumProfile), true) return 15
    const mappedMaximumProfile = profileRequest(
        "{\"display_name\":\"Ada\",\"Age\":120," +
        "\"Email\":\"ada@example.com\",\"Tags\":[\"foundation\"]}",
        "application/json"
    )
    if mappedStatus(application, $application.Dispatch($mappedMaximumProfile)) != 422 return 16
    discard application

    const serverApplication = BuildFoundationApplication()
    var server = serverOr(web.NewServer<FoundationWebError>(
        "127.0.0.1",
        0,
        $serverApplication
        ))
    const port = server.Port()
    const serving = server.ServeOne()
    const connecting = spawn net.Connect("127.0.0.1", port)
    const connection = connectionOr($connecting.wait())
    const pair = pairOr(connection.Split())
    const net.StreamPair { Reader Writer } = pair
    const writing = spawn net.WriteAll(
        $Writer,
        "POST /profiles HTTP/1.1\r\nHost: localhost\r\nContent-Length: 2\r\n\r\n{}"
    )
    const written = $writing.wait()
    const net.WriteOutcome { Writer as writerAfter Value as writeResult } = written
    discard writerAfter
    const writeAccepted = match writeResult {
        Ok: true
        Err(error): false
    }
    const statusReading = spawn net.ReadLine($Reader)
    const statusOutcome = $statusReading.wait()
    const net.ReadLineOutcome { Reader as readerAfter Value as statusResult } = statusOutcome
    const status = lineOr($statusResult)
    discard readerAfter
    const servedOutcome = $serving.wait()
    const web.ServeOutcome { Server Value } = servedOutcome
    discard Server
    if !writeAccepted || !served($Value) return 17
    if status != "HTTP/1.1 415 Unsupported Media Type" return 18

    print("generated web")
    0
}
