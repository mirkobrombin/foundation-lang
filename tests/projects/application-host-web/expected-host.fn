        if source.Contains("DisplayName") {
            const value = source.Required("DisplayName")
            self.DisplayName = value
        }
        if source.Contains("Age") {
            const value = source.Required("Age")
            const bindingParsed1 = foundationHost5.U8(value) else error {
                const bindingKind1 foundationHost0.ErrorKind = match error {
                    Empty: .Empty
                    Invalid: .Invalid
                    Overflow: .OutOfRange
                }
                return .Err(foundationHost0.Error {
                    Kind = bindingKind1
                    Field = "Age"
                    Key = "Age"
                    Value = value
                })
            }
            self.Age = bindingParsed1
        }
        if source.Contains("Email") {
            const value = source.Required("Email")
            self.Email = value
        }
        if source.Contains("Enabled") {
            const value = source.Required("Enabled")
            const bindingParsed3 = foundationHost5.Bool(value) else error {
                const bindingKind3 foundationHost0.ErrorKind = match error {
                    Empty: .Empty
                    Invalid: .Invalid
                }
                return .Err(foundationHost0.Error {
                    Kind = bindingKind3
                    Field = "Enabled"
                    Key = "Enabled"
                    Value = value
                })
            }
            self.Enabled = bindingParsed3
        }
        if source.Contains("Tags") {
            const value = source.Required("Tags")
            foundationHost0.Append(&self.Tags, $value)
        }
        .Ok
    }

    fn BindJSON(
        &self,
        source String
    ) Result<void, foundationHost0.Error> {
        const bindingJsonRoot = foundationHost4.Parse(source) else error {
            return .Err(foundationHost0.JsonSyntaxError(error))
        }
        const bindingJsonSelected = foundationHost0.JsonObject($bindingJsonRoot) else error {
            return .Err(error)
        }
        var bindingJsonObject = bindingJsonSelected
        var bindingJsonValues = foundationHost0.NewValues()
        const bindingJsonField0 = foundationHost0.CopyJsonText(
            &bindingJsonObject,
            &bindingJsonValues,
            "display_name",
            "DisplayName",
            "DisplayName"
        ) else error {
            return .Err(error)
        }
        discard bindingJsonField0
        const bindingJsonField1 = foundationHost0.CopyJsonNumber(
            &bindingJsonObject,
            &bindingJsonValues,
            "Age",
            "Age",
            "Age"
        ) else error {
            return .Err(error)
        }
        discard bindingJsonField1
        const bindingJsonField2 = foundationHost0.CopyJsonText(
            &bindingJsonObject,
            &bindingJsonValues,
            "Email",
            "Email",
            "Email"
        ) else error {
            return .Err(error)
        }
        discard bindingJsonField2
        const bindingJsonField3 = foundationHost0.CopyJsonBool(
            &bindingJsonObject,
            &bindingJsonValues,
            "Enabled",
            "Enabled",
            "Enabled"
        ) else error {
            return .Err(error)
        }
        discard bindingJsonField3
        const bindingJsonField4 = foundationHost0.CopyJsonTextList(
            &bindingJsonObject,
            &self.Tags,
            "Tags",
            "Tags"
        ) else error {
            return .Err(error)
        }
        discard bindingJsonField4
        if bindingJsonObject.Len() != 0 {
            return .Err(foundationHost0.JsonUnknownField(&bindingJsonObject))
