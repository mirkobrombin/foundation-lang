methods ProfileInput {
    fn Validate(self) own foundationHost1.Errors {
        var errors = foundationHost1.NewErrors()
        if !self.DisplayName {
            errors.Add(
                .Required,
                "DisplayName",
                "required"
            )
        }
        if self.Age < 18 {
            errors.Add(
                .Min,
                "Age",
                "min 18"
            )
        }
        if self.Age > 99 {
            errors.Add(
                .Max,
                "Age",
                "max 99"
            )
        }
        if !self.Email {
            errors.Add(
                .Required,
                "Email",
                "required"
            )
        }
        if !foundationHost1.IsEmail(self.Email) {
            errors.Add(
                .Email,
                "Email",
                "invalid email"
            )
        }
        if !self.Tags {
            errors.Add(
                .Required,
                "Tags",
                "required"
            )
        }
        errors
    }
}

methods ProfileInput {
    fn Bind(
        &self,
