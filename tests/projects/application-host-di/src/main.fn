package test.host.di

import foundation.actions
import foundation.di

contract Store {
    fn Value(self) i32
}

@di.Name("primary")
@di.Scope(.Singleton)
service PrimaryStore implements Store {
    ctor New() {
        PrimaryStore {}
    }

    fn Value(self) i32 {
        1
    }
}

@di.Name("secondary")
@di.Scope(.Singleton)
service SecondaryStore implements Store {
    ctor New() {
        SecondaryStore {}
    }

    fn Value(self) i32 {
        2
    }
}

@di.Scope(.Singleton)
service Reader {
    value i32

    ctor New(
        @di.From("primary") primary Store,
        @di.From("secondary") secondary Store
    ) {
        Reader { value = primary.Value() * 10 + secondary.Value() }
    }

    @actions.Name("read")
    action Read(self) i32 {
        self.value
    }
}

fn main() i32 {
    const application = BuildFoundationApplication()
    if application.Read() != 12 return 1
    print("named DI")
    0
}
