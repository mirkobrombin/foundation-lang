package test.host.di

struct FoundationApplication {
    foundationPrimaryStore PrimaryStore
    foundationSecondaryStore SecondaryStore
    foundationReader Reader
}

fn BuildFoundationApplication() FoundationApplication {
    const foundationPrimaryStore = PrimaryStore.New()
    const foundationSecondaryStore = SecondaryStore.New()
    const foundationReader = Reader.New(foundationPrimaryStore, foundationSecondaryStore)
    FoundationApplication { foundationPrimaryStore = foundationPrimaryStore foundationSecondaryStore = foundationSecondaryStore foundationReader = foundationReader }
}

methods FoundationApplication {
    fn Read(self) i32 {
        self.foundationReader.Read()
    }
}

enum FoundationAction {
    Read
}

struct FoundationActionKeyBinding {
    key String
    actionName String
}

enum FoundationActionResult {
    Read(value i32)
}

enum FoundationDispatchError {
    UnknownName
    UnknownKey
    ActionMismatch
}

methods FoundationApplication {
    fn HasAction(self, name String) bool {
        name == "read"
    }

    fn ActionNames(self) [1]String {
        ["read"]
    }

    fn ActionKeyBindings(self) [0]FoundationActionKeyBinding {
        []
    }
}

methods FoundationApplication {
    fn foundationDispatchRead(self) Result<FoundationActionResult, FoundationDispatchError> {
        .Ok(.Read(value = self.Read()))
    }

    fn foundationDispatchNameRead(self, foundationDispatchName String) Result<FoundationActionResult, FoundationDispatchError> {
        if foundationDispatchName != "read" return .Err(.ActionMismatch)
        self.foundationDispatchRead()
    }

    fn foundationDispatchKeyRead(self, foundationDispatchKey String) Result<FoundationActionResult, FoundationDispatchError> {
        if true return .Err(.ActionMismatch)
        self.foundationDispatchRead()
    }
}

methods FoundationApplication {
    fn Dispatch(self, $request FoundationAction) Result<FoundationActionResult, FoundationDispatchError> {
        match request {
            Read: self.foundationDispatchRead()
        }
    }
}

methods FoundationApplication {
    fn DispatchName(self, foundationDispatchName String, $request FoundationAction) Result<FoundationActionResult, FoundationDispatchError> {
        if foundationDispatchName != "read" return .Err(.UnknownName)
        match request {
            Read: self.foundationDispatchNameRead(foundationDispatchName)
        }
    }
}

// foundation:generated application/v1
