package sample.source

enum GreetingError {
    EmptyName
    Rejected(String)
}

struct Profile {
    Name String
    Score i32

    ctor New($name String, score i32) {
        Profile { Name = name Score = score }
    }

    ctor Empty() {
        Profile { Name = "" Score = 0 }
    }

    ctor Checked($name String, score i32) Result<GreetingError> {
        if !name return .Err(.EmptyName)
        .Ok(Profile { Name = name Score = score })
    }

    fn Origin() Profile {
        Profile { Name = "origin" Score = 0 }
    }

    fn Display(self) String {
        "" + self.Name
    }

    fn Rename(&self, $name String) void {
        self.Name = name
    }

    fn AddScore(&self, delta i32) void {
        self.Score = self.Score + delta
    }

    fn BumpTwice(&self) void {
        self.AddScore(1)
        self.AddScore(1)
    }

    fn ChooseAndBump(&self) i32 {
        42 if self.bumpCondition() else 0
    }

    fn ReplaceName(&self, $name String) String {
        replace self.Name with name
    }

    fn ReplaceSliceOrdered(&self, &values [i32]) i32 {
        replace values[self.replacementIndex()] with self.replacementValue()
    }

    fn ReplacePanicOrder(&self, &values [i32]) i32 {
        replace values[self.replacementIndex()] with Divide(1, 0)
    }

    fn DestructureGenerated(&self) String {
        const Profile { Name as name Score as score } = self.profileForDestructure()
        if score != 42 || self.Score != 1 return "invalid"
        name
    }

    fn WithBonus(self, delta i32) i32 {
        self.scoreWith(delta)
    }

    fn scoreWith(self, delta i32) i32 {
        self.Score + delta
    }

    fn bumpCondition(&self) bool {
        self.Score = self.Score + 1
        true
    }

    fn replacementValue(&self) i32 {
        self.Score = self.Score * 10 + 1
        42
    }

    fn replacementIndex(&self) usize {
        self.Score = self.Score * 10 + 2
        1
    }

    fn profileForDestructure(&self) Profile {
        self.Score = self.Score + 1
        Profile { Name = "Foundation" Score = 42 }
    }
}

fn twice(value i32) i32 {
    value * 2
}

fn genericIdentity<T>($value T) T {
    value
}

fn genericAssignAt<T>(&values [T], index usize, $value T) void {
    values[index] = value
}

struct Box<T> {
    Value T

    ctor New($value T) {
        Box<T> { Value = value }
    }

    fn Marker(self) i32 {
        42
    }

    fn Set(&self, $value T) void {
        self.Value = value
    }
}

struct BoxI32 {
    Code i32
}

struct FunctionCounter {
    Value i32
}

enum SourceOperation {
    Missing
    Apply(fn(i32) i32)
}

fn ApplyFunction(value i32, operation fn(i32) i32) i32 {
    operation(value)
}

fn incrementCounter(&counter FunctionCounter) void {
    counter.Value = counter.Value + 1
}

fn consumeOperationText($value String) String {
    value + "!"
}

fn makeOffset(offset i32) fn(i32) i32 {
    fn(value i32) i32 capture(offset) {
        value + offset
    }
}

fn compose($operation fn(i32) i32) fn(i32) i32 {
    fn(value i32) i32 capture($operation) {
        operation(operation(value))
    }
}

fn editThroughClosure(&counter FunctionCounter) i32 {
    const operation = fn() i32 capture(&counter) {
        counter.Value = counter.Value + 1
        counter.Value
    }
    operation()
}

fn FunctionNamed() i32 {
    const operation fn(i32) i32 = twice
    ApplyFunction(21, operation)
}

fn GenericDirect() i32 {
    genericIdentity<i32>(42)
}

fn GenericInferred() i32 {
    genericIdentity(42)
}

fn GenericText() String {
    genericIdentity<String>("Foundation")
}

fn GenericFunctionValue() i32 {
    const operation fn(i32) i32 = genericIdentity<i32>
    operation(42)
}

fn GenericEdit() i32 {
    var values = [0]
    const operation fn(&[i32], usize, $i32) void = genericAssignAt<i32>
    operation(&values, 0, 42)
    values[0]
}

fn GenericStructNumber() Box<i32> {
    Box<i32>.New(42)
}

fn GenericStructText() Box<String> {
    Box<String>.New("Foundation")
}

fn GenericStructMethods() i32 {
    const box = Box<i32>.New(42)
    box.Value
}

fn GenericStructNested() Box<Box<i32>> {
    Box<Box<i32>>.New(Box<i32>.New(42))
}

fn GenericStructDestructure() i32 {
    const Box { Value as value } = Box<i32>.New(42)
    value
}

fn GenericStructNameCollision() BoxI32 {
    BoxI32 { Code = 42 }
}

fn FunctionPayload() i32 {
    const operation = SourceOperation.Apply(twice)
    match operation {
        Missing: 0
        Apply(call): call(21)
    }
}

fn FunctionEdit() i32 {
    const operation fn(&FunctionCounter) void = incrementCounter
    var counter = FunctionCounter { Value = 41 }
    operation(&counter)
    counter.Value
}

fn FunctionOwn() String {
    const operation fn($String) String = consumeOperationText
    const value = "Foundation"
    operation($value)
}

fn ClosureCopy() i32 {
    var factor = 2
    const operation = fn(value i32) i32 capture(factor) {
        value * factor
    }
    factor = 3
    operation(21)
}

fn ClosureEdit() i32 {
    var total = 40
    const operation = fn(value i32) i32 capture(&total) {
        total = total + value
        total
    }
    discard operation(1)
    operation(1)
}

fn ClosureOwn() String {
    const prefix = "Found"
    const operation = fn($suffix String) String capture($prefix) {
        prefix + suffix
    }
    operation("ation")
}

fn ClosureReturn() i32 {
    const operation = makeOffset(2)
    operation(40)
}

fn ClosureFunctionCapture() i32 {
    const operation = compose($twice)
    operation(11)
}

fn ClosureBorrowedEdit() i32 {
    var counter = FunctionCounter { Value = 41 }
    const result = editThroughClosure(&counter)
    if counter.Value != 42 return 0
    result
}

fn foundationAddI32(value i32) i32 {
    value
}

fn Add(left i32, right i32) i32 {
    left + right
}

fn Subtract(left i32, right i32) i32 {
    left - right
}

fn Multiply(left i32, right i32) i32 {
    left * right
}

fn Divide(left i32, right i32) i32 {
    left / right
}

fn Remainder(left i32, right i32) i32 {
    left % right
}

fn ShiftLeft(left i32, right i32) i32 {
    left << right
}

fn ShiftRight(left i32, right i32) i32 {
    left >> right
}

fn ShiftUnsigned(left u32, right u32) u32 {
    left >> right
}

fn ShiftCompound(value i32, count i32) i32 {
    var result = value
    result <<= count
    result
}

fn ShiftOverflow() i32 {
    1073741824 << 1
}

fn ShiftInvalidCount() i32 {
    1 << 32
}

fn Negate(value i32) i32 {
    -value
}

fn AddUnsigned(left u32, right u32) u32 {
    left + right
}

fn SubtractUnsigned(left u32, right u32) u32 {
    left - right
}

fn NameSafety(
    int32 i32,
    len i32,
    foundationState i32
) i32 {
    foundationAddI32(int32) + len + foundationState
}

fn Greet(name String) String {
    if !name {
        return "Hello, stranger"
    }
    "Hello, " + name
}

fn TextLength(value String) usize {
    len(value)
}

fn QuoteLine(value String) String {
    "line 1\n\"" + value + "\"\\end"
}

fn SameText(left String, right String) bool {
    left == right
}

fn Accent() String {
    "héllo 🙂"
}

fn MakeProfile(name String, score i32) Profile {
    Profile { Name = "" + name Score = score }
}

fn RenameProfile(profile Profile, name String) Profile {
    Profile { Name = "" + name Score = profile.Score }
}

fn ProfileName(profile Profile) String {
    "" + profile.Name
}

fn IncreaseScore(profile Profile, delta i32) i32 {
    profile.Score + delta
}

fn MethodScore(profile Profile, delta i32) i32 {
    profile.WithBonus(delta)
}

fn ChooseLabel(ready bool) String {
    if ready {
        const prefix = "Found"
        prefix + "ation"
    } else {
        "fallback"
    }
}

fn ChooseNumber(ready bool) i32 {
    42 if ready else 7
}

fn ChooseNested(first bool, second bool) i32 {
    42 if first else 21 if second else 0
}

fn LazyThen() i32 {
    42 if true else Divide(1, 0)
}

fn LazyElse() i32 {
    Divide(1, 0) if false else 42
}

fn ReplaceLocal() String {
    var value = "old"
    const previous = replace value with "new"
    previous + ":" + value
}

fn ReplaceArrayElement() i32 {
    var values = [10, 20]
    const previous = replace values[1] with 42
    previous + values[1]
}

fn DestructureLocal() i32 {
    const profile = Profile { Name = "local" Score = 42 }
    const Profile { Name Score } = profile
    if Name != "local" return 0
    Score
}

fn BuildNumbers() [3]i32 {
    [10, 20, 30]
}

fn BuildWords() [2]String {
    ["Foundation", " Lang"]
}

fn EmptyNumbers() [0]i32 {
    []
}

fn SumFixed(values [3]i32) i32 {
    values[0] + values[1] + values[2]
}

fn SumSlice(values [i32]) i32 {
    var total = 0
    for index, value in values {
        if index == 1 continue
        total = total + value
    }
    total
}

fn JoinWords(values [String]) String {
    var result = ""
    for value in values {
        result = result + value
    }
    result
}

fn BumpSlice(&values [i32]) void {
    for &value in values {
        value = value + 1
    }
}

fn SequenceIsEmpty(values [i32]) bool {
    !values
}

fn FixedLength(values [3]i32) usize {
    len(values)
}

fn SliceLength(values [i32]) usize {
    len(values)
}

fn FirstSlice(values [i32]) i32 {
    values[0]
}

fn MatrixValue(values [2] [2]i32) i32 {
    values[1][0]
}

fn FirstProfileName(values [Profile]) String {
    "" + values[0].Name
}

fn SumBuiltNumbers() i32 {
    const values = BuildNumbers()
    SumSlice(values)
}

fn SumTemporaryNumbers() i32 {
    SumSlice(BuildNumbers())
}

fn BumpAndSum() i32 {
    var values = [1, 2, 3]
    BumpSlice(&values)
    SumFixed(values)
}

fn MaybeName(name String) Option<String> {
    if !name return .None
    .Some("" + name)
}

fn ReadOptional(value Option<String>) String {
    match value {
        None: "none"
        Some(name): "" + name
    }
}

fn DescribeOptional(value Option<String>) String {
    match value {
        None: "none"
        Some(name) if name == "Foundation": "foundation"
        Some(name): "" + name
    }
}

fn RenderGreeting(name String) Result<String, GreetingError> {
    if !name return .Err(.EmptyName)
    .Ok("Hello, " + name)
}

fn RenderOrFallback(name String) String {
    const value = RenderGreeting(name) else error {
        discard error
        return "fallback"
    }
    value
}

fn ValidateName(name String) Result<void, GreetingError> {
    if !name return .Err(.EmptyName)
    .Ok
}

fn IsValidName(name String) bool {
    ValidateName(name) else error {
        discard error
        return false
    }
    true
}

fn DescribeError(error GreetingError) String {
    match error {
        EmptyName: "empty name"
        Rejected(reason): "rejected: " + reason
    }
}

fn Clamp(value i32, minimum i32, maximum i32) i32 {
    if value < minimum {
        return minimum
    }
    if value > maximum {
        return maximum
    }
    value
}

fn TwicePlus(value i32, extra i32) i32 {
    twice(value) + extra
}

fn SumTo(limit i32) i32 {
    var current = 0
    var total = 0
    while current < limit {
        total = total + current
        current = current + 1
    }
    total
}

fn IsWithin(value i32, minimum i32, maximum i32) bool {
    value >= minimum && value <= maximum
}

fn PrintLines(name String) void {
    print(name + " Foundation")
    print("")
    print("tab\tquote\"")
}

fn PrintAndPanic() void {
    print("before panic")
    panic("stop")
}

fn CheckedDivide(left i32, right i32) i32 {
    if right == 0 {
        panic("division rejected: " + "zero")
    }
    left / right
}

fn RequirePositive(value i32) i32 {
    if value > 0 return value
    panic("value must be positive")
}

fn RequireSome(value Option<i32>) i32 {
    match value {
        None: panic("missing value")
        Some(inner): inner
    }
}

fn RequireReady(ready bool) i32 {
    42 if ready else panic("not ready")
}

fn RequireNarrow(value i64) i32 {
    const converted = i32.From(value) else {
        panic("conversion failed")
    }
    converted
}

fn WidenSigned(value i32) i64 {
    i64.From(value)
}

fn WidenUnsigned(value u8) i32 {
    i32.From(value)
}

fn WidenFloat(value f32) f64 {
    f64.From(value)
}

fn ExactFloat(value i32) f64 {
    f64.From(value)
}

fn NarrowSigned(value i64) Result<i32, NumberError> {
    i32.From(value)
}

fn SignedToUnsigned(value i32) Result<u32, NumberError> {
    u32.From(value)
}

fn UnsignedToSigned(value u64) Result<i64, NumberError> {
    i64.From(value)
}

fn FloatToSigned(value f64) Result<i32, NumberError> {
    i32.From(value)
}

fn FloatToUnsigned(value f32) Result<u8, NumberError> {
    u8.From(value)
}

fn FloatToSize(value f64) Result<usize, NumberError> {
    usize.From(value)
}

fn FloatToIsize(value f64) Result<isize, NumberError> {
    isize.From(value)
}

fn SignedToFloat(value i64) Result<f64, NumberError> {
    f64.From(value)
}

fn SizeToFloat(value usize) Result<f32, NumberError> {
    f32.From(value)
}

fn NarrowFloat(value f64) Result<f32, NumberError> {
    f32.From(value)
}

fn NarrowOrZero(value i64) i32 {
    const converted = i32.From(value) else {
        return 0
    }
    converted
}

struct Countdown {
    Remaining i32

    fn Next(&self) Option<i32> {
        if self.Remaining == 0 return .None
        const value = self.Remaining
        self.Remaining = self.Remaining - 1
        .Some(value)
    }
}

fn countdown(start i32) Countdown {
    Countdown { Remaining = start }
}

fn SumCountdown(start i32) i32 {
    var total = 0
    for value in countdown(start) {
        total = total + value
    }
    total
}

fn IndexedCountdown(start i32) i32 {
    var total = 0
    for index, value in countdown(start) {
        if value == 2 continue
        if index == 5 break
        total = total * 10 + value
    }
    total
}

fn StopCountdown() i32 {
    var source = Countdown { Remaining = 5 }
    for value in source {
        if value == 3 break
    }
    source.Remaining
}

fn DrainCountdown(&source Countdown) i32 {
    var total = 0
    for value in source {
        total = total + value
    }
    total
}

enum Shape {
    Empty
    Square(i32)
    Named(String)
}

fn maybeNumber(value i32) Option<i32> {
    if value == 0 return .None
    .Some(value)
}

fn Classify(shape Shape) i32 {
    const size = match shape {
        Empty: {
            return -1
        }
        Square(side) if side > 100: {
            return 100
        }
        Square(side): side * side
        _: 7
    }
    size + 1
}

fn SumUntilStop(values [i32]) i32 {
    var total = 0
    for value in values {
        const step = if value < 0 {
            if value == -1 break
            if value == -2 continue
            0
        } else {
            value
        }
        total = total + step
    }
    total
}

fn EarlyConditional(flag bool, value i32) i32 {
    const result = if flag {
        if value > 10 return value
        value + 1
    } else {
        0
    }
    result * 2
}

fn AssignEscape(values [i32]) i32 {
    var last = 0
    for value in values {
        last = match maybeNumber(value) {
            None: {
                continue
            }
            Some(inner) if inner > 50: {
                break
            }
            Some(inner): inner
        }
    }
    last
}

fn TailEscape(value Option<i32>) i32 {
    match value {
        None: {
            return 0
        }
        Some(inner): inner + 1
    }
}

fn DiscardEscape(values [i32]) i32 {
    var count = 0
    for value in values {
        match maybeNumber(value) {
            None: {
                break
            }
            Some(inner): {
                count = count + inner
            }
        }
    }
    count
}

fn NestedEscape(value Option<i32>, limit i32) i32 {
    const result = match value {
        None: 0
        Some(inner): if inner > limit {
            if inner > 1000 return -1
            limit
        } else {
            inner
        }
    }
    result + 1
}

fn GuardFallthrough(value Option<i32>) i32 {
    const result = match value {
        Some(inner) if inner > 10: {
            if inner > 20 return 20
            inner
        }
        Some(inner): inner + 100
        None: {
            return -5
        }
    }
    result
}

fn LetElseInArm(value Option<i32>, wide i64) i32 {
    const result = match value {
        None: 0
        Some(inner): {
            const narrow = i32.From(wide) else {
                return -1
            }
            inner + narrow
        }
    }
    result
}

struct Point {
    X i32
    Y i32
}

struct Holder {
    Label String
    Child own Point
}

enum Tree {
    Leaf(i32)
    Node(own Branch)
}

struct Branch {
    Left Tree
    Right Tree
}

struct ListNode {
    Value i32
    Next Option<own ListNode>
}

fn MakePoint(x i32, y i32) own Point {
    own Point { X = x Y = y }
}

fn ConsumePoint($point own Point) i32 {
    point.X * point.Y
}

fn MovePoint(x i32) i32 {
    var point = MakePoint(x, 2)
    point.X = point.X + 1
    const moved = point
    ConsumePoint($moved)
}

fn bumpPoint(&point Point) void {
    point.X = point.X + 10
}

fn EditOwner() i32 {
    var point = own Point { X = 1 Y = 2 }
    bumpPoint(&point)
    point.X
}

fn ReplaceChild() i32 {
    var holder = Holder { Label = "h" Child = own Point { X = 1 Y = 3 } }
    const previous = replace holder.Child with own Point { X = 5 Y = 6 }
    previous.X * 100 + holder.Child.Y
}

fn DestructureOwner() i32 {
    const Point { X Y } = MakePoint(4, 5)
    X * Y
}

fn SumTree(tree Tree) i32 {
    match tree {
        Leaf(value): value
        Node(branch): SumTree(branch.Left) + SumTree(branch.Right)
    }
}

fn BuildTree(depth i32) Tree {
    if depth == 0 return .Leaf(1)
    .Node(own Branch { Left = BuildTree(depth - 1) Right = BuildTree(depth - 1) })
}

fn GraftLeft($tree Tree, value i32) Tree {
    match tree {
        Leaf(old): .Leaf(old + value)
        Node(branch): {
            var edited = branch
            edited.Left = .Leaf(value)
            .Node(edited)
        }
    }
}

fn Prepend($list Option<own ListNode>, value i32) Option<own ListNode> {
    .Some(own ListNode { Value = value Next = list })
}

fn ListSum(list Option<own ListNode>) i32 {
    match list {
        None: 0
        Some(node): node.Value + ListSum(node.Next)
    }
}

fn BuildList(count i32) Option<own ListNode> {
    var list Option<own ListNode> = .None
    var index = 0
    while index < count {
        index = index + 1
        list = Prepend($list, index)
    }
    list
}

struct Wallet {
    Owner String
    Coins i32

    fn Spend($self, amount i32) own Wallet {
        const Wallet { Owner Coins } = self
        own Wallet { Owner = Owner Coins = Coins - amount }
    }

    fn Total($self) i32 {
        self.Coins
    }
}

fn SpendTwice(start i32) i32 {
    const wallet = own Wallet { Owner = "a" Coins = start }
    const spent = wallet.Spend(3)
    const again = spent.Spend(4)
    again.Total()
}

fn OwnedReceiver() i32 {
    const owned = own Wallet { Owner = "b" Coins = 10 }
    owned.Total()
}

contract Named<T> {
    fn value(self) T
}

contract Scored {
    fn score(self) i32

    fn doubled(self) i32 {
        self.score() * 2
    }
}

contract Labeled {
    fn label(self) i32

    fn described(self) i32 {
        self.label() + 1000
    }
}

contract Accumulator {
    fn add(&self, amount i32) void

    fn addTwice(&self, amount i32) void {
        self.add(amount)
        self.add(amount)
    }
}

contract Valued {
    fn worth(self) i32
    fn take($self) i32

    fn plusOne(self) i32 {
        self.worth() + 1
    }
}

struct Identity implements Named<i32> {
    stored i32

    fn value(self) i32 { self.stored }
}

struct DelegatedEntry implements Named<i32> {
    identity Identity

    delegate identity as Named<i32>
}

struct Metric implements Scored {
    stored i32

    fn score(self) i32 { self.stored }
}

struct CustomMetric implements Scored {
    stored i32

    fn score(self) i32 { self.stored }
    fn doubled(self) i32 { self.stored + 2 }
}

struct MetricWrapper implements Scored {
    inner Metric

    delegate inner as Scored
}

struct Tag implements Labeled {
    stored i32

    fn label(self) i32 { self.stored }
}

struct OverridingTag implements Labeled {
    inner Tag

    delegate inner as Labeled

    fn label(self) i32 { self.inner.stored + 1 }
}

struct Counter implements Accumulator {
    value i32

    fn add(&self, amount i32) void {
        self.value = self.value + amount
    }
}

struct Coin implements Valued {
    stored i32

    fn worth(self) i32 { self.stored }
    fn take($self) i32 { self.stored * 10 }
}

struct Note implements Valued {
    text String

    fn worth(self) i32 { 99 }
    fn take($self) i32 { 1 }
}

struct Pouch {
    coin own Valued
}

fn readNamed(value Named<i32>) i32 {
    value.value()
}

fn readDoubled(value Scored) i32 {
    value.doubled()
}

fn readDescribed(value Labeled) i32 {
    value.described()
}

fn AddTwiceTo(&value Accumulator, amount i32) void {
    value.addTwice(amount)
}

fn ReadWorth(value Valued) i32 {
    value.worth()
}

fn MakeCoin(value i32) own Valued {
    own Coin { stored = value }
}

fn pick(flag bool) own Valued {
    if flag {
        own Coin { stored = 3 }
    } else {
        own Note { text = "note" }
    }
}

fn maybeCoin(flag bool) Option<own Valued> {
    if !flag return .None
    .Some(MakeCoin(5))
}

fn NamedValues() i32 {
    const identity = Identity { stored = 40 }
    const delegated = DelegatedEntry { identity = Identity { stored = 2 } }
    readNamed(identity) + readNamed(delegated)
}

fn Doubled() i32 {
    const metric = Metric { stored = 20 }
    const custom = CustomMetric { stored = 40 }
    const wrapped = MetricWrapper { inner = Metric { stored = 5 } }
    readDoubled(metric) * 10000 + readDoubled(custom) * 100 + readDoubled(wrapped)
}

fn Described() i32 {
    const tag = Tag { stored = 1 }
    const overriding = OverridingTag { inner = Tag { stored = 7 } }
    readDescribed(tag) * 10000 + readDescribed(overriding)
}

fn Accumulate() i32 {
    var counter = Counter { value = 40 }
    AddTwiceTo(&counter, 1)
    counter.value
}

fn OwnedValued() i32 {
    const coin = MakeCoin(4)
    const read = ReadWorth(coin)
    const plus = coin.plusOne()
    read * 1000 + plus * 100 + coin.take()
}

fn HeldValued() i32 {
    const pouch = Pouch { coin = MakeCoin(7) }
    ReadWorth(pouch.coin)
}

fn Heterogeneous() i32 {
    const first = pick(true)
    const second = pick(false)
    first.worth() * 1000 + second.worth()
}

fn OptionalValued(flag bool) i32 {
    match maybeCoin(flag) {
        None: 0
        Some(value): value.plusOne()
    }
}

fn doubledStatic<T Scored>(value T) i32 {
    value.doubled()
}

fn describedStatic<T Labeled>(value T) i32 {
    value.described()
}

fn addTwiceStatic<T Accumulator>(&value T, amount i32) void {
    value.addTwice(amount)
}

fn StaticDoubled() i32 {
    const metric = Metric { stored = 5 }
    const wrapped = MetricWrapper { inner = Metric { stored = 6 } }
    doubledStatic(metric) + readDoubled(metric) +
        (doubledStatic(wrapped) + readDoubled(wrapped)) * 100
}

fn StaticDescribed() i32 {
    const overriding = OverridingTag { inner = Tag { stored = 7 } }
    describedStatic(overriding) + readDescribed(overriding)
}

fn StaticAccumulate() i32 {
    var counter = Counter { value = 20 }
    addTwiceStatic(&counter, 1)
    AddTwiceTo(&counter, 10)
    counter.value
}

fn check(name String, actual i32, expected i32) void {
    if actual == expected {
        print(name + " ok")
    } else {
        print(name + " FAIL")
    }
}

// Prints one line per behavior check. The export test compares this output across the C, LLVM,
// and Go translations.
fn Report() void {
    check("classify empty", Classify(.Empty), -1)
    check("classify large", Classify(.Square(200)), 100)
    check("classify square", Classify(.Square(3)), 10)
    check("classify named", Classify(.Named("x")), 8)
    check("sum stop", SumUntilStop([1, 2, -2, 3, -1, 50]), 6)
    check("sum all", SumUntilStop([4, -3, 5]), 9)
    check("early return", EarlyConditional(true, 42), 42)
    check("early value", EarlyConditional(true, 4), 10)
    check("early else", EarlyConditional(false, 4), 0)
    check("assign continue", AssignEscape([3, 0, 9, 0]), 9)
    check("assign break", AssignEscape([3, 60, 9]), 3)
    check("tail none", TailEscape(.None), 0)
    check("tail some", TailEscape(.Some(41)), 42)
    check("discard", DiscardEscape([1, 2, 0, 40]), 3)
    check("nested none", NestedEscape(.None, 5), 1)
    check("nested limit", NestedEscape(.Some(9), 5), 6)
    check("nested return", NestedEscape(.Some(5000), 5), -1)
    check("nested inner", NestedEscape(.Some(3), 5), 4)
    check("guard high", GuardFallthrough(.Some(30)), 20)
    check("guard middle", GuardFallthrough(.Some(15)), 15)
    check("guard low", GuardFallthrough(.Some(1)), 101)
    check("guard none", GuardFallthrough(.None), -5)
    check("let else ok", LetElseInArm(.Some(2), 40), 42)
    check("let else failure", LetElseInArm(.Some(2), 5000000000), -1)
    check("let else none", LetElseInArm(.None, 5000000000), 0)
    check("move point", MovePoint(3), 8)
    check("edit owner", EditOwner(), 11)
    check("replace child", ReplaceChild(), 106)
    check("destructure owner", DestructureOwner(), 20)
    check("tree total", SumTree(BuildTree(3)), 8)
    check("graft", SumTree(GraftLeft(BuildTree(2), 7)), 9)
    check("list sum", ListSum(BuildList(4)), 10)
    check("spend twice", SpendTwice(20), 13)
    check("owned receiver", OwnedReceiver(), 10)
    check("named", NamedValues(), 42)
    check("doubled", Doubled(), 404210)
    check("described", Described(), 10011008)
    check("accumulate", Accumulate(), 42)
    check("owned valued", OwnedValued(), 4540)
    check("held valued", HeldValued(), 7)
    check("heterogeneous", Heterogeneous(), 3099)
    check("optional some", OptionalValued(true), 6)
    check("optional none", OptionalValued(false), 0)
    check("static doubled", StaticDoubled(), 2420)
    check("static described", StaticDescribed(), 2016)
    check("static accumulate", StaticAccumulate(), 42)
}

fn main() i32 {
    Report()
    0
}
