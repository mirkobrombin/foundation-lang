package test.host.dispatcher

import foundation.actions as foundationHost0

struct FoundationApplication {
    foundationCalculator Calculator
}

fn BuildFoundationApplication() FoundationApplication {
    const foundationCalculator = Calculator.New()
    FoundationApplication { foundationCalculator = foundationCalculator }
}

methods FoundationApplication {
    fn Calculate(&self, value i32, fail bool) Result<i32, WorkError> {
        self.foundationCalculator.Calculate(value, fail)
    }

    fn Echo(self, $text String) String {
        self.foundationCalculator.Echo($text)
    }

    fn Work(self, foundationWorkerAllow bool, value i32, fail bool) Result<Result<i32, WorkError>, ActivationError> {
        const foundationWorker = Worker.New(foundationWorkerAllow) else error {
            return .Err(error)
        }
        .Ok(foundationWorker.Work(value, fail))
    }
}

struct FoundationCalculateAction {
    value i32
    fail bool
}

struct FoundationEchoAction {
    text String
}

struct FoundationWorkAction {
    foundationWorkerAllow bool
    value i32
    fail bool
}

enum FoundationAction {
    Calculate(FoundationCalculateAction)
    Echo(FoundationEchoAction)
    Work(FoundationWorkAction)
}

struct FoundationActionKeyBinding {
    key String
    actionName String
}

enum FoundationActionResult {
    Calculate(value i32)
    Echo(value String)
    Work(value i32)
}

enum FoundationDispatchError {
    UnknownName
    UnknownKey
    ActionMismatch
    Denied(policy String)
    CalculateFailed(error WorkError)
    WorkActivation(error ActivationError)
    WorkFailed(error WorkError)
}

methods FoundationApplication {
    fn HasAction(self, name String) bool {
        name == "calculate" || name == "echo" || name == "work"
    }

    fn ActionNames(self) [3]String {
        ["calculate", "echo", "work"]
    }

    fn ActionKeyBindings(self) [3]FoundationActionKeyBinding {
        [FoundationActionKeyBinding { key = "ctrl+c" actionName = "calculate" }, FoundationActionKeyBinding { key = "ctrl+w" actionName = "work" }, FoundationActionKeyBinding { key = "enter" actionName = "echo" }]
    }
}

methods FoundationApplication {
    fn foundationDispatchCalculate(&self, $payload FoundationCalculateAction, authorizer foundationHost0.Authorizer) Result<FoundationActionResult, FoundationDispatchError> {
        const FoundationCalculateAction { value fail } = payload
        if !authorizer.Allows("calculate", "work") {
            return .Err(.Denied(policy = "work"))
        }
        match self.Calculate(value, fail) {
            Ok(value): .Ok(.Calculate(value = value))
            Err(error): .Err(.CalculateFailed(error = error))
        }
    }

    fn foundationDispatchNameCalculate(&self, foundationDispatchName String, $payload FoundationCalculateAction, authorizer foundationHost0.Authorizer) Result<FoundationActionResult, FoundationDispatchError> {
        if foundationDispatchName != "calculate" return .Err(.ActionMismatch)
        self.foundationDispatchCalculate($payload, authorizer)
    }

    fn foundationDispatchKeyCalculate(&self, foundationDispatchKey String, $payload FoundationCalculateAction, authorizer foundationHost0.Authorizer) Result<FoundationActionResult, FoundationDispatchError> {
        if foundationDispatchKey != "ctrl+c" return .Err(.ActionMismatch)
        self.foundationDispatchCalculate($payload, authorizer)
    }

    fn foundationDispatchEcho(self, $payload FoundationEchoAction) Result<FoundationActionResult, FoundationDispatchError> {
        const FoundationEchoAction { text } = payload
        .Ok(.Echo(value = self.Echo($text)))
    }

    fn foundationDispatchNameEcho(self, foundationDispatchName String, $payload FoundationEchoAction) Result<FoundationActionResult, FoundationDispatchError> {
        if foundationDispatchName != "echo" return .Err(.ActionMismatch)
        self.foundationDispatchEcho($payload)
    }

    fn foundationDispatchKeyEcho(self, foundationDispatchKey String, $payload FoundationEchoAction) Result<FoundationActionResult, FoundationDispatchError> {
        if foundationDispatchKey != "enter" return .Err(.ActionMismatch)
        self.foundationDispatchEcho($payload)
    }

    fn foundationDispatchWork(self, $payload FoundationWorkAction, authorizer foundationHost0.Authorizer) Result<FoundationActionResult, FoundationDispatchError> {
        const FoundationWorkAction { foundationWorkerAllow value fail } = payload
        if !authorizer.Allows("work", "work") {
            return .Err(.Denied(policy = "work"))
        }
        match self.Work(foundationWorkerAllow, value, fail) {
            Ok(result):             match result {
                Ok(value): .Ok(.Work(value = value))
                Err(error): .Err(.WorkFailed(error = error))
            }
            Err(error): .Err(.WorkActivation(error = error))
        }
    }

    fn foundationDispatchNameWork(self, foundationDispatchName String, $payload FoundationWorkAction, authorizer foundationHost0.Authorizer) Result<FoundationActionResult, FoundationDispatchError> {
        if foundationDispatchName != "work" return .Err(.ActionMismatch)
        self.foundationDispatchWork($payload, authorizer)
    }

    fn foundationDispatchKeyWork(self, foundationDispatchKey String, $payload FoundationWorkAction, authorizer foundationHost0.Authorizer) Result<FoundationActionResult, FoundationDispatchError> {
        if foundationDispatchKey != "ctrl+w" return .Err(.ActionMismatch)
        self.foundationDispatchWork($payload, authorizer)
    }
}

methods FoundationApplication {
    fn Dispatch(&self, authorizer foundationHost0.Authorizer, $request FoundationAction) Result<FoundationActionResult, FoundationDispatchError> {
        match request {
            Calculate(payload): self.foundationDispatchCalculate($payload, authorizer)
            Echo(payload): self.foundationDispatchEcho($payload)
            Work(payload): self.foundationDispatchWork($payload, authorizer)
        }
    }
}

methods FoundationApplication {
    fn DispatchName(&self, authorizer foundationHost0.Authorizer, foundationDispatchName String, $request FoundationAction) Result<FoundationActionResult, FoundationDispatchError> {
        if foundationDispatchName != "calculate" && foundationDispatchName != "echo" && foundationDispatchName != "work" return .Err(.UnknownName)
        match request {
            Calculate(payload): self.foundationDispatchNameCalculate(foundationDispatchName, $payload, authorizer)
            Echo(payload): self.foundationDispatchNameEcho(foundationDispatchName, $payload)
            Work(payload): self.foundationDispatchNameWork(foundationDispatchName, $payload, authorizer)
        }
    }
}

methods FoundationApplication {
    fn DispatchKey(&self, authorizer foundationHost0.Authorizer, foundationDispatchKey String, $request FoundationAction) Result<FoundationActionResult, FoundationDispatchError> {
        if foundationDispatchKey != "ctrl+c" && foundationDispatchKey != "enter" && foundationDispatchKey != "ctrl+w" return .Err(.UnknownKey)
        match request {
            Calculate(payload): self.foundationDispatchKeyCalculate(foundationDispatchKey, $payload, authorizer)
            Echo(payload): self.foundationDispatchKeyEcho(foundationDispatchKey, $payload)
            Work(payload): self.foundationDispatchKeyWork(foundationDispatchKey, $payload, authorizer)
        }
    }
}

// foundation:generated application/v1
