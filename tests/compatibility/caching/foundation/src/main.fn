package test.compatibility.caching

import foundation.caching
import foundation.serializer
import std.bytes
import std.format
import std.text
import std.time

@serializer.Serializable()
struct Profile {
    Name String
    Age i32
}

fn cloneProfile(value Profile) Profile {
    Profile { Name = text.Copy(value.Name) Age = value.Age }
}

fn encodeProfile(
    value Profile
) Result<own bytes.Bytes, serializer.Error> {
    const encoded = value.Marshal() else error {
        return .Err(error)
    }
    .Ok(bytes.FromText(encoded))
}

fn decodeProfile(
    value bytes.Bytes
) Result<Profile, serializer.Error> {
    const encoded = value.Text() else error {
        discard error
        return .Err(serializer.Error {
            Kind = .Custom
            Message = "cached bytes are not UTF-8"
        })
    }
    Profile.Unmarshal(encoded)
}

fn requireVoid($value Result<void, caching.Error>) void {
    match value {
        Ok: done()
        Err(error): fail(error)
    }
}

fn done() void {
    return
}

fn requireI32($value Result<i32, caching.Error>) i32 {
    match value {
        Ok(found): found
        Err(error): fail(error)
    }
}

fn requireOptionalProfile(
    $value Result<Option<Profile>, caching.Error>
) Option<Profile> {
    match value {
        Ok(found): found
        Err(error): fail(error)
    }
}

fn profileText($value Option<Profile>) String {
    match value {
        None: "miss"
        Some(profile): profile.Name + ":" + format.I32(profile.Age)
    }
}

fn requireBytes(
    $value Result<Option<own bytes.Bytes>, caching.Error>
) String {
    match value {
        Err(error): fail(error)
        Ok(found): match found {
            None: "miss"
            Some(content): bytesText($content)
        }
    }
}

fn bytesText($value own bytes.Bytes) String {
    const content = value.Text() else error {
        discard error
        panic("cached bytes are invalid")
    }
    content
}

fn requireBridgeProfile(
    $value Result<
    Option<Profile>,
    caching.BridgeError<caching.Error, serializer.Error>
    >
) String {
    match value {
        Ok(found): profileText($found)
        Err(error): failBridge($error)
    }
}

fn requireBridgeVoid(
    $value Result<
    void,
    caching.BridgeError<caching.Error, serializer.Error>
    >
) void {
    match value {
        Ok: done()
        Err(error): failBridge($error)
    }
}

fn fail(error caching.Error) never {
    discard error
    panic("cache compatibility operation failed")
}

fn failBridge(
    $error caching.BridgeError<caching.Error, serializer.Error>
) never {
    discard error
    panic("cache compatibility bridge failed")
}

fn waitFor(duration time.Duration) void {
    const started = time.MonotonicNow()
    var elapsed i64 = 0
    while elapsed <= duration.Nanoseconds() {
        const measured = time.MonotonicNow().Since(started) else error {
            discard error
            panic("monotonic clock moved backwards")
        }
        elapsed = measured.Nanoseconds()
    }
}

fn main() i32 {
    const memory = caching.New<Profile>($cloneProfile)
    print("memory:" + profileText($requireOptionalProfile($memory.Get("profile").wait())))
    requireVoid($memory.Set(
        "profile",
        Profile { Name = "Ada" Age = 36 },
        time.Zero()
        ).wait())
    print("memory:" + profileText($requireOptionalProfile($memory.Get("profile").wait())))
    requireVoid($memory.Set(
        "profile",
        Profile { Name = "Grace" Age = 37 },
        time.Zero()
        ).wait())
    print("memory:" + profileText($requireOptionalProfile($memory.Get("profile").wait())))
    requireVoid($memory.Invalidate("profile").wait())
    print("memory:" + profileText($requireOptionalProfile($memory.Get("profile").wait())))

    const expiring = caching.NewWith<Profile>(
        $cloneProfile,
        caching.Policy {
        DefaultTTL = time.Milliseconds(2)
        MaxEntries = 8
    }
    ) else error {
        discard error
        return 1
    }
    requireVoid($expiring.Set(
        "short",
        Profile { Name = "Short" Age = 1 },
        time.Zero()
        ).wait())
    waitFor(time.Milliseconds(3))
    print("ttl:" + profileText($requireOptionalProfile($expiring.Get("short").wait())))

    const bounded = caching.NewWith<Profile>(
        $cloneProfile,
        caching.Policy { MaxEntries = 1 }
    ) else error {
        discard error
        return 2
    }
    requireVoid($bounded.Set(
        "one",
        Profile { Name = "One" Age = 1 },
        time.Zero()
        ).wait())
    requireVoid($bounded.Set(
        "two",
        Profile { Name = "Two" Age = 2 },
        time.Zero()
        ).wait())
    print("bounded:" + format.I32(requireI32($bounded.Len().wait())))

    const backend = caching.NewDistributed()
    requireVoid($backend.Set(
        "raw",
        bytes.FromText("Foundation"),
        time.Zero()
        ).wait())
    print("bytes:" + requireBytes($backend.Get("raw").wait()))

    const bridge = caching.NewBridge<
    Profile,
    caching.Error,
    serializer.Error
    >(
        backend.Fork(),
        $encodeProfile,
        $decodeProfile
    )
    requireBridgeVoid($bridge.Set(
        "typed",
        Profile { Name = "Ada" Age = 37 },
        time.Zero()
        ).wait())
    print("bridge:" + requireBridgeProfile($bridge.Get("typed").wait()))
    requireBridgeVoid($bridge.Invalidate("typed").wait())
    print("bridge:" + requireBridgeProfile($bridge.Get("typed").wait()))
    0
}
