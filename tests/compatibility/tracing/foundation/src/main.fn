package test.compatibility.tracing

import foundation.tracing
import std.collections
import std.format

enum TraceError {
    Failed
}

struct RecordingSpan implements tracing.Span<TraceError> {
    fn SetAttributes(
        &self,
        $attributes own collections.List<tracing.Attribute>
    ) void {
        print("attributes=" + format.I32(attributes.Len()))
        discard attributes
    }

    fn RecordError(&self, $error TraceError) void {
        match error {
            Failed: print("error=failed")
        }
    }

    fn End(&self) void {
        print("ended=true")
    }
}

struct RecordingTracer implements tracing.Tracer<TraceError> {
    fn Start(
        &self,
        $parent tracing.Context,
        $name String,
        $attributes own collections.List<tracing.Attribute>
    ) own tracing.Started<TraceError> {
        const tracing.Context { TraceID SpanID } = parent
        print("name=" + name)
        print("parent=" + TraceID + "/" + SpanID)
        discard attributes
        own tracing.Started<TraceError> {
            Context = tracing.Context {
                TraceID = TraceID
                SpanID = "child"
            }
            Span = own RecordingSpan {}
        }
    }
}

fn oneAttribute() own collections.List<tracing.Attribute> {
    tracing.WithAttribute(
        tracing.Attributes(),
        tracing.Attribute {
        Key = "component"
        Value = .Text("checkout")
    }
    )
}

fn main() i32 {
    var tracer = RecordingTracer {}
    var started = tracing.Start<TraceError>(
        &tracer,
        tracing.Context { TraceID = "trace" SpanID = "parent" },
        "checkout",
        tracing.Attributes()
    )
    started.Span.SetAttributes(oneAttribute())
    const failure = TraceError.Failed
    started.Span.RecordError($failure)
    started.Span.End()

    var noop = tracing.Noop<TraceError>()
    var silent = tracing.Start<TraceError>(
        &noop,
        tracing.Root(),
        "ignored",
        tracing.Attributes()
    )
    silent.Span.SetAttributes(tracing.Attributes())
    const ignored = TraceError.Failed
    silent.Span.RecordError($ignored)
    silent.Span.End()
    print("noop=ok")
    0
}
