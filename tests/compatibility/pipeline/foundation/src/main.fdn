package test.compatibility.pipeline

import foundation.pipeline as pipes

enum Error {
    Stopped
}

struct StatefulSuffix implements pipes.Middleware<String, String, Error> {
    calls i32

    fn Handle(
        &self,
        $input String,
        next fn($String) Result<String, Error>
    ) Result<String, Error> {
        self.calls = self.calls + 1
        const suffix = if self.calls == 1 { "1" } else { "2" }
        const output = next(input + "s") else error {
            return .Err(error)
        }
        .Ok(output + suffix)
    }
}

fn outer(
    $input String,
    next fn($String) Result<String, Error>
) Result<String, Error> {
    const output = next(input + "a") else error {
        return .Err(error)
    }
    .Ok(output + "A")
}

fn inner(
    $input String,
    next fn($String) Result<String, Error>
) Result<String, Error> {
    const output = next(input + "b") else error {
        return .Err(error)
    }
    .Ok(output + "B")
}

fn terminal($input String) Result<String, Error> {
    .Ok(input + "h")
}

fn stop(
    $input String,
    next fn($String) Result<String, Error>
) Result<String, Error> {
    discard input
    discard next
    .Err(.Stopped)
}

fn unreachable($input String) Result<String, Error> {
    panic(input)
}

fn expectStopped($result Result<String, Error>) bool {
    match result {
        Ok(value): rejectText($value)
        Err(error): match error {
            Stopped: true
        }
    }
}

fn rejectText($value String) bool {
    discard value
    false
}

fn main() i32 {
    var builder = pipes.New<String, String, Error>()
    builder.Use($outer)
    builder.Use($inner)
    var chain = builder.Then($terminal)
    const output = chain.Process("") else error {
        discard error
        return 1
    }
    print(output)

    var statefulBuilder = pipes.New<String, String, Error>()
    statefulBuilder.UseStateful(own StatefulSuffix { calls = 0 })
    var stateful = statefulBuilder.Then($terminal)
    const first = stateful.Process("x") else error {
        discard error
        return 2
    }
    const second = stateful.Process("x") else error {
        discard error
        return 3
    }
    print(first)
    print(second)

    var stoppedBuilder = pipes.New<String, String, Error>()
    stoppedBuilder.Use($stop)
    var stopped = stoppedBuilder.Then($unreachable)
    if !expectStopped($stopped.Process("ignored")) return 4
    print("stopped")
    0
}
