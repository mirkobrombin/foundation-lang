package test.compatibility.fsm_machine

import foundation.events
import foundation.fsm
import std.collections

state_machine Job {
    state Draft
    state Confirmed

    on Confirm from Draft to Confirmed
}

state_machine Flow {
    state Idle
    state Active
    state Done
    state Cancelled

    on Activate from Idle to Active
    on Complete from Active to Done
    on Cancel from Idle, Active, Done, Cancelled to Cancelled
}

enum Trigger {
    Manual
    Activate
    Complete
    Cancel
}

enum Log {
    Rejected
}

fn cloneJob(value Job) Job {
    match value {
        Draft: .Draft
        Confirmed: .Confirmed
    }
}

fn cloneTrigger(value Trigger) Trigger {
    match value {
        Manual: .Manual
        Activate: .Activate
        Complete: .Complete
        Cancel: .Cancel
    }
}

fn cloneFlow(value Flow) Flow {
    match value {
        Idle: .Idle
        Active: .Active
        Done: .Done
        Cancelled: .Cancelled
    }
}

fn confirm(&job Job) Result<void, JobTransitionError> {
    job.Confirm()
}

fn activate(&flow Flow) Result<void, FlowTransitionError> {
    flow.Activate()
}

fn complete(&flow Flow) Result<void, FlowTransitionError> {
    flow.Complete()
}

fn cancel(&flow Flow) Result<void, FlowTransitionError> {
    flow.Cancel()
}

fn flowStateName(value Flow) String {
    match value {
        Idle: "idle"
        Active: "active"
        Done: "done"
        Cancelled: "cancelled"
    }
}

fn hookExit(event fsm.Event<Flow, Trigger>) Result<void, FlowTransitionError> {
    print("hook exit " + flowStateName(event.From))
    .Ok
}

fn hookEnter(event fsm.Event<Flow, Trigger>) Result<void, FlowTransitionError> {
    print("hook enter " + flowStateName(event.To))
    .Ok
}

fn requireFlowApply(
    $value Result<
    own fsm.ApplyReport<FlowTransitionError, Log>,
    fsm.ApplyError<FlowTransitionError>
    >
) void {
    match value {
        Ok(report): {
            if !report.IsClean() {
                discard report
                panic("fsm wildcard compatibility callbacks failed")
            }
            discard report
        }
        Err(error): {
            discard error
            panic("fsm wildcard compatibility transition failed")
        }
    }
}

fn stateName(value Job) String {
    match value {
        Draft: "draft"
        Confirmed: "confirmed"
    }
}

fn eventName(value fsm.EventType) String {
    match value {
        BeforeTransition: "before"
        ExitState: "exit"
        EnterState: "enter"
        AfterTransition: "after"
    }
}

fn triggerName(value Trigger) String {
    match value {
        Manual: "manual"
        Activate: "activate"
        Complete: "complete"
        Cancel: "cancel"
    }
}

fn observe(event fsm.Event<Job, Trigger>) Result<void, Log> {
    print(
        eventName(event.Type) + ":" + stateName(event.From) + "->" +
        stateName(event.To)
    )
    .Ok
}

fn rejectConfirm(
    event fsm.GuardEvent<Job, Trigger>
) Result<void, JobTransitionError> {
    discard event
    .Err(.InvalidState)
}

fn exitEffect(
    event fsm.Event<Job, Trigger>
) Result<void, JobTransitionError> {
    discard event
    print("effect exit")
    .Ok
}

fn enterEffect(
    event fsm.Event<Job, Trigger>
) Result<void, JobTransitionError> {
    discard event
    print("effect enter")
    .Ok
}

fn requireApply(
    $value Result<own fsm.ApplyReport<JobTransitionError, Log>, fsm.ApplyError<JobTransitionError>>
) void {
    match value {
        Ok(report): {
            if !report.IsClean() {
                panic("fsm compatibility callbacks failed")
            }
        }
        Err(error): {
            discard error
            panic("fsm compatibility transition failed")
        }
    }
}

fn requiredRecord(
    $value Option<fsm.Record<Job, Trigger>>
) fsm.Record<Job, Trigger> {
    match value {
        None: panic("fsm compatibility history missing")
        Some(record): record
    }
}

fn printHistory(
    $history own collections.List<fsm.Record<Job, Trigger>>
) void {
    var records = history
    const record = requiredRecord(records.PopFront())
    const fsm.Record { From To Trigger Timestamp } = record
    discard Timestamp
    print(
        "history:" + stateName(From) + "->" + stateName(To) + ":" +
        triggerName(Trigger)
    )
    discard records
}

fn rejected(
    $value Result<own fsm.ApplyReport<JobTransitionError, Log>, fsm.ApplyError<JobTransitionError>>
) bool {
    match value {
        Ok(report): {
            discard report
            false
        }
        Err(error): match error {
            Transition(error): match error {
                InvalidState: true
            }
            Guard(error): {
                discard error
                false
            }
            Clock(error): {
                discard error
                false
            }
            InvalidTimeout: false
            OverlappingTimeout: false
        }
    }
}

fn guardRejected(
    $value Result<own fsm.ApplyReport<JobTransitionError, Log>, fsm.ApplyError<JobTransitionError>>
) bool {
    match value {
        Ok(report): {
            discard report
            false
        }
        Err(error): match error {
            Transition(error): {
                discard error
                false
            }
            Guard(error): match error {
                Reentrant: false
                Handler(error): match error {
                    InvalidState: true
                }
                Handlers(errors): {
                    discard errors
                    false
                }
            }
            Clock(error): {
                discard error
                false
            }
            InvalidTimeout: false
            OverlappingTimeout: false
        }
    }
}

fn main() i32 {
    var blockedInitial Job = .Draft
    var blocked = fsm.New<Job, Trigger, JobTransitionError, Log>(
        $blockedInitial,
        $cloneJob,
        $cloneTrigger
    )
    blocked.Guard($rejectConfirm, events.Priority.Normal) else error {
        discard error
        return 1
    }
    print("guarded:" + if guardRejected($blocked.Apply(.Manual, $confirm)) {
        "true"
    } else {
        "false"
    })

    var initial Job = .Draft
    var machine = fsm.New<Job, Trigger, JobTransitionError, Log>(
        $initial,
        $cloneJob,
        $cloneTrigger
    )
    machine.OnExit($exitEffect, events.Priority.Normal) else error {
        discard error
        return 2
    }
    machine.OnEnter($enterEffect, events.Priority.Normal) else error {
        discard error
        return 3
    }
    machine.Subscribe($observe, events.Priority.Normal) else error {
        discard error
        return 4
    }
    print("initial:" + stateName(machine.Snapshot()))
    requireApply($machine.Apply(.Manual, $confirm))
    print("current:" + stateName(machine.Snapshot()))
    printHistory($machine.History())
    print("invalid:" + if rejected($machine.Apply(.Manual, $confirm)) {
        "true"
    } else {
        "false"
    })

    var flowInitial Flow = .Idle
    var flow = fsm.New<Flow, Trigger, FlowTransitionError, Log>(
        $flowInitial,
        $cloneFlow,
        $cloneTrigger
    )
    flow.OnExit($hookExit, events.Priority.Normal) else error {
        discard error
        return 5
    }
    flow.OnEnter($hookEnter, events.Priority.Normal) else error {
        discard error
        return 6
    }
    print("wildcard-initial:" + flowStateName(flow.Snapshot()))
    requireFlowApply($flow.Apply(.Activate, $activate))
    requireFlowApply($flow.Apply(.Complete, $complete))
    requireFlowApply($flow.Apply(.Cancel, $cancel))
    print("wildcard-current:" + flowStateName(flow.Snapshot()))
    requireFlowApply($flow.Apply(.Cancel, $cancel))
    print("wildcard-self:" + flowStateName(flow.Snapshot()))
    0
}
