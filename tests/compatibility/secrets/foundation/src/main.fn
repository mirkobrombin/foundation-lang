package test.compatibility.secrets

import foundation.secrets
import std.bytes
import std.text

struct FailingStore implements secrets.Store {
    fn Clone(self) own secrets.Store { own FailingStore {} }

    fn Set(
        self,
        $key String,
        $value own bytes.Bytes
    ) Task<Result<void, secrets.Error>> {
        spawn failSet($key, $value)
    }

    fn Get(self, $key String) Task<Result<own bytes.Bytes, secrets.Error>> {
        spawn failGet($key)
    }

    fn Delete(self, $key String) Task<Result<void, secrets.Error>> {
        spawn failDelete($key)
    }
}

struct VaultTransport implements secrets.VaultTransport {
    fn Clone(self) own secrets.VaultTransport { own VaultTransport {} }

    fn Send(
        self,
        $request secrets.VaultRequest
    ) Task<Result<secrets.VaultResponse, secrets.Error>> {
        spawn sendVault($request)
    }
}

task failSet(
    $key String,
    $value own bytes.Bytes
) Result<void, secrets.Error> {
    discard key
    discard value
    .Err(.Transport)
}

task failGet($key String) Result<own bytes.Bytes, secrets.Error> {
    discard key
    .Err(.Transport)
}

task failDelete($key String) Result<void, secrets.Error> {
    discard key
    .Err(.Transport)
}

task sendVault(
    $request secrets.VaultRequest
) Result<secrets.VaultResponse, secrets.Error> {
    const secrets.VaultRequest {
        Method
        Address
        Path
        Token
        Body
        MaximumResponseSize
        FollowRedirects
    } = request
    if Address != "http://127.0.0.1:8200" || Token != "token" ||
        MaximumResponseSize != 1048576 || FollowRedirects {
        discard Address
        discard Path
        discard Token
        discard Body
        return .Err(.Protocol)
    }
    discard Address
    discard Token
    if Path == "/v1/secret/data/missing" {
        discard Path
        discard Body
        return .Ok(secrets.VaultResponse { Status = 404 Body = "" })
    }
    if Path != "/v1/secret/data/app/db" {
        discard Path
        discard Body
        return .Err(.Protocol)
    }
    discard Path
    match Method {
        Put: {
            if Body != "{\"data\":{\"value\":\"cGFzc3dvcmQ=\"}}" {
                discard Body
                return .Err(.Protocol)
            }
            discard Body
            .Ok(secrets.VaultResponse { Status = 204 Body = "" })
        }
        Get: {
            discard Body
            .Ok(secrets.VaultResponse {
                Status = 200
                Body = "{\"request_id\":\"fixture\",\"data\":{\"data\":{\"value\":\"cGFzc3dvcmQ=\",\"version\":\"current\"},\"metadata\":{\"version\":1}}}"
            })
        }
        Delete: {
            discard Body
            .Ok(secrets.VaultResponse { Status = 204 Body = "" })
        }
    }
}

fn expect($result Result<void, secrets.Error>) void {
    match result {
        Ok: {}
        Err(error): {
            discard error
            panic("unexpected secret store error")
        }
    }
}

fn takeBytes(
    $result Result<own bytes.Bytes, secrets.Error>
) own bytes.Bytes {
    match result {
        Ok(value): value
        Err(error): {
            discard error
            panic("missing secret value")
        }
    }
}

fn takeText($result Result<own bytes.Bytes, secrets.Error>) String {
    const value = takeBytes($result)
    const content = value.Text() else error {
        discard value
        discard error
        panic("secret value is not text")
    }
    discard value
    content
}

fn expectedError(error secrets.Error, expected i32) bool {
    match error {
        NotFound: expected == 1
        ReadOnly: expected == 2
        InvalidKey: expected == 3
        AuthenticationFailed: expected == 4
        InsecureAddress: expected == 5
        Transport: expected == 6
        NotConfigured: false
        InvalidCipherKey: false
        TooLarge: false
        Closed: false
        Cancelled: false
        Permission: false
        Protocol: false
        Io: false
    }
}

fn valueFailedAs(
    $result Result<own bytes.Bytes, secrets.Error>,
    expected i32
) bool {
    match result {
        Ok(value): {
            discard value
            false
        }
        Err(error): expectedError(error, expected)
    }
}

fn writeFailedAs(
    $result Result<void, secrets.Error>,
    expected i32
) bool {
    match result {
        Ok: false
        Err(error): expectedError(error, expected)
    }
}

fn vaultFailedAs(
    $result Result<own secrets.VaultStore, secrets.Error>,
    expected i32
) bool {
    match result {
        Ok(store): {
            discard store
            false
        }
        Err(error): expectedError(error, expected)
    }
}

fn main() i32 {
    const memory = secrets.NewMemoryStore()
    const storing = memory.Set("token", bytes.FromText("value"))
    const stored = $storing.wait()
    expect($stored)
    const firstLoad = memory.Get("token")
    const first = $firstLoad.wait()
    if takeText($first) != "value" return 1
    const secondLoad = memory.Get("token")
    const second = $secondLoad.wait()
    if takeText($second) != "value" return 2
    print("memory copies")

    const deleting = memory.Delete("token")
    const deleted = $deleting.wait()
    expect($deleted)
    const missingLoad = memory.Get("token")
    const missing = $missingLoad.wait()
    if !valueFailedAs($missing, 1) return 3
    print("memory delete")

    const environment = secrets.NewEnvStore()
    const environmentLoad = environment.Get("FOUNDATION_SECRET_TEST")
    const environmentValue = $environmentLoad.wait()
    if takeText($environmentValue) != "environment-value" return 4
    const environmentStore = environment.Set("FOUNDATION_SECRET_TEST", bytes.FromText("x"))
    const environmentWrite = $environmentStore.wait()
    if !writeFailedAs($environmentWrite, 2) return 5
    print("environment read only")

    const prefixMemory = secrets.NewMemoryStore()
    const prefixed = secrets.NewPrefixStore(prefixMemory.Clone(), "app/")
    const prefixStore = prefixed.Set("token", bytes.FromText("namespaced"))
    const prefixStored = $prefixStore.wait()
    expect($prefixStored)
    const prefixLoad = prefixMemory.Get("app/token")
    const prefixValue = $prefixLoad.wait()
    if takeText($prefixValue) != "namespaced" return 6
    print("prefix namespace")

    const fallbackMemory = secrets.NewMemoryStore()
    const fallback = secrets.NewFallbackStore(
        secrets.NewEnvStore(),
        fallbackMemory.Clone()
    )
    const fallbackStore = fallback.Set(
        "FOUNDATION_SECRET_FALLBACK",
        bytes.FromText("secondary")
    )
    const fallbackStored = $fallbackStore.wait()
    expect($fallbackStored)
    const fallbackLoad = fallback.Get("FOUNDATION_SECRET_FALLBACK")
    const fallbackValue = $fallbackLoad.wait()
    if takeText($fallbackValue) != "secondary" return 7
    print("fallback expected conditions")

    const preserving = secrets.NewFallbackStore(
        own FailingStore {},
        fallbackMemory.Clone()
    )
    const preserveLoad = preserving.Get("FOUNDATION_SECRET_FALLBACK")
    const preserveResult = $preserveLoad.wait()
    if !valueFailedAs($preserveResult, 6) return 8
    print("fallback preserves failures")

    const cipherMemory = secrets.NewMemoryStore()
    const cipher = secrets.NewCipherStore(
        cipherMemory.Clone(),
        bytes.FromText("0123456789abcdef0123456789abcdef")
    ) else error {
        discard error
        return 9
    }
    const cipherStore = cipher.Set("one", bytes.FromText("first"))
    const cipherStored = $cipherStore.wait()
    expect($cipherStored)
    const cipherLoad = cipher.Get("one")
    const cipherValue = $cipherLoad.wait()
    if takeText($cipherValue) != "first" return 10
    const rawLoad = cipherMemory.Get("one")
    const rawResult = $rawLoad.wait()
    const raw = takeBytes($rawResult)
    const plain = bytes.FromText("first")
    if bytes.ConstantTimeEqual(raw, plain) return 11
    discard raw
    discard plain
    print("cipher round trip")

    const secondCipherStore = cipher.Set("two", bytes.FromText("second"))
    const secondCipherStored = $secondCipherStore.wait()
    expect($secondCipherStored)
    const rawSecondLoad = cipherMemory.Get("two")
    const rawSecondResult = $rawSecondLoad.wait()
    const rawSecond = takeBytes($rawSecondResult)
    const replaceFirst = cipherMemory.Set("one", $rawSecond)
    const replacedFirst = $replaceFirst.wait()
    expect($replacedFirst)
    const boundLoad = cipher.Get("one")
    const boundResult = $boundLoad.wait()
    if !valueFailedAs($boundResult, 4) return 12
    print("cipher key binding")

    const vault = secrets.NewVaultStore(
        own VaultTransport {},
        "http://127.0.0.1:8200",
        "token",
        "secret"
    ) else error {
        discard error
        return 13
    }
    const vaultStore = vault.Set("app/db", bytes.FromText("password"))
    const vaultStored = $vaultStore.wait()
    expect($vaultStored)
    const vaultLoad = vault.Get("app/db")
    const vaultValue = $vaultLoad.wait()
    if takeText($vaultValue) != "password" return 14
    const vaultDelete = vault.Delete("app/db")
    const vaultDeleted = $vaultDelete.wait()
    expect($vaultDeleted)
    print("vault kv2 wire")

    const vaultMissingLoad = vault.Get("missing")
    const vaultMissing = $vaultMissingLoad.wait()
    if !valueFailedAs($vaultMissing, 1) return 15
    print("vault missing")

    const invalidLoad = vault.Get("app/../db")
    const invalid = $invalidLoad.wait()
    if !valueFailedAs($invalid, 3) return 16
    print("vault invalid key")

    const insecureTransport = own VaultTransport {}
    const insecure = secrets.NewVaultStore(
        $insecureTransport,
        "http://vault.example.com",
        "token",
        "secret"
    )
    if !vaultFailedAs($insecure, 5) return 17
    print("insecure vault rejected")
    print("secrets compatibility ok")
    0
}
