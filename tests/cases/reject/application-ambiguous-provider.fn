import foundation.di

contract Store {
    fn Count(self) i32
}

service MemoryStore implements Store {
    ctor New() {
        MemoryStore {}
    }

    fn Count(self) i32 {
        1
    }
}

service FileStore implements Store {
    ctor New() {
        FileStore {}
    }

    fn Count(self) i32 {
        2
    }
}

@di.Scope(.Singleton)
service Api {
    ctor New(store Store) {
        discard store
        Api {}
    }
}

fn main() i32 {
    0
}
