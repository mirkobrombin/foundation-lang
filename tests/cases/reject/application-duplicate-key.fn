import foundation.actions
import foundation.di

service Commands {
    @di.Inject()
    fn New() Commands {
        Commands {}
    }

    @actions.Name("first")
    @actions.Key("ctrl+x")
    action First(self) i32 {
        1
    }

    @actions.Name("second")
    @actions.Key("ctrl+x")
    action Second(self) i32 {
        2
    }
}

fn main() i32 {
    0
}
