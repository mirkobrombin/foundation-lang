contract Consumer {
    fn take($self) i32
}

struct Value implements Consumer {
    stored i32

    fn take($self) i32 { self.stored }
}

fn erase($value own Value) own Consumer { value }

fn main() i32 {
    const value = erase(own Value { stored = 42 })
    const result = value.take()
    discard value
    result
}
