package test.host

import foundation.actions
import foundation.di

service First {
    ctor New() Result<bool> {
        .Ok(First {})
    }
}

service Second {
    ctor New() Result<String> {
        .Ok(Second {})
    }
}

service Runner {
    ctor New(first First, second Second) {
        discard first
        discard second
        Runner {}
    }

    @actions.Name("run")
    action Run(self) i32 {
        0
    }
}

fn main() i32 {
    0
}
