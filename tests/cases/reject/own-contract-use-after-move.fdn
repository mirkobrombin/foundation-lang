contract Consumer {
    fn take(own) i32
}

struct Value implements Consumer {
    stored i32

    fn take(own) i32 { self.stored }
}

fn erase(value own Value) own Consumer { value }

fn main() i32 {
    let value = erase(own Value { stored = 42 })
    let result = value.take()
    discard value
    result
}
