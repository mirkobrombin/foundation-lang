import foundation.di

contract Store {
    fn Value(self) i32
}

@di.Name("store")
service MemoryStore implements Store {
    ctor New() {
        MemoryStore {}
    }

    fn Value(self) i32 {
        1
    }
}

service Reader {
    ctor New(@di.From("") store Store) {
        discard store
        Reader {}
    }
}

fn main() i32 {
    0
}
