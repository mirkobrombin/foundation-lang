package test.environment

import std.env

fn optionValue(value Option<String>) String {
    match value {
        None: ""
        Some(item): item
    }
}

fn unexpectedString(value String) i32 {
    discard value
    5
}

fn missingCode(value Option<String>) i32 {
    match value {
        None: 0
        Some(item): unexpectedString(item)
    }
}

fn unexpectedOption(value Option<String>) i32 {
    discard value
    6
}

fn errorCode(error env.Error) i32 {
    match error {
        InvalidName: 0
        InvalidUtf8: 7
        Platform: 8
    }
}

fn invalidCode(value Result<Option<String>, env.Error>) i32 {
    match value {
        Ok(item): unexpectedOption(item)
        Err(error): errorCode(error)
    }
}

fn main() i32 {
    let foundName = "FOUNDATION_ENV_TEST"
    let found = env.Get(view foundName) else error {
        discard error
        return 1
    }
    let value = optionValue(found)
    if value != "foundation env value" {
        return 3
    }

    let missingName = "FOUNDATION_ENV_TEST_MISSING_71C0"
    let missing = env.Get(view missingName) else error {
        discard error
        return 4
    }
    let missingStatus = missingCode(missing)
    if missingStatus != 0 {
        return missingStatus
    }

    let invalidName = "INVALID=NAME"
    let invalid = env.Get(view invalidName)
    let invalidStatus = invalidCode(invalid)
    if invalidStatus != 0 {
        return invalidStatus
    }

    print("env ok")
    0
}
