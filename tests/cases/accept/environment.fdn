package test.environment

import std.env

fn optionValue($value Option<String>) String {
    match value {
        None: ""
        Some(item): item
    }
}

fn unexpectedString($value String) i32 {
    discard value
    5
}

fn missingCode($value Option<String>) i32 {
    match value {
        None: 0
        Some(item): unexpectedString($item)
    }
}

fn unexpectedOption($value Option<String>) i32 {
    discard value
    6
}

fn errorCode(error env.Error) i32 {
    match error {
        InvalidName: 0
        InvalidUtf8: 7
        Platform: 8
    }
}

fn invalidCode($value Result<Option<String>, env.Error>) i32 {
    match value {
        Ok(item): unexpectedOption($item)
        Err(error): errorCode(error)
    }
}

fn main() i32 {
    const foundName = "FOUNDATION_ENV_TEST"
    const found = env.Get(foundName) else error {
        discard error
        return 1
    }
    const value = optionValue($found)
    if value != "foundation env value" {
        return 3
    }

    const missingName = "FOUNDATION_ENV_TEST_MISSING_71C0"
    const missing = env.Get(missingName) else error {
        discard error
        return 4
    }
    const missingStatus = missingCode($missing)
    if missingStatus != 0 {
        return missingStatus
    }

    const invalidName = "INVALID=NAME"
    const invalid = env.Get(invalidName)
    const invalidStatus = invalidCode($invalid)
    if invalidStatus != 0 {
        return invalidStatus
    }

    print("env ok")
    0
}
