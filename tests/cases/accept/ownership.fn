struct Node {
    value i32
    next Option<own Node>
}

enum Item {
    Empty
    Present(own Node)
}

fn nodeValue(node Node) i32 {
    node.value
}

fn consume($node own Node) i32 {
    node.value
}

fn setValue(&node Node, value i32) void {
    node.value = value
}

fn allocate<T>($value T) own T {
    own value
}

fn loadNode(value i32) Result<own Node, String> {
    .Ok(own Node { value = value next = .None })
}

fn failedNode() Result<i32, own Node> {
    .Err(own Node { value = 10 next = .None })
}

fn recoverNode() i32 {
    const value = failedNode() else node {
        return node.value
    }
    value
}

fn main() i32 {
    const tail = own Node { value = 2 next = .None }
    var head = own Node { value = 7 next = .Some(tail) }
    const viewed = nodeValue(head)
    setValue(&head, 8)
    head.value = 9
    const moved = head
    const consumed = consume($moved)

    const item = Item.Present(own Node { value = 5 next = .None })
    const matched = match item {
        Empty: 0
        Present(node): node.value
    }

    const loaded = loadNode(4) else error {
        panic(error)
    }
    const loadedValue = nodeValue(loaded)
    discard loaded

    const generic = allocate(Node { value = 6 next = .None })
    discard generic

    if true {
        const scoped = own Node { value = 11 next = .None }
        nodeValue(scoped)
    }

    var replaced = own Node { value = 12 next = .None }
    replaced = own Node { value = 13 next = .None }
    discard replaced

    var round = 0
    while round < 2 {
        const scoped = own Node { value = round next = .None }
        nodeValue(scoped)
        round = round + 1
    }

    const discarded = own Node { value = 1 next = .None }
    discard discarded
    print("ownership ok")
    viewed + consumed + matched + loadedValue + recoverNode() - 35
}
