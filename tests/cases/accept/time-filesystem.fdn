import std.fs
import std.time

fn main(args [String]) i32 {
    if len(args) != 1 {
        return 1
    }
    const modified = fs.Modified(args[0]) else error {
        discard error
        return 2
    }
    const now = time.Now()
    if now.Unix() < 1700000000 || modified < 1700000000 {
        return 3
    }
    const fileTime = time.FromUnix(modified)
    if now.Before(fileTime) {
        return 4
    }
    const elapsed = now.Since(fileTime) else error {
        discard error
        return 5
    }
    if elapsed.Seconds() > now.Unix() {
        return 6
    }
    print("time ok")
    0
}
