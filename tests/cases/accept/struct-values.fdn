struct LabeledPair {
    pair Pair
    label String
}

struct Pair {
    left i32
    right i32
}

fn first() i32 {
    print("first")
    1
}

fn second() i32 {
    print("second")
    2
}

fn makePair() Pair {
    Pair {
        right = second()
        left = first()
    }
}

fn sum(pair Pair) i32 {
    pair.left + pair.right
}

fn main() i32 {
    const pair = makePair()
    var copy Pair = pair
    copy = Pair { left = copy.left right = copy.right }
    const labeled = LabeledPair { label = "pair" pair = copy }
    print(labeled.label)
    sum(labeled.pair) - 3
}
