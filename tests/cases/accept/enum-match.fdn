struct Failure {
    message String
}

enum Lookup {
    Missing
    Found(i32)
    Failed(Failure)
}

fn makeValue() i32 {
    print("payload")
    7
}

fn lookup(found bool) Lookup {
    if found {
        return .Found(makeValue())
    }
    .Missing
}

fn report(error Failure) i32 {
    print(error.message)
    -1
}

fn valueOr(result Lookup, fallback i32) i32 {
    match result {
        Missing: fallback
        Found(value): value
        Failed(error): report(error)
    }
}

fn main() i32 {
    var result Lookup = lookup(true)
    let found = valueOr(result, 0)
    result = Lookup.Failed(Failure { message = "failed" })
    let failed = valueOr(result, 0)
    if found == 7 && failed == -1 {
        return 0
    }
    1
}
