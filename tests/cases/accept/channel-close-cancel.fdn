task sendClosed($sender Sender<String>) Result<void, ChannelError> {
    const delivered = sender.send("hel" + "lo")
    delivered
}

task receiveClosed($receiver Receiver<String>) Result<String, ChannelError> {
    const received = receiver.receive()
    received
}

task waitForCancellation($receiver Receiver<i32>) void {
    discard receiver.receive()
}

fn closedCode(error ChannelError) i32 {
    match error {
        Closed: 0
        Cancelled: 1
        Timeout: 2
    }
}

fn main() i32 {
    const Channel { sender receiver as sendReceiver } = channel<String>(0)
    discard sendReceiver
    const sending = spawn sendClosed($sender)
    const sent = $sending.wait()
    const sendCode = match sent {
        Ok: 3
        Err(error): closedCode(error)
    }
    if sendCode != 0 {
        return sendCode
    }

    const Channel { sender as receiveSender receiver } = channel<String>(0)
    discard receiveSender
    const receiving = spawn receiveClosed($receiver)
    const received = $receiving.wait()
    const receiveCode = match received {
        Ok(message): 4
        Err(error): closedCode(error)
    }
    if receiveCode != 0 {
        return receiveCode
    }

    const Channel { sender as cancelSender receiver as cancelReceiver } = channel<i32>(0)
    const waiting = spawn waitForCancellation($cancelReceiver)
    discard waiting
    discard cancelSender
    print("channel close and cancellation")
    0
}
