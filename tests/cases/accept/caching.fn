package test.caching

import foundation.caching
import foundation.worker
import std.bytes
import std.time

enum CodecError {
    Invalid
}

fn cloneI32(value i32) i32 {
    value
}

fn requireVoid($value Result<void, caching.Error>) void {
    match value {
        Ok: done()
        Err(error): fail(error)
    }
}

fn done() void {
    return
}

fn requireI32($value Result<i32, caching.Error>) i32 {
    match value {
        Ok(found): found
        Err(error): fail(error)
    }
}

fn requireOptional(
    $value Result<Option<i32>, caching.Error>
) Option<i32> {
    match value {
        Ok(found): found
        Err(error): fail(error)
    }
}

fn requireDuration(
    $value Result<time.Duration, time.DurationError>
) time.Duration {
    match value {
        Ok(duration): duration
        Err(error): {
            discard error
            panic("duration parsing failed")
        }
    }
}

fn isInvalidConfigurationTTL(
    $value Result<
    own caching.InMemory<i32>,
    caching.ConfigurationError
    >
) bool {
    match value {
        Ok(cache): {
            discard cache
            false
        }
        Err(error): match error {
            InvalidTTL: true
            InvalidMaxEntries: false
        }
    }
}

fn isInvalidMaxEntries(
    $value Result<
    own caching.InMemory<i32>,
    caching.ConfigurationError
    >
) bool {
    match value {
        Ok(cache): {
            discard cache
            false
        }
        Err(error): match error {
            InvalidTTL: false
            InvalidMaxEntries: true
        }
    }
}

fn isInvalidWriteTTL(
    $value Result<void, caching.Error>
) bool {
    match value {
        Ok: false
        Err(error): match error {
            InvalidTTL: true
            Closed: false
            Cancelled: false
        }
    }
}

fn optionalValue($value Option<i32>) i32 {
    match value {
        None: -1
        Some(found): found
    }
}

fn fail(error caching.Error) never {
    discard error
    panic("cache operation failed")
}

fn waitFor(duration time.Duration) void {
    const started = time.MonotonicNow()
    var elapsed i64 = 0
    while elapsed <= duration.Nanoseconds() {
        const measured = time.MonotonicNow().Since(started) else error {
            discard error
            panic("monotonic clock moved backwards")
        }
        elapsed = measured.Nanoseconds()
    }
}

fn requireText(
    $value Result<Option<own bytes.Bytes>, caching.Error>
) String {
    match value {
        Err(error): fail(error)
        Ok(found): optionalText($found)
    }
}

fn requireBytes(
    $value Result<Option<own bytes.Bytes>, caching.Error>
) own bytes.Bytes {
    match value {
        Err(error): fail(error)
        Ok(found): match found {
            None: panic("cached bytes are missing")
            Some(content): content
        }
    }
}

fn optionalText($value Option<own bytes.Bytes>) String {
    match value {
        None: ""
        Some(found): bytesText($found)
    }
}

fn bytesText($value own bytes.Bytes) String {
    const content = value.Text() else error {
        discard error
        panic("invalid cached text")
    }
    content
}

fn encodeText(value String) Result<own bytes.Bytes, CodecError> {
    if value == "invalid" return .Err(.Invalid)
    .Ok(bytes.FromText(value))
}

fn decodeText(value bytes.Bytes) Result<String, CodecError> {
    const content = value.Text() else error {
        discard error
        return .Err(.Invalid)
    }
    .Ok(content)
}

fn requireBridgeVoid(
    $value Result<void, caching.BridgeError<caching.Error, CodecError>>
) void {
    match value {
        Ok: done()
        Err(error): failBridge(error)
    }
}

fn requireBridgeText(
    $value Result<
    Option<String>,
    caching.BridgeError<caching.Error, CodecError>
    >
) String {
    match value {
        Err(error): failBridge(error)
        Ok(found): match found {
            None: ""
            Some(content): content
        }
    }
}

fn failBridge(
    $error caching.BridgeError<caching.Error, CodecError>
) never {
    discard error
    panic("cache bridge operation failed")
}

fn isEncodeFailure(
    $value Result<
    void,
    caching.BridgeError<caching.Error, CodecError>
    >
) bool {
    match value {
        Ok: false
        Err(error): match error {
            Encode(error): isCodecInvalid(error)
            Transport(error): fail(error)
            Backend(error): fail(error)
            Decode(error): isCodecInvalid(error)
        }
    }
}

fn isCodecInvalid(error CodecError) bool {
    match error {
        Invalid: true
    }
}

task store(
    $handle caching.Handle<i32>,
    $key String,
    value i32
) void {
    const pending = handle.Set($key, value, time.Zero())
    const result = $pending.wait()
    requireVoid($result)
}

task waitUntilCount(
    $handle caching.Handle<i32>,
    expected i32
) i32 {
    while true {
        const pending = handle.Len()
        const result = $pending.wait()
        const count = requireI32($result)
        if count >= expected return count
    }
    0
}

fn main() i32 {
    const negative = requireDuration($time.Duration.Parse("-1ms"))
    const invalidTTLConfiguration = caching.NewWith<i32>(
        $cloneI32,
        caching.Policy { DefaultTTL = negative }
    )
    if !isInvalidConfigurationTTL($invalidTTLConfiguration) {
        return 1
    }
    const invalidCapacityConfiguration = caching.NewWith<i32>(
        $cloneI32,
        caching.Policy { MaxEntries = -1 }
    )
    if !isInvalidMaxEntries($invalidCapacityConfiguration) {
        return 2
    }

    const cache = caching.NewWith<i32>(
        $cloneI32,
        caching.Policy {
        DefaultTTL = time.Milliseconds(2)
        MaxEntries = 2
    }
    ) else error {
        discard error
        return 3
    }

    if !isInvalidWriteTTL($cache.Set("invalid", 0, negative).wait()) return 4

    requireVoid($cache.Set("one", 1, time.Zero()).wait())
    requireVoid($cache.Set("two", 2, time.Zero()).wait())
    if optionalValue(requireOptional($cache.Get("one").wait())) != 1 return 5

    requireVoid($cache.Set("three", 3, time.Zero()).wait())
    if optionalValue(requireOptional($cache.Get("one").wait())) != -1 return 6
    if requireI32($cache.Len().wait()) != 2 return 7

    requireVoid($cache.Invalidate("two").wait())
    if requireI32($cache.Len().wait()) != 1 return 8
    waitFor(time.Milliseconds(3))
    if requireI32($cache.Len().wait()) != 0 return 9

    const unbounded = caching.NewWith<i32>(
        $cloneI32,
        caching.Policy { MaxEntries = 0 }
    ) else error {
        discard error
        return 10
    }
    const workers = worker.NewPool(3)
    workers.Start(spawn store(unbounded.Handle(), "one", 1))
    workers.Start(spawn store(unbounded.Handle(), "two", 2))
    workers.Start(spawn store(unbounded.Handle(), "three", 3))
    const waiting = spawn waitUntilCount(unbounded.Handle(), 3)
    if $waiting.wait() != 3 return 11
    workers.Shutdown()
    if requireI32($unbounded.Len().wait()) != 3 return 12

    const backend = caching.NewDistributed()
    requireVoid($backend.Set(
        "profile",
        bytes.FromText("{\"name\":\"Ada\"}"),
        time.Zero()
        ).wait())
    if requireText($backend.Get("profile").wait()) != "{\"name\":\"Ada\"}" {
        return 13
    }
    var copied = requireBytes($backend.Get("profile").wait())
    discard copied.Close()
    if requireText($backend.Get("profile").wait()) != "{\"name\":\"Ada\"}" {
        return 14
    }
    requireVoid($backend.Delete("profile").wait())
    if requireText($backend.Get("profile").wait()) != "" return 15

    const bridge = caching.NewBridge<String, caching.Error, CodecError>(
        backend.Fork(),
        $encodeText,
        $decodeText
    )
    requireBridgeVoid($bridge.Set(
        "typed",
        "Foundation",
        time.Zero()
        ).wait())
    if requireBridgeText($bridge.Get("typed").wait()) != "Foundation" return 16
    requireBridgeVoid($bridge.Invalidate("typed").wait())
    if requireBridgeText($bridge.Get("typed").wait()) != "" return 17
    if !isEncodeFailure($bridge.Set(
        "typed",
        "invalid",
        time.Zero()
        ).wait()) {
        return 18
    }

    print("caching ok")
    0
}
