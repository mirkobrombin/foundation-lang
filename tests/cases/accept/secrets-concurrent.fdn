package test.secrets.concurrent

import foundation.secrets
import foundation.worker
import std.bytes

task store(
    $target own secrets.MemoryStore,
    $key String,
    $value own bytes.Bytes,
    $results Sender<i32>
) void {
    const storing = target.Set($key, $value)
    discard target
    const stored = $storing.wait()
    match stored {
        Ok: {
            discard results.send(1)
        }
        Err(error): {
            discard error
            discard results.send(0)
        }
    }
}

task collect($results Receiver<i32>, count i32) i32 {
    var total = 0
    var remaining = count
    while remaining > 0 {
        const received = results.receive()
        match received {
            Ok(value): {
                total = total + value
            }
            Err(error): {
                discard error
                panic("secret result channel failed")
            }
        }
        remaining = remaining - 1
    }
    total
}

fn present(
    $result Result<own bytes.Bytes, secrets.Error>,
    expected String
) bool {
    match result {
        Ok(value): {
            const content = value.Text() else error {
                discard value
                discard error
                return false
            }
            discard value
            content == expected
        }
        Err(error): {
            discard error
            false
        }
    }
}

fn main() i32 {
    const memory = secrets.NewMemoryStore()
    const Channel { sender receiver } = channel<i32>(4)
    const gathering = spawn collect($receiver, 4)
    const pool = worker.NewPool(4)
    pool.Start(spawn store(memory.Share(), "one", bytes.FromText("1"), sender.clone()))
    pool.Start(spawn store(memory.Share(), "two", bytes.FromText("2"), sender.clone()))
    pool.Start(spawn store(memory.Share(), "three", bytes.FromText("3"), sender.clone()))
    pool.Start(spawn store(memory.Share(), "four", bytes.FromText("4"), sender.clone()))
    if $gathering.wait() != 4 return 1
    pool.Shutdown()
    discard sender

    const one = memory.Get("one")
    if !present($one.wait(), "1") return 2
    const two = memory.Get("two")
    if !present($two.wait(), "2") return 3
    const three = memory.Get("three")
    if !present($three.wait(), "3") return 4
    const four = memory.Get("four")
    if !present($four.wait(), "4") return 5

    print("concurrent secret memory ok")
    0
}
