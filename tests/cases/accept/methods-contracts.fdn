contract Readable {
    fn read(self) i32
    fn add(&self, amount i32) void
    fn take($self) i32
}

contract Boxed<T> {
    fn set(&self, $value T) void
}

contract Pinger {
    fn ping(self) i32
}

contract Formatter {
    fn format(self, value Pinger) i32
}

struct Counter implements Readable {
    value i32

    fn read(self) i32 {
        self.value
    }

    fn add(&self, amount i32) void {
        self.value = self.value + amount
    }

    fn take($self) i32 {
        self.value
    }
}

methods Counter {
    fn New(value i32) Counter {
        Counter { value = value }
    }
}

struct Box<T> implements Boxed<T> {
    value T

    fn set(&self, $value T) void {
        self.value = value
    }
}

methods Box<T> {
    fn New($value T) Box<T> {
        Box<T> { value = value }
    }
}

struct EmptyPinger implements Pinger {
    fn ping(self) i32 {
        42
    }
}

struct PingerFormatter implements Formatter {
    fn format(self, value Pinger) i32 {
        value.ping()
    }
}

fn readContract(value Readable) i32 {
    value.read()
}

fn addContract(&value Readable, amount i32) void {
    value.add(amount)
}

fn readConcrete(value Counter) i32 {
    value.read()
}

fn addConcrete(&value Counter, amount i32) void {
    value.add(amount)
}

fn setAny<T>(&value Boxed<T>, $next T) void {
    value.set($next)
}

fn ping(value Pinger) i32 {
    value.ping()
}

fn format(value Formatter, pinger EmptyPinger) i32 {
    value.format(pinger)
}

fn main() i32 {
    var counter = Counter.New(40)
    addConcrete(&counter, 1)
    addContract(&counter, 1)
    const current = readContract(counter)
    const concrete = readConcrete(counter)
    const owned = own Counter { value = current }
    const taken = owned.take()
    var box = Box<i32>.New(0)
    setAny(&box, 42)
    const boxed = box.value
    const pinger = EmptyPinger {}
    const pinged = ping(pinger)
    const formatter = PingerFormatter {}
    const direct = formatter.format(pinger)
    const dynamic = format(formatter, pinger)
    if taken == 42 && concrete == 42 && boxed == 42 && pinged == 42 && direct == 42 && dynamic == 42 {
        print("methods work")
        return 0
    }
    1
}
