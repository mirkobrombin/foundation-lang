fn main() i32 {
    var ascending = 0
    for value in range(1, 6, step = 2) {
        ascending = ascending + value
    }
    if ascending != 9 return 1

    var descending = 0
    for index, value in range(5, 0, step = -2) {
        if index == 1 continue
        descending = descending + value
    }
    if descending != 6 return 2
    0
}
