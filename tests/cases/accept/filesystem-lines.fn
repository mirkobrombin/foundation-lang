package test.filesystem_lines

import std.fs

fn lineOr($value Result<Option<String>, fs.Error>) String {
    match value {
        Ok(line): match line {
            None: ""
            Some(text): text
        }
        Err(error): ""
    }
}

fn isLineTooLong($value Result<Option<String>, fs.Error>) bool {
    match value {
        Ok(line): false
        Err(error): match error {
            NotFound: false
            Permission: false
            InvalidPath: false
            InvalidUtf8: false
            LineTooLong: true
            TooLarge: false
            Closed: false
            Io: false
        }
    }
}

fn main(args [String]) i32 {
    const size = fs.Size(args[0]) else error {
        discard error
        return 1
    }
    const opened = fs.OpenLines(args[0]) else error {
        discard error
        return 2
    }
    var reader = opened
    const first = lineOr(reader.Next())
    const second = lineOr(reader.Next())
    const third = lineOr(reader.Next())
    const end = lineOr(reader.Next())
    discard reader.Close()
    const limited = fs.OpenLines(args[0]) else error {
        discard error
        return 3
    }
    var limitedReader = limited
    const shortLimit u64 = 8
    const bounded = isLineTooLong(limitedReader.NextLimited(shortLimit))
    discard limitedReader.Close()
    if size > 0 && first == "{\"id\":1,\"text\":\"first\"}" &&
        second == "{\"id\":2,\"text\":\"héllo\"}" &&
        third == "{\"id\":3,\"text\":\"last\"}" && end == "" && bounded {
        print("fs lines ok")
        return 0
    }
    return 4
}
