import std.text

struct Counter {
    value i32
}

struct Record {
    name String
    counter Counter
    values [3]i32
}

fn copyName(value String) String {
    text.Copy(value)
}

fn increment(&value Counter) void {
    value.value = value.value + 1
}

fn first(values [i32]) i32 {
    values[0]
}

fn preserveOnSuccess(result Result<i32, bool>, $message String) String {
    const value = result else error {
        discard error
        discard message
        return "failed"
    }
    discard value
    message
}

fn main() i32 {
    var record = Record {
        name = "foundation"
        counter = Counter { value = 41 }
        values = [7, 8, 9]
    }
    const name = copyName(record.name)
    increment(&record.counter)
    const selected = first(record.values)
    const preserved = preserveOnSuccess(.Ok(1), "preserved")
    print(name)
    print(preserved)
    if record.counter.value != 42 || selected != 7 {
        panic("field borrow changed value")
    }
    0
}
