fn sum(values [i32]) i32 {
    values[0] + values[1] + values[2]
}

fn clearFirst(&values [i32]) void {
    values[0] = 0
}

fn printFirst(values [String]) void {
    print(values[0])
}

fn earlyReturn(flag bool) i32 {
    const values = own ["early " + "return"]
    if flag {
        return 1
    }
    discard values
    0
}

fn main() i32 {
    var numbers = [2, 3, 4]
    clearFirst(&numbers)
    const total = sum(numbers)

    var words = ["Foundation", " Lang"]
    const message = words[0] + words[1]
    if message != "Foundation Lang" {
        panic("String equality failed")
    }
    print(message)
    print("temporary " + "String" + "")
    words[1] = "!"
    printFirst(words)

    const moved = words
    printFirst(moved)
    discard moved

    const heapWords = own ["owned array"]
    printFirst(heapWords)
    discard heapWords

    const empty [0]i32 = []
    discard empty
    total + earlyReturn(true) - 8
}
