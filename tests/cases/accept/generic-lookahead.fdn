fn identity<T>($value T) T {
    value
}

fn apply(value i32, operation fn(i32) i32) i32 {
    operation(value)
}

fn applyPair(value i32, first fn(i32) i32, second fn(i32) i32) i32 {
    first(second(value))
}

fn specialize() fn(i32) i32 { identity<i32> }

fn main() i32 {
    const x = 1
    const y = 2
    const p = 5
    const c = 4
    const before = x < y
    const after = p > (c)

    const direct fn(i32) i32 = identity<i32>
    const returned = specialize()
    const functions = [identity<i32>, identity<i32>]
    const single = apply(20, identity<i32>)
    const paired = applyPair(5, identity<i32>, identity<i32>)
    discard functions

    if before && after {
        print("generic lookahead ok")
        return direct(single) + returned(paired) - 25
    } else {
        return 1
    }
}
