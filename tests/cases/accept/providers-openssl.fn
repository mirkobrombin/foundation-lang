package test.providers_openssl

import foundation.auth
import foundation.httpx
import foundation.tls as secureTLS
import foundation.web
import std.bytes
import std.collections
import std.concurrent
import std.net

enum WebFailure {
    Rejected
}

struct rejectingApplication implements web.Application<WebFailure> {
    fn Dispatch(
        &self,
        $request web.Request
    ) Result<web.Response, web.DispatchError<WebFailure>> {
        discard request
        .Err(.Handler(error = .Rejected))
    }
}

fn invalidPrivateKey(
    $result Result<own bytes.Bytes, auth.AsymmetricProviderError>
) bool {
    match result {
        Ok(signature): {
            discard signature
            false
        }
        Err(error): match error {
            InvalidPrivateKey: true
            Unsupported: false
            InvalidPublicKey: false
            InvalidSignature: false
            Failed: false
        }
    }
}

fn cancelledTLS(
    $result Result<httpx.Response, httpx.TLSError>
) bool {
    match result {
        Ok(response): {
            discard response
            false
        }
        Err(error): match error {
            Cancelled: true
            InvalidServerName: false
            CertificateNotFound: false
            CertificateRejected: false
            HandshakeFailed: false
            PeerVerificationFailed: false
            Timeout: false
            ProtocolFailed: false
            Unavailable: false
        }
    }
}

fn request() httpx.Request {
    const created = httpx.NewRequest(
        "GET",
        "https://example.com/",
        ""
    ) else error {
        discard error
        panic("OpenSSL provider request fixture failed")
    }
    created
}

fn invalidServerCertificate() bool {
    var certificates = collections.NewList<own web.OpenSSLCertificate>()
    certificates.PushFront(own web.OpenSSLCertificate {
        ServerName = "example.com"
        CertificatePEM = bytes.FromText("not a certificate")
        PrivateKeyPEM = bytes.FromText("not a private key")
    })
    const opened = web.NewOpenSSLServer<WebFailure>(
        "127.0.0.1",
        0,
        $certificates,
        own rejectingApplication {}
    )
    match opened {
        Ok(server): {
            const serving = server.ServeBatch(0)
            const outcome = $serving.wait()
            discard outcome
            false
        }
        Err(error): {
            discard error
            true
        }
    }
}

fn generatedEd25519Works() bool {
    const generated = auth.GenerateOpenSSLEd25519() else {
        return false
    }
    const auth.OpenSSLEd25519KeyPair {
        PrivateKeyPEM
        PublicKeyPEM
        RawPublicKey
    } = generated
    const rawLength = RawPublicKey.Len() else { return false }
    if rawLength != 32 return false
    const derived = auth.OpenSSLEd25519Public(PrivateKeyPEM) else {
        return false
    }
    const auth.OpenSSLEd25519PublicKey {
        PublicKeyPEM as DerivedPublicKeyPEM
        RawPublicKey as DerivedRawPublicKey
    } = derived
    if !bytes.ConstantTimeEqual(RawPublicKey, DerivedRawPublicKey) return false
    const convertedPublicKeyPEM = auth.OpenSSLEd25519PublicPEM(RawPublicKey) else {
        return false
    }
    if !bytes.ConstantTimeEqual(PublicKeyPEM, convertedPublicKeyPEM) return false
    const certificate = auth.OpenSSLEd25519Certificate(PrivateKeyPEM) else {
        return false
    }
    const certificateLength = certificate.Len() else { return false }
    if certificateLength == 0 return false
    var provider = auth.OpenSSLAsymmetricProvider {}
    const input = bytes.FromText("generated Ed25519 key")
    const signature = provider.Sign(.EdDSA, PrivateKeyPEM, input) else {
        return false
    }
    provider.Verify(.EdDSA, DerivedPublicKeyPEM, input, signature) else {
        return false
    }
    true
}

fn controlledTLSWorks() bool {
    const host = auth.GenerateOpenSSLEd25519() else { return false }
    const certificate = auth.OpenSSLEd25519Certificate(host.PrivateKeyPEM) else {
        return false
    }
    const listener = secureTLS.OpenSSLListen(
        $"127.0.0.1",
        0,
        $"foundation-test",
        certificate,
        host.PrivateKeyPEM,
        $"foundation-test/1"
    ) else { return false }
    const port = listener.Port
    const pin = host.RawPublicKey.Copy() else { return false }
    const source = concurrent.NewCancellationSource()
    const cancellation = source.Token()
    discard source
    const accepting = spawn secureTLS.OpenSSLAccept($listener)
    const dialing = spawn secureTLS.OpenSSLDialPinned(
        $"127.0.0.1",
        port,
        $pin,
        $"foundation-test/1",
        5000000000,
        $cancellation
    )
    const clientConnection = $dialing.wait() else { return false }
    const accepted = $accepting.wait()
    const secureTLS.OpenSSLAcceptOutcome { Listener Value } = accepted
    const serverConnection = Value else { return false }
    const client = clientConnection.SplitControlled() else { return false }
    const server = serverConnection.SplitControlled() else { return false }
    const secureTLS.OpenSSLControlledStream {
        Reader as clientReader
        Writer as clientWriter
        Controller as clientController
    } = client
    const secureTLS.OpenSSLControlledStream {
        Reader as serverReader
        Writer as serverWriter
        Controller as serverController
    } = server
    const readingClient = spawn secureTLS.OpenSSLReadExactBytes($clientReader, 6)
    const readingServer = spawn secureTLS.OpenSSLReadExactBytes($serverReader, 6)
    const writingClient = spawn secureTLS.OpenSSLWriteAllBytes(
        $clientWriter,
        $bytes.FromText("client")
    )
    const writingServer = spawn secureTLS.OpenSSLWriteAllBytes(
        $serverWriter,
        $bytes.FromText("server")
    )
    const clientWrite = $writingClient.wait()
    const serverWrite = $writingServer.wait()
    const clientRead = $readingClient.wait()
    const serverRead = $readingServer.wait()
    const secureTLS.OpenSSLWriteOutcome {
        Writer as restoredClientWriter
        Value as clientWriteValue
    } = clientWrite
    const secureTLS.OpenSSLWriteOutcome {
        Writer as restoredServerWriter
        Value as serverWriteValue
    } = serverWrite
    const secureTLS.OpenSSLReadOutcome {
        Reader as restoredClientReader
        Value as clientReadValue
    } = clientRead
    const secureTLS.OpenSSLReadOutcome {
        Reader as restoredServerReader
        Value as serverReadValue
    } = serverRead
    const clientWritten = validTLSWrite($clientWriteValue)
    const serverWritten = validTLSWrite($serverWriteValue)
    const clientReadOption = tlsBytes($clientReadValue)
    const serverReadOption = tlsBytes($serverReadValue)
    const clientBytes = match clientReadOption {
        Some(value): value
        None: { return false }
    }
    const serverBytes = match serverReadOption {
        Some(value): value
        None: { return false }
    }
    const clientText = clientBytes.Text() else { return false }
    const serverText = serverBytes.Text() else { return false }
    const result = clientWritten && serverWritten &&
        clientText == "server" && serverText == "client"
    discard restoredClientWriter
    discard restoredServerWriter
    discard restoredClientReader
    discard restoredServerReader
    discard clientController
    discard serverController
    discard Listener
    result
}

fn connectedTLSWorks() bool {
    const host = auth.GenerateOpenSSLEd25519() else { return false }
    const auth.OpenSSLEd25519KeyPair {
        PrivateKeyPEM
        PublicKeyPEM
        RawPublicKey
    } = host
    discard PublicKeyPEM
    const certificate = auth.OpenSSLEd25519Certificate(PrivateKeyPEM) else {
        return false
    }
    const listener = net.Listen("127.0.0.1", 0) else { return false }
    const port = listener.Port
    const accepting = spawn net.Accept($listener)
    const connecting = spawn net.Connect("127.0.0.1", port)
    const clientTransport = $connecting.wait() else { return false }
    const accepted = $accepting.wait()
    const net.AcceptOutcome { Listener Value } = accepted
    const serverTransport = Value else { return false }
    const source = concurrent.NewCancellationSource()
    const serverCancellation = source.Token()
    const clientCancellation = source.Token()
    discard source
    const pin = RawPublicKey.Copy() else { return false }
    discard RawPublicKey
    const serving = spawn secureTLS.OpenSSLAcceptOver(
        $serverTransport,
        $certificate,
        $PrivateKeyPEM,
        $"foundation-over/1",
        5000000000,
        $serverCancellation
    )
    const dialing = spawn secureTLS.OpenSSLConnectOverPinned(
        $clientTransport,
        $pin,
        $"foundation-over/1",
        5000000000,
        $clientCancellation
    )
    const client = $dialing.wait() else { return false }
    const server = $serving.wait() else { return false }
    const clientStream = client.Split() else { return false }
    const serverStream = server.Split() else { return false }
    const secureTLS.OpenSSLStreamPair {
        Reader as clientReader
        Writer as clientWriter
    } = clientStream
    const secureTLS.OpenSSLStreamPair {
        Reader as serverReader
        Writer as serverWriter
    } = serverStream
    const writing = spawn secureTLS.OpenSSLWriteAllBytes(
        $clientWriter,
        $bytes.FromText("over")
    )
    const reading = spawn secureTLS.OpenSSLReadExactBytes($serverReader, 4)
    const secureTLS.OpenSSLWriteOutcome {
        Writer as restoredClientWriter
        Value as written
    } = $writing.wait()
    const secureTLS.OpenSSLReadOutcome {
        Reader as restoredServerReader
        Value as received
    } = $reading.wait()
    const writeSucceeded = validTLSWrite($written)
    const payload = tlsBytes($received)
    const matches = match payload {
        Some(value): {
            const textValue = value.Text() else { return false }
            textValue == "over"
        }
        None: false
    }
    const success = writeSucceeded && matches
    discard restoredClientWriter
    discard restoredServerReader
    discard clientReader
    discard serverWriter
    discard Listener
    success
}

fn validTLSWrite($value Result<void, secureTLS.Error>) bool {
    match value {
        Ok: true
        Err(error): {
            discard error
            false
        }
    }
}

fn tlsBytes(
    $value Result<own bytes.Bytes, secureTLS.Error>
) Option<own bytes.Bytes> {
    match value {
        Ok(value): .Some(value)
        Err(error): {
            discard error
            .None
        }
    }
}

fn main() i32 {
    var asymmetric = auth.OpenSSLAsymmetricProvider {}
    const privateKey = bytes.FromText("not a private key")
    const signingInput = bytes.FromText("header.payload")
    if !invalidPrivateKey(asymmetric.Sign(.RS256, privateKey, signingInput)) {
        return 1
    }
    discard asymmetric

    const source = concurrent.NewCancellationSource()
    const cancellation = source.Token()
    source.Cancel()
    var tls = httpx.OpenSSLTLSProvider {}
    const pending = tls.SendWithCancellation(request(), $cancellation)
    const completed = $pending.wait()
    discard tls
    if !cancelledTLS($completed) return 2
    if !invalidServerCertificate() return 3
    if !generatedEd25519Works() return 4
    if !controlledTLSWorks() return 5
    if !connectedTLSWorks() return 6

    print("OpenSSL providers ok")
    0
}
