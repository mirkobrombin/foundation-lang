fn joiner($prefix String) fn($String) String {
    fn($suffix String) String capture $prefix {
        prefix + suffix
    }
}

struct CallbackBox {
    callback fn() String
}

enum CallbackChoice {
    Missing
    Ready(fn() String)
}

fn invokeRead(operation fn() String) String {
    operation()
}

fn double(value i32) i32 {
    value * 2
}

fn twice($operation fn(i32) i32) fn(i32) i32 {
    fn(value i32) i32 capture $operation {
        operation(operation(value))
    }
}

fn prefer<T>($value T, ignored T) T {
    value
}

fn keep<T>($captured T) fn($T) T {
    fn($value T) T capture $captured {
        prefer($value, captured)
    }
}

enum Branch {
    First
    Second
}

fn main() i32 {
    const factor = 2
    const scale = fn(value i32) i32 capture factor {
        value * factor
    }
    const base = 2
    const read = fn(value i32) i32 capture base {
        value + base
    }
    const borrowedLabel = "borrowed"
    const borrowedRead = fn() void capture borrowedLabel {
        discard len(borrowedLabel)
    }
    borrowedRead()

    var total = 0
    const bump = fn(value i32) i32 capture &total {
        total = total + value
        total
    }

    const label = "value"
    const render = fn($suffix String) void capture $label {
        print(label + suffix)
    }
    render("!")
    const join = joiner("left")
    const composed = twice($double)
    const keepText = keep("captured")
    const keptText = keepText("value")
    const directLabel = "direct"
    const directText = invokeRead(fn() String capture $directLabel {
        directLabel + ""
    })
    const boxedLabel = "boxed"
    const box = CallbackBox {
        callback = fn() String capture $boxedLabel {
            boxedLabel + ""
        }
    }
    const movedBox = box
    discard movedBox
    const selectedLabel = "selected"
    const choice = CallbackChoice.Ready(fn() String capture $selectedLabel {
        selectedLabel + ""
    })
    const selectedText = match choice {
        Missing: "missing"
        Ready(callback): callback()
    }
    var branchTotal = 0
    const selected = match Branch.First {
        First: fn(value i32) i32 capture &branchTotal {
            branchTotal = branchTotal + value
            branchTotal
        }
        Second: fn(value i32) i32 capture &branchTotal {
            branchTotal = branchTotal - value
            branchTotal
        }
    }
    if join("right") == "leftright" && keptText == "value" && directText == "direct" &&
        selectedText == "selected" {
        return scale(20) + bump(2) + read(0) + composed(21) + selected(2) - 130
    } else {
        return 1
    }
}
