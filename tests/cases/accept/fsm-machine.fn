import foundation.events
import foundation.fsm
import std.collections
import std.text
import std.time

state_machine Job {
    state Idle
    state Running(id i32)
    state Done(code i32)

    on Start(id i32) from Idle to Running(id)
    on Finish(code i32) from Running to Done(code)
}

enum Trigger {
    Start
    Finish
}

enum LogError {
    Rejected
}

enum MachineError {
    InvalidTransition
    GuardRejected
    EffectRejected
}

state_machine Doc {
    state Draft
    state Named(name String)

    on Name($name String) from Draft to Named(name)
}

state_machine Timer {
    state Waiting
    state Expired

    on Expire from Waiting to Expired after 1.nanoseconds
}

enum TimerTrigger {
    Expire
}

enum TimeoutOverlapState {
    First
    Second
    Shared
}

enum DocTrigger {
    Rename(name String)
}

fn cloneJob(value Job) Job {
    match value {
        Idle: .Idle
        Running(id): .Running(id = id)
        Done(code): .Done(code = code)
    }
}

fn cloneTrigger(value Trigger) Trigger {
    match value {
        Start: .Start
        Finish: .Finish
    }
}

fn cloneDoc(value Doc) Doc {
    match value {
        Draft: .Draft
        Named(name): .Named(name = text.Copy(name))
    }
}

fn cloneDocTrigger(value DocTrigger) DocTrigger {
    match value {
        Rename(name): .Rename(name = text.Copy(name))
    }
}

fn cloneTimer(value Timer) Timer {
    match value {
        Waiting: .Waiting
        Expired: .Expired
    }
}

fn cloneTimerTrigger(value TimerTrigger) TimerTrigger {
    match value {
        Expire: .Expire
    }
}

fn timerTimeout(value Timer) Option<u64> {
    Timer.TimeoutForExpire(value)
}

fn zeroTimerTimeout(value Timer) Option<u64> {
    match value {
        Waiting: .Some(0)
        Expired: .None
    }
}

fn cloneTimeoutOverlapState(value TimeoutOverlapState) TimeoutOverlapState {
    match value {
        First: .First
        Second: .Second
        Shared: .Shared
    }
}

fn firstOverlapTimeout(value TimeoutOverlapState) Option<u64> {
    match value {
        First: .Some(1)
        Second: .None
        Shared: .Some(1)
    }
}

fn secondOverlapTimeout(value TimeoutOverlapState) Option<u64> {
    match value {
        First: .None
        Second: .Some(1)
        Shared: .Some(1)
    }
}

fn changingTimeout(value TimeoutOverlapState) Option<u64> {
    match value {
        First: .Some(1)
        Second: .None
        Shared: .Some(2)
    }
}

fn timeoutOverlapCode(value TimeoutOverlapState) i32 {
    match value {
        First: 1
        Second: 2
        Shared: 3
    }
}

fn rejectOverlapTimeout(
    &value TimeoutOverlapState
) Result<void, MachineError> {
    discard value
    .Err(.InvalidTransition)
}

fn expireTimer(&value Timer) Result<void, TimerTransitionError> {
    value.Expire()
}

fn start(&job Job) Result<void, MachineError> {
    job.Start(7) else error {
        discard error
        return .Err(.InvalidTransition)
    }
    .Ok
}

fn finish(&job Job) Result<void, MachineError> {
    job.Finish(0) else error {
        discard error
        return .Err(.InvalidTransition)
    }
    .Ok
}

fn mutateThenReject(&job Job) Result<void, MachineError> {
    job.Start(99) else error {
        discard error
        return .Err(.InvalidTransition)
    }
    .Err(.InvalidTransition)
}

fn nameDoc(
    &document Doc
) Result<void, DocTransitionError> {
    var name = text.Copy("profile")
    document.Name($name)
}

fn reject(event fsm.Event<Job, Trigger>) Result<void, LogError> {
    discard event
    .Err(.Rejected)
}

fn rejectCandidate(
    event fsm.GuardEvent<Job, Trigger>
) Result<void, MachineError> {
    const fsm.GuardEvent { From To Trigger } = event
    if stateCode($From) == 0 && stateCode($To) == 7 &&
        triggerCode(Trigger) == 1 {
        return .Err(.GuardRejected)
    }
    .Err(.InvalidTransition)
}

fn shouldNotRunGuard(
    event fsm.GuardEvent<Job, Trigger>
) Result<void, MachineError> {
    discard event
    panic("guard fail-fast invariant failed")
}

fn rejectEffect(
    event fsm.Event<Job, Trigger>
) Result<void, MachineError> {
    discard event
    .Err(.EffectRejected)
}

fn shouldNotRunEffect(
    event fsm.Event<Job, Trigger>
) Result<void, MachineError> {
    discard event
    panic("effect stop invariant failed")
}

fn requiredFailure<E>(
    $value Option<fsm.ListenerFailure<E>>
) fsm.ListenerFailure<E> {
    match value {
        None: panic("missing listener failure")
        Some(failure): failure
    }
}

fn requiredEffectFailure<E>(
    $value Option<fsm.EffectFailure<E>>
) fsm.EffectFailure<E> {
    match value {
        None: panic("missing effect failure")
        Some(failure): failure
    }
}

fn requiredMachineError(
    $value Option<MachineError>
) MachineError {
    match value {
        None: panic("missing machine error")
        Some(error): error
    }
}

fn isEffectRejected(error MachineError) bool {
    match error {
        InvalidTransition: false
        GuardRejected: false
        EffectRejected: true
    }
}

fn machineErrorsMatch(
    $error events.PublishError<MachineError>,
    expected i32,
    failFast bool
) bool {
    match error {
        Reentrant: false
        Handler(error): failFast && expected == 1 && isEffectRejected(error)
        Handlers(errors): {
            if failFast return false
            var pending = errors
            if pending.Len() != expected return false
            while !pending.IsEmpty() {
                if !isEffectRejected(requiredMachineError(pending.PopFront())) {
                    return false
                }
            }
            true
        }
    }
}

fn effectFailureMatches(
    $failure fsm.EffectFailure<MachineError>,
    phase i32,
    expected i32,
    failFast bool
) bool {
    const fsm.EffectFailure { Type Error } = failure
    phaseCode(Type) == phase && machineErrorsMatch($Error, expected, failFast)
}

fn requiredListenerError(
    $value Option<LogError>
) LogError {
    match value {
        None: panic("missing listener error")
        Some(error): error
    }
}

fn listenerErrorMatches(
    $error events.PublishError<LogError>
) bool {
    match error {
        Reentrant: false
        Handler(error): {
            discard error
            false
        }
        Handlers(errors): {
            var pending = errors
            if pending.Len() != 1 return false
            const item = requiredListenerError(pending.PopFront())
            const matched = match item {
                Rejected: true
            }
            matched && pending.IsEmpty()
        }
    }
}

fn phaseCode(kind fsm.EventType) i32 {
    match kind {
        BeforeTransition: 1
        ExitState: 2
        EnterState: 3
        AfterTransition: 4
    }
}

fn expectFailure(
    $failure fsm.ListenerFailure<LogError>,
    expected i32
) bool {
    const fsm.ListenerFailure { Type Error } = failure
    phaseCode(Type) == expected && listenerErrorMatches($Error)
}

fn expectListenerFailures(
    $errors own collections.List<fsm.ListenerFailure<LogError>>
) bool {
    var pending = errors
    if pending.Len() != 4 return false
    if !expectFailure(requiredFailure(pending.PopFront()), 1) return false
    if !expectFailure(requiredFailure(pending.PopFront()), 2) return false
    if !expectFailure(requiredFailure(pending.PopFront()), 3) return false
    if !expectFailure(requiredFailure(pending.PopFront()), 4) return false
    pending.IsEmpty()
}

fn docStateName($value Doc) String {
    match value {
        Draft: ""
        Named(name): name
    }
}

fn docTriggerName($value DocTrigger) String {
    match value {
        Rename(name): name
    }
}

fn requiredDocRecord(
    $value Option<fsm.Record<Doc, DocTrigger>>
) fsm.Record<Doc, DocTrigger> {
    match value {
        None: panic("missing document history record")
        Some(record): record
    }
}

fn ownedSnapshots() bool {
    var initial Doc = .Draft
    var machine = fsm.New<Doc, DocTrigger, DocTransitionError, LogError>(
        $initial,
        $cloneDoc,
        $cloneDocTrigger
    )
    const renamed = machine.Apply(
        .Rename(name = "manual"),
        $nameDoc
    )
    match renamed {
        Ok(report): {
            if !report.IsClean() return false
        }
        Err(error): {
            discard error
            return false
        }
    }

    if docStateName($machine.Snapshot()) != "profile" return false
    var history = machine.History()
    if history.Len() != 1 return false
    const record = requiredDocRecord(history.PopFront())
    const fsm.Record { From To Trigger Timestamp } = record
    discard Timestamp
    if docStateName($From) != "" return false
    if docStateName($To) != "profile" return false
    if docTriggerName($Trigger) != "manual" return false
    if !history.IsEmpty() return false
    docStateName($machine.Snapshot()) == "profile"
}

fn expectCommitted(
    $result Result<own fsm.ApplyReport<MachineError, LogError>, fsm.ApplyError<MachineError>>
) bool {
    match result {
        Ok(report): {
            const fsm.ApplyReport { EffectFailures ListenerFailures } = report
            if !EffectFailures.IsEmpty() return false
            discard EffectFailures
            expectListenerFailures($ListenerFailures)
        }
        Err(error): match error {
            Transition(error): {
                discard error
                false
            }
            Guard(error): {
                discard error
                false
            }
            Clock(error): {
                discard error
                false
            }
            InvalidTimeout: false
            OverlappingTimeout: false
        }
    }
}

fn expectRejected(
    $result Result<own fsm.ApplyReport<MachineError, LogError>, fsm.ApplyError<MachineError>>
) bool {
    match result {
        Ok(report): {
            discard report
            false
        }
        Err(error): match error {
            Transition(error): match error {
                InvalidTransition: true
                GuardRejected: false
                EffectRejected: false
            }
            Guard(error): {
                discard error
                false
            }
            Clock(error): {
                discard error
                false
            }
            InvalidTimeout: false
            OverlappingTimeout: false
        }
    }
}

fn guardErrorMatches(
    $error events.PublishError<MachineError>
) bool {
    match error {
        Reentrant: false
        Handler(error): match error {
            InvalidTransition: false
            GuardRejected: true
            EffectRejected: false
        }
        Handlers(errors): {
            discard errors
            false
        }
    }
}

fn expectGuardRejected(
    $result Result<own fsm.ApplyReport<MachineError, LogError>, fsm.ApplyError<MachineError>>
) bool {
    match result {
        Ok(report): {
            discard report
            false
        }
        Err(error): match error {
            Transition(error): {
                discard error
                false
            }
            Guard(error): guardErrorMatches($error)
            Clock(error): {
                discard error
                false
            }
            InvalidTimeout: false
            OverlappingTimeout: false
        }
    }
}

fn expectBestEffortReport(
    $result Result<own fsm.ApplyReport<MachineError, LogError>, fsm.ApplyError<MachineError>>
) bool {
    match result {
        Ok(report): {
            const fsm.ApplyReport { EffectFailures ListenerFailures } = report
            var effects = EffectFailures
            if effects.Len() != 2 return false
            if !effectFailureMatches(
                requiredEffectFailure(effects.PopFront()),
                2,
                2,
                false
            ) {
                return false
            }
            if !effectFailureMatches(
                requiredEffectFailure(effects.PopFront()),
                3,
                1,
                false
            ) {
                return false
            }
            if !effects.IsEmpty() return false
            expectListenerFailures($ListenerFailures)
        }
        Err(error): {
            discard error
            false
        }
    }
}

fn expectStoppedEffectReport(
    $result Result<own fsm.ApplyReport<MachineError, LogError>, fsm.ApplyError<MachineError>>
) bool {
    match result {
        Ok(report): {
            const fsm.ApplyReport { EffectFailures ListenerFailures } = report
            if !ListenerFailures.IsEmpty() return false
            discard ListenerFailures
            var effects = EffectFailures
            if effects.Len() != 1 return false
            if !effectFailureMatches(
                requiredEffectFailure(effects.PopFront()),
                2,
                1,
                true
            ) {
                return false
            }
            effects.IsEmpty()
        }
        Err(error): {
            discard error
            false
        }
    }
}

fn guardedRejection() bool {
    var initial Job = .Idle
    var machine = fsm.New<Job, Trigger, MachineError, LogError>(
        $initial,
        $cloneJob,
        $cloneTrigger
    )
    machine.Guard($rejectCandidate, events.Priority.High) else error {
        discard error
        return false
    }
    machine.Guard($shouldNotRunGuard, events.Priority.Low) else error {
        discard error
        return false
    }
    if !expectGuardRejected($machine.Apply(.Start, $start)) return false
    stateCode($machine.Snapshot()) == 0 && machine.HistoryLen() == 0
}

fn bestEffortEffects() bool {
    var initial Job = .Idle
    var machine = fsm.New<Job, Trigger, MachineError, LogError>(
        $initial,
        $cloneJob,
        $cloneTrigger
    )
    machine.OnExit($rejectEffect, events.Priority.High) else error {
        discard error
        return false
    }
    machine.OnExit($rejectEffect, events.Priority.Low) else error {
        discard error
        return false
    }
    machine.OnEnter($rejectEffect, events.Priority.Normal) else error {
        discard error
        return false
    }
    machine.Subscribe($reject, events.Priority.Normal) else error {
        discard error
        return false
    }
    if !expectBestEffortReport($machine.Apply(.Start, $start)) return false
    stateCode($machine.Snapshot()) == 7 && machine.HistoryLen() == 1
}

fn stoppedEffects() bool {
    var initial Job = .Idle
    var machine = fsm.NewWithEffectPolicy<Job, Trigger, MachineError, LogError>(
        $initial,
        $cloneJob,
        $cloneTrigger,
        .StopOnFirstError
    )
    machine.OnExit($rejectEffect, events.Priority.High) else error {
        discard error
        return false
    }
    machine.OnExit($shouldNotRunEffect, events.Priority.Low) else error {
        discard error
        return false
    }
    machine.OnEnter($shouldNotRunEffect, events.Priority.High) else error {
        discard error
        return false
    }
    if !expectStoppedEffectReport($machine.Apply(.Start, $start)) return false
    stateCode($machine.Snapshot()) == 7 && machine.HistoryLen() == 1
}

fn stateCode($value Job) i32 {
    match value {
        Idle: 0
        Running(id): id
        Done(code): 100 + code
    }
}

fn triggerCode(value Trigger) i32 {
    match value {
        Start: 1
        Finish: 2
    }
}

fn requiredRecord(
    $value Option<fsm.Record<Job, Trigger>>
) fsm.Record<Job, Trigger> {
    match value {
        None: panic("missing history record")
        Some(record): record
    }
}

fn recordMatches(
    $record fsm.Record<Job, Trigger>,
    from i32,
    to i32,
    trigger i32
) bool {
    const fsm.Record { From To Trigger Timestamp } = record
    const recent = Timestamp.Unix() <= time.Now().Unix()
    stateCode($From) == from && stateCode($To) == to &&
        triggerCode(Trigger) == trigger && recent
}

fn expectHistory(
    &machine fsm.Machine<Job, Trigger, MachineError, LogError>
) bool {
    var history = machine.History()
    if history.Len() != 2 return false
    if !recordMatches(requiredRecord(history.PopFront()), 0, 7, 1) return false
    if !recordMatches(requiredRecord(history.PopFront()), 7, 100, 2) return false
    if !history.IsEmpty() return false
    machine.HistoryLen() == 2
}

fn requireDuration(
    $value Result<time.Duration, time.DurationError>
) time.Duration {
    match value {
        Ok(duration): duration
        Err(error): {
            discard error
            panic("duration parsing failed")
        }
    }
}

fn timeoutRejected(
    &machine fsm.Machine<Job, Trigger, MachineError, LogError>,
    duration time.Duration
) bool {
    const checked = machine.CheckTimeout(duration, .Finish, $finish)
    match checked {
        Ok(expired): {
            discard expired
            false
        }
        Err(error): match error {
            Transition(error): {
                discard error
                false
            }
            Guard(error): {
                discard error
                false
            }
            Clock(error): {
                discard error
                false
            }
            InvalidTimeout: true
            OverlappingTimeout: false
        }
    }
}

fn invalidTimeout(
    &machine fsm.Machine<Job, Trigger, MachineError, LogError>
) bool {
    if !timeoutRejected(&machine, time.Zero()) return false
    const negative = requireDuration($time.Duration.Parse("-1ns"))
    timeoutRejected(&machine, negative)
}

fn futureTimeout(
    &machine fsm.Machine<Job, Trigger, MachineError, LogError>
) bool {
    const checked = machine.CheckTimeout(time.Seconds(60), .Finish, $finish)
    match checked {
        Ok(result): match result {
            Pending: true
            Applied(report): {
                discard report
                false
            }
        }
        Err(error): {
            discard error
            false
        }
    }
}

fn expiredTimeout() bool {
    var initial Job = .Idle
    var machine = fsm.New<Job, Trigger, MachineError, LogError>(
        $initial,
        $cloneJob,
        $cloneTrigger
    )
    const started = machine.Apply(.Start, $start)
    match started {
        Ok(report): {
            if !report.IsClean() return false
        }
        Err(error): {
            discard error
            return false
        }
    }

    var elapsedNanoseconds i64 = 0
    while elapsedNanoseconds == 0 {
        const elapsed = machine.Elapsed() else error {
            discard error
            return false
        }
        elapsedNanoseconds = elapsed.Nanoseconds()
    }

    const checked = machine.CheckTimeout(
        time.Nanoseconds(1),
        .Finish,
        $finish
    )
    match checked {
        Ok(result): match result {
            Pending: false
            Applied(report): {
                const clean = report.IsClean()
                clean && stateCode($machine.Snapshot()) == 100 &&
                    machine.HistoryLen() == 2
            }
        }
        Err(error): {
            discard error
            false
        }
    }
}

fn timeoutRegistrationAccepted(
    $value Result<void, fsm.TimeoutRegistrationError>
) bool {
    match value {
        Ok: true
        Err(error): {
            discard error
            false
        }
    }
}

fn timeoutRegistrationRejected(
    $value Result<void, fsm.TimeoutRegistrationError>,
    expected i32
) bool {
    match value {
        Ok: false
        Err(error): match error {
            SourceNotCovered: expected == 1
            DuplicateSource: expected == 2
            InvalidTimeout: expected == 3
        }
    }
}

fn requiredTimeoutRule<S, G>(
    $value Option<fsm.TimeoutRule<S, G>>
) fsm.TimeoutRule<S, G> {
    match value {
        None: panic("missing timeout rule")
        Some(rule): rule
    }
}

fn timerIsWaiting(value Timer) bool {
    match value {
        Waiting: true
        Expired: false
    }
}

fn timerIsExpired(value Timer) bool {
    match value {
        Waiting: false
        Expired: true
    }
}

fn timerTriggerIsExpire(value TimerTrigger) bool {
    match value {
        Expire: true
    }
}

fn declarativeTimeout() bool {
    var initial Timer = .Waiting
    var machine = fsm.New<Timer, TimerTrigger, TimerTransitionError, LogError>(
        $initial,
        $cloneTimer,
        $cloneTimerTrigger
    )
    const unbound = machine.CheckTimeouts()
    match unbound {
        Ok(result): match result {
            NoRule: unboundTimeoutSucceeded()
            Pending: {
                return false
            }
            Applied(report): {
                discard report
                return false
            }
        }
        Err(error): {
            discard error
            return false
        }
    }
    if !timeoutRegistrationRejected(
        $machine.BindTimeout(.Expired, .Expire, $timerTimeout, $expireTimer),
        1
    ) {
        return false
    }
    if !timeoutRegistrationRejected(
        $machine.BindTimeout(
            .Waiting,
            .Expire,
            $zeroTimerTimeout,
            $expireTimer
        ),
        3
    ) {
        return false
    }
    if !timeoutRegistrationAccepted(
        $machine.BindTimeout(.Waiting, .Expire, $timerTimeout, $expireTimer)
    ) {
        return false
    }
    if !timeoutRegistrationRejected(
        $machine.BindTimeout(.Waiting, .Expire, $timerTimeout, $expireTimer),
        2
    ) {
        return false
    }

    var rules = machine.TimeoutRules()
    if rules.Len() != 1 return false
    const rule = requiredTimeoutRule(rules.PopFront())
    const fsm.TimeoutRule { Source Trigger Duration } = rule
    if !timerIsWaiting(Source) return false
    if !timerTriggerIsExpire(Trigger) return false
    if Duration.Nanoseconds() != 1 return false
    if !rules.IsEmpty() return false

    var applied = false
    while !applied {
        const checked = machine.CheckTimeouts()
        match checked {
            Ok(result): match result {
                NoRule: {
                    return false
                }
                Pending: {
                    applied = false
                }
                Applied(report): {
                    if !report.IsClean() return false
                    applied = true
                }
            }
            Err(error): {
                discard error
                return false
            }
        }
    }
    if !timerIsExpired(machine.Snapshot()) return false
    if machine.HistoryLen() != 1 return false
    const finished = machine.CheckTimeouts()
    match finished {
        Ok(result): match result {
            NoRule: true
            Pending: false
            Applied(report): {
                discard report
                false
            }
        }
        Err(error): {
            discard error
            false
        }
    }
}

fn overlappingTimeoutRejected() bool {
    var initial TimeoutOverlapState = .Shared
    var machine = fsm.New<TimeoutOverlapState, Trigger, MachineError, LogError>(
        $initial,
        $cloneTimeoutOverlapState,
        $cloneTrigger
    )
    if !timeoutRegistrationAccepted(
        $machine.BindTimeout(
            .First,
            .Finish,
            $firstOverlapTimeout,
            $rejectOverlapTimeout
        )
    ) {
        return false
    }
    if !timeoutRegistrationAccepted(
        $machine.BindTimeout(
            .Second,
            .Finish,
            $secondOverlapTimeout,
            $rejectOverlapTimeout
        )
    ) {
        return false
    }

    const checked = machine.CheckTimeouts()
    const rejected = match checked {
        Ok(result): {
            discard result
            false
        }
        Err(error): match error {
            Transition(error): {
                discard error
                false
            }
            Guard(error): {
                discard error
                false
            }
            Clock(error): {
                discard error
                false
            }
            InvalidTimeout: false
            OverlappingTimeout: true
        }
    }
    if !rejected return false

    var rules = machine.TimeoutRules()
    if rules.Len() != 2 return false
    const first = requiredTimeoutRule(rules.PopFront())
    const second = requiredTimeoutRule(rules.PopFront())
    if timeoutOverlapCode(first.Source) != 1 return false
    if timeoutOverlapCode(second.Source) != 2 return false
    rules.IsEmpty()
}

fn changingTimeoutRejected() bool {
    var initial TimeoutOverlapState = .Shared
    var machine = fsm.New<TimeoutOverlapState, Trigger, MachineError, LogError>(
        $initial,
        $cloneTimeoutOverlapState,
        $cloneTrigger
    )
    if !timeoutRegistrationAccepted(
        $machine.BindTimeout(
            .First,
            .Finish,
            $changingTimeout,
            $rejectOverlapTimeout
        )
    ) {
        return false
    }

    const checked = machine.CheckTimeouts()
    match checked {
        Ok(result): {
            discard result
            false
        }
        Err(error): match error {
            Transition(error): {
                discard error
                false
            }
            Guard(error): {
                discard error
                false
            }
            Clock(error): {
                discard error
                false
            }
            InvalidTimeout: true
            OverlappingTimeout: false
        }
    }
}

fn unboundTimeoutSucceeded() void {
    return
}

fn main() i32 {
    var initial Job = .Idle
    var machine = fsm.New<Job, Trigger, MachineError, LogError>(
        $initial,
        $cloneJob,
        $cloneTrigger
    )
    machine.Subscribe($reject, events.Priority.Normal) else error {
        discard error
        return 1
    }

    if !expectRejected($machine.Apply(.Start, $mutateThenReject)) return 2
    if stateCode($machine.Snapshot()) != 0 return 3
    if machine.HistoryLen() != 0 return 4

    if !expectCommitted($machine.Apply(.Start, $start)) return 5
    if stateCode($machine.Snapshot()) != 7 return 6
    if machine.HistoryLen() != 1 return 7

    if !expectCommitted($machine.Apply(.Finish, $finish)) return 8
    if stateCode($machine.Snapshot()) != 100 return 9
    if !expectHistory(&machine) return 10

    if !expectRejected($machine.Apply(.Start, $start)) return 11
    if machine.HistoryLen() != 2 return 12
    if !invalidTimeout(&machine) return 13
    if !futureTimeout(&machine) return 14
    const elapsed = machine.Elapsed() else error {
        discard error
        return 15
    }
    discard elapsed
    if !ownedSnapshots() return 16
    if !expiredTimeout() return 17
    if !guardedRejection() return 18
    if !bestEffortEffects() return 19
    if !stoppedEffects() return 20
    if !declarativeTimeout() return 21
    if !overlappingTimeoutRejected() return 22
    if !changingTimeoutRejected() return 23
    print("fsm machine ok")
    0
}
