contract Named<T> {
    fn value(self) T
}

contract Tagged<T> extends Named<T> {
    fn tag(self) i32
}

contract Audited<T> extends Named<T> {
    fn audited(self) bool
}

contract Principal<T> extends Tagged<T>, Audited<T> {}

contract Scored {
    fn score(self) i32

    fn doubled(self) i32 {
        self.score() * 2
    }
}

contract Echo<T> {
    fn current(self) T

    fn fallback(self, $candidate T) T {
        discard self.current()
        candidate
    }
}

contract RemappedDefault<A, B> {
    fn first(self, $left A, $right B) A {
        discard right
        left
    }
}

contract IntegerDefault<T> extends RemappedDefault<i32, T> {}

contract LeftValue {
    fn left(self) i32
}

contract RightValue {
    fn right(self) i32

    fn rightPlusOne(self) i32 {
        self.right() + 1
    }
}

contract CombinedValue extends LeftValue, RightValue {}

contract Accumulator {
    fn add(&self, amount i32) void

    fn addTwice(&self, amount i32) void {
        self.add(amount)
        self.add(amount)
    }
}

contract Consumable {
    fn value(self) i32
    fn add(&self, amount i32) void
    fn take($self) i32
}

contract OwnedValue<T> {
    fn takeValue($self) T
}

struct Entry implements Principal<i32> {
    stored i32

    fn value(self) i32 { self.stored }
    fn tag(self) i32 { 2 }
    fn audited(self) bool { true }
}

struct Identity implements Named<i32> {
    stored i32

    fn value(self) i32 { self.stored }
}

struct DelegatedEntry implements Named<i32> {
    identity Identity

    delegate identity as Named<i32>
}

struct NestedEntry implements Named<i32> {
    entry DelegatedEntry

    delegate entry as Named<i32>
}

struct OverriddenEntry implements Named<i32> {
    identity Identity

    delegate identity as Named<i32>

    fn value(self) i32 { self.identity.stored + 2 }
}

struct Metric implements Scored {
    stored i32

    fn score(self) i32 { self.stored }
}

struct CustomMetric implements Scored {
    stored i32

    fn score(self) i32 { self.stored }
    fn doubled(self) i32 { self.stored + 2 }
}

struct MetricWrapper implements Scored {
    inner Metric

    delegate inner as Scored
}

struct Number implements Echo<i32> {
    stored i32

    fn current(self) i32 { self.stored }
}

struct RemappedNumber implements IntegerDefault<bool> {}

struct CombinedNumber implements CombinedValue {
    fn left(self) i32 { 1 }
    fn right(self) i32 { 41 }
}

struct CombinedWrapper implements CombinedValue {
    inner CombinedNumber

    delegate inner as CombinedValue
}

struct Counter implements Accumulator {
    value i32

    fn add(&self, amount i32) void {
        self.value = self.value + amount
    }
}

struct Resource implements Consumable {
    stored i32

    fn value(self) i32 { self.stored }

    fn add(&self, amount i32) void {
        self.stored = self.stored + amount
    }

    fn take($self) i32 { self.stored }

    fn drop(&self) void {
        print("resource dropped")
    }
}

struct OwnedNumber implements OwnedValue<i32> {
    stored i32

    fn takeValue($self) i32 { self.stored }
}

struct ResourceHolder {
    resource own Consumable
}

fn readNamed(value Named<i32>) i32 {
    value.value()
}

fn readDoubled(value Scored) i32 {
    value.doubled()
}

fn useFallback(value Echo<i32>) i32 {
    value.fallback(42)
}

fn addTwice(&value Accumulator, amount i32) void {
    value.addTwice(amount)
}

fn makeResource(value i32) own Consumable {
    own Resource { stored = value }
}

fn makeCombined() own CombinedValue {
    own CombinedWrapper { inner = CombinedNumber {} }
}

fn readResource(value Consumable) i32 {
    value.value()
}

fn editResource(&value Consumable, amount i32) void {
    value.add(amount)
}

fn consumeValue<T>($value own OwnedValue<T>, $fallback T) T {
    discard fallback
    value.takeValue()
}

fn takeResource($holder own ResourceHolder) own Consumable {
    const ResourceHolder { resource } = holder
    resource
}

fn main() i32 {
    const entry = Entry { stored = 40 }
    const total = readNamed(entry) + entry.tag()
    const metric = Metric { stored = 20 }
    const custom = CustomMetric { stored = 40 }
    const delegated = DelegatedEntry { identity = Identity { stored = 42 } }
    const nested = NestedEntry { entry = delegated }
    const overridden = OverriddenEntry { identity = Identity { stored = 40 } }
    const wrapped = MetricWrapper { inner = metric }
    const number = Number { stored = 1 }
    const remapped = RemappedNumber {}
    const combined = CombinedNumber {}
    const combinedWrapper = CombinedWrapper { inner = combined }
    const dynamicCombined = makeCombined()
    var counter = Counter { value = 40 }
    addTwice(&counter, 1)
    var resource = makeResource(40)
    const resourceBefore = readResource(resource)
    resource.add(1)
    editResource(&resource, 1)
    const resourceValue = resource.take()
    discard makeResource(1)
    const ownedValue = consumeValue(own OwnedNumber { stored = 42 }, 0)
    const holder = own ResourceHolder { resource = makeResource(1) }
    const heldResource = takeResource($holder)
    discard heldResource
    if total == 42 && entry.audited() && readNamed(nested) == 42 && readNamed(overridden) == 42 && metric.doubled() == 40 && readDoubled(wrapped) == 40 && readDoubled(custom) == 42 && useFallback(number) == 42 && remapped.first(42, true) == 42 && combined.rightPlusOne() == 42 && combinedWrapper.rightPlusOne() == 42 && dynamicCombined.rightPlusOne() == 42 && counter.value == 42 && resourceBefore == 40 && resourceValue == 42 && ownedValue == 42 {
        print("contract inheritance works")
        return 0
    }
    1
}
