import foundation.secrets
import std.bytes
import std.text

struct FailingStore implements secrets.Store {
    fn Clone(self) own secrets.Store {
        own FailingStore {}
    }

    fn Set(
        self,
        $key String,
        $value own bytes.Bytes
    ) Task<Result<void, secrets.Error>> {
        spawn failSet($key, $value)
    }

    fn Get(self, $key String) Task<Result<own bytes.Bytes, secrets.Error>> {
        spawn failGet($key)
    }

    fn Delete(self, $key String) Task<Result<void, secrets.Error>> {
        spawn failDelete($key)
    }
}

struct FakeVaultTransport implements secrets.VaultTransport {
    fn Clone(self) own secrets.VaultTransport {
        own FakeVaultTransport {}
    }

    fn Send(
        self,
        $request secrets.VaultRequest
    ) Task<Result<secrets.VaultResponse, secrets.Error>> {
        spawn sendVault($request)
    }
}

task failSet(
    $key String,
    $value own bytes.Bytes
) Result<void, secrets.Error> {
    discard key
    discard value
    .Err(.Transport)
}

task failGet($key String) Result<own bytes.Bytes, secrets.Error> {
    discard key
    .Err(.Transport)
}

task failDelete($key String) Result<void, secrets.Error> {
    discard key
    .Err(.Transport)
}

task sendVault(
    $request secrets.VaultRequest
) Result<secrets.VaultResponse, secrets.Error> {
    const secrets.VaultRequest {
        Method
        Address
        Path
        Token
        Body
        MaximumResponseSize
        FollowRedirects
    } = request
    if Address != "http://127.0.0.1:8200" || Token != "token" ||
        MaximumResponseSize != 1048576 || FollowRedirects {
        discard Address
        discard Path
        discard Token
        discard Body
        return .Err(.Protocol)
    }
    discard Address
    discard Token
    if Path == "/v1/secret/data/missing" {
        discard Path
        discard Body
        return .Ok(secrets.VaultResponse { Status = 404 Body = "" })
    }
    if Path == "/v1/secret/data/malformed" {
        discard Path
        discard Body
        return .Ok(secrets.VaultResponse {
            Status = 200
            Body = "{\"data\":{\"data\":{\"value\":\"invalid*\"}}}"
        })
    }
    if Path == "/v1/secret/data/cancelled" {
        discard Path
        discard Body
        return .Err(.Cancelled)
    }
    if Path == "/v1/secret/data/oversized" {
        discard Path
        discard Body
        return .Ok(secrets.VaultResponse { Status = 200 Body = oversizedBody() })
    }
    if Path != "/v1/secret/data/app/db" {
        discard Path
        discard Body
        return .Err(.Protocol)
    }
    discard Path
    match Method {
        Put: {
            if Body != "{\"data\":{\"value\":\"cGFzc3dvcmQ=\"}}" {
                discard Body
                return .Err(.Protocol)
            }
            discard Body
            .Ok(secrets.VaultResponse { Status = 204 Body = "" })
        }
        Get: {
            if !text.IsEmpty(Body) {
                discard Body
                return .Err(.Protocol)
            }
            discard Body
            .Ok(secrets.VaultResponse {
                Status = 200
                Body = "{\"request_id\":\"fixture\",\"data\":{\"data\":{\"value\":\"cGFzc3dvcmQ=\",\"version\":\"current\"},\"metadata\":{\"version\":1}}}"
            })
        }
        Delete: {
            if !text.IsEmpty(Body) {
                discard Body
                return .Err(.Protocol)
            }
            discard Body
            .Ok(secrets.VaultResponse { Status = 204 Body = "" })
        }
    }
}

fn oversizedBody() String {
    var body = "x"
    var exponent = 0
    while exponent < 20 {
        body = body + body
        exponent = exponent + 1
    }
    body + "x"
}

fn expect($result Result<void, secrets.Error>) void {
    match result {
        Ok: {}
        Err(error): {
            discard error
            panic("unexpected secret store error")
        }
    }
}

fn takeBytes(
    $result Result<own bytes.Bytes, secrets.Error>
) own bytes.Bytes {
    match result {
        Ok(secret): secret
        Err(error): {
            discard error
            panic("secret value missing")
        }
    }
}

fn takeText($result Result<own bytes.Bytes, secrets.Error>) String {
    const value = takeBytes($result)
    const content = value.Text() else error {
        discard value
        discard error
        panic("secret value is not text")
    }
    discard value
    content
}

fn isNotFound($result Result<own bytes.Bytes, secrets.Error>) bool {
    match result {
        Ok(value): {
            discard value
            false
        }
        Err(error): errorIsNotFound(error)
    }
}

fn errorIsNotFound(error secrets.Error) bool {
    match error {
        NotFound: true
        ReadOnly: false
        NotConfigured: false
        InvalidKey: false
        InvalidCipherKey: false
        AuthenticationFailed: false
        InsecureAddress: false
        TooLarge: false
        Closed: false
        Cancelled: false
        Permission: false
        Transport: false
        Protocol: false
        Io: false
    }
}

fn isReadOnly($result Result<void, secrets.Error>) bool {
    match result {
        Ok: false
        Err(error): match error {
            ReadOnly: true
            NotFound: false
            NotConfigured: false
            InvalidKey: false
            InvalidCipherKey: false
            AuthenticationFailed: false
            InsecureAddress: false
            TooLarge: false
            Closed: false
            Cancelled: false
            Permission: false
            Transport: false
            Protocol: false
            Io: false
        }
    }
}

fn isAuthenticationFailure(
    $result Result<own bytes.Bytes, secrets.Error>
) bool {
    match result {
        Ok(value): {
            discard value
            false
        }
        Err(error): match error {
            AuthenticationFailed: true
            NotFound: false
            ReadOnly: false
            NotConfigured: false
            InvalidKey: false
            InvalidCipherKey: false
            InsecureAddress: false
            TooLarge: false
            Closed: false
            Cancelled: false
            Permission: false
            Transport: false
            Protocol: false
            Io: false
        }
    }
}

fn isTransportFailure(
    $result Result<own bytes.Bytes, secrets.Error>
) bool {
    match result {
        Ok(value): {
            discard value
            false
        }
        Err(error): match error {
            Transport: true
            NotFound: false
            ReadOnly: false
            NotConfigured: false
            InvalidKey: false
            InvalidCipherKey: false
            AuthenticationFailed: false
            InsecureAddress: false
            TooLarge: false
            Closed: false
            Cancelled: false
            Permission: false
            Protocol: false
            Io: false
        }
    }
}

fn invalidAddress(
    $result Result<own secrets.VaultStore, secrets.Error>
) bool {
    match result {
        Ok(store): {
            discard store
            false
        }
        Err(error): match error {
            InsecureAddress: true
            NotFound: false
            ReadOnly: false
            NotConfigured: false
            InvalidKey: false
            InvalidCipherKey: false
            AuthenticationFailed: false
            TooLarge: false
            Closed: false
            Cancelled: false
            Permission: false
            Transport: false
            Protocol: false
            Io: false
        }
    }
}

fn validAddress(
    $result Result<own secrets.VaultStore, secrets.Error>
) bool {
    match result {
        Ok(store): {
            discard store
            true
        }
        Err(error): {
            discard error
            false
        }
    }
}

fn invalidCipherKey(
    $result Result<own secrets.CipherStore, secrets.Error>
) bool {
    match result {
        Ok(store): {
            discard store
            false
        }
        Err(error): match error {
            InvalidCipherKey: true
            NotFound: false
            ReadOnly: false
            NotConfigured: false
            InvalidKey: false
            AuthenticationFailed: false
            InsecureAddress: false
            TooLarge: false
            Closed: false
            Cancelled: false
            Permission: false
            Transport: false
            Protocol: false
            Io: false
        }
    }
}

fn isProtocolFailure(
    $result Result<own bytes.Bytes, secrets.Error>
) bool {
    match result {
        Ok(value): {
            discard value
            false
        }
        Err(error): match error {
            Protocol: true
            NotFound: false
            ReadOnly: false
            NotConfigured: false
            InvalidKey: false
            InvalidCipherKey: false
            AuthenticationFailed: false
            InsecureAddress: false
            TooLarge: false
            Closed: false
            Cancelled: false
            Permission: false
            Transport: false
            Io: false
        }
    }
}

fn isCancelled(
    $result Result<own bytes.Bytes, secrets.Error>
) bool {
    match result {
        Ok(value): {
            discard value
            false
        }
        Err(error): match error {
            Cancelled: true
            NotFound: false
            ReadOnly: false
            NotConfigured: false
            InvalidKey: false
            InvalidCipherKey: false
            AuthenticationFailed: false
            InsecureAddress: false
            TooLarge: false
            Closed: false
            Permission: false
            Transport: false
            Protocol: false
            Io: false
        }
    }
}

fn main(args [String]) i32 {
    if len(args) != 1 return 1

    const original = secrets.NewMemoryStore()
    const cloned = original.Clone()
    const setting = original.Set("token", bytes.FromText("value"))
    const set = $setting.wait()
    expect($set)
    discard original
    const loading = cloned.Get("token")
    const loaded = $loading.wait()
    if takeText($loaded) != "value" return 2
    const loadingAgain = cloned.Get("token")
    const loadedAgain = $loadingAgain.wait()
    if takeText($loadedAgain) != "value" return 3
    print("memory copy and clone")

    const deleting = cloned.Delete("token")
    const deleted = $deleting.wait()
    expect($deleted)
    const missing = cloned.Get("token")
    const missed = $missing.wait()
    if !isNotFound($missed) return 4
    print("memory delete")

    const environment = secrets.NewEnvStore()
    const readingEnvironment = environment.Get("FOUNDATION_SECRET_TEST")
    const environmentValue = $readingEnvironment.wait()
    if takeText($environmentValue) != "environment-value" return 5
    const writingEnvironment = environment.Set("FOUNDATION_SECRET_TEST", bytes.FromText("x"))
    const environmentWrite = $writingEnvironment.wait()
    if !isReadOnly($environmentWrite) return 6
    print("environment read only")

    const prefixMemory = secrets.NewMemoryStore()
    const prefixed = secrets.NewPrefixStore(prefixMemory.Clone(), "app/")
    const settingPrefix = prefixed.Set("token", bytes.FromText("namespaced"))
    const prefixSet = $settingPrefix.wait()
    expect($prefixSet)
    const loadingPrefix = prefixMemory.Get("app/token")
    const prefixValue = $loadingPrefix.wait()
    if takeText($prefixValue) != "namespaced" return 7
    print("prefix namespace")

    const fallbackMemory = secrets.NewMemoryStore()
    const fallback = secrets.NewFallbackStore(
        secrets.NewEnvStore(),
        fallbackMemory.Clone()
    )
    const settingFallback = fallback.Set(
        "FOUNDATION_SECRET_FALLBACK",
        bytes.FromText("secondary")
    )
    const fallbackSet = $settingFallback.wait()
    expect($fallbackSet)
    const loadingFallback = fallback.Get("FOUNDATION_SECRET_FALLBACK")
    const fallbackValue = $loadingFallback.wait()
    if takeText($fallbackValue) != "secondary" return 8
    print("fallback expected conditions")

    const preserving = secrets.NewFallbackStore(
        own FailingStore {},
        fallbackMemory.Clone()
    )
    const preserved = preserving.Get("FOUNDATION_SECRET_FALLBACK")
    const preservedResult = $preserved.wait()
    if !isTransportFailure($preservedResult) return 9
    print("fallback preserves failures")

    const cipherMemory = secrets.NewMemoryStore()
    const cipher = secrets.NewCipherStore(
        cipherMemory.Clone(),
        bytes.FromText("0123456789abcdef0123456789abcdef")
    ) else error {
        discard error
        return 10
    }
    const settingCipher = cipher.Set("one", bytes.FromText("first"))
    const cipherSet = $settingCipher.wait()
    expect($cipherSet)
    const loadingCipher = cipher.Get("one")
    const cipherValue = $loadingCipher.wait()
    if takeText($cipherValue) != "first" return 11
    const loadingRaw = cipherMemory.Get("one")
    const rawResult = $loadingRaw.wait()
    const raw = takeBytes($rawResult)
    const plain = bytes.FromText("first")
    if bytes.ConstantTimeEqual(raw, plain) return 12
    discard raw
    discard plain
    print("cipher round trip")

    const settingSecond = cipher.Set("two", bytes.FromText("second"))
    const secondSet = $settingSecond.wait()
    expect($secondSet)
    const loadingSecondRaw = cipherMemory.Get("two")
    const secondRawResult = $loadingSecondRaw.wait()
    const secondRaw = takeBytes($secondRawResult)
    const replacingFirst = cipherMemory.Set("one", $secondRaw)
    const replacedFirst = $replacingFirst.wait()
    expect($replacedFirst)
    const loadingBound = cipher.Get("one")
    const boundResult = $loadingBound.wait()
    if !isAuthenticationFailure($boundResult) return 13
    print("cipher key binding")

    const invalidCipher = secrets.NewCipherStore(
        cipherMemory.Clone(),
        bytes.FromText("short")
    )
    if !invalidCipherKey($invalidCipher) return 14
    print("cipher key size")

    const creatingPrivate = spawn secrets.NewPrivateFileStore(
        text.Copy(args[0]),
        bytes.FromText("abcdef0123456789abcdef0123456789")
    )
    const privateResult = $creatingPrivate.wait()
    const privateStore = match privateResult {
        Ok(store): store
        Err(error): {
            discard error
            return 15
        }
    }
    const settingPrivate = privateStore.Set("database", bytes.FromText("private"))
    const privateSet = $settingPrivate.wait()
    expect($privateSet)
    const loadingPrivate = privateStore.Get("database")
    const privateValue = $loadingPrivate.wait()
    if takeText($privateValue) != "private" return 16
    const deletingPrivate = privateStore.Delete("database")
    const privateDelete = $deletingPrivate.wait()
    expect($privateDelete)
    const loadingPrivateMissing = privateStore.Get("database")
    const privateMissing = $loadingPrivateMissing.wait()
    if !isNotFound($privateMissing) return 17
    print("private encrypted file")

    const vault = secrets.NewVaultStore(
        own FakeVaultTransport {},
        "http://127.0.0.1:8200/",
        "token",
        "/secret/"
    ) else error {
        discard error
        return 18
    }
    const settingVault = vault.Set("app/db", bytes.FromText("password"))
    const vaultSet = $settingVault.wait()
    expect($vaultSet)
    const loadingVault = vault.Get("app/db")
    const vaultValue = $loadingVault.wait()
    if takeText($vaultValue) != "password" return 19
    const deletingVault = vault.Delete("app/db")
    const vaultDelete = $deletingVault.wait()
    expect($vaultDelete)
    const loadingVaultMissing = vault.Get("missing")
    const vaultMissing = $loadingVaultMissing.wait()
    if !isNotFound($vaultMissing) return 20
    print("vault kv2 wire")

    const loadingMalformed = vault.Get("malformed")
    const malformed = $loadingMalformed.wait()
    if !isProtocolFailure($malformed) return 21
    print("vault malformed response")

    const loadingCancelled = vault.Get("cancelled")
    const cancelled = $loadingCancelled.wait()
    if !isCancelled($cancelled) return 22
    print("vault cancellation")

    const loadingOversized = vault.Get("oversized")
    const oversized = $loadingOversized.wait()
    if !isProtocolFailure($oversized) return 23
    print("vault response limit")

    const insecureTransport = own FakeVaultTransport {}
    const insecure = secrets.NewVaultStore(
        $insecureTransport,
        "http://vault.example.com",
        "token",
        "secret"
    )
    if !invalidAddress($insecure) return 24
    print("insecure vault rejected")

    const loopback = secrets.NewVaultStore(
        own FakeVaultTransport {},
        "http://localhost:8200/base",
        "token",
        "secret"
    )
    if !validAddress($loopback) return 25
    const loopbackIpv6 = secrets.NewVaultStore(
        own FakeVaultTransport {},
        "http://[::1]:8200",
        "token",
        "secret"
    )
    if !validAddress($loopbackIpv6) return 26
    const userInfoBypass = secrets.NewVaultStore(
        own FakeVaultTransport {},
        "http://localhost:token@vault.example.com",
        "token",
        "secret"
    )
    if !invalidAddress($userInfoBypass) return 27
    const suffixBypass = secrets.NewVaultStore(
        own FakeVaultTransport {},
        "http://localhost.example.com",
        "token",
        "secret"
    )
    if !invalidAddress($suffixBypass) return 28
    const invalidPort = secrets.NewVaultStore(
        own FakeVaultTransport {},
        "http://127.0.0.1:65536",
        "token",
        "secret"
    )
    if !invalidAddress($invalidPort) return 29
    const emptyHttpsAuthority = secrets.NewVaultStore(
        own FakeVaultTransport {},
        "https:///vault",
        "token",
        "secret"
    )
    if !invalidAddress($emptyHttpsAuthority) return 30
    const invalidHttpsPort = secrets.NewVaultStore(
        own FakeVaultTransport {},
        "https://vault.example.com:not-a-port",
        "token",
        "secret"
    )
    if !invalidAddress($invalidHttpsPort) return 31
    const validHttps = secrets.NewVaultStore(
        own FakeVaultTransport {},
        "https://vault.example.com:8200/base",
        "token",
        "secret"
    )
    if !validAddress($validHttps) return 32
    print("vault address grammar")
    print("secrets ok")
    0
}
