package test.network_tcp

import std.bytes
import std.net
import std.time

extern c fn startServer(&port u64) u64 as foundation_test_net_server_start
extern c fn joinServer(server u64) i32 as foundation_test_net_server_join
extern c fn liveAddresses() u64 as foundation_runtime_net_live_addresses
extern c fn liveListeners() u64 as foundation_runtime_net_live_listeners
extern c fn liveConnections() u64 as foundation_runtime_net_live_connections
extern c fn liveRequests() u64 as foundation_runtime_net_live_requests
extern c fn liveServices() u64 as foundation_runtime_net_live_services

fn errorName(error net.Error) String {
    match error {
        InvalidAddress: "TCP address is invalid"
        ResolveFailed: "TCP resolution failed"
        Refused: "TCP connection was refused"
        Closed: "TCP connection was closed"
        Cancelled: "TCP connection was cancelled"
        InvalidUtf8: "TCP connection returned invalid UTF-8"
        LineTooLong: "TCP connection returned a long line"
        AddressInUse: "TCP address is already in use"
        Timeout: "TCP operation timed out"
        InvalidLimit: "TCP byte limit is invalid"
        Io: "TCP connection I/O failed"
    }
}

fn connectionOr($value Result<own net.TcpConnection, net.Error>) own net.TcpConnection {
    const connection = value else error {
        panic(errorName(error))
    }
    connection
}

fn pairOr($value Result<net.StreamPair, net.Error>) net.StreamPair {
    const pair = value else error {
        discard error
        panic("TCP split failed")
    }
    pair
}

fn controlledOr(
    $value Result<net.ControlledStream, net.Error>
) net.ControlledStream {
    const stream = value else error {
        discard error
        panic("TCP controlled split failed")
    }
    stream
}

fn lineOr($value Result<Option<String>, net.Error>) String {
    match value {
        Ok(optional): match optional {
            None: ""
            Some(line): line
        }
        Err(error): ""
    }
}

fn textOr($value Result<String, net.Error>) String {
    match value {
        Ok(text): text
        Err(error): ""
    }
}

fn isEof($value Result<Option<String>, net.Error>) bool {
    match value {
        Ok(optional): match optional {
            None: true
            Some(line): false
        }
        Err(error): false
    }
}

fn writeSucceeded($value Result<void, net.Error>) bool {
    match value {
        Ok: true
        Err(error): false
    }
}

fn binaryPayload() own bytes.Bytes {
    const opened = bytes.NewBuilder(4) else error {
        discard error
        panic("binary payload builder failed")
    }
    var builder = opened
    builder.WriteByte(0) else error {
        discard error
        discard builder
        panic("binary payload byte failed")
    }
    builder.WriteByte(255) else error {
        discard error
        discard builder
        panic("binary payload byte failed")
    }
    builder.WriteByte(195) else error {
        discard error
        discard builder
        panic("binary payload byte failed")
    }
    builder.WriteByte(40) else error {
        discard error
        discard builder
        panic("binary payload byte failed")
    }
    const value = builder.Finish() else error {
        discard error
        discard builder
        panic("binary payload finish failed")
    }
    discard builder
    value
}

fn binaryMatches(
    $value Result<own bytes.Bytes, net.Error>
) bool {
    match value {
        Ok(content): {
            const length = content.Len() else error {
                discard error
                discard content
                return false
            }
            const first = content.At(0) else error {
                discard error
                discard content
                return false
            }
            const second = content.At(1) else error {
                discard error
                discard content
                return false
            }
            const third = content.At(2) else error {
                discard error
                discard content
                return false
            }
            const fourth = content.At(3) else error {
                discard error
                discard content
                return false
            }
            const matches = length == 4 && first == 0 && second == 255 &&
                third == 195 && fourth == 40
            discard content
            matches
        }
        Err(error): {
            discard error
            false
        }
    }
}

fn someBinaryMatches(
    $value Result<Option<own bytes.Bytes>, net.Error>
) bool {
    match value {
        Ok(optional): match optional {
            None: false
            Some(content): {
                const matches = binaryMatches(.Ok(content))
                matches
            }
        }
        Err(error): {
            discard error
            false
        }
    }
}

fn isByteEof(
    $value Result<Option<own bytes.Bytes>, net.Error>
) bool {
    match value {
        Ok(optional): match optional {
            None: true
            Some(content): {
                discard content
                false
            }
        }
        Err(error): {
            discard error
            false
        }
    }
}

fn isStoppedRead(
    $value Result<Option<own bytes.Bytes>, net.Error>
) bool {
    match value {
        Ok(optional): match optional {
            None: true
            Some(content): {
                discard content
                false
            }
        }
        Err(error): match error {
            Closed: true
            _: false
        }
    }
}

task abortTcp($controller own net.TcpController) bool {
    var active = controller
    const aborted = active.Abort()
    discard active
    aborted
}

fn isInvalidLimit(
    $value Result<Option<own bytes.Bytes>, net.Error>
) bool {
    match value {
        Ok(optional): {
            discard optional
            false
        }
        Err(error): match error {
            InvalidAddress: false
            ResolveFailed: false
            Refused: false
            Closed: false
            Cancelled: false
            InvalidUtf8: false
            LineTooLong: false
            AddressInUse: false
            Timeout: false
            InvalidLimit: true
            Io: false
        }
    }
}

fn isInvalidUtf8($value Result<Option<String>, net.Error>) bool {
    match value {
        Ok(optional): false
        Err(error): match error {
            InvalidAddress: false
            ResolveFailed: false
            Refused: false
            Closed: false
            Cancelled: false
            InvalidUtf8: true
            LineTooLong: false
            AddressInUse: false
            Timeout: false
            InvalidLimit: false
            Io: false
        }
    }
}

fn isLineTooLong($value Result<Option<String>, net.Error>) bool {
    match value {
        Ok(optional): false
        Err(error): match error {
            InvalidAddress: false
            ResolveFailed: false
            Refused: false
            Closed: false
            Cancelled: false
            InvalidUtf8: false
            LineTooLong: true
            AddressInUse: false
            Timeout: false
            InvalidLimit: false
            Io: false
        }
    }
}

fn isRefused($value Result<own net.TcpConnection, net.Error>) bool {
    match value {
        Ok(connection): false
        Err(error): match error {
            InvalidAddress: false
            ResolveFailed: false
            Refused: true
            Closed: false
            Cancelled: false
            InvalidUtf8: false
            LineTooLong: false
            AddressInUse: false
            Timeout: false
            InvalidLimit: false
            Io: false
        }
    }
}

fn isInvalidAddress($value Result<own net.TcpConnection, net.Error>) bool {
    match value {
        Ok(connection): false
        Err(error): match error {
            InvalidAddress: true
            ResolveFailed: false
            Refused: false
            Closed: false
            Cancelled: false
            InvalidUtf8: false
            LineTooLong: false
            AddressInUse: false
            Timeout: false
            InvalidLimit: false
            Io: false
        }
    }
}

fn isTimeout($value Result<Option<String>, net.Error>) bool {
    match value {
        Ok(optional): {
            discard optional
            false
        }
        Err(error): match error {
            InvalidAddress: false
            ResolveFailed: false
            Refused: false
            Closed: false
            Cancelled: false
            InvalidUtf8: false
            LineTooLong: false
            AddressInUse: false
            Timeout: true
            InvalidLimit: false
            Io: false
        }
    }
}

fn listenerOr($value Result<own net.TcpListener, net.Error>) own net.TcpListener {
    const listener = value else error {
        panic(errorName(error))
    }
    listener
}

fn invalidEndpoint(value String) bool {
    match net.ParseEndpoint(value) {
        Ok(endpoint): {
            discard endpoint
            false
        }
        Err(error): match error {
            InvalidAddress: true
            _: false
        }
    }
}

fn endpointChecks() bool {
    const domain = net.ParseEndpoint("example.com:443") else error {
        discard error
        return false
    }
    const ipv4 = net.ParseEndpoint("127.0.0.1:8080") else error {
        discard error
        return false
    }
    const ipv6 = net.ParseEndpoint("[::1]:65535") else error {
        discard error
        return false
    }
    domain.Host == "example.com" && domain.Port == 443 &&
        domain.Address() == "example.com:443" &&
        ipv4.Host == "127.0.0.1" && ipv4.Port == 8080 &&
        ipv4.Address() == "127.0.0.1:8080" &&
        ipv6.Host == "::1" && ipv6.Port == 65535 &&
        ipv6.Address() == "[::1]:65535" &&
        invalidEndpoint(":80") && invalidEndpoint("example.com") &&
        invalidEndpoint("example.com:0") &&
        invalidEndpoint("example.com:65536") &&
        invalidEndpoint("::1:80") && invalidEndpoint("[::1]x:80")
}

fn listenerRoundTrip() bool {
    const listener = listenerOr(net.Listen("127.0.0.1", 0))
    const port = listener.Port
    const accepting = spawn net.Accept($listener)
    const connecting = spawn net.Connect("127.0.0.1", port)
    const client = connectionOr($connecting.wait())
    const net.AcceptOutcome { Listener as listenerAfter Value as accepted } = $accepting.wait()
    const server = connectionOr($accepted)
    const clientPeer = textOr(client.PeerAddress())
    const serverPeer = textOr(server.PeerAddress())
    const clientPair = pairOr(client.Split())
    const serverPair = pairOr(server.Split())
    const net.StreamPair { Reader as clientReader Writer as clientWriter } = clientPair
    const net.StreamPair { Reader as serverReader Writer as serverWriter } = serverPair

    const clientWriting = spawn net.WriteAll($clientWriter, "hello\n")
    const serverReading = spawn net.ReadLine($serverReader)
    const net.WriteOutcome { Writer as clientWriterAfter Value as clientWrite } = $clientWriting.wait()
    const net.ReadLineOutcome { Reader as serverReaderAfter Value as request } = $serverReading.wait()
    const bodyWriting = spawn net.WriteAllBytes(
        $clientWriterAfter,
        binaryPayload()
    )
    const bodyReading = spawn net.ReadExactBytes($serverReaderAfter, 4)
    const net.WriteOutcome {
        Writer as clientWriterBody
        Value as bodyWriteResult
    } = $bodyWriting.wait()
    const net.ReadBytesOutcome {
        Reader as serverReaderBody
        Value as bodyResult
    } = $bodyReading.wait()
    const deadline = net.DeadlineAfter(time.Seconds(5)) else error {
        discard error
        panic("binary network deadline failed")
    }
    const responseWriting = spawn net.WriteAllBytesUntil(
        $serverWriter,
        binaryPayload(),
        deadline
    )
    const responseReading = spawn net.ReadExactBytesUntil(
        $clientReader,
        4,
        deadline
    )
    const net.WriteOutcome {
        Writer as serverWriterBinary
        Value as responseWriteResult
    } = $responseWriting.wait()
    const net.ReadBytesOutcome {
        Reader as clientReaderBinary
        Value as binaryResponse
    } = $responseReading.wait()
    const serverWriting = spawn net.WriteAll($serverWriterBinary, "world\n")
    const clientReading = spawn net.ReadLine($clientReaderBinary)
    const net.WriteOutcome { Writer as serverWriterAfter Value as serverWrite } = $serverWriting.wait()
    const net.ReadLineOutcome { Reader as clientReaderAfter Value as response } = $clientReading.wait()

    const chunkWriting = spawn net.WriteAllBytes(
        $clientWriterBody,
        binaryPayload()
    )
    const net.WriteOutcome {
        Writer as chunkWriter
        Value as chunkWriteResult
    } = $chunkWriting.wait()
    discard chunkWriter
    const chunkReading = spawn net.ReadSomeBytesUntil(
        $serverReaderBody,
        8,
        deadline
    )
    const net.ReadSomeBytesOutcome {
        Reader as chunkReader
        Value as chunkResult
    } = $chunkReading.wait()
    const eofReading = spawn net.ReadSomeBytes($chunkReader, 8)
    const net.ReadSomeBytesOutcome {
        Reader as eofReader
        Value as byteEof
    } = $eofReading.wait()
    const invalidReading = spawn net.ReadSomeBytes($eofReader, 0)
    const net.ReadSomeBytesOutcome {
        Reader as invalidReader
        Value as invalidLimit
    } = $invalidReading.wait()

    const success = lineOr($request) == "hello" && binaryMatches($bodyResult) &&
        binaryMatches($binaryResponse) &&
        lineOr($response) == "world" &&
        clientPeer == "127.0.0.1" && serverPeer == "127.0.0.1" &&
        writeSucceeded($clientWrite) && writeSucceeded($bodyWriteResult) &&
        writeSucceeded($responseWriteResult) && writeSucceeded($serverWrite) &&
        writeSucceeded($chunkWriteResult) && someBinaryMatches($chunkResult) &&
        isByteEof($byteEof) && isInvalidLimit($invalidLimit)
    discard listenerAfter
    discard invalidReader
    discard serverWriterAfter
    discard clientReaderAfter
    success
}

fn controlledAbort() bool {
    const listener = listenerOr(net.Listen("127.0.0.1", 0))
    const port = listener.Port
    const accepting = spawn net.Accept($listener)
    const connecting = spawn net.Connect("127.0.0.1", port)
    const client = connectionOr($connecting.wait())
    const net.AcceptOutcome {
        Listener
        Value as accepted
    } = $accepting.wait()
    const server = connectionOr($accepted)
    const stream = controlledOr(client.SplitControlled())
    const net.ControlledStream { Reader Writer Controller } = stream
    const reading = spawn net.ReadSomeBytes($Reader, 1)
    const aborting = spawn abortTcp($Controller)
    const net.ReadSomeBytesOutcome { Reader as restored Value } = $reading.wait()
    const aborted = $aborting.wait()
    const stopped = isStoppedRead($Value)
    discard restored
    discard Writer
    discard server
    discard Listener
    aborted && stopped
}

fn controlledListenerClose() bool {
    const listener = listenerOr(net.Listen("127.0.0.1", 0))
    const controllerValue = listener.Control() else error {
        discard error
        discard listener
        return false
    }
    var controller = controllerValue
    const accepting = spawn net.Accept($listener)
    const closed = controller.Close()
    const net.AcceptOutcome { Listener Value } = $accepting.wait()
    const stopped = match Value {
        Ok(connection): {
            discard connection
            false
        }
        Err(error): match error {
            Closed: true
            _: false
        }
    }
    discard controller
    discard Listener
    closed && stopped
}

fn deadlineRoundTrip() bool {
    const listener = listenerOr(net.Listen("127.0.0.1", 0))
    const port = listener.Port
    const accepting = spawn net.Accept($listener)
    const connecting = spawn net.Connect("127.0.0.1", port)
    const client = connectionOr($connecting.wait())
    const acceptedOutcome = $accepting.wait()
    const net.AcceptOutcome {
        Listener as listenerAfter
        Value as accepted
    } = acceptedOutcome
    const server = connectionOr($accepted)
    const clientPair = pairOr(client.Split())
    const serverPair = pairOr(server.Split())
    const net.StreamPair {
        Reader as clientReader
        Writer as clientWriter
    } = clientPair
    const net.StreamPair {
        Reader as serverReader
        Writer as serverWriter
    } = serverPair
    const deadline = net.DeadlineAfter(time.Milliseconds(10)) else error {
        discard error
        discard listenerAfter
        discard clientReader
        discard clientWriter
        discard serverReader
        discard serverWriter
        return false
    }
    const reading = spawn net.ReadLineLimitedUntil(
        $clientReader,
        64,
        deadline
    )
    const outcome = $reading.wait()
    const net.ReadLineOutcome {
        Reader as readerAfter
        Value
    } = outcome
    const timedOut = isTimeout($Value)
    discard listenerAfter
    discard readerAfter
    discard clientWriter
    discard serverReader
    discard serverWriter
    timedOut
}

fn main() i32 {
    if !endpointChecks() {
        return 11
    }
    if !listenerRoundTrip() {
        return 9
    }
    if !deadlineRoundTrip() {
        return 10
    }
    if !controlledAbort() {
        return 12
    }
    if !controlledListenerClose() {
        return 13
    }
    var port u64 = 0
    const server = startServer(&port)
    if server == 0 || port == 0 || port > 65535 {
        return 1
    }
    const invalidAddress = spawn net.Connect("", port)
    if !isInvalidAddress($invalidAddress.wait()) {
        return 8
    }

    const connecting = spawn net.Connect("localhost", port)
    const connection = connectionOr($connecting.wait())
    const pair = pairOr(connection.Split())
    const net.StreamPair { Reader as reader Writer as writer } = pair

    const writing = spawn net.WriteAll($writer, "ping\n")
    const reading = spawn net.ReadLine($reader)
    const net.WriteOutcome { Writer as writerAfter Value as writeResult } = $writing.wait()
    const net.ReadLineOutcome { Reader as readerAfter Value as firstResult } = $reading.wait()
    const first = lineOr($firstResult)

    const secondReading = spawn net.ReadLineLimited($readerAfter, 3)
    const net.ReadLineOutcome { Reader as readerSecond Value as secondResult } = $secondReading.wait()
    const second = lineOr($secondResult)

    const eofReading = spawn net.ReadLine($readerSecond)
    const net.ReadLineOutcome { Reader as readerEof Value as eofResult } = $eofReading.wait()
    if first != "pong" || second != "abc" || !writeSucceeded($writeResult) ||
        !isEof($eofResult) {
        return 2
    }
    discard readerEof
    discard writerAfter

    const cancellingConnection = connectionOr($(spawn net.Connect("127.0.0.1", port)).wait())
    const cancellingPair = pairOr(cancellingConnection.Split())
    const net.StreamPair { Reader as cancellingReader Writer as cancellingWriter } = cancellingPair
    const cancelledRead = spawn net.ReadExact($cancellingReader, 4)
    discard cancelledRead
    discard cancellingWriter

    const invalidConnection = connectionOr($(spawn net.Connect("127.0.0.1", port)).wait())
    const invalidPair = pairOr(invalidConnection.Split())
    const net.StreamPair { Reader as invalidReader Writer as invalidWriter } = invalidPair
    discard invalidWriter
    const invalidReading = spawn net.ReadLine($invalidReader)
    const net.ReadLineOutcome { Reader as invalidReaderAfter Value as invalidResult } = $invalidReading.wait()
    if !isInvalidUtf8($invalidResult) {
        return 3
    }
    discard invalidReaderAfter

    const longConnection = connectionOr($(spawn net.Connect("127.0.0.1", port)).wait())
    const longPair = pairOr(longConnection.Split())
    const net.StreamPair { Reader as longReader Writer as longWriter } = longPair
    discard longWriter
    const longReading = spawn net.ReadLineLimited($longReader, 3)
    const net.ReadLineOutcome { Reader as longReaderAfter Value as longResult } = $longReading.wait()
    if !isLineTooLong($longResult) {
        return 4
    }
    discard longReaderAfter

    if joinServer(server) != 0 {
        return 5
    }
    const refused = spawn net.Connect("127.0.0.1", port)
    if !isRefused($refused.wait()) {
        return 6
    }
    if liveAddresses() != 0 || liveListeners() != 0 || liveConnections() != 0 ||
        liveRequests() != 0 || liveServices() != 0 {
        return 7
    }
    print("tcp ok")
    0
}
