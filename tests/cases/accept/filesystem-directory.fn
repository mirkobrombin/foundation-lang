package test.filesystem_directory

import std.fs
import std.path

fn nameOr($value Result<Option<String>, fs.Error>) String {
    match value {
        Ok(name): match name {
            None: ""
            Some(item): item
        }
        Err(error): ""
    }
}

fn main(args [String]) i32 {
    const opened = fs.OpenDir(args[0]) else error {
        discard error
        return 1
    }
    var directory = opened
    const name = nameOr(directory.Next())
    const end = nameOr(directory.Next())
    const filePath = path.Join(args[0], name)
    const isDirectory = fs.IsDirectory(filePath) else error {
        discard error
        return 2
    }
    discard directory.Close()
    if name == "lines.jsonl" && end == "" && !isDirectory {
        print("fs directory ok")
        return 0
    }
    return 3
}
