package test.package_primitives

import std.bytes
import std.fs
import std.io
import std.path
import std.text

fn binaryPayload() own bytes.Bytes {
    const opened = bytes.NewBuilder(4) else error {
        discard error
        panic("binary payload builder failed")
    }
    var builder = opened
    builder.WriteByte(0) else error {
        discard error
        panic("binary payload zero failed")
    }
    builder.WriteByte(255) else error {
        discard error
        panic("binary payload high byte failed")
    }
    builder.WriteByte(71) else error {
        discard error
        panic("binary payload text byte failed")
    }
    builder.SetByte(2, 70) else error {
        discard error
        panic("binary payload edit failed")
    }
    builder.WriteByte(10) else error {
        discard error
        panic("binary payload newline failed")
    }
    const result = builder.Finish() else error {
        discard error
        panic("binary payload finish failed")
    }
    result
}

fn readIsTooLarge($value Result<own bytes.Bytes, fs.HostError>) bool {
    match value {
        Ok(result): false
        Err(error): match error {
            TooLarge: true
            _: false
        }
    }
}

fn removeIsTooLarge($value Result<void, fs.HostError>) bool {
    match value {
        Ok: false
        Err(error): match error {
            TooLarge: true
            _: false
        }
    }
}

fn removeIsInvalidPath($value Result<void, fs.HostError>) bool {
    match value {
        Ok: false
        Err(error): match error {
            InvalidPath: true
            _: false
        }
    }
}

task resizeStreamFile($file own fs.File) fs.FileOutcome {
    const growing = spawn fs.ResizeFile($file, 6)
    const grownOutcome = $growing.wait()
    const fs.FileOutcome { File as grownFile Value as grownValue } = grownOutcome
    grownValue else error {
        return fs.FileOutcome { File = grownFile Value = .Err(error) }
    }
    const shrinking = spawn fs.ResizeFile($grownFile, 4)
    const result = $shrinking.wait()
    result
}

task exerciseStreaming($rootPath String) i32 {
    const openedRoot = fs.OpenRoot(rootPath) else error {
        discard error
        return 1
    }
    const opening = spawn fs.CreateRootFile($openedRoot, "stream.bin")
    const openedOutcome = $opening.wait()
    const fs.RootFileOpenOutcome {
        Root as root
        Value as openedValue
    } = openedOutcome
    const openedFile = openedValue else error {
        discard error
        discard root
        return 2
    }
    const streamPayload = binaryPayload()
    const writing = spawn fs.WriteFileChunk($openedFile, $streamPayload)
    const writtenOutcome = $writing.wait()
    const fs.FileOutcome { File as writtenFile Value as writtenValue } =
        writtenOutcome
    writtenValue else error {
        discard error
        discard writtenFile
        discard root
        return 3
    }
    const resizing = spawn resizeStreamFile($writtenFile)
    const shrunkOutcome = $resizing.wait()
    const fs.FileOutcome { File as shrunkFile Value as shrunkValue } =
        shrunkOutcome
    shrunkValue else error {
        discard error
        discard shrunkFile
        discard root
        return 4
    }
    const syncing = spawn fs.SyncFile($shrunkFile)
    const syncedOutcome = $syncing.wait()
    const fs.FileOutcome { File as syncedFile Value as syncedValue } =
        syncedOutcome
    syncedValue else error {
        discard error
        discard syncedFile
        discard root
        return 4
    }
    var completedFile = syncedFile
    const fileClosed = completedFile.Close() else error {
        discard error
        discard root
        return 5
    }
    if !fileClosed {
        discard root
        return 5
    }
    var completedRoot = root
    const rootClosed = completedRoot.Close() else error {
        discard error
        return 6
    }
    if !rootClosed return 6

    const filePath = path.Join(rootPath, "stream.bin")
    const readingOpen = spawn fs.OpenFile($filePath, .Read)
    const readingValue = $readingOpen.wait()
    const readingFile = readingValue else error {
        discard error
        return 7
    }
    const sizing = spawn fs.SizeFile($readingFile)
    const sizedOutcome = $sizing.wait()
    const fs.FileSizeOutcome { File as sizedFile Value as sizeValue } =
        sizedOutcome
    const size = sizeValue else error {
        discard error
        discard sizedFile
        return 8
    }
    if size != 4 {
        discard sizedFile
        return 9
    }
    const seeking = spawn fs.SeekFile($sizedFile, 1)
    const soughtOutcome = $seeking.wait()
    const fs.FileOutcome { File as soughtFile Value as soughtValue } =
        soughtOutcome
    soughtValue else error {
        discard error
        discard soughtFile
        return 10
    }
    const firstReading = spawn fs.ReadFileChunk($soughtFile, 2)
    const firstOutcome = $firstReading.wait()
    const fs.FileReadOutcome { File as firstFile Value as firstValue } =
        firstOutcome
    const firstOptional = firstValue else error {
        discard error
        discard firstFile
        return 11
    }
    const first = match firstOptional {
        None: {
            discard firstFile
            return 12
        }
        Some(value): value
    }
    const firstLength = first.Len() else error {
        discard error
        discard firstFile
        return 13
    }
    const firstByte = first.At(0) else error {
        discard error
        discard firstFile
        return 14
    }
    const secondByte = first.At(1) else error {
        discard error
        discard firstFile
        return 15
    }
    if firstLength != 2 || firstByte != 255 || secondByte != 70 {
        discard firstFile
        return 16
    }
    const secondReading = spawn fs.ReadFileChunk($firstFile, 8)
    const secondOutcome = $secondReading.wait()
    const fs.FileReadOutcome { File as secondFile Value as secondValue } =
        secondOutcome
    const secondOptional = secondValue else error {
        discard error
        discard secondFile
        return 17
    }
    const second = match secondOptional {
        None: {
            discard secondFile
            return 18
        }
        Some(value): value
    }
    const secondLength = second.Len() else error {
        discard error
        discard secondFile
        return 19
    }
    const newline = second.At(0) else error {
        discard error
        discard secondFile
        return 20
    }
    if secondLength != 1 || newline != 10 {
        discard secondFile
        return 21
    }
    const eofReading = spawn fs.ReadFileChunk($secondFile, 8)
    const eofOutcome = $eofReading.wait()
    const fs.FileReadOutcome { File as eofFile Value as eofValue } = eofOutcome
    const eofOptional = eofValue else error {
        discard error
        discard eofFile
        return 22
    }
    const atEOF = match eofOptional {
        None: true
        Some(value): {
            discard value
            false
        }
    }
    var completedRead = eofFile
    discard completedRead.Close()
    if !atEOF return 23
    0
}

fn main(args [String]) i32 {
    const root = fs.CreateTempDirectory(args[0], "fdn-package") else error {
        discard error
        return 1
    }
    const opened = fs.OpenRoot(root) else error {
        discard error
        return 2
    }
    var writer = opened
    writer.CreateDirectory("nested/deep") else error {
        discard error
        return 3
    }
    const payload = binaryPayload()
    writer.WriteFile("nested/deep/payload.bin", payload, 384) else error {
        discard error
        return 4
    }
    discard writer.Close()

    const file = path.Join(root, "nested/deep/payload.bin")
    if !readIsTooLarge(fs.ReadBytesSync(file, 3)) return 5
    const read = fs.ReadBytesSync(file, 4) else error {
        discard error
        return 6
    }
    const length = read.Len() else error {
        discard error
        return 7
    }
    const first = read.At(0) else error {
        discard error
        return 8
    }
    const second = read.At(1) else error {
        discard error
        return 9
    }
    if length != 4 || first != 0 || second != 255 return 10

    const streaming = spawn exerciseStreaming(text.Copy(root))
    const streamingStatus = $streaming.wait()
    if streamingStatus != 0 return 30 + streamingStatus

    var sha256 = bytes.NewSha256()
    sha256.WriteText("abc") else error {
        discard error
        return 11
    }
    const suffix = bytes.FromText("def")
    sha256.WriteBytes(suffix) else error {
        discard error
        return 12
    }
    const digest = sha256.Finish() else error {
        discard error
        return 13
    }
    if sha256.Close() return 14
    const encoded = bytes.EncodeBase64URL(digest) else error {
        discard error
        return 15
    }
    if !text.Equal(encoded, "vvV-x_U6bUC-tkCngKY5yDvCmsipgW8fxsXG3Nk8RyE") {
        return 16
    }

    const alias = root + "/nested/deep/../.."
    if !removeIsInvalidPath(fs.RemoveTree(alias, 32, 8)) return 17
    const existsAfterAlias = fs.Exists(file) else error {
        discard error
        return 18
    }
    if !existsAfterAlias return 19
    if !removeIsTooLarge(fs.RemoveTree(root, 1, 8)) return 20
    const existsAfterLimit = fs.Exists(root) else error {
        discard error
        return 21
    }
    if !existsAfterLimit return 22
    fs.RemoveTree(root, 32, 8) else error {
        discard error
        return 23
    }
    const existsAfterRemove = fs.Exists(root) else error {
        discard error
        return 24
    }
    if existsAfterRemove return 25

    io.WriteStdoutText("package") else error {
        discard error
        return 26
    }
    const stdout = bytes.FromText(" primitives ok\n")
    io.WriteStdoutBytes(stdout) else error {
        discard error
        return 27
    }
    const stderr = bytes.FromText("package")
    io.WriteStderrBytes(stderr) else error {
        discard error
        return 28
    }
    io.WriteStderrText(" primitives stderr\n") else error {
        discard error
        return 29
    }
    0
}
