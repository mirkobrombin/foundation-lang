fn success(value i32) Result<i32, String> {
    .Ok(value)
}

fn forward(result Result<i32, String>) Result<i32, String> {
    let value = result else error {
        return .Err(error)
    }
    .Ok(value)
}

fn main() i32 {
    let optional = Option.Some(2)
    let result = forward(success(match optional {
        None: 0
        Some(value): value
    }))
    discard Result<i32, String>.Err("ignored")
    match result {
        Ok(value): value - 2
        Err(error): 1
    }
}
