import std.json
import std.text

fn textIs($value Option<json.Value>, expected String) bool {
    match value {
        None: false
        Some(actual): match actual {
            Text(content): text.Equal(content, expected)
            Null: false
            Bool(flag): false
            Number(number): false
            Array(items): false
            Object(fields): false
        }
    }
}

fn numberIs($value Option<json.Value>, expected String) bool {
    match value {
        None: false
        Some(actual): match actual {
            Number(number): text.Equal(number, expected)
            Null: false
            Bool(flag): false
            Text(content): false
            Array(items): false
            Object(fields): false
        }
    }
}

fn boolIs($value Option<json.Value>, expected bool) bool {
    match value {
        None: false
        Some(actual): match actual {
            Bool(flag): flag == expected
            Null: false
            Number(number): false
            Text(content): false
            Array(items): false
            Object(fields): false
        }
    }
}

fn isJsonNull($value Option<json.Value>) bool {
    match value {
        None: false
        Some(actual): match actual {
            Null: true
            Bool(flag): false
            Number(number): false
            Text(content): false
            Array(items): false
            Object(fields): false
        }
    }
}

fn arrayIs($value Option<json.Value>) bool {
    match value {
        None: false
        Some(actual): match actual {
            Array(items): inspectArray($items)
            Null: false
            Bool(flag): false
            Number(number): false
            Text(content): false
            Object(fields): false
        }
    }
}

fn inspectArray($items own json.Array) bool {
    var values = items
    const expected = "x"
    values.Len() == 3 && boolIs(values.PopFront(), true) &&
        isJsonNull(values.PopFront()) && textIs(values.PopFront(), expected) &&
        values.Len() == 0
}

fn inspectObject($object own json.Object) bool {
    var fields = object
    const name = "name"
    const count = "count"
    const entries = "items"
    const escaped = "escaped"
    const expectedName = "Foundation 🙂"
    const expectedNumber = "12.5e2"
    const expectedEscaped = "a\nb"
    fields.Len() == 4 &&
        textIs(fields.Take(name), expectedName) &&
        numberIs(fields.Take(count), expectedNumber) &&
        arrayIs(fields.Take(entries)) &&
        textIs(fields.Take(escaped), expectedEscaped) &&
        fields.Len() == 0
}

fn inspect($value json.Value) bool {
    match value {
        Object(object): inspectObject($object)
        Null: false
        Bool(flag): false
        Number(number): false
        Text(content): false
        Array(items): false
    }
}

fn errorCode(kind json.ErrorKind) i32 {
    match kind {
        UnexpectedEnd: 1
        UnexpectedToken: 2
        InvalidString: 3
        InvalidEscape: 4
        InvalidNumber: 5
        DuplicateKey: 6
        DepthLimit: 7
        TrailingData: 8
    }
}

fn failedAs($value Result<json.Value, json.Error>, code i32) bool {
    match value {
        Ok(parsed): false
        Err(error): errorCode(error.Kind) == code
    }
}

fn deeplyNested() String {
    var builder = text.NewBuilder()
    const open = "["
    const close = "]"
    const zero = "0"
    var count u64 = 0
    while count < 130 {
        discard builder.Write(open)
        count = count + 1
    }
    discard builder.Write(zero)
    count = 0
    while count < 130 {
        discard builder.Write(close)
        count = count + 1
    }
    const value = builder.Finish() else error {
        discard error
        panic("builder closed before JSON depth test")
    }
    value
}

fn main() i32 {
    const source = "{\"name\":\"Foundation \\uD83D\\uDE42\",\"count\":12.5e2,\"items\":[true,null,\"x\"],\"escaped\":\"a\\nb\"}"
    const parsed = json.Parse(source) else error {
        discard error
        return 1
    }
    if !inspect($parsed) {
        return 2
    }
    const duplicate = "{\"x\":1,\"x\":2}"
    if !failedAs(json.Parse(duplicate), 6) {
        return 3
    }
    const invalidEscape = "\"\\uD800\""
    if !failedAs(json.Parse(invalidEscape), 4) {
        return 4
    }
    const trailing = "true false"
    if !failedAs(json.Parse(trailing), 8) {
        return 5
    }
    const invalidNumber = "01"
    if !failedAs(json.Parse(invalidNumber), 5) {
        return 6
    }
    const deep = deeplyNested()
    if !failedAs(json.Parse(deep), 7) {
        return 7
    }
    print("json ok")
    0
}
