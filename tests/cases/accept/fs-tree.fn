package test.fs_tree

import std.bytes
import std.fs
import std.text

fn requiredEntry($value Option<fs.TreeEntry>) fs.TreeEntry {
    match value {
        None: panic("filesystem tree entry is missing")
        Some(entry): entry
    }
}

fn binaryPayload() own bytes.Bytes {
    const opened = bytes.NewBuilder(14) else error {
        discard error
        panic("filesystem tree payload builder failed")
    }
    var builder = opened
    const prefix = bytes.FromText("binary")
    builder.Write(prefix) else error {
        discard error
        panic("filesystem tree payload prefix failed")
    }
    builder.WriteByte(0) else error {
        discard error
        panic("filesystem tree payload zero failed")
    }
    const suffix = bytes.FromText("payload")
    builder.Write(suffix) else error {
        discard error
        panic("filesystem tree payload suffix failed")
    }
    const result = builder.Finish() else error {
        discard error
        panic("filesystem tree payload finish failed")
    }
    result
}

fn kindIs(kind fs.TreeKind, expected i32) bool {
    match kind {
        File: expected == 1
        Directory: expected == 2
        SymbolicLink: expected == 3
        Other: expected == 4
    }
}

fn requireAlreadyExists(value Result<void, fs.HostError>) void {
    match value {
        Ok: panic("filesystem operation replaced an occupied path")
        Err(error): match error {
            AlreadyExists: {}
            _: panic("filesystem operation returned the wrong occupied-path error")
        }
    }
}

@target(linux)
fn expectedPermissions() u32 {
    385
}

@target(macos)
fn expectedPermissions() u32 {
    385
}

@target(windows)
fn expectedPermissions() u32 {
    438
}

fn verifySource(path String) i32 {
    const openedSource = fs.OpenTree(path, 10, 4096) else error {
        discard error
        return 1
    }
    var source = openedSource
    const sourceNext = source.Next() else error {
        discard error
        return 2
    }
    const sourceEntry = requiredEntry($sourceNext)
    if !text.Equal(sourceEntry.Path, "lines.jsonl") ||
        !kindIs(sourceEntry.Kind, 1) || sourceEntry.Size == 0 {
        return 3
    }
    const sourceBytes = source.ReadFile(sourceEntry.Path, sourceEntry.Size) else error {
        discard error
        return 4
    }
    const sourceText = sourceBytes.Text() else error {
        discard error
        return 5
    }
    if !text.Contains(sourceText, "last") return 6
    discard source.Close()
    0
}

fn writeTarget(path String, payload bytes.Bytes) i32 {
    const openedRoot = fs.OpenRoot(path) else error {
        discard error
        return 7
    }
    var root = openedRoot
    root.CreateDirectoryEntry("nested", 448) else error {
        discard error
        return 8
    }
    const duplicate = root.CreateDirectoryEntry("nested", 448)
    requireAlreadyExists(duplicate)
    root.WriteFile("nested/payload.bin", payload, 416) else error {
        discard error
        return 9
    }
    root.Rename("nested/payload.bin", "nested/renamed.bin") else error {
        discard error
        return 9
    }
    root.WriteFile("nested/conflict.bin", payload, 416) else error {
        discard error
        return 24
    }
    const occupied = root.Rename(
        "nested/conflict.bin",
        "nested/renamed.bin"
    )
    requireAlreadyExists(occupied)
    root.RemoveFile("nested/conflict.bin") else error {
        discard error
        return 27
    }
    root.SetPermissions("nested/renamed.bin", 385) else error {
        discard error
        return 10
    }
    root.SetModified("nested/renamed.bin", 1700000000) else error {
        discard error
        return 11
    }
    discard root.Close()
    0
}

fn verifyTarget(path String, payload bytes.Bytes) i32 {
    const openedOutput = fs.OpenTree(path, 10, 4096) else error {
        discard error
        return 12
    }
    var output = openedOutput
    const directoryNext = output.Next() else error {
        discard error
        return 13
    }
    const directory = requiredEntry($directoryNext)
    const fileNext = output.Next() else error {
        discard error
        return 14
    }
    const file = requiredEntry($fileNext)
    if !text.Equal(directory.Path, "nested") || !kindIs(directory.Kind, 2) ||
        !text.Equal(file.Path, "nested/renamed.bin") || !kindIs(file.Kind, 1) ||
        file.Size != 14 || file.Permissions != expectedPermissions() ||
        file.Modified != 1700000000 {
        return 15
    }
    const copied = output.ReadFile(file.Path, 14) else error {
        discard error
        return 16
    }
    if !bytes.ConstantTimeEqual(payload, copied) return 17
    discard output.Close()
    0
}

fn cleanTarget(path String) i32 {
    const reopenedRoot = fs.OpenRoot(path) else error {
        discard error
        return 18
    }
    var cleanup = reopenedRoot
    cleanup.RemoveFile("nested/renamed.bin") else error {
        discard error
        return 19
    }
    cleanup.RemoveEmptyDirectory("nested") else error {
        discard error
        return 20
    }
    discard cleanup.Close()
    0
}

fn main(args [String]) i32 {
    const compatible = fs.TreeEntry {
        Path = "legacy"
        Kind = .Other
        Executable = false
        Size = 0
    }
    if compatible.Permissions != 0 || compatible.Modified != 0 return 21

    const sourceStatus = verifySource(args[0])
    if sourceStatus != 0 return sourceStatus
    const payload = binaryPayload()
    const writeStatus = writeTarget(args[1], payload)
    if writeStatus != 0 return writeStatus
    const verifyStatus = verifyTarget(args[1], payload)
    if verifyStatus != 0 return verifyStatus
    const cleanStatus = cleanTarget(args[1])
    if cleanStatus != 0 return cleanStatus

    print("fs tree ok")
    0
}
