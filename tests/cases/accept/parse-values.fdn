import std.parse
import std.format
import std.text
import std.time

fn valueOr(value Result<u64, parse.IntegerError>) u64 {
    match value {
        Ok(number): number
        Err(error): 0
    }
}

fn failed(value Result<u64, parse.IntegerError>) bool {
    match value {
        Ok(number): false
        Err(error): true
    }
}

fn boolFailed(value Result<bool, parse.BooleanError>) bool {
    match value {
        Ok(parsed): false
        Err(error): true
    }
}

fn boolMatches(value Result<bool, parse.BooleanError>, expected bool) bool {
    match value {
        Ok(parsed): parsed == expected
        Err(error): false
    }
}

fn boolMatchesWithWhitespace(codePoint u64) bool {
    var builder = text.NewBuilder()
    const opened = builder.WriteCodePoint(codePoint) else error {
        discard error
        return false
    }
    if !opened {
        return false
    }
    const token = builder.Write("YES") else error {
        discard error
        return false
    }
    if !token {
        return false
    }
    const closed = builder.WriteCodePoint(codePoint) else error {
        discard error
        return false
    }
    if !closed {
        return false
    }
    const value = builder.Finish() else error {
        discard error
        return false
    }
    const matches = boolMatches(parse.Bool(value), true)
    discard value
    matches
}

fn float64Matches(value Result<f64, parse.FloatError>, expected f64) bool {
    match value {
        Ok(parsed): parsed == expected
        Err(error): false
    }
}

fn float32Matches(value Result<f32, parse.FloatError>, expected f32) bool {
    match value {
        Ok(parsed): parsed == expected
        Err(error): false
    }
}

fn float64FailsAs(value Result<f64, parse.FloatError>, expected i32) bool {
    match value {
        Ok(parsed): false
        Err(error): match error {
            Empty: expected == 1
            Invalid: expected == 2
            OutOfRange: expected == 3
        }
    }
}

fn durationMatches(value Result<time.Duration, time.DurationError>, expected i64) bool {
    match value {
        Ok(duration): duration.Nanoseconds() == expected
        Err(error): false
    }
}

fn durationFailsAs(
    value Result<time.Duration, time.DurationError>,
    expected i32
) bool {
    match value {
        Ok(duration): false
        Err(error): match error {
            Empty: expected == 1
            Invalid: expected == 2
            OutOfRange: expected == 3
        }
    }
}

fn durationMatchesWithMicrosecond(codePoint u64) bool {
    var builder = text.NewBuilder()
    const prefix = builder.Write("12") else error {
        discard error
        return false
    }
    if !prefix return false
    const symbol = builder.WriteCodePoint(codePoint) else error {
        discard error
        return false
    }
    if !symbol return false
    const suffix = builder.Write("s") else error {
        discard error
        return false
    }
    if !suffix return false
    const value = builder.Finish() else error {
        discard error
        return false
    }
    const matches = durationMatches(time.Duration.Parse(value), 12000)
    discard value
    matches
}

fn main() i32 {
    const maximum = "18446744073709551615"
    const overflow = "18446744073709551616"
    const invalid = "12x"
    const empty = ""
    if valueOr(parse.U64(maximum)) != 18446744073709551615 ||
        !failed(parse.U64(overflow)) || !failed(parse.U64(invalid)) ||
        !failed(parse.U64(empty)) {
        return 1
    }
    const minimum = parse.I64("-9223372036854775808") else error {
        discard error
        return 2
    }
    if minimum != -9223372036854775807 - 1 {
        return 3
    }
    const signed8 = parse.I8("-128") else error {
        discard error
        return 4
    }
    if signed8 != -128 {
        return 5
    }
    const unsigned32 = parse.U32("4294967295") else error {
        discard error
        return 6
    }
    if unsigned32 != 4294967295 {
        return 7
    }
    const signedSize = parse.Isize("-1") else error {
        discard error
        return 8
    }
    const unsignedSize = parse.Usize("42") else error {
        discard error
        return 9
    }
    if signedSize != -1 || unsignedSize != 42 {
        return 10
    }
    const tooSmall = parse.I8("-129")
    const tooLarge = parse.U16("65536")
    const unsignedSign = parse.U64("-1")
    const tooSmallFailed = match tooSmall {
        Ok(value): false
        Err(error): true
    }
    const tooLargeFailed = match tooLarge {
        Ok(value): false
        Err(error): true
    }
    if !tooSmallFailed || !tooLargeFailed || !failed(unsignedSign) {
        return 11
    }
    if !boolMatches(parse.Bool("1"), true) || !boolMatches(parse.Bool("t"), true) ||
        !boolMatches(parse.Bool("true"), true) || !boolMatches(parse.Bool("yes"), true) ||
        !boolMatches(parse.Bool("y"), true) || !boolMatches(parse.Bool("on"), true) {
        return 12
    }
    if !boolMatches(parse.Bool("0"), false) || !boolMatches(parse.Bool("f"), false) ||
        !boolMatches(parse.Bool("false"), false) || !boolMatches(parse.Bool("no"), false) ||
        !boolMatches(parse.Bool("n"), false) || !boolMatches(parse.Bool("off"), false) {
        return 13
    }
    const enabled = parse.Bool(" YES\t") else error {
        discard error
        return 14
    }
    const disabled = parse.Bool("\nOff ") else error {
        discard error
        return 15
    }
    if !enabled || disabled || !boolFailed(parse.Bool("maybe")) ||
        !boolFailed(parse.Bool(" \t")) {
        return 16
    }
    if !boolMatchesWithWhitespace(133) || !boolMatchesWithWhitespace(160) ||
        !boolMatchesWithWhitespace(5760) || !boolMatchesWithWhitespace(8192) ||
        !boolMatchesWithWhitespace(8193) || !boolMatchesWithWhitespace(8194) ||
        !boolMatchesWithWhitespace(8195) || !boolMatchesWithWhitespace(8196) ||
        !boolMatchesWithWhitespace(8197) || !boolMatchesWithWhitespace(8198) ||
        !boolMatchesWithWhitespace(8199) || !boolMatchesWithWhitespace(8200) ||
        !boolMatchesWithWhitespace(8201) || !boolMatchesWithWhitespace(8202) ||
        !boolMatchesWithWhitespace(8232) || !boolMatchesWithWhitespace(8233) ||
        !boolMatchesWithWhitespace(8239) || !boolMatchesWithWhitespace(8287) ||
        !boolMatchesWithWhitespace(12288) {
        return 17
    }
    if !float64Matches(parse.F64("3.14"), 3.14) ||
        !float64Matches(parse.F64("1_2.5_0"), 12.5) ||
        !float64Matches(parse.F64("0x1.8p+1"), 3.0) ||
        !float64Matches(parse.F64("1e-5000"), 0.0) ||
        !float32Matches(parse.F32("0x1.8p+1"), 3.0) {
        return 18
    }
    const notANumber = parse.F64("NaN") else error {
        discard error
        return 19
    }
    const infinity = parse.F64("-Infinity") else error {
        discard error
        return 20
    }
    if format.F64(notANumber) != "NaN" || format.F64(infinity) != "-Infinity" {
        return 21
    }
    if !float64FailsAs(parse.F64(""), 1) ||
        !float64FailsAs(parse.F64(" 1"), 2) ||
        !float64FailsAs(parse.F64("1__2"), 2) ||
        !float64FailsAs(parse.F64("0x1.0"), 2) ||
        !float64FailsAs(parse.F64("1.7976931348623159e308"), 3) {
        return 22
    }
    if !durationMatches(time.Duration.Parse("0"), 0) ||
        !durationMatches(time.Duration.Parse("5.s"), 5000000000) ||
        !durationMatches(time.Duration.Parse(".5s"), 500000000) ||
        !durationMatches(time.Duration.Parse("1h2m3s4ms5us6ns"), 3723004005006) ||
        !durationMatches(time.Duration.Parse("-2m3.4s"), -123400000000) ||
        !durationMatches(time.Duration.Parse("9223372036854775807ns"), 9223372036854775807) ||
        !durationMatches(
        time.Duration.Parse("-9223372036854775808ns"),
        -9223372036854775807 - 1
    ) || !durationMatchesWithMicrosecond(181) || !durationMatchesWithMicrosecond(956) {
        return 23
    }
    if !durationFailsAs(time.Duration.Parse(""), 1) ||
        !durationFailsAs(time.Duration.Parse("1"), 2) ||
        !durationFailsAs(time.Duration.Parse("1d"), 2) ||
        !durationFailsAs(time.Duration.Parse("9223372036854775808ns"), 3) {
        return 24
    }
    print("parse ok")
    0
}
