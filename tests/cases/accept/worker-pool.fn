import foundation.worker

task calculate(limit i32, $message String) void {
    var current = 0
    while current < limit {
        current = current + 1
    }
    print(message)
}

task nested($message String) void {
    const child = spawn calculate(10000, $message)
    $child.wait()
}

task observeCancellation($receiver Receiver<void>) void {
    const received = receiver.receive()
    match received {
        Ok: panic("cancelled worker received an unexpected value")
        Err(error): match error {
            Closed: panic("cancelled worker channel closed")
            Cancelled: print("cancelled")
            Timeout: panic("cancelled worker timed out")
        }
    }
}

fn main() i32 {
    const pool = worker.NewPool(2)
    pool.Start(spawn calculate(20000, "work" + "er"))
    pool.Start(spawn calculate(20000, "work" + "er"))
    pool.Start(spawn nested("worker"))
    pool.Shutdown()
    print("done")

    const Channel { sender receiver } = channel<void>(0)
    const cancelled = worker.NewPool(1)
    cancelled.Start(spawn observeCancellation($receiver))
    cancelled.Cancel()
    discard sender
    0
}
