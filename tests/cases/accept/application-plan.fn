import foundation.actions
import foundation.di

contract Clock {
    fn Now(self) i32
}

service Fallible {
    ctor New() Result<bool> {
        .Ok(Fallible {})
    }
}

@di.Name("system")
@di.Scope(.Singleton)
service SystemClock implements Clock {
    ctor New() {
        SystemClock {}
    }

    fn Now(self) i32 {
        42
    }
}

@di.Scope(.Scoped)
service Greeter {
    prefix String

    ctor New(
        @di.From("system") clock Clock,
        $prefix String
    ) {
        discard clock
        Greeter { prefix = prefix }
    }

    ctor Empty() {
        Greeter { prefix = "" }
    }

    @actions.Name("greeter.greet")
    @actions.Key("ctrl+g")
    @actions.Policy("greet")
    action Greet(self, name String) String {
        self.prefix + name
    }
}

fn main() i32 {
    0
}
