struct Pair<T> {
    value T
    count i32
}

struct Holder {
    value String
}

struct Order {
    value i32
}

struct Marker {
    value i32

    fn drop(&self) void {
        print("marker")
    }
}

fn replacement(&order Order) String {
    order.value = order.value * 10 + 1
    "new"
}

fn position(&order Order) usize {
    order.value = order.value * 10 + 2
    0
}

fn takeIndex(value String) usize {
    discard value
    0
}

fn extract<T>($pair own Pair<T>) T {
    const Pair { value count } = pair
    if count != 1 {
        panic("invalid pair count")
    }
    value
}

fn main() i32 {
    const marker = Marker { value = 1 }
    const movedMarker = marker
    discard movedMarker

    var current = "first"
    const previous = replace current with "second"

    var holder = own Holder { value = "inside" }
    const inside = replace holder.value with "changed"

    var values = ["left", "right"]
    const left = replace values[0] with "updated"

    var order = Order { value = 0 }
    var ordered = ["old"]
    const old = replace ordered[position(&order)] with replacement(&order)
    if order.value != 12 || old != "old" || ordered[0] != "new" {
        panic("replace evaluation order changed")
    }

    var analyzed = ["old"]
    const token = "token"
    const analyzedPrevious = replace analyzed[takeIndex(token)] with token + "-new"

    const pair = own Pair { value = "payload" count = 1 }
    const payload = extract($pair)

    print(previous + current + inside + holder.value + left + values[0] +
          analyzedPrevious + analyzed[0] + payload)
    discard holder
    0
}
