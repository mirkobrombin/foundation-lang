fn add(left: i32, right: i32) -> i32 {
    return left + right;
}

fn left() -> bool {
    print("left");
    return false;
}

fn right() -> bool {
    print("right");
    return true;
}

fn first() -> i32 {
    print("first");
    return 1;
}

fn second() -> i32 {
    print("second");
    return 2;
}

fn echo(value: String) -> String {
    return value;
}

fn ignore(value: i32) -> i32 {
    return 0;
}

fn greet(message: String) -> void {
    print(message);
}

fn main() -> i32 {
    greet(echo("typed foundation"));
    let unused = 1;
    let minimum: i32 = -2147483648;
    let arithmetic = (8 - 2) * 2 / 4 % 2;
    let negative = -1;
    var total: i32 = 0;
    while total < 3 {
        total = total + 1;
    }
    if left() && right() {
        return 1;
    }
    if arithmetic != 1 || -negative != 1 {
        return 2;
    }
    if !(minimum <= -2147483648) || !(3 > 2 && 3 >= 3) {
        return 3;
    }
    if total == add(first(), second()) {
        return 0;
    } else {
        return 4;
    }
}
