fn combine(left u64, right u64) u64 {
    left + right
}

fn main() i32 {
    const bytes u64 = 11925602363
    const total = combine(bytes, 7)
    const product u64 = 6 * 7
    const quotient u64 = product / 2
    const remainder u64 = product % 5
    if total == 11925602370 && quotient == 21 && remainder == 2 && total > bytes {
        return 0
    } else {
        return 1
    }
}
