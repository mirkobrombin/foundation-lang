import foundation.worker
import std.concurrent

task finish($message String) void {
    print(message)
}

task observe($cancel concurrent.Cancellation) void {
    if cancel.IsRequested() {
        print("cancelled")
    }
}

task settle() void {}

fn main() i32 {
    const supervisor = worker.NewSupervisor()
    supervisor.Start(spawn finish("first"))
    supervisor.Start(spawn finish("second"))
    supervisor.Shutdown()

    const source = concurrent.NewCancellationSource()
    const cancelled = worker.NewSupervisor()
    cancelled.Start(spawn observe(source.Token()))
    cancelled.Cancel()

    const joining = worker.NewSupervisor()
    joining.Start(spawn settle())
    const waiting = joining.ShutdownTask()
    discard $waiting.wait()

    const stopping = worker.NewSupervisor()
    stopping.Start(spawn settle())
    const cancellation = stopping.CancelTask()
    discard $cancellation.wait()
    0
}
