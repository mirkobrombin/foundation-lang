import std.format

contract Readable {
    fn Read(self) i32
}

struct Tracked implements Readable {
    label String
    value i32

    fn Read(self) i32 {
        self.value
    }

    fn drop(&self) void {
        print("drop " + self.label)
    }
}

fn make(label String, value i32) Tracked {
    Tracked { label = label + " temporary" value = value }
}

fn makeOwned(label String, value i32) own Tracked {
    own Tracked { label = label + " owned temporary" value = value }
}

fn makeDynamic(label String, value i32) own Readable {
    own Tracked { label = label + " dynamic temporary" value = value }
}

fn inspect(value Tracked) i32 {
    value.value
}

fn sum(values [i32]) i32 {
    values[0] + values[1] + values[2]
}

fn main() i32 {
    const argument = inspect(make("argument", 7))
    print(format.I32(argument))
    const receiver = make("receiver", 9).Read()
    print(format.I32(receiver))
    const ownedArgument = inspect(makeOwned("argument", 11))
    print(format.I32(ownedArgument))
    const ownedReceiver = makeOwned("receiver", 13).Read()
    print(format.I32(ownedReceiver))
    const dynamicReceiver = makeDynamic("receiver", 15).Read()
    print(format.I32(dynamicReceiver))
    print(format.I32(sum(own [1, 2, 3])))
    0
}
