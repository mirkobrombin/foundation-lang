package example.counter

contract Counter {
    fn Add(edit, amount i32) void
    fn Read(view) i32
}

struct Memory implements Counter {
    Value i32

    fn Add(edit, amount i32) void {
        self.Value = self.Value + amount
    }

    fn Read(view) i32 {
        self.Value
    }
}

fn Apply(value edit Counter, amount i32) void {
    value.Add(amount)
}

fn Snapshot(value view Counter) i32 {
    value.Read()
}
