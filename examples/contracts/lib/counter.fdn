package example.counter

contract Counter {
    fn Add(&self, amount i32) void
    fn Read(self) i32
}

struct Memory implements Counter {
    Value i32

    fn Add(&self, amount i32) void {
        self.Value = self.Value + amount
    }

    fn Read(self) i32 {
        self.Value
    }
}

fn Apply(&value Counter, amount i32) void {
    value.Add(amount)
}

fn Snapshot(value Counter) i32 {
    value.Read()
}
