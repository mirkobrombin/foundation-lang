package example.collections

import std.collections
import std.text

struct Item {
    value i32
}

fn compareText(left view String, right view String) i32 {
    text.Compare(left, right)
}

fn main() i32 {
    var values = collections.NewList<String>()
    values.PushFront("one")
    values.PushFront("two")

    let first = values.PopFront()
    let second = values.PopFront()
    let missing = values.PopFront()

    let firstValue = match first {
        None: "missing"
        Some(value): value
    }
    let secondValue = match second {
        None: "missing"
        Some(value): value
    }
    let missingValue = match missing {
        None: "empty"
        Some(value): value
    }

    var owned = collections.NewList<own Item>()
    owned.PushFront(own Item { value = 42 })
    let ownedValue = match owned.PopFront() {
        None: 0
        Some(item): item.value
    }

    var cleared = collections.NewList<String>()
    cleared.PushFront("discarded")
    cleared.Clear()

    var unsorted = collections.NewList<String>()
    unsorted.PushFront("b")
    unsorted.PushFront("a")
    unsorted.PushFront("c")
    let compare fn(view String, view String) i32 = compareText
    var sorted = collections.Sort(unsorted, view compare)
    let firstSorted = match sorted.PopFront() {
        None: ""
        Some(value): value
    }
    let secondSorted = match sorted.PopFront() {
        None: ""
        Some(value): value
    }
    let thirdSorted = match sorted.PopFront() {
        None: ""
        Some(value): value
    }

    print(firstValue + secondValue + missingValue)
    print(firstSorted + secondSorted + thirdSorted)
    if values.IsEmpty() && values.Len() == 0 && ownedValue == 42 && cleared.IsEmpty() &&
        sorted.IsEmpty() {
        return 0
    }
    1
}
