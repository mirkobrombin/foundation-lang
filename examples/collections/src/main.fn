package example.collections

import std.collections
import std.text

struct Item {
    value i32
}

fn compareText(left String, right String) i32 {
    text.Compare(left, right)
}

fn main() i32 {
    var values = collections.NewList<String>()
    values.PushFront("one")
    values.PushFront("two")

    const first = values.PopFront()
    const second = values.PopFront()
    const missing = values.PopFront()

    const firstValue = match first {
        None: "missing"
        Some(value): value
    }
    const secondValue = match second {
        None: "missing"
        Some(value): value
    }
    const missingValue = match missing {
        None: "empty"
        Some(value): value
    }

    var owned = collections.NewList<own Item>()
    owned.PushFront(own Item { value = 42 })
    const ownedValue = match owned.PopFront() {
        None: 0
        Some(item): item.value
    }

    var cleared = collections.NewList<String>()
    cleared.PushFront("discarded")
    cleared.Clear()

    var unsorted = collections.NewList<String>()
    unsorted.PushFront("b")
    unsorted.PushFront("a")
    unsorted.PushFront("c")
    const compare fn(String, String) i32 = compareText
    var sorted = collections.Sort($unsorted, compare)
    const firstSorted = match sorted.PopFront() {
        None: ""
        Some(value): value
    }
    const secondSorted = match sorted.PopFront() {
        None: ""
        Some(value): value
    }
    const thirdSorted = match sorted.PopFront() {
        None: ""
        Some(value): value
    }

    print(firstValue + secondValue + missingValue)
    print(firstSorted + secondSorted + thirdSorted)
    if values.IsEmpty() && values.Len() == 0 && ownedValue == 42 && cleared.IsEmpty() &&
        sorted.IsEmpty() {
        return 0
    }
    1
}
