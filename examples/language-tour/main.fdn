// This program tracks the complete executable language subset.

package tour

import std.collections
import std.env
import std.format
import std.json
import std.path
import std.platform
import std.text
import std.time

@target(linux)
fn expectedPlatform() String {
    "linux"
}

@target(macos)
fn expectedPlatform() String {
    "macos"
}

@target(windows)
fn expectedPlatform() String {
    "windows"
}

// A bodyless C ABI declaration imports its explicit C symbol. It is unused here so the tour
// remains runnable without a native input.
extern c fn nativeProbe() i32 as foundation_native_probe

// A C ABI declaration with a body exports its Foundation implementation.
extern c fn FoundationProbe(value i32) i32 as foundation_tour_probe {
    value
}

struct TourResult<T> {
    message String
    code T
}

struct TourOwned {
    label String
    count i32
}

struct TourResource {
    label String

    fn drop(edit) void {
        self.label = ""
    }
}

enum TourState<T> {
    Running
    Done(TourResult<T>)
}

contract Counter {
    fn read(view) i32
    fn increment(edit) void
}

struct TourCounter implements Counter {
    value i32

    fn read(view) i32 {
        self.value
    }

    fn increment(edit) void {
        self.value = self.value + 1
    }
}

fn readCounter(counter view Counter) i32 {
    counter.read()
}

fn incrementCounter(counter edit Counter) void {
    counter.increment()
}

fn sum(values view [i32]) i32 {
    values[0] + values[1] + values[2]
}

fn clearFirst(values edit [i32]) void {
    values[0] = 0
}

fn printFirst(values view [String]) void {
    print(values[0])
}

fn identity<T>(value T) T {
    value
}

fn apply<T>(value T, operation view fn(T) T) T {
    operation(value)
}

fn typeMarker<T>() void {
    return
}

fn maybeOr(value Option<i32>, fallback i32) i32 {
    match value {
        None: fallback
        Some(number): number
    }
}

fn resultOr(value Result<i32, bool>, fallback i32) i32 {
    match value {
        Ok(number): number
        Err(failed): fallback
    }
}

fn isEven(value i32) bool {
    value % 2 == 0
}

fn inRange(value i32, minimum i32, maximum i32) bool {
    value >= minimum && value <= maximum
}

fn parsedTruth(value json.Value) bool {
    match value {
        Bool(flag): flag
        Null: false
        Number(number): false
        Text(content): false
        Array(items): false
        Object(fields): false
    }
}

fn showKind(value i32) void {
    if isEven(value) {
        print("even")
    } else {
        print("odd")
    }
}

fn main(args view [String]) i32 {
    print("Foundation language tour")
    discard env.Home()
    typeMarker<Result<i32, bool>>()

    let first i32 = 1
    let byteCount u64 = 11925602363
    let nextByteCount = byteCount + 1
    let count = 4
    var current = first
    let typedIdentity fn(i32) i32 = identity<i32>
    let copied = 2
    let copyCallback = fn(value i32) i32 capture copied {
        value + copied
    }
    let base = 3
    let viewCallback = fn(value i32) i32 capture view base {
        value + base
    }
    var total = 4
    let editCallback = fn(value i32) i32 capture edit total {
        total = total + value
        total
    }
    let label = "owned"
    let ownCallback = fn() i32 capture own label {
        if label == "owned" {
            return 1
        }
        0
    }
    let callbackValue = apply(1, view typedIdentity) + copyCallback(1) +
        viewCallback(1) + editCallback(1) + ownCallback()
    var counter = own TourCounter { value = 0 }
    incrementCounter(edit counter)
    let counterValue = readCounter(view counter)
    let directCounterValue = counter.read()

    var numbers = [1, 2, 3]
    clearFirst(edit numbers)
    let sequenceValue = sum(view numbers)
    var labels = ["arrays", " and slices"]
    let sequenceLabel = labels[0] + labels[1]
    print(sequenceLabel)
    labels[1] = " updated"
    let ownedLabels = own ["owned arrays"]
    printFirst(view ownedLabels)
    discard ownedLabels

    var phase = "before"
    let previousPhase = replace phase with "after"
    print(previousPhase + phase)
    let TourOwned { label as destructuredLabel count as destructuredCount } =
        own TourOwned { label = "destructured" count = 1 }
    if destructuredCount == 1 {
        print(destructuredLabel)
    }
    let resource = own TourResource { label = "cleanup" }
    discard resource

    var list = collections.NewList<String>()
    list.PushFront("list item")
    let listItem = match list.PopFront() {
        None: "missing list item"
        Some(value): value
    }
    print(listItem)

    while current <= count {
        showKind(current)
        current = current + 1
    }

    let result = TourResult {
        code = identity(current - 5)
        message = "done"
    }
    let optional = Option.Some(result.code)
    print(result.message)
    let state = TourState.Done(result)
    let delivered = Result<i32, bool>.Ok(maybeOr(optional, 1))
    let deliveredValue = delivered else failed {
        if failed {
            panic("delivery failed")
        }
        return 1
    }
    let epoch = time.FromUnix(0)
    let epochText = epoch.FormatUtc() else error {
        discard error
        return 1
    }
    let timeMatches = epochText == "1970-01-01T00:00:00Z"
    discard Result<i32, bool>.Err(false)
    let movedCounter = counter
    discard movedCounter
    let platformMatches = platform.Name(platform.Current()) == expectedPlatform()
    let pathBase = "/tmp"
    let pathChild = "foundation"
    let joinedPath = path.Join(view pathBase, view pathChild)
    let pathPart = "foundation"
    let pathMatches = text.Contains(view joinedPath, view pathPart)
    let jsonSource = "true"
    let decoded = json.Parse(view jsonSource) else error {
        discard error
        return 1
    }
    let jsonMatches = parsedTruth(decoded)
    let verified = Result<i32, bool>.Ok(deliveredValue)
    let argumentCount = len(args)
    let formattedCount = format.U64(argumentCount)
    discard formattedCount
    if (inRange(current, 5, 5) || false) && nextByteCount == 11925602364 &&
        platformMatches && pathMatches && jsonMatches && timeMatches && argumentCount == 0 {
        return match state {
            Running: resultOr(verified, 0) + counterValue + directCounterValue + sequenceValue + callbackValue - 20
            Done(done): resultOr(verified, done.code) + counterValue + directCounterValue + sequenceValue + callbackValue - 21
        }
    } else {
        discard verified
    }

    1
}
