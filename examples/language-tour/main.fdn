// This program tracks the complete executable language subset.

struct TourResult {
    message: String
    code: i32
}

enum TourState {
    Running
    Done(result: TourResult)
}

fn is_even(value: i32) -> bool {
    return value % 2 == 0;
}

fn in_range(value: i32, minimum: i32, maximum: i32) -> bool {
    return value >= minimum && value <= maximum;
}

fn show_kind(value: i32) -> void {
    if is_even(value) {
        print("even");
    } else {
        print("odd");
    }
}

fn main() -> i32 {
    print("Foundation language tour");

    let first: i32 = 1;
    let count = 4;
    var current = first;

    while current <= count {
        show_kind(current);
        current = current + 1;
    }

    let result = TourResult {
        code: current - 5
        message: "done"
    };
    let state = TourState::Done(result);
    if in_range(current, 5, 5) || false {
        print(result.message);
        return match state {
            TourState::Running => 1
            TourState::Done(done) => done.code
        };
    }

    return 1;
}
