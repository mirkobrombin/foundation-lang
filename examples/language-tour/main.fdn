// This program tracks the complete executable language subset.

package tour

import foundation.worker
import std.collections
import std.concurrent
import std.env
import std.format
import std.fs
import std.json
import std.path
import std.platform
import std.parse
import std.text
import std.time

@target(linux)
fn expectedPlatform() String {
    "linux"
}

@target(macos)
fn expectedPlatform() String {
    "macos"
}

@target(windows)
fn expectedPlatform() String {
    "windows"
}

// A blocking bodyless C ABI declaration imports its explicit symbol. It is unused here so the
// tour remains runnable without a native input while still checking the annotation.
@blocking
extern c fn nativeProbe() i32 as foundation_native_probe

// A callback bodyless C ABI declaration imports an asynchronous start symbol and optional cancel
// symbol. It also remains unused so the tour does not require a native input.
@callback(cancel = foundation_native_probe_cancel)
extern c fn nativeCallbackProbe(&result i32) i32 as foundation_native_probe_start

// A C ABI declaration with a body exports its Foundation implementation.
extern c fn FoundationProbe(value i32) i32 as foundation_tour_probe {
    value
}

enum TourCommand {
    Show
}

struct TourMetadata {
    public bool
    codes [2]i32
}

attribute TourRoute(
    command TourCommand,
    path String,
    metadata TourMetadata,
    fallback Option<String>
) targets(fn)
attribute TourLabel(value String) targets(struct, field, variant, method, parameter) repeatable

@TourLabel("result")
struct TourResult<T> {
    message String = "done"

    @TourLabel("status")
    code T
}

struct TourOwned {
    label String
    count i32
}

struct TourResource {
    label String

    fn drop(&self) void {
        self.label = ""
    }
}

enum TourState<T> {
    Running

    @TourLabel("completed")
    Done(result TourResult<T>)
}

contract ReadableCounter {
    fn read(self) i32
}

contract Counter extends ReadableCounter {
    fn increment(&self) void

    fn incrementTwice(&self) void {
        self.increment()
        self.increment()
    }
}

struct TourCounter implements Counter {
    value i32

    @TourLabel("reader")
    fn read(self) i32 {
        self.value
    }

    fn increment(&self) void {
        self.value = self.value + 1
    }
}

struct TourCounterProxy implements Counter {
    counter TourCounter

    delegate counter as Counter
}

fn readCounter(@TourLabel("counter") counter Counter) i32 {
    counter.read()
}

fn incrementCounter(&counter Counter) void {
    counter.increment()
}

fn makeCounter(value i32) own Counter {
    own TourCounter { value = value }
}

fn sum(values [i32]) i32 {
    values[0] + values[1] + values[2]
}

fn clearFirst(&values [i32]) void {
    values[0] = 0
}

fn printFirst(values [String]) void {
    print(values[0])
}

fn identity<T>($value T) T {
    value
}

task backgroundIdentity<T>($value T) T {
    value
}

task observeCancellation($cancel concurrent.Cancellation) bool {
    cancel.IsRequested()
}

task nestedBackgroundIdentity(value i32) i32 {
    const child = spawn backgroundIdentity<i32>(value)
    const result = $child.wait()
    result
}

fn printChannelMessage(message String) bool {
    print(message)
    true
}

fn rejectChannelMessage(error ChannelError) bool {
    discard error
    false
}

task sendChannelMessage($sender Sender<String>) void {
    discard sender.send("channel message")
}

task receiveChannelMessage($receiver Receiver<String>) bool {
    select {
        const message = receiver.receive(): return printChannelMessage(message)
        timeout 1.seconds: return false
        else error: return rejectChannelMessage(error)
    }
}

task supervisedMessage() void {
    print("supervised task")
}

task parallelMessage($message String) void {
    print(message)
}

fn apply<T>($value T, operation fn(T) T) T {
    operation(value)
}

fn typeMarker<T>() void {
    return
}

fn maybeOr(value Option<i32>, fallback i32) i32 {
    match value {
        None: fallback
        Some(number): number
    }
}

fn resultOr(value Result<i32, bool>, fallback i32) i32 {
    match value {
        Ok(number): number
        Err(failed): fallback
    }
}

fn isEven(value i32) bool {
    value % 2 == 0
}

fn inRange(value i32, minimum i32, maximum i32) bool {
    value >= minimum && value <= maximum
}

fn parsedTruth($value json.Value) bool {
    match value {
        Bool(flag): flag
        Null: false
        Number(number): false
        Text(content): false
        Array(items): false
        Object(fields): false
    }
}

state_machine TourFlow {
    state Ready
    state Finished(value i32)

    on Finish(value i32) from Ready to Finished(value)
}

fn pipelineDouble(value i32) Result<i32, bool> {
    .Ok(value * 2)
}

fn pipelineAddOne(value i32) Result<i32, bool> {
    .Ok(value + 1)
}

pipeline TourTransform(input i32) Result<i32, bool> {
    step double using pipelineDouble retry exponential(max = 2)
    step add using pipelineAddOne
}

fn sagaOpen(value i32) Result<void, bool> {
    discard value
    .Ok
}

fn sagaClose(value i32) Result<void, bool> {
    discard value
    .Ok
}

fn sagaFinish(value i32) Result<i32, bool> {
    .Ok(value)
}

saga TourSaga(input i32) Result<i32, bool> {
    step open using sagaOpen
        compensate sagaClose
    step finish using sagaFinish
}

@TourRoute(.Show, "/tour/:value", TourMetadata { public = true codes = [200, 404] }, .None)
fn showKind(value i32) void {
    if isEven(value) {
        print("even")
    } else {
        print("odd")
    }
}

fn main(args [String]) i32 {
    print("Foundation language tour")
    discard env.Home()
    typeMarker<Result<i32, bool>>()

    const first i32 = 1
    const byteCount u64 = 11925602363
    const nextByteCount = byteCount + 1
    const count = 4
    const small i8 = 120
    const widened i64 = i64.From(small)
    const narrowed = i8.From(count) else error {
        discard error
        return 1
    }
    const decimal32 f32 = 1.5
    const decimal64 f64 = f64.From(decimal32)
    var current = first
    const typedIdentity fn(i32) i32 = identity<i32>
    const copied = 2
    const copyCallback fn(i32) i32 = fn(value) capture(copied) {
        value + copied
    }
    const base = 3
    const viewCallback = fn(value i32) i32 capture(base) {
        value + base
    }
    var total = 4
    const editCallback = fn(value i32) i32 capture(&total) {
        total = total + value
        total
    }
    const label = "owned"
    const emptyLabel = ""
    const emptyStringMatches = !emptyLabel
    const ownCallback = fn() i32 capture($label) {
        if label == "owned" {
            return 1
        }
        0
    }
    const callbackValue = apply(1, typedIdentity) + copyCallback(1) +
        viewCallback(1) + editCallback(1) + ownCallback()
    var counter = own TourCounter { value = 0 }
    incrementCounter(&counter)
    const counterValue = readCounter(counter)
    const directCounterValue = counter.read()
    var counterProxy = TourCounterProxy { counter = TourCounter { value = 0 } }
    counterProxy.incrementTwice()
    const proxyCounterValue = readCounter(counterProxy)
    var dynamicCounter = makeCounter(0)
    incrementCounter(&dynamicCounter)
    const dynamicCounterValue = readCounter(dynamicCounter)
    discard dynamicCounter

    var numbers = [1, 2, 3]
    clearFirst(&numbers)
    const sequenceValue = sum(numbers)
    var iteratedValue = 0
    for index, value in numbers {
        if index == 1 continue
        iteratedValue = iteratedValue + value
    }
    for &value in numbers {
        value = value + 1
    }
    const editedSequence = numbers[0] == 1 && numbers[1] == 3 && numbers[2] == 4
    var labels = ["arrays", " and slices"]
    const sequenceLabel = labels[0] + labels[1]
    print(sequenceLabel)
    labels[1] = " updated"
    const ownedLabels = own ["owned arrays"]
    printFirst(ownedLabels)
    discard ownedLabels

    var phase = "before"
    const previousPhase = replace phase with "after"
    print(previousPhase + phase)
    const TourOwned { label as destructuredLabel count as destructuredCount } =
        own TourOwned { label = "destructured" count = 1 }
    if destructuredCount == 1 {
        print(destructuredLabel)
    }
    const resource = own TourResource { label = "cleanup" }
    discard resource

    var list = collections.NewList<String>()
    list.PushFront("list item")
    const listItem = match list.PopFront() {
        None: "missing list item"
        Some(value): value
    }
    const emptyListMatches = !list
    print(listItem)

    while current <= count {
        showKind(current)
        current = current + 1
    }

    const result = TourResult {
        code = identity(current - 5)
    }
    const optional = Option.Some(result.code)
    print(result.message)
    const state = TourState.Done(result = result)
    const delivered = Result<i32, bool>.Ok(maybeOr(optional, 1))
    const deliveredValue = delivered else failed {
        if failed {
            panic("delivery failed")
        }
        return 1
    }
    const epoch = time.FromUnix(0)
    const epochText = epoch.FormatUtc() else error {
        discard error
        return 1
    }
    const parsedFloat = parse.F64("0x1.5p+5") else error {
        discard error
        return 1
    }
    const parsedDuration = time.Duration.Parse("1m30.5s") else error {
        discard error
        return 1
    }
    const timeMatches = epochText == "1970-01-01T00:00:00Z" && parsedFloat == 42.0 &&
        parsedDuration.Nanoseconds() == 90500000000
    const canonicalUUID = "01890f47-9b5a-7cc1-98f2-b6b9c317d28a"
    const parsedUUID = UUID.Parse(canonicalUUID) else error {
        discard error
        return 1
    }
    const firstUUID = UUID.NewV7()
    const secondUUID = UUID.NewV7()
    const uuidMatches = parsedUUID.String() == canonicalUUID && !parsedUUID.IsNil() &&
        UUID.Nil().IsNil() && firstUUID.Compare(secondUUID) < 0
    const conditionalValue = if timeMatches {
        const baseValue = 40
        baseValue + 2
    } else {
        0
    }
    const postfixValue = 42 if conditionalValue == 42 else 0
    discard Result<i32, bool>.Err(false)
    const movedCounter = counter
    discard movedCounter
    const platformMatches = platform.Name(platform.Current()) == expectedPlatform()
    const pathBase = "/tmp"
    const pathChild = "foundation"
    const joinedPath = path.Join(pathBase, pathChild)
    const pathPart = "foundation"
    const pathMatches = text.Contains(joinedPath, pathPart)
    const jsonSource = "true"
    const decoded = json.Parse(jsonSource) else error {
        discard error
        return 1
    }
    const jsonMatches = parsedTruth($decoded)
    var workflow TourFlow = .Ready
    workflow.Finish(42) else transition {
        discard transition
        return 1
    }
    const workflowValue = match workflow {
        Ready: 0
        Finished(value): value
    }
    const pipelineValue = TourTransform(20) else error {
        discard error
        return 1
    }
    const sagaValue = TourSaga(42) else failure {
        discard failure
        return 1
    }
    const verified = Result<i32, bool>.Ok(deliveredValue)
    const argumentCount = len(args)
    const formattedCount = format.Usize(argumentCount)
    discard formattedCount
    const pendingIdentity = spawn backgroundIdentity<i32>(42)
    const backgroundValue = $pendingIdentity.wait()
    const nestedPendingIdentity = spawn nestedBackgroundIdentity(42)
    const nestedBackgroundValue = $nestedPendingIdentity.wait()
    const cancellation = concurrent.NewCancellationSource()
    const beforeCancellationPending = spawn observeCancellation(cancellation.Token())
    const beforeCancellation = $beforeCancellationPending.wait()
    cancellation.Cancel()
    const afterCancellationPending = spawn observeCancellation(cancellation.Token())
    const afterCancellation = $afterCancellationPending.wait()
    const Channel { sender receiver } = channel<String>(0)
    const sendingMessage = spawn sendChannelMessage($sender)
    const receivingMessage = spawn receiveChannelMessage($receiver)
    $sendingMessage.wait()
    const channelMatches = $receivingMessage.wait()
    const background = worker.NewSupervisor()
    background.Start(spawn supervisedMessage())
    background.Shutdown()
    const workers = worker.NewPool(2)
    workers.Start(spawn parallelMessage("parallel " + "task"))
    workers.Start(spawn parallelMessage("parallel " + "task"))
    workers.Shutdown()
    if (inRange(current, 5, 5) || false) && nextByteCount == 11925602364 &&
        platformMatches && pathMatches && jsonMatches && timeMatches && argumentCount == 0 &&
        uuidMatches &&
        proxyCounterValue == 2 && dynamicCounterValue == 1 && backgroundValue == 42 &&
        nestedBackgroundValue == 42 && iteratedValue == 3 && editedSequence &&
        !beforeCancellation && afterCancellation && channelMatches && postfixValue == 42 &&
        widened == 120 && narrowed == 4 && decimal64 == 1.5 && emptyStringMatches &&
        emptyListMatches && workflowValue == 42 && pipelineValue == 41 && sagaValue == 42 {
        return match state {
            Running: resultOr(verified, 0) + counterValue + directCounterValue +
                sequenceValue + callbackValue - 20
            Done(done): resultOr(verified, done.code) + counterValue + directCounterValue +
                sequenceValue + callbackValue - 21
        }
    } else {
        discard verified
    }

    1
}
