package example.web

import foundation.di
import foundation.openapi
import foundation.web
import std.collections
import std.format
import std.net
import std.text

enum ApiError {
    Disabled
}

@di.Scope(.Singleton)
service AppInfo {
    name String
    version String

    @di.Inject()
    fn New() AppInfo {
        AppInfo { name = "Foundation Web" version = "0.1.0" }
    }

    fn Label(self) String {
        text.Copy(self.name) + " " + text.Copy(self.version)
    }
}

@di.Scope(.Scoped)
service RequestInfo {
    marker String

    @di.Inject()
    fn New() RequestInfo {
        RequestInfo { marker = "request" }
    }

    fn Ready(self) bool {
        self.marker == "request"
    }
}

@di.Scope(.Transient)
service UserPresenter {
    ready bool

    @di.Inject()
    fn New(requestInfo RequestInfo, info AppInfo) UserPresenter {
        UserPresenter {
            ready = requestInfo.Ready() && info.Label() == "Foundation Web 0.1.0"
        }
    }

    fn Ready(self) bool {
        self.ready
    }
}

@web.GlobalMiddleware(10)
fn responseMetadata<E>(
    $request web.Request,
    next fn($web.Request) Result<web.Response, web.DispatchError<E>>
) Result<web.Response, web.DispatchError<E>> {
    addServerHeader<E>($next($request))
}

@web.GroupMiddleware("/users", 10)
fn requireApiKey<E>(
    $request web.Request,
    next fn($web.Request) Result<web.Response, web.DispatchError<E>>
) Result<web.Response, web.DispatchError<E>> {
    var active = request
    const apiKey = active.Header("X-Api-Key")
    const accepted = match apiKey {
        None: false
        Some(value): value == "foundation-demo"
    }
    if !accepted {
        discard active
        return .Ok(web.Text(401, "missing api key"))
    }
    next($active)
}

fn addServerHeader<E>(
    $value Result<web.Response, web.DispatchError<E>>
) Result<web.Response, web.DispatchError<E>> {
    match value {
        Ok(response): .Ok(withServerHeader($response))
        Err(error): .Err(error)
    }
}

fn withServerHeader($response web.Response) web.Response {
    const web.Response { Status Headers Body } = response
    var activeHeaders = Headers
    activeHeaders.PushFront(web.HeaderValue {
        Name = "Server"
        Value = "Foundation"
    })
    web.Response { Status = Status Headers = activeHeaders Body = Body }
}

@openapi.Summary("Show application information")
@openapi.Response(200, "Application information")
@web.Route(.GET, "/")
fn Index(@web.Inject() info AppInfo) web.Response {
    web.Text(200, info.Label())
}

@openapi.Summary("Check service health")
@openapi.Response(200, "Service is healthy")
@web.Route(.GET, "/health")
task Health() web.Response {
    web.Json(200, "{\"status\":\"healthy\"}")
}

@openapi.Summary("Find a user")
@openapi.Response(200, "User found")
@openapi.Response(401, "API key missing")
@web.Route(.GET, "/users/{id:alpha}")
fn GetUser(
    @web.Path("id") id String,
    @web.Query("limit") @openapi.Minimum(1) limit i32,
    @web.Query("note") $note Option<String>,
    @web.Header("X-Trace") trace String,
    @web.Inject() requestInfo RequestInfo,
    @web.Inject() presenter UserPresenter,
    @web.Inject() info AppInfo
) web.Response {
    if !requestInfo.Ready() || !presenter.Ready() {
        return web.Text(500, "request activation failed")
    }
    const noteValue = match note {
        None: "none"
        Some(value): value
    }
    const body = info.Label() + " user=" + text.Copy(id) +
        " limit=" + format.I32(limit) + " note=" + noteValue +
        " trace=" + text.Copy(trace)
    web.Text(200, $body)
}

@openapi.Summary("Create a user")
@openapi.Response(201, "User created")
@openapi.Response(401, "API key missing")
@web.Route(.POST, "/users/{id:alpha}")
fn CreateUser(
    @web.Path("id") id String,
    @web.Header("X-Enabled") enabled bool,
    @web.Body() body String
) Result<web.Response, ApiError> {
    if !enabled return .Err(.Disabled)
    .Ok(web.Text(201, "created " + text.Copy(id) + ": " + text.Copy(body)))
}

@openapi.Summary("Log in")
@openapi.Response(200, "Login accepted")
@web.Route(.POST, "/login")
fn Login(@web.Form("username") username String) web.Response {
    web.Text(200, "welcome " + text.Copy(username))
}

fn newRequest(method web.Method, $target String, $path String) web.Request {
    web.Request {
        Method = method
        Target = target
        Path = path
        Version = "HTTP/1.1"
        Headers = collections.NewList<web.HeaderValue>()
        Params = collections.NewList<web.Parameter>()
    }
}

fn responseOr(
    $value Result<web.Response, web.DispatchError<FoundationWebError>>
) web.Response {
    match value {
        Ok(response): response
        Err(error): dispatchPanic($error)
    }
}

fn dispatchPanic($error web.DispatchError<FoundationWebError>) never {
    discard error
    panic("web example dispatch failed")
}

fn bodyOf($response web.Response) String {
    const web.Response { Status Headers Body } = response
    discard Status
    discard Headers
    Body
}

fn serverOr(
    $value Result<own web.Server<FoundationWebError>, net.Error>
) own web.Server<FoundationWebError> {
    const server = value else error {
        discard error
        panic("web example server bind failed")
    }
    server
}

fn served($value Result<void, web.ServeError<FoundationWebError>>) bool {
    match value {
        Ok: true
        Err(error): serveFailure($error)
    }
}

fn serveFailure($error web.ServeError<FoundationWebError>) bool {
    discard error
    false
}

fn serveForever() i32 {
    const application = BuildFoundationApplication()
    var server = serverOr(web.NewServer<FoundationWebError>(
        "127.0.0.1",
        8080,
        $application
        ))
    print("listening on http://127.0.0.1:" + format.U64(server.Port()))

    while true {
        const serving = server.ServeOne()
        const outcome = $serving.wait()
        const web.ServeOutcome { Server Value } = outcome
        server = Server
        if !served($Value) return 1
    }
    0
}

fn selfTest() i32 {
    var application = BuildFoundationApplication()

    var lookup = newRequest(
        .GET,
        "/users/Ada?limit=10&note=demo",
        "/users/Ada"
    )
    lookup.Headers.PushFront(web.HeaderValue {
        Name = "X-Trace"
        Value = "local"
    })
    lookup.Headers.PushFront(web.HeaderValue {
        Name = "X-Api-Key"
        Value = "foundation-demo"
    })
    const lookupResponse = responseOr($application.Dispatch($lookup))
    if bodyOf($lookupResponse) !=
        "Foundation Web 0.1.0 user=Ada limit=10 note=demo trace=local" {
        return 1
    }

    const unauthorized = newRequest(.GET, "/users/Ada?limit=10", "/users/Ada")
    const unauthorizedResponse = responseOr($application.Dispatch($unauthorized))
    const web.Response { Status Headers Body } = unauthorizedResponse
    discard Headers
    if Status != 401 || Body != "missing api key" return 2

    var create = newRequest(.POST, "/users/Ada", "/users/Ada")
    create.Body = "profile body"
    create.Headers.PushFront(web.HeaderValue {
        Name = "X-Enabled"
        Value = "true"
    })
    create.Headers.PushFront(web.HeaderValue {
        Name = "X-Api-Key"
        Value = "foundation-demo"
    })
    const createResponse = responseOr($application.Dispatch($create))
    if bodyOf($createResponse) != "created Ada: profile body" return 3

    var login = newRequest(.POST, "/login", "/login")
    login.Body = "username=Ada+Lovelace"
    const loginResponse = responseOr($application.Dispatch($login))
    if bodyOf($loginResponse) != "welcome Ada Lovelace" return 4

    print("web app example ok")
    0
}

fn main(args [String]) i32 {
    if len(args) > 0 && args[0] == "--serve" return serveForever()
    selfTest()
}
