package example.state_machine

import foundation.events
import foundation.fsm
import std.text
import std.time

// Tracks an order through submission, payment, or cancellation.
state_machine Order {
    // The order has not been submitted.
    state Draft

    // The order is waiting for payment.
    state Submitted

    // The order has a recorded payment receipt.
    state Paid(receipt i32)

    // The order stopped with an owned reason.
    state Cancelled(reason String)

    // Submits a draft order.
    on Submit from Draft to Submitted

    // Records payment for a submitted order.
    on Pay(receipt i32) from Submitted to Paid(receipt)

    // Cancels an order before payment.
    on Cancel($reason String) from Draft, Submitted to Cancelled(reason)
}

// Identifies the application event that requested a transition.
enum OrderTrigger {
    // Requests draft submission.
    Submit

    // Requests payment.
    Pay

    // Requests cancellation.
    Cancel
}

// Represents a lifecycle listener failure in this example.
enum LogError {
    // The listener rejected an event.
    Rejected
}

fn cloneOrder(value Order) Order {
    match value {
        Draft: .Draft
        Submitted: .Submitted
        Paid(receipt): .Paid(receipt = receipt)
        Cancelled(reason): .Cancelled(reason = text.Copy(reason))
    }
}

fn cloneTrigger(value OrderTrigger) OrderTrigger {
    match value {
        Submit: .Submit
        Pay: .Pay
        Cancel: .Cancel
    }
}

fn submitTransition(&order Order) Result<void, OrderTransitionError> {
    order.Submit()
}

fn payTransition(&order Order) Result<void, OrderTransitionError> {
    order.Pay(42)
}

fn observe(event fsm.Event<Order, OrderTrigger>) Result<void, LogError> {
    match event.Type {
        BeforeTransition: print("before")
        ExitState: print("exit")
        EnterState: print("enter")
        AfterTransition: print("after")
    }
    .Ok
}

fn submissionGuard(
    event fsm.GuardEvent<Order, OrderTrigger>
) Result<void, OrderTransitionError> {
    const sourceIsDraft = isDraft(event.From)
    const destinationIsSubmitted = isSubmitted(event.To)
    const requestedSubmission = isSubmit(event.Trigger)
    if sourceIsDraft && destinationIsSubmitted && requestedSubmission return .Ok
    .Err(.InvalidState)
}

fn isDraft(value Order) bool {
    match value {
        Draft: true
        _: false
    }
}

fn isSubmitted(value Order) bool {
    match value {
        Submitted: true
        _: false
    }
}

fn isSubmit(value OrderTrigger) bool {
    match value {
        Submit: true
        _: false
    }
}

fn recordExit(
    event fsm.Event<Order, OrderTrigger>
) Result<void, OrderTransitionError> {
    discard event
    print("effect exit")
    .Ok
}

fn recordEnter(
    event fsm.Event<Order, OrderTrigger>
) Result<void, OrderTransitionError> {
    discard event
    print("effect enter")
    .Ok
}

fn managedDemo() i32 {
    var initial Order = .Draft
    var machine = fsm.New<Order, OrderTrigger, OrderTransitionError, LogError>(
        $initial,
        $cloneOrder,
        $cloneTrigger
    )
    machine.Guard($submissionGuard, events.Priority.Normal) else error {
        discard error
        return 1
    }
    machine.OnExit($recordExit, events.Priority.Normal) else error {
        discard error
        return 1
    }
    machine.OnEnter($recordEnter, events.Priority.Normal) else error {
        discard error
        return 1
    }
    machine.Subscribe($observe, events.Priority.Normal) else error {
        discard error
        return 1
    }
    const applied = machine.Apply(.Submit, $submitTransition) else error {
        discard error
        return 2
    }
    if !applied.IsClean() return 2
    if machine.HistoryLen() != 1 return 3

    const snapshot = machine.Snapshot()
    const submitted = match snapshot {
        Draft: false
        Submitted: true
        Paid(receipt): receipt == 42
        Cancelled(reason): cancelledCode(reason) == 0
    }
    if !submitted return 4

    var history = machine.History()
    if history.Len() != 1 return 5
    discard history

    const checked = machine.CheckTimeout(
        time.Seconds(60),
        .Pay,
        $payTransition
    ) else error {
        discard error
        return 6
    }
    const pending = match checked {
        Pending: true
        Applied(report): {
            discard report
            false
        }
    }
    if !pending return 7
    0
}

fn paymentRejected(&order Order) bool {
    order.Pay(7) else transition {
        print("invalid transition")
        discard transition
        return true
    }
    false
}

fn cancelledCode(reason String) i32 {
    print(reason)
    0
}

fn cancellationRejected(&order Order, $reason String) bool {
    order.Cancel($reason) else transition {
        discard transition
        return true
    }
    false
}

fn main() i32 {
    var paid Order = .Draft
    if !paymentRejected(&paid) return 1

    paid.Submit() else transition {
        discard transition
        return 2
    }
    paid.Pay(42) else transition {
        discard transition
        return 3
    }
    const paidCode = match paid {
        Draft: -1
        Submitted: -2
        Paid(receipt): receipt
        Cancelled(reason): cancelledCode(reason)
    }
    if paidCode != 42 return 5
    print("paid")

    var retained Order = .Draft
    retained.Submit() else transition {
        discard transition
        return 6
    }
    retained.Pay(9) else transition {
        discard transition
        return 7
    }
    var invalidReason String = "not stored"
    if !cancellationRejected(&retained, $invalidReason) return 8
    const retainedCode = match retained {
        Draft: -1
        Submitted: -2
        Paid(receipt): receipt
        Cancelled(message): cancelledCode(message)
    }
    if retainedCode != 9 return 9

    var cancelled Order = .Draft
    var reason String = "cancelled"
    cancelled.Cancel($reason) else transition {
        discard transition
        return 10
    }
    const cancelledResult = match cancelled {
        Draft: -1
        Submitted: -2
        Paid(receipt): receipt
        Cancelled(message): cancelledCode(message)
    }
    if cancelledResult != 0 return 11
    managedDemo()
}
