package tour.app

import tour.math
import tour.text as text

fn offset(value i32) i32 {
    value + 100
}

fn main() i32 {
    print(text.Message())
    const add fn(i32, i32) i32 = math.Add
    const offset fn(i32) i32 = fn(value i32) i32 {
        value
    }
    const pair math.Pair = math.MakePair(20, 22)
    const boxed math.Box<i32> = math.BoxOf<i32>(pair.Left)
    const direct math.Box<i32> = math.Box<i32> { Value = boxed.Value }
    const maybe math.Maybe<i32> = math.Maybe<i32>.Value(direct.Value)
    const status = math.StatusFor(0)
    const code = match status {
        Ready: 0
        Failed(value): value
    }
    const unwrapped = match maybe {
        Empty: 0
        Value(value): value
    }
    add(math.Identity<i32>(unwrapped), pair.Right) - 42 + code + offset(0)
}
