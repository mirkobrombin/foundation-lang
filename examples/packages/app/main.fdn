package tour.app

import tour.math
import tour.text as text

fn main() i32 {
    print(text.Message())
    let pair math.Pair = math.MakePair(20, 22)
    let boxed math.Box<i32> = math.BoxOf<i32>(pair.Left)
    let direct math.Box<i32> = math.Box<i32> { Value = boxed.Value }
    let maybe math.Maybe<i32> = math.Maybe<i32>.Value(direct.Value)
    let status = math.StatusFor(0)
    let code = match status {
        Ready: 0
        Failed(value): value
    }
    let unwrapped = match maybe {
        Empty: 0
        Value(value): value
    }
    math.Add(math.Identity<i32>(unwrapped), pair.Right) - 42 + code
}
